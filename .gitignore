# Cursor only keeps local links. Skills and rules are maintained in Documents/.
.cursor/

# Toolchain
Toolchain/node_modules/
Toolchain/Dist/

# Compiler host products. obrc writes an extensionless program. -zap also writes a .zap sibling.
Compiler/**/build/
Compiler/**/*.exe
Compiler/**/*.o
Compiler/**/*.obj
Compiler/**/*.zap
# Compiler build system and ISO installer.
# Source stays in Compiler/BuildSystem; only generated trees are ignored.
Compiler/BuildSystem/build/
Compiler/BuildSystem/out/
Compiler/BuildSystem/CMakeUserPresets.json
Compiler/BuildSystem/Installer/work/
Compiler/BuildSystem/Installer/out/
Compiler/BuildSystem/Installer/*.iso
Compiler/BuildSystem/Installer/*.sha256
Compiler/**/*.pdb
Compiler/**/*.ilk
Compiler/**/*.exp
# Packaged editor plugin. Source stays in Compiler/ObjectiveR; rebuild with vsce.
Compiler/ObjectiveR/*.vsix
# g++ -o obrc on Linux. The source file is obrc.cpp and stays tracked.
Compiler/**/obrc
# obrc -o beside an example. The .obr and .mr sources stay tracked.
Compiler/Obr/examples/*
!Compiler/Obr/examples/*.obr
!Compiler/Obr/examples/*.mr
!Compiler/Obr/examples/*.md

# Preview firmware from Boot/*.obr. Logo, Bios, and Load are the three ROM images.
# The .debug beside each is the fault map. This build does not write .zap.
Toolchain/Zap/

# Guest tree of the reference NAS. None of it is source.
# obrc writes /kernel, /os, and /bin. provision.mjs copies Resource/Font into /font
# and marks those copies read-only. It seeds /boot/display and /boot/debug
# only when the file is missing. Those two stay writable.
# Wiping this directory and compiling again recreates it.
# Kernel sources stay under ZerOS-PRO/Kernel/.
# Userspace sources stay under ZerOS-PRO/System/.
# Font sources stay under ZerOS-PRO/Resource/.
ZerOS-PRO/Hardware/Nas/Root/

# Vite dependency cache
**/.vite/

# temp
dev/
@dev/

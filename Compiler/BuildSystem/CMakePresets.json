{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-mingw",
      "displayName": "Windows MinGW-w64 + Ninja (Release)",
      "description": "Uses c++.exe from PATH. Generated files stay under BuildSystem/build.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-mingw",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "environment": {
        "TMP": "${sourceDir}/build",
        "TEMP": "${sourceDir}/build"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "c++.exe"
      }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux GCC + Ninja (Release)",
      "description": "Uses the host c++ from PATH.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-gcc",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-mingw",
      "configurePreset": "windows-mingw",
      "environment": {
        "TMP": "${sourceDir}/build",
        "TEMP": "${sourceDir}/build"
      }
    },
    {
      "name": "linux-gcc",
      "configurePreset": "linux-gcc"
    }
  ],
  "testPresets": [
    {
      "name": "windows-mingw",
      "configurePreset": "windows-mingw",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-gcc",
      "configurePreset": "linux-gcc",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}

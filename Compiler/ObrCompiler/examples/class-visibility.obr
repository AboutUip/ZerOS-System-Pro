/* Plan 2 M4：可见性与 friend。成员缺省 public；private 真实检查；
   @Friend(类名...) 类级（整类）或成员级（单个成员）授权。结果 0。*/
#VERSION 2

@Friend(Auditor) class Account {
  private long balance;
  @Friend(Owner) private long secret;
  deRfun Account(long start): void { balance = start; secret = 7; }
  deRfun deposit(long v): void { balance = balance + v; }
  deRfun total(): long { return balance + secret; }
}

class Owner {
  deRfun peek(Account a): long { return a.secret; }
}

class Auditor {
  deRfun check(Account a): long { return a.balance; }
}

class Stranger {
  deRfun total(Account a): long { return a.total(); }
}

deRfun main(): int {
  Account a = new Account(100);
  a.deposit(5);
  Owner o = new Owner();
  Auditor d = new Auditor();
  Stranger s = new Stranger();
  if (d.check(a) != 105L) return 1;
  if (o.peek(a) != 7L) return 2;
  if (s.total(a) != 112L) return 3;
  return 0;
}

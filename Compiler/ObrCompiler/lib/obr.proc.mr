/* 客程序的系统调用。home 是 query(1, 8, core())，也就是本核心的界限起点。
   窗口里的字：
   +0 分配的位数、释放的块地址、装入或卸下的核心号。
   +64 释放时的位数。
   +128 打开标志、描述符、目录下标、权限、属主、等待的 pid、spawn 的核心、信号的目标、管道的读端、驱动方向、dup 与 dup2 的旧描述符。
   +192 打开得到的描述符、读写偏移、目录容量、属组、退出码、spawn 得到的 pid、信号号、管道的写端、接入得到的入口、dup 的新描述符、dup2 要占用的描述符。
   +256 读写个数、目录读回的名字长度。
   +320 实际读写的个数。
   +512 只给服务 26 回写字体路径。请求路径不放这里。
   +448 stat 交回访问时间。+576 修改时间。+640 状态时间。三个都是从 Unix 纪元起的毫秒。
   +12288 附近是调用帧。
   +16384 请求路径，排法见 obr.text。最长 8192 个八位组。一个分量在内核里最长 512。
   +131072 读写和目录项的八位组，相邻隔 8 位，不是计数字符串。一次最多 262144 个八位组。
   返回值就是内核状态，0 是成功。等待时子任务还在跑，这次调用不返回。 */
namespace obr {
namespace proc {
/* 本核心的界限起点。 */
deRfun home(): long;
/* 请求路径的起点，home + 16384。 */
deRfun path(long home): long;
/* 读写字节的起点，home + 131072。一次最多 262144 个八位组。 */
deRfun bytes(long home): long;
/* 读窗口里的一个字。offset 是上面列出的位偏移。 */
deRfun slot(long home, long offset): long;
/* 服务 5。路径已在 +16384。标志 0 只读，1 只写并截断，2 读写，3 追加。成功时描述符在 +192。 */
deRfun open(long home, long flags): long;
/* 服务 7。字节在 +131072。实际个数在 +320。 */
deRfun read(long home, long fd, long offset, long count): long;
/* 服务 8。字节在 +131072。实际个数在 +320。 */
deRfun write(long home, long fd, long offset, long count): long;
/* 服务 6。 */
deRfun close(long home, long fd): long;
/* 服务 24。成功时新描述符在 +192，是该任务最小的空位。没有空位是 7。旧描述符不存在是 -1。 */
deRfun dup(long home, long fd): long;
/* 服务 25。to 不在 0 到 7，或旧描述符不存在，是 -1。两个号码相同则回复 0，不关闭。 */
deRfun dup2(long home, long from, long to): long;
/* 服务 4。路径在 +16384。种类在 +128，大小在 +192，权限在 +256，属主在 +320，属组在 +384。
   访问时间在 +448，修改时间在 +576，状态时间在 +640。 */
deRfun stat(long home): long;
/* 服务 9。路径在 +16384。名字八位组写到 +131072，个数在 +256。 */
deRfun readdir(long home, long index, long capacity): long;
/* 服务 34。从下标起把这一层放得进字节区的记录一次交回。+256 是条数，+320 是八位组数。
   每条先是 9 个字：名字长度、种类、大小、权限、属主、属组、访问时间、修改时间、状态时间，随后是名字。
   下一条紧跟名字。下标已经越过末尾时状态是 2。 */
deRfun list(long home, long index): long;
/* 服务 10。路径在 +16384。 */
deRfun mkdir(long home): long;
/* 服务 11。路径在 +16384。 */
deRfun unlink(long home): long;
/* 服务 14。路径在 +16384。mode 只留低 9 位。 */
deRfun chmod(long home, long mode): long;
/* 服务 15。路径在 +16384。 */
deRfun chown(long home, long uid, long gid): long;
/* 服务 16。路径在 +16384。 */
deRfun chdir(long home): long;
/* 服务 20。读端在 +128，写端在 +192。 */
deRfun pipe(long home): long;
/* 服务 17。路径在 +16384。core 为 0 时由内核选一颗。pid 在 +192，实际核心在 +256。 */
deRfun spawn(long home, long core): long;
/* 服务 18。不能把 1 号作为目标。 */
deRfun kill(long home, long pid, long sig): long;
/* 服务 19。返回取到的信号，没有则是 0。 */
deRfun sigtake(): long;
/* 服务 21。pid 为 0 表示任意子任务。成功时返回值是 pid，退出码在 +192。没有子任务是 2。 */
deRfun wait(long home, long pid): long;
/* 服务 28。把 0 至 255 的状态交给父任务的 wait，然后不再返回。 */
deRfun exit(long home, long code): long;
/* 服务 29。当前目录的绝对路径写到字节区，长度在 +256。不含 . 和 ..。 */
deRfun getcwd(long home): long;
/* 服务 30。任何任务都能调用。+128 是从 Unix 纪元起的毫秒。 */
deRfun clock(long home): long;
/* 服务 31。路径在 +16384。setAccess 不是 0 时把 access 写成访问时间，setModify 不是 0 时把 modify 写成修改时间。
   给出 0 的那一项保持原值。状态时间改成这次调用读到的现在。属主或根才能改。 */
deRfun utime(long home, long setAccess, long setModify, long access, long modify): long;
/* 服务 32。uid 在 +128，gid 在 +192，euid 在 +256，egid 在 +320。 */
deRfun ident(long home): long;
/* 服务 33。start 放在 +128。没有更多任务时回复 2。找到时回复 0，这份下标在 +192，下一份下标在 +320。
   字节区 12 个字：pid、ppid、状态、核心、uid、gid、euid、egid、地址空间起点、长度、档、名字长度。
   名字从第 12 个字之后起，最多 32 个八位组。状态 1 正在跑，2 就绪，3 在等，4 停住，5 僵尸。 */
deRfun task(long home, long start): long;
/* 服务 35。壳画完提示符后调用；只回复 0。宿主在 svc 边界记 prompt 事件，用于诊断。 */
deRfun prompt(long home): long;
/* 服务 36。壳开始解析一行命令时调用；只回复 0。宿主在 svc 边界开命令 span。 */
deRfun command(long home): long;
/* 服务 2。返回块地址。 */
deRfun alloc(long home, long size): long;
/* 服务 3。 */
deRfun free(long home, long block, long size): long;
/* 服务 12。需要能力位 0。返回装上的核心，失败是 0。 */
deRfun load(long home, long core): long;
/* 服务 13。需要能力位 0。 */
deRfun unload(long home, long core): long;
/* 服务 22。路径在 +16384。入口地址在 +192。 */
deRfun loadlib(long home): long;
/* 服务 23。只有发布了设备的驱动调用。dir 0 从下行环取出，1 写入上行环。个数在 +256，字节在 +131072，实际个数在 +320。 */
deRfun devio(long home, long dir): long;
/* 服务 26。index 为 -1 时返回系统字体的份数。否则成功时 +128 是引导时在不在，+192 是八位组数，+512 是路径。下标越界是 -1。 */
deRfun font(long home, long index): long;
}
}

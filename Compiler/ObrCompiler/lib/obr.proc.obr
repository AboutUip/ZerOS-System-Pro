/* 客程序系统调用。只填窗口再 svc，不碰扩展口。 */
import board;
import memory;
import obr.os;

deRfun obr::proc::home(): long {
  return query(1L, 8L, obr::os::core());
}

/* 请求路径的起点。字体服务的回复仍写在 +512。 */
deRfun obr::proc::path(long home): long {
  return home + 16384L;
}

/* 读写字节的起点。一次最多 262144 个八位组。 */
deRfun obr::proc::bytes(long home): long {
  return home + 131072L;
}

deRfun obr::proc::slot(long home, long offset): long {
  return memory::load64(home + offset);
}

deRfun obr::proc::open(long home, long flags): long {
  memory::store64(flags, home + 128L);
  return obr::os::svc(5L);
}

deRfun obr::proc::read(long home, long fd, long offset, long count): long {
  memory::store64(fd, home + 128L);
  memory::store64(offset, home + 192L);
  memory::store64(count, home + 256L);
  return obr::os::svc(7L);
}

deRfun obr::proc::write(long home, long fd, long offset, long count): long {
  memory::store64(fd, home + 128L);
  memory::store64(offset, home + 192L);
  memory::store64(count, home + 256L);
  return obr::os::svc(8L);
}

deRfun obr::proc::close(long home, long fd): long {
  memory::store64(fd, home + 128L);
  return obr::os::svc(6L);
}

deRfun obr::proc::dup(long home, long fd): long {
  memory::store64(fd, home + 128L);
  return obr::os::svc(24L);
}

deRfun obr::proc::dup2(long home, long from, long to): long {
  memory::store64(from, home + 128L);
  memory::store64(to, home + 192L);
  return obr::os::svc(25L);
}

deRfun obr::proc::stat(long home): long {
  return obr::os::svc(4L);
}

deRfun obr::proc::readdir(long home, long index, long capacity): long {
  memory::store64(index, home + 128L);
  memory::store64(capacity, home + 192L);
  return obr::os::svc(9L);
}

/* 一次最多交回 131072 个八位组，剩下的半扇留给调用方在写出之前把记录挪走。 */
deRfun obr::proc::list(long home, long index): long {
  memory::store64(index, home + 128L);
  memory::store64(131072L, home + 192L);
  return obr::os::svc(34L);
}

deRfun obr::proc::mkdir(long home): long {
  return obr::os::svc(10L);
}

deRfun obr::proc::unlink(long home): long {
  return obr::os::svc(11L);
}

deRfun obr::proc::chmod(long home, long mode): long {
  memory::store64(mode, home + 128L);
  return obr::os::svc(14L);
}

deRfun obr::proc::chown(long home, long uid, long gid): long {
  memory::store64(uid, home + 128L);
  memory::store64(gid, home + 192L);
  return obr::os::svc(15L);
}

deRfun obr::proc::chdir(long home): long {
  return obr::os::svc(16L);
}

deRfun obr::proc::pipe(long home): long {
  return obr::os::svc(20L);
}

deRfun obr::proc::spawn(long home, long core): long {
  memory::store64(core, home + 128L);
  return obr::os::svc(17L);
}

deRfun obr::proc::kill(long home, long pid, long sig): long {
  memory::store64(pid, home + 128L);
  memory::store64(sig, home + 192L);
  return obr::os::svc(18L);
}

deRfun obr::proc::sigtake(): long {
  return obr::os::svc(19L);
}

deRfun obr::proc::wait(long home, long pid): long {
  memory::store64(pid, home + 128L);
  return obr::os::svc(21L);
}

/* 成功时监督核不回复，调用停在这里。 */
deRfun obr::proc::exit(long home, long code): long {
  memory::store64(code, home + 128L);
  return obr::os::svc(28L);
}

deRfun obr::proc::getcwd(long home): long {
  return obr::os::svc(29L);
}

deRfun obr::proc::clock(long home): long {
  long status = obr::os::svc(30L);
  if (status != 0L) {
    memory::store64(0L, home + 128L);
  }
  return status;
}

deRfun obr::proc::utime(long home, long setAccess, long setModify, long access, long modify): long {
  memory::store64(setAccess, home + 128L);
  memory::store64(setModify, home + 192L);
  memory::store64(access, home + 256L);
  memory::store64(modify, home + 320L);
  return obr::os::svc(31L);
}

deRfun obr::proc::ident(long home): long {
  return obr::os::svc(32L);
}

deRfun obr::proc::task(long home, long start): long {
  memory::store64(start, home + 128L);
  return obr::os::svc(33L);
}

/* 服务 35。提示符诊断标记；宿主在 svc 边界记 prompt 事件。 */
deRfun obr::proc::prompt(long home): long {
  return obr::os::svc(35L);
}

/* 服务 36。命令开始诊断标记；宿主在 svc 边界开命令 span。 */
deRfun obr::proc::command(long home): long {
  return obr::os::svc(36L);
}

deRfun obr::proc::alloc(long home, long size): long {
  memory::store64(size, home);
  return obr::os::svc(2L);
}

deRfun obr::proc::free(long home, long block, long size): long {
  memory::store64(block, home);
  memory::store64(size, home + 64L);
  return obr::os::svc(3L);
}

deRfun obr::proc::load(long home, long core): long {
  memory::store64(core, home);
  return obr::os::svc(12L);
}

deRfun obr::proc::unload(long home, long core): long {
  memory::store64(core, home);
  return obr::os::svc(13L);
}

deRfun obr::proc::loadlib(long home): long {
  return obr::os::svc(22L);
}

deRfun obr::proc::devio(long home, long dir): long {
  memory::store64(dir, home + 128L);
  return obr::os::svc(23L);
}

deRfun obr::proc::font(long home, long index): long {
  memory::store64(index, home);
  return obr::os::svc(26L);
}

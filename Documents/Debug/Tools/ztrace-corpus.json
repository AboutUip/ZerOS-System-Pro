{
  "schema": "zeros.ztrace.corpus/1",
  "description": "v1 全命令语料。每项只验证命令能回到提示符，不比较输出文本。",
  "commands": [
    { "name": "basename", "command": "basename /home/test.txt" },
    { "name": "cat", "command": "cat /home/test.txt" },
    { "name": "chmod", "command": "chmod 644 /home/test.txt" },
    { "name": "chown", "command": "chown 0 /home/test.txt" },
    { "name": "cksum", "command": "cksum /home/test.txt" },
    { "name": "cmp", "command": "cmp /home/test.txt /home/test.txt" },
    { "name": "comm", "command": "comm /home/perf/a.txt /home/perf/b.txt" },
    { "name": "cp", "command": "cp /home/test.txt /home/perf/corpus-copy.txt" },
    { "name": "cut", "command": "cut -f 1 /home/test.txt" },
    { "name": "date", "command": "date" },
    { "name": "dd", "command": "dd if=/home/test.txt of=/home/perf/corpus-dd.txt" },
    { "name": "diff", "command": "diff /home/test.txt /home/test.txt" },
    { "name": "dirname", "command": "dirname /home/test.txt" },
    { "name": "du", "command": "du /home/perf" },
    { "name": "echo", "command": "echo ok" },
    { "name": "env", "command": "env" },
    { "name": "expr", "command": "expr 1 + 2" },
    { "name": "false", "command": "false" },
    { "name": "find", "command": "find /home/perf -name a.txt" },
    { "name": "fold", "command": "fold -w 8 /home/test.txt" },
    { "name": "grep", "command": "grep Hello /home/test.txt" },
    { "name": "head", "command": "head /home/test.txt" },
    { "name": "id", "command": "id" },
    { "name": "install", "command": "install /home/test.txt /home/perf/corpus-install.txt" },
    { "name": "kill", "command": "kill" },
    { "name": "ls", "command": "ls /home/perf" },
    { "name": "mkdir", "command": "mkdir -p /home/perf/corpus-dir" },
    { "name": "mktemp", "command": "mktemp" },
    { "name": "mv", "command": "mv /home/perf/corpus-copy.txt /home/perf/corpus-copy2.txt" },
    { "name": "od", "command": "od /home/test.txt" },
    { "name": "paste", "command": "paste /home/perf/a.txt /home/perf/b.txt" },
    { "name": "printf", "command": "printf hi" },
    { "name": "ps", "command": "ps" },
    { "name": "pwd", "command": "pwd" },
    { "name": "realpath", "command": "realpath /home/test.txt" },
    { "name": "rm", "command": "rm /home/perf/corpus-copy2.txt" },
    { "name": "rmdir", "command": "rmdir /home/perf/corpus-dir" },
    { "name": "seq", "command": "seq 1 3" },
    { "name": "sleep", "command": "sleep 0.1" },
    { "name": "sort", "command": "sort /home/perf/a.txt" },
    { "name": "tail", "command": "tail /home/test.txt" },
    { "name": "tee", "command": "echo hi | tee /home/perf/corpus-tee.txt" },
    { "name": "test", "command": "test -f /home/test.txt" },
    { "name": "touch", "command": "touch /home/perf/corpus-touch.txt" },
    { "name": "tr", "command": "echo abc | tr a b" },
    { "name": "tree", "command": "tree -L 1 /home/perf" },
    { "name": "true", "command": "true" },
    { "name": "uname", "command": "uname" },
    { "name": "uniq", "command": "uniq /home/perf/a.txt" },
    { "name": "wc", "command": "wc /home/test.txt" },
    { "name": "which", "command": "which ls" },
    { "name": "whoami", "command": "whoami" },
    { "name": "xargs", "command": "xargs echo < /home/test.txt" },
    { "name": "yes", "command": "yes --help" }
  ]
}

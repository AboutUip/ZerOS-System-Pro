/* export-before-kill 测试驱动：只在收到 SIGTERM 时把计数器写进服务 57，
   然后 halt。平时不 checkpoint，所以“没有状态 → 重启后出现状态”只能由
   旧实例在退出前导出产生。 */
import board;
import memory;
import obr.os;

deRfun main(): int {
  long home = obr::os::svc(65L);
  memory::store64(2L, home + 64L);
  long count = obr::os::svc(57L);
  long value = 0L;
  if (count == 8L) {
    value = memory::load64(home + 131072L);
  }
  while (1L) {
    value = value + 1L;
    long sig = obr::os::svc(19L);
    if (sig == 15L) {
      /* 导出前重新取本核窗口起点。启动时的 home 可能被同核的窗口/上下文换掉。 */
      long at = query(1L, 8L, obr::os::core());
      memory::store64(value, at + 131072L);
      memory::store64(8L, at + 128L);
      memory::store64(1L, at + 64L);
      obr::os::svc(57L);
      /* 主函数返回只会 halt，任务仍占着核；显式走退出服务，管理器才能收掉。 */
      memory::store64(0L, at + 128L);
      obr::os::svc(28L);
      return 0;
    }
    obr::os::dwell(50L);
  }
  return 0;
}

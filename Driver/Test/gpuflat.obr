/* Flat GPU continuity checker: 由 /bin/gpuflat 经服务 46 装入。
   读服务 69 → SIGTERM 旧 GPU 驱动 → 重新装入 → 读服务 69 → 写 verdict 文件。
   窗口任务，不走旧布局 kSp。 */
import board;
import memory;
import obr.os;

deRfun myHome(): long {
  long value = query(1L, 8L, obr::os::core());
  long tries = 0L;
  while (value == 0L && tries < 20L) {
    obr::os::dwell(5L);
    value = query(1L, 8L, obr::os::core());
    tries = tries + 1L;
  }
  if (value == 0L) {
    value = obr::os::svc(65L);
  }
  return value;
}

deRfun setPath(long home, string path): void {
  long count = length(path);
  memory::store64(count, home + 16384L);
  long index = 0L;
  while (index < count) {
    memory::storeOctet(path[index], home + 16384L + 64L + index * 8L);
    index = index + 1L;
  }
}

deRfun putVerdict(long home, long code): void {
  setPath(home, "/temp/gpu.cont");
  memory::store64(1L, home + 128L);
  if (obr::os::svc(5L) != 0L) {
    return;
  }
  long fd = memory::load64(home + 192L);
  memory::store64(fd, home + 128L);
  memory::store64(0L, home + 192L);
  memory::store64(1L, home + 256L);
  memory::storeOctet(code, home + 131072L);
  obr::os::svc(8L);
  memory::store64(fd, home + 128L);
  obr::os::svc(6L);
}

deRfun stage(long home, long tag, long value): void {
  setPath(home, "/temp/gpu.slots");
  long flags = 2L;
  if (tag == 65L) {
    flags = 1L;
  }
  memory::store64(flags, home + 128L);
  if (obr::os::svc(5L) != 0L) {
    return;
  }
  long fd = memory::load64(home + 192L);
  memory::storeOctet(value % 256L, home + 131072L);
  memory::store64(fd, home + 128L);
  memory::store64(tag - 65L, home + 192L);
  memory::store64(1L, home + 256L);
  obr::os::svc(8L);
  memory::store64(fd, home + 128L);
  obr::os::svc(6L);
}

deRfun main(): int {
  long home = myHome();
  home = myHome();
  memory::store64(2L, home + 64L);
  long got = obr::os::svc(69L);
  home = myHome();
  long before = 0L;
  if (got == 16L) {
    before = memory::load64(home + 131072L);
  }
  home = myHome();
  memory::store64(9L, home + 64L);
  long oldpid = obr::os::svc(56L);
  home = myHome();
  home = myHome();
  if (oldpid > 1L) {
    home = myHome();
    memory::store64(oldpid, home + 128L);
    memory::store64(15L, home + 192L);
    obr::os::svc(18L);
  }
  home = myHome();
  long live = 1L;
  long waits = 0L;
  while (live > 0L && waits < 30L) {
    home = myHome();
    memory::store64(10L, home + 64L);
    live = obr::os::svc(56L);
    if (live > 0L) {
      obr::os::dwell(50L);
    }
    waits = waits + 1L;
  }
  home = myHome();
  home = myHome();
  setPath(home, "/drivers/gpu.zo");
  long status = 11L;
  long tries = 0L;
  while (status == 11L && tries < 30L) {
    home = myHome();
    memory::store64(0L, home + 128L);
    memory::store64(1L, home + 64L);
    status = obr::os::svc(56L);
    if (status == 11L) {
      obr::os::dwell(100L);
    }
    tries = tries + 1L;
  }
  home = myHome();
  if (status != 0L) {
    home = myHome();
    putVerdict(home, 254L);
    memory::store64(0L, home + 128L);
    obr::os::svc(28L);
    return 0;
  }
  obr::os::dwell(2500L);
  home = myHome();
  memory::store64(2L, home + 64L);
  got = obr::os::svc(69L);
  if (got != 16L) {
    putVerdict(home, 253L);
    memory::store64(0L, home + 128L);
    obr::os::svc(28L);
    return 0;
  }
  long frames = memory::load64(home + 131072L);
  long base = memory::load64(home + 131136L);
  home = myHome();
  long code = 42L;
  if (base < 1L) {
    code = 250L;
  } else if (base < before) {
    code = 251L;
  } else if (frames < base) {
    code = 252L;
  }
  putVerdict(home, code);
  memory::store64(0L, home + 128L);
  obr::os::svc(28L);
  return 0;
}

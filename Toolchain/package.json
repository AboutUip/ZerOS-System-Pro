{
  "name": "zeros-pro-toolchain",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node ./run-lint.mjs",
    "check": "npm run typecheck && npm run lint",
    "build": "npm run check && vite build",
    "check:bios-input": "node Checks/check-bios-input.mjs",
    "check:bios-layout": "node Checks/check-bios.mjs && node Checks/check-bios.mjs --numbers"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/node": "^22.15.21",
    "eslint": "^9.27.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@bylan280/xaiop": "^0.15.1"
  }
}

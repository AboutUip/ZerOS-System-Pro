/* 画表里的一行。index 是核心或扩展口的循环下标。 */
deRfun show(long x, long y, long wide, long kind, long a, long b, long c, long index): long {
  long ink = obr::ui::rgb(232L, 236L, 242L);
  long dim = obr::ui::rgb(132L, 144L, 162L);
  if (kind == 1L) {
    say(x, y, 16L, a, ink);
    return y + b;
  }
  if (kind == 2L) {
    say(x, y, 16L, a, dim);
    return y + b;
  }
  if (kind == 3L) {
    return y + a;
  }
  if (kind == 4L || kind == 5L) {
    long field = c % 8L;
    long off = c / 8L;
    say(x, y, 16L, a, dim);
    if (kind == 4L) {
      putnum(x + off, y, query(b, field, index), ink);
    } else {
      putfield(x + off, y, b, field, 0L, ink);
    }
    return y + 24L;
  }
  if (kind == 8L) {
    long field = c % 8L;
    long color = (c / 8L) % 8L;
    long maxCode = (c / 64L) % 2L;
    long off = c / 128L;
    long maximum = 1000000000L;
    long fill = obr::ui::rgb(72L, 156L, 255L);
    long value = 0L;
    if (maxCode == 1L) {
      maximum = 1000L;
    }
    if (color == 1L) {
      fill = obr::ui::rgb(72L, 196L, 150L);
    } else if (color == 2L) {
      fill = obr::ui::rgb(214L, 164L, 72L);
    } else if (color == 3L) {
      fill = obr::ui::rgb(120L, 160L, 220L);
    }
    if (b == 1L && field == 6L && query(1L, 0L, 0L) == 0L) {
      value = 0L;
    } else {
      value = query(b, field, index);
    }
    if (a >= 0L) {
      say(x, y, 16L, a, dim);
      putnum(x + off, y, value, ink);
      y = y + 22L;
    }
    meterbar(x, y, wide, value, maximum, fill);
    return y + 22L;
  }
  if (kind == 9L) {
    say(x, y, 16L, a, dim);
    putnum(x + c, y, b, ink);
    return y + 24L;
  }
  if (kind == 15L) {
    long cores = query(1L, 0L, 0L);
    long run = 0L;
    long cursor = 0L;
    while (cursor != cores) {
      if (query(1L, 5L, cursor) != 0L) {
        run = run + 1L;
      }
      cursor = cursor + 1L;
    }
    say(x, y, 16L, 16L, dim);
    cursor = putnum(x + 40L, y, run, ink);
    obr::ui::glyph(47L, cursor, y, 16L, dim, 255L);
    putnum(cursor + 8L, y, cores, ink);
    y = y + 20L;
    if (cores > 0L) {
      meterbar(x, y, wide, run, cores, obr::ui::rgb(72L, 156L, 255L));
      y = y + 22L;
    }
    return y + 8L;
  }
  if (kind == 16L) {
    long count = query(0L, 1L, 0L);
    long cursor = 0L;
    while (cursor != count) {
      long tag = 38L;
      if (cursor == 0L) {
        tag = 37L;
      } else if (cursor == 1L) {
        tag = 6L;
      } else if (cursor == 2L) {
        tag = 7L;
      } else if (cursor == 3L) {
        tag = 30L;
      }
      say(x, y, 16L, tag, dim);
      putfield(x + 56L, y, 0L, 2L, cursor * 8L, ink);
      y = y + 24L;
      cursor = cursor + 1L;
    }
    return y;
  }
  if (kind == 17L) {
    say(x, y, 16L, a, dim);
    say(x + c, y, 16L, b, ink);
    return y + 24L;
  }
  if (kind == 18L) {
    long cursor = 0L;
    say(x, y, 16L, a, dim);
    cursor = putnum(x + c, y, query(b, 0L, 0L), ink);
    obr::ui::glyph(120L, cursor + 8L, y, 16L, dim, 255L);
    putnum(cursor + 24L, y, query(b, 1L, 0L), ink);
    return y + 24L;
  }
  if (kind == 19L) {
    long cursor = 0L;
    say(x, y, 16L, 9L, dim);
    cursor = putnum(x + 80L, y, query(4L, 0L, 0L), ink);
    obr::ui::glyph(120L, cursor + 8L, y, 16L, dim, 255L);
    cursor = putnum(cursor + 24L, y, query(4L, 1L, 0L), ink);
    say(cursor + 12L, y, 16L, 15L, dim);
    putnum(cursor + 40L, y, query(4L, 2L, 0L), ink);
    return y + 36L;
  }
  if (kind == 20L) {
    y = y + 16L;
    say(x, y, 16L, 41L, ink);
    putnum(x + 56L, y, index, ink);
    return y + 24L;
  }
  if (kind == 21L) {
    say(x, y, 16L, 25L, dim);
    if (query(1L, 5L, index) == 0L) {
      say(x + 64L, y, 16L, 45L, obr::ui::rgb(196L, 96L, 96L));
    } else {
      say(x + 64L, y, 16L, 16L, obr::ui::rgb(96L, 196L, 140L));
    }
    return y + 24L;
  }
  if (kind == 14L) {
    long* selection = (long*)5568;
    long state = query(5L, 0L, index);
    if (index == *selection) {
      obr::ui::rect(x - 8L, y - 4L, 280L, 48L, obr::ui::rgb(24L, 44L, 72L), 255L);
      obr::ui::rect(x - 8L, y - 4L, 3L, 48L, obr::ui::rgb(88L, 168L, 255L), 255L);
    }
    say(x, y, 16L, 30L, ink);
    putnum(x + 56L, y, index, ink);
    y = y + 22L;
    say(x, y, 16L, 25L, dim);
    putnum(x + 64L, y, state, ink);
    if (state != 0L) {
      putfield(x + 96L, y, 5L, 1L, index * 64L, ink);
    } else {
      say(x + 96L, y, 16L, 31L, dim);
    }
    return y + 32L;
  }
  if (kind == 22L) {
    long state = query(5L, 0L, index);
    say(x, y, 16L, 30L, ink);
    putnum(x + 56L, y, index, ink);
    y = y + 22L;
    say(x, y, 16L, 25L, dim);
    putnum(x + 64L, y, state, ink);
    y = y + 22L;
    if (state != 0L) {
      say(x, y, 16L, 36L, dim);
      putfield(x + 72L, y, 5L, 1L, index * 64L, ink);
      y = y + 22L;
      putfield(x, y, 5L, 2L, index * 64L, ink);
      return y + 28L;
    }
    say(x, y, 16L, 31L, dim);
    return y + 28L;
  }
  if (kind == 23L) {
    long* selection = (long*)5568;
    say(x, y, 16L, 30L, ink);
    putnum(x + 56L, y, *selection, ink);
    return y + 28L;
  }
  if (kind == 24L) {
    long* selection = (long*)5568;
    say(x, y, 16L, 25L, dim);
    putnum(x + 64L, y, query(5L, 0L, *selection), ink);
    return y + 24L;
  }
  if (kind == 25L) {
    long* selection = (long*)5568;
    long field = c % 8L;
    long off = c / 8L;
    say(x, y, 16L, a, dim);
    putfield(x + off, y, 5L, field, *selection * 64L, ink);
    return y + 24L;
  }
  return y;
}

/* 顺着当前页的行往下画。10 到 11 按核心重复，12 到 13 按四个扩展口重复。 */
deRfun rows(long x, long y, long wide, long page): long {
  long pc = at(12288L + page * 64L);
  long back = 0L;
  long index = 0L;
  long count = 0L;
  long step = 0L;
  while (step != 400L) {
    long kind = at(pc);
    step = step + 1L;
    if (kind == 0L) {
      return y;
    }
    if (kind == 10L) {
      back = pc + 256L;
      index = 0L;
      count = query(1L, 0L, 0L);
      pc = back;
      if (count == 0L) {
        while (at(pc) != 11L && at(pc) != 0L) {
          pc = pc + 256L;
        }
        if (at(pc) == 11L) {
          pc = pc + 256L;
        }
      }
      continue;
    }
    if (kind == 11L || kind == 13L) {
      index = index + 1L;
      if (index == count) {
        pc = pc + 256L;
        index = 0L;
      } else {
        pc = back;
      }
      continue;
    }
    if (kind == 12L) {
      back = pc + 256L;
      index = 0L;
      count = 4L;
      pc = back;
      continue;
    }
    y = show(x, y, wide, kind, at(pc + 64L), at(pc + 128L), at(pc + 192L), index);
    pc = pc + 256L;
  }
  return y;
}

deRfun pageOf(): long {
  long* category = (long*)5248;
  long* sub = (long*)4160;
  long* depth = (long*)5376;
  if (*category == 0L) {
    if (*sub == 5L && *depth != 0L) {
      return 6L;
    }
    return *sub;
  }
  return 7L + *sub;
}

/* 左侧一项。on 不是 0 时铺高亮，并在左缘留一条强调色。 */
deRfun sideRow(long y, long wide, long on, string name): void {
  long ink = obr::ui::rgb(132L, 144L, 162L);
  if (on != 0L) {
    obr::ui::rect(4L, y, wide - 8L, 30L, obr::ui::rgb(24L, 44L, 72L), 255L);
    obr::ui::rect(4L, y, 3L, 30L, obr::ui::rgb(88L, 168L, 255L), 255L);
    ink = obr::ui::rgb(232L, 236L, 242L);
  }
  obr::ui::text(16L, y + 7L, 16L, name, ink, 255L);
}

deRfun sideAt(long y, long wide, long on, long index): void {
  string* cell = (string*)(8192L + index * 64L);
  sideRow(y, wide, on, *cell);
}

/* 顶栏、左侧和右侧。滚动只平移右侧文字，栏本身不动。字和子页都从固定内存读。 */
deRfun paint(): void {
  if (at(5760L) == 0L) {
    fill();
  }
  long* phase = (long*)5888;
  *phase = *phase + 1L;
  long* focus = (long*)5184;
  long* category = (long*)5248;
  long* sub = (long*)4160;
  long* scroll = (long*)5312;
  long* limit = (long*)5632;
  long wide = obr::ui::width();
  long high = obr::ui::height();
  long top = 40L;
  long side = 136L;
  if (*scroll < 0L) {
    *scroll = 0L;
  }
  if (*scroll > *limit) {
    *scroll = *limit;
  }
  long panel = obr::ui::rgb(16L, 20L, 28L);
  long main = obr::ui::rgb(10L, 14L, 20L);
  long line = obr::ui::rgb(48L, 58L, 74L);
  long accent = obr::ui::rgb(88L, 168L, 255L);
  long ink = obr::ui::rgb(232L, 236L, 242L);
  long dim = obr::ui::rgb(132L, 144L, 162L);
  obr::ui::clear(obr::ui::rgb(8L, 10L, 14L), 255L);
  obr::ui::rect(0L, 0L, wide, top, panel, 255L);
  obr::ui::rect(0L, top, side, high - top, panel, 255L);
  obr::ui::rect(side, top, wide - side, high - top, main, 255L);
  obr::ui::rect(0L, top - 1L, wide, 1L, line, 255L);
  obr::ui::rect(side - 1L, top, 1L, high - top, line, 255L);
  long edge = line;
  if (*focus == 0L) {
    edge = accent;
  }
  obr::ui::rect(0L, 0L, wide, 2L, edge, 255L);
  obr::ui::rect(0L, top - 2L, wide, 2L, edge, 255L);
  edge = line;
  if (*focus == 1L) {
    edge = accent;
  }
  obr::ui::rect(0L, top, 2L, high - top, edge, 255L);
  obr::ui::rect(side - 2L, top, 2L, high - top, edge, 255L);
  edge = line;
  if (*focus == 2L) {
    edge = accent;
  }
  obr::ui::rect(side, top, wide - side, 2L, edge, 255L);
  obr::ui::rect(wide - 2L, top, 2L, high - top, edge, 255L);
  obr::ui::rect(side, high - 2L, wide - side, 2L, edge, 255L);
  long half = wide / 2L;
  long firm = dim;
  long about = dim;
  if (*category == 0L) {
    firm = ink;
    obr::ui::rect(12L, top - 4L, half - 24L, 2L, accent, 255L);
  } else {
    about = ink;
    obr::ui::rect(half + 12L, top - 4L, half - 24L, 2L, accent, 255L);
  }
  say(20L, 12L, 16L, 0L, firm);
  say(half + 20L, 12L, 16L, 1L, about);
  if (*focus == 0L) {
    say(wide - 48L, 12L, 16L, 2L, accent);
  } else if (*focus == 1L) {
    say(wide - 56L, 12L, 16L, 3L, accent);
  } else {
    say(wide - 56L, 12L, 16L, 4L, accent);
  }
  long row = top + 10L;
  if (*category == 0L) {
    long on = 0L;
    if (*sub == 0L) {
      on = 1L;
    }
    sideAt(row, side, on, 5L);
    row = row + 34L;
    on = 0L;
    if (*sub == 1L) {
      on = 1L;
    }
    sideAt(row, side, on, 6L);
    row = row + 34L;
    on = 0L;
    if (*sub == 2L) {
      on = 1L;
    }
    sideAt(row, side, on, 7L);
    row = row + 34L;
    on = 0L;
    if (*sub == 3L) {
      on = 1L;
    }
    sideAt(row, side, on, 8L);
    row = row + 34L;
    on = 0L;
    if (*sub == 4L) {
      on = 1L;
    }
    sideAt(row, side, on, 9L);
    row = row + 34L;
    on = 0L;
    if (*sub == 5L) {
      on = 1L;
    }
    sideAt(row, side, on, 10L);
  } else {
    long on = 0L;
    if (*sub == 0L) {
      on = 1L;
    }
    sideAt(row, side, on, 12L);
    row = row + 34L;
    on = 0L;
    if (*sub == 1L) {
      on = 1L;
    }
    sideAt(row, side, on, 13L);
    row = row + 34L;
    on = 0L;
    if (*sub == 2L) {
      on = 1L;
    }
    sideAt(row, side, on, 14L);
  }
  say(16L, high - 22L, 12L, 11L, dim);
  long body = wide - side - 36L;
  if (body < 40L) {
    body = 40L;
  }
  obr::ui::clip(side + 4L, top + 4L, wide - side - 12L, high - top - 8L);
  obr::ui::save();
  obr::ui::translate(0L, 0L - *scroll);
  long bottom = rows(side + 16L, top + 14L, body, pageOf());
  obr::ui::restore();
  obr::ui::unclip();
  long max = bottom - (high - 4L);
  if (max < 0L) {
    max = 0L;
  }
  *limit = max;
  if (max > 0L) {
    long track = high - top - 16L;
    long thumb = 28L;
    long travel = track - thumb;
    if (travel < 1L) {
      travel = 1L;
    }
    long thumbY = top + 8L + *scroll * travel / max;
    obr::ui::rect(wide - 7L, top + 8L, 3L, track, line, 255L);
    obr::ui::rect(wide - 7L, thumbY, 3L, thumb, accent, 255L);
  }
  obr::ui::present();
}

/* 从收件箱取出一次按键。0 没有事件，1 是可导航的按下，2 是其它已收完的事件。 */
deRfun poll(): int {
  long* port = (long*)4480;
  long* count = (long*)4352;
  long* name = (long*)4864;
  long* mods = (long*)4928;
  while (1) {
    long word = 0L;
    long found = inbox(&word);
    if (found == 0L) {
      return 0;
    }
    if (*port == 4L) {
      return 0;
    }
    long next = xchg(*port, 0L, word);
    if (next != *count) {
      *count = next;
      if (xchg(*port, 1L, 1L) != 0L) {
        return 2;
      }
      if (xchg(*port, 1L, 4L) != 0L) {
        return 2;
      }
      *name = xchg(*port, 1L, 3L);
      *mods = xchg(*port, 1L, 6L);
      return 1;
    }
  }
}

/* F12 进入设置。Tab 轮换焦点。方向键在当前块里移动。Esc 先退出详情，再离开设置。 */
deRfun onkey(): void {
  long* mode = (long*)4096;
  long* name = (long*)4864;
  long* mods = (long*)4928;
  long* focus = (long*)5184;
  long* category = (long*)5248;
  long* sub = (long*)4160;
  long* scroll = (long*)5312;
  long* depth = (long*)5376;
  long* selection = (long*)5568;
  if (*name == 0x323146L) {
    if (*mode != 2L) {
      *mode = 2L;
      *focus = 0L;
      *category = 0L;
      *sub = 0L;
      *scroll = 0L;
      *depth = 0L;
      *selection = 0L;
      if (at(5760L) == 0L) {
        fill();
      }
    }
    return;
  }
  if (*mode != 2L) {
    return;
  }
  if (*name == 0x657061637345L) {
    if (*depth != 0L) {
      *depth = 0L;
      *scroll = 0L;
      return;
    }
    clear();
    *mode = 1L;
    return;
  }
  if (*name == 0x626154L) {
    long dir = 1L;
    if (*mods % 2L != 0L) {
      dir = 0L - 1L;
    }
    *focus = bump(*focus, dir, 3L);
    return;
  }
  if (*name == 0x7265746e45L) {
    if (*category == 0L && *sub == 5L && *depth == 0L) {
      if (query(5L, 0L, *selection) != 0L) {
        *depth = 1L;
        *scroll = 0L;
      }
    }
    return;
  }
  if (backward(*name) == 1) {
    if (*focus == 0L) {
      *category = bump(*category, 0L - 1L, 2L);
      *sub = 0L;
      *scroll = 0L;
      *depth = 0L;
    } else if (*focus == 1L) {
      *sub = bump(*sub, 0L - 1L, subcount());
      *scroll = 0L;
      *depth = 0L;
    } else if (*category == 0L && *sub == 5L && *depth == 0L) {
      *selection = bump(*selection, 0L - 1L, 4L);
    } else {
      nudge(0L - 1L);
    }
    return;
  }
  if (forward(*name) == 1) {
    if (*focus == 0L) {
      *category = bump(*category, 1L, 2L);
      *sub = 0L;
      *scroll = 0L;
      *depth = 0L;
    } else if (*focus == 1L) {
      *sub = bump(*sub, 1L, subcount());
      *scroll = 0L;
      *depth = 0L;
    } else if (*category == 0L && *sub == 5L && *depth == 0L) {
      *selection = bump(*selection, 1L, 4L);
    } else {
      nudge(1L);
    }
  }
}

/* 把六个点重画一遍。hot 那颗是红的，其余是白的。点本身不动，颜色往后换。 */
deRfun dots(long hot): void {
  long wide = obr::ui::width();
  long high = obr::ui::height();
  long size = 48L;
  long step = obr::ui::advance(size);
  long word = obr::ui::textWidth(size, "Starting");
  long origin = obr::ui::align(0L, wide, word + step * 6L, obr::ui::Align::Center) + 8L;
  long y = obr::ui::align(0L, high, size, obr::ui::Align::Center);
  long white = obr::ui::rgb(255L, 255L, 255L);
  long red = obr::ui::rgb(255L, 0L, 0L);
  long index = 0L;
  while (index != 6L) {
    long color = white;
    if (index == hot) {
      color = red;
    }
    obr::ui::glyph(46L, origin + word + index * step, y, size, color, 255L);
    index = index + 1L;
  }
  obr::ui::present();
}

/* 找键盘口，然后一直轮询。等待时每 24 次把红点换到下一颗。设置画面按键立刻重画，空闲时少刷几次，让频率条上的亮线还能动。 */
deRfun main(): int {
  long* mode = (long*)4096;
  long* count = (long*)4352;
  long* wait = (long*)4416;
  long* port = (long*)4480;
  long* tick = (long*)5696;
  gl::load();
  *mode = 0L;
  *count = 0L;
  *wait = 800L;
  *tick = 0L;
  long index = 0L;
  long matched = 0L;
  while (index != 4L && matched == 0L) {
    if (port::state(index) == 2L && port::char(index, 0L) == 0x5AL && port::char(index, 1L) == 0x4BL && port::char(index, 2L) == 0x50L && port::char(index, 3L) == 0x31L) {
      *port = index;
      matched = 1L;
    } else {
      index = index + 1L;
    }
  }
  if (matched == 0L) {
    *port = 4L;
    clear();
    halt();
    return 0;
  }
  while (1) {
    int event = poll();
    if (event == 1) {
      onkey();
    }
    if (*mode == 2L) {
      if (event == 1) {
        paint();
        *tick = 0L;
      } else {
        *tick = *tick + 1L;
        if (*tick == 80L) {
          *tick = 0L;
          paint();
        }
      }
    } else if (*mode == 0L) {
      *wait = *wait - 1L;
      if (*wait == 0L) {
        clear();
        *mode = 1L;
      } else if (*wait % 24L == 0L) {
        dots((obr::ui::frame() - 1L) % 6L);
      }
    }
  }
}

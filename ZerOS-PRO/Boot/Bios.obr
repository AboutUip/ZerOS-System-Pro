/* 固件主程序。启动画面还在时 F12 进入设置：顶栏两个类别，左侧子类，右侧内容。Tab 在三块之间移动焦点。结束标志写成 1 之后不再进入。
   子页是 13312 起的行表，字符串在 8192。进入设置时写一次，之后只读地址。
   下面这些格子都低于 1048576。内核数据从 537919488 起，窗口记在 Hardware/Cpu/Config/KernelWindow.ts。
   4096 模式：0 等待 F12，此间画 Starting。1 操作系统加载，四块方标。2 设置画面。5952 写成 1 之后 F12 不再进入设置，并从 Starting 换成方标。
   4160 当前子类。4224 盒子编号。4288 旧文字行的纵坐标，界面改走加速绘制后不再使用。
   4352 键盘已完成次数。4416 等待拍数。4480 键盘口，4 表示没有。
   4864 键位名。4928 修饰位。4992 键值，上一次事件的第一个 UTF-16 码元。5056 为 1 表示这次是按住后的重复。
   5184 焦点：0 顶栏，1 左侧，2 右侧。5248 类别：0 固件，1 关于。
   5312 右侧滚动。5376 扩展口是否进入了详情。5568 选中的口。
   5632 右侧还能往下滚多少。5696 进入加载时清零。设置画面按墙钟重画，不再用它计数。5760 行表是否已经写入。5824 写入行表时的游标。
   5888 进度条亮线的相位。每次重画只加一，所有横条共用，不再按条去问显卡。
   5952 由核心 2 在各映像都尝试装入之后写成 1。装入程序失败时由核心 3 写成 1。
   6080 加载拖影的头部，0 到 23，绕圆一周。6144 是过渡拍，0 到 20：四块蓝色方标先淡入并上移，拖影晚几拍再淡入。
   6272 由监督核在看到 shell 之后写成 1，这时还没读字体。6336 由固件看见 6272 之后写成 1，表示方标已经停笔。
   6400 是 Starting 的红点，0 到 5。6464 为 1 表示倒计时阶段已经画过一次 Starting。
   监督核读到 6336 之后才画终端。这四格和 4096、5952 一样走共享内存。
   6528 是键盘环的写入次数。6656 起五个槽，每槽两个字、共 128 位，到 7296 为止。
   停笔之后、且不在设置里时，按下（含重复）先写入这个环，再交给原来的按键处理。
   这一段必须进共享内存，监督核才读得到。7360 起仍是显示器尺寸，不要写进去。
   7360 显示器尺寸档，0 到 4。7424 比例，0 原始、1 为 4:3、2 为 16:9、3 为 16:10。
   7488 打开的选择器：0 没有，1 尺寸，2 比例。7552 已经看过的鼠标完成次数。
   7616 右侧焦点落在哪一个选择器：0 尺寸，1 比例。7680、7744 是最近一次鼠标坐标。7808 为 1 表示已经有过鼠标事件。
   7872 起四个八位组是读 /boot/display 的暂存：宽的低 8 位、宽的高 8 位、高的低 8 位、高的高 8 位，相邻隔 8 位。不是 64 位格子。
   7936 为 1 表示正在拖右侧滚动条。8000 是按下时的纵坐标，8064 是按下时的滚动量。
   8128 是调试开关，0 关，1 开。整字必须出核心，主板看见 store.64 之后告诉页面。页面把同一位写入 /boot/debug。这格停在字符串表前面。
   4096 和 5952 都走共享内存。核心 0 画出加载画面后把 4096 写成 1，核心 2 要读得到。8128 也出核心。
   其余固件格子可以留在本核心上。
   6016 固件是否已经调度过核心 3。调度之后每 200 圈换一颗红点，这一段不等待，免得和内核读盘抢同一条宿主线程。
   固件启动时读 NAS 的 /boot/display 和 /boot/debug。改尺寸和改调试开关都由页面写入，不在这里占客机会话。
   8192 起是 64 个字符串指针，每项 64 位。0 FIRMWARE，1 ABOUT，2 TOP，3 SIDE，4 MAIN，
   5 OVERVIEW，6 CPU，7 GPU，8 MEMORY，9 DISPLAY，10 PORTS，11 TAB，12 SYSTEM，13 PROTOCOLS，
   14 DRIVERS，15 HZ，16 RUN，17 ACCESS，18 BYTES，19 FRAME，20 ID，21 VENDOR，22 PROTOCOL，
   23 CORES，24 REGISTERS，25 STATE，26 EXEC，27 WIDTH，28 HEIGHT，29 HERTZ，30 PORT，31 EMPTY，
   32 BOOT，33 SHELL，34 GL，35 LOADED，36 DEVICE，37 MEM，38 XCHG，39 KEYBOARD ZKP1，40 PANEL，
   41 CORE，42 ENTER OPENS  ESC BACK，43 ESC RETURNS，44 HZ MAX，45 STOP，46 COMMANDS，47 INIT，
   48 MEMORYID，49 DISPLAY ZDP1，50 POINTER ZPP1，51 DEBUG，52 ENTER TOGGLES。
   固件子类 6 是调试，页号 10。页号 6 仍是扩展口详情。
   12288 起是 16 个页起点。13312 起是行，每行四个字、共 256 位：种类、甲、乙、丙。
   种类 0 结束。1 亮字，2 暗字，3 空档，4 查询数字，5 查询字符串，8 频率条，9 固定数字，
   10 到 11 按核心重复，12 到 13 按四个扩展口重复，14 口列表，15 运行数，16 协议名，
   17 两个字，18 宽乘高，19 显示器一行，20 核心标题，21 运行或停止，22 驱动口，
   23 到 25 是选中口的详情。这些地址只给固件用，不是查询字段。
   r0 是返回值，r1 至 r5 是参数和临时，r7 只做 call 链接。
   找键盘口时 r0 至 r5 都占着，盒子编号已经写入 4224，所以借用 r6 当口编号。 */
import firmware;
import gl;
import board;
import obr.os;
import obr.ui;
import obr.nas;
import memory;
import pointer;
import obr.widget;
import panel;

/* 从高位往低位把一个非负整数画成字形，返回写完后的横坐标。 */
deRfun putnum(long x, long y, long value, long color): long {
  if (value < 0L) {
    value = 0L;
  }
  long step = obr::ui::advance(16L);
  if (value < 10L) {
    obr::ui::glyph(48L + value, x, y, 16L, color, 255L);
    return x + step;
  }
  long next = putnum(x, y, value / 10L, color);
  obr::ui::glyph(48L + value % 10L, next, y, 16L, color, 255L);
  return next + step;
}

/* 从查询字段连续读字符，遇到 0 停止。最多 32 个，避免没有结尾时一直画。 */
deRfun putfield(long x, long y, long seat, long field, long start, long color): long {
  long step = obr::ui::advance(16L);
  long index = 0L;
  while (index != 32L) {
    long code = query(seat, field, start + index);
    if (code == 0L) {
      return x;
    }
    obr::ui::glyph(code, x, y, 16L, color, 255L);
    x = x + step;
    index = index + 1L;
  }
  return x;
}

/* 横条表示 value / maximum。填充里有一条亮线，跟这一次重画的相位走。数值本身仍是查询结果。 */
deRfun meterbar(long x, long y, long wide, long value, long maximum, long fill): void {
  long track = obr::ui::rgb(24L, 30L, 40L);
  obr::ui::bar(x, y, wide, 12L, 5L, value, maximum, track, fill, 255L);
  long span = obr::ui::meter(wide, value, maximum);
  if (span > 6L) {
    long* phase = (long*)5888;
    long pip = (*phase * 4L) % span;
    obr::ui::rect(x + pip, y + 2L, 3L, 8L, obr::ui::rgb(236L, 244L, 255L), 255L);
  }
}

/* 当前类别有几个子类。固件 7 个，关于 3 个。调试是第 7 个，不能和扩展口详情共用页号。 */
deRfun subcount(): long {
  long* category = (long*)5248;
  if (*category == 0L) {
    return 7L;
  }
  return 3L;
}

/* 在 count 项里按 dir 进一格，两头相接。dir 是 1 或 -1。 */
deRfun bump(long current, long dir, long count): long {
  long next = current + dir;
  if (next < 0L) {
    return count - 1L;
  }
  if (next == count) {
    return 0L;
  }
  return next;
}

/* ArrowUp、Left，以及小键盘 8 和 4。 */
deRfun backward(long name): int {
  if (name == 0x7055776f727241L) {
    return 1;
  }
  if (name == 0x7466654cL) {
    return 1;
  }
  if (name == 0x386461706d754eL) {
    return 1;
  }
  if (name == 0x346461706d754eL) {
    return 1;
  }
  return 0;
}

/* ArrowDown 收成 Down，ArrowRight 收成 Right。小键盘 2 和 6 同样往前。 */
deRfun forward(long name): int {
  if (name == 0x6e776f44L) {
    return 1;
  }
  if (name == 0x7468676952L) {
    return 1;
  }
  if (name == 0x326461706d754eL) {
    return 1;
  }
  if (name == 0x366461706d754eL) {
    return 1;
  }
  return 0;
}

/* 右侧内容往上或往下移一截。limit 是上一帧算出的最大滚动量。 */
deRfun nudge(long dir): void {
  long* scroll = (long*)5312;
  long* limit = (long*)5632;
  *scroll = *scroll + dir * 20L;
  if (*scroll < 0L) {
    *scroll = 0L;
  }
  if (*scroll > *limit) {
    *scroll = *limit;
  }
}

/* 字表在 8192，每项 64 位，存的是字符串指针。下标见 Bios.ts。 */
deRfun keep(long index, string text): void {
  string* cell = (string*)(8192L + index * 64L);
  *cell = text;
}

deRfun say(long x, long y, long size, long index, long color): void {
  string* cell = (string*)(8192L + index * 64L);
  obr::ui::text(x, y, size, *cell, color, 255L);
}

deRfun at(long address): long {
  long* cell = (long*)address;
  return *cell;
}

deRfun set(long address, long value): void {
  long* cell = (long*)address;
  *cell = value;
}

/* 字段放低 3 位，数值横坐标是其余部分。 */
deRfun pack(long field, long off): long {
  return field + off * 8L;
}

/* 频率条：字段、颜色、满刻度、数值横坐标。颜色 0 处理器，1 内存，2 显卡，3 显示器。满刻度 0 是 10 亿，1 是 1000。 */
deRfun barPack(long field, long color, long maxCode, long off): long {
  return field + color * 8L + maxCode * 64L + off * 128L;
}

/* 一行四个字：种类、甲、乙、丙。种类 0 结束这一页。 */
deRfun plant(long kind, long a, long b, long c): void {
  long cursor = at(5824L);
  set(cursor, kind);
  set(cursor + 64L, a);
  set(cursor + 128L, b);
  set(cursor + 192L, c);
  set(5824L, cursor + 256L);
}

deRfun mark(long page): void {
  set(12288L + page * 64L, at(5824L));
}


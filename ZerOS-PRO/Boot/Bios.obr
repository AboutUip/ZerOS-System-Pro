deRfun han(long id, long x, long y, long color): void {
  long row = 0L;
  while (row < 16L) {
    long bits = bitrow(id, row);
    long col = 0L;
    long probe = 1L;
    while (col < 16L) {
      if ((bits / probe) % 2L == 1L) {
        obr::ui::rect(x + col, y + row, 1L, 1L, color, 255L);
      }
      probe = probe * 2L;
      col = col + 1L;
    }
    row = row + 1L;
  }
}

/* 名字和密码各最多 16 个八位组，拆在两个字里。低位是前面的字。
   用 set/at 写这些格子：同一个指针中途改地址会被收成最后一个。 */

deRfun scaleOf(long index): long {
  long scale = 1L;
  long step = 0L;
  while (step < index) {
    scale = scale * 256L;
    step = step + 1L;
  }
  return scale;
}

deRfun takeByte(long word, long index): long {
  long scale = scaleOf(index);
  return (word / scale) % 256L;
}

deRfun putByte(long word, long index, long code): long {
  long scale = scaleOf(index);
  long old = (word / scale) % 256L;
  return word - old * scale + (code % 256L) * scale;
}

deRfun pushAt(long lenAt, long lowAt, long highAt, long code): void {
  long len = at(lenAt);
  if (len < 0L || len >= 16L) {
    return;
  }
  if (len < 8L) {
    set(lowAt, putByte(at(lowAt), len, code));
  } else {
    set(highAt, putByte(at(highAt), len - 8L, code));
  }
  set(lenAt, len + 1L);
}

deRfun popAt(long lenAt): void {
  long len = at(lenAt);
  if (len <= 0L) {
    return;
  }
  set(lenAt, len - 1L);
}

deRfun cellAt(long lowAt, long highAt, long index): long {
  if (index < 8L) {
    return takeByte(at(lowAt), index);
  }
  return takeByte(at(highAt), index - 8L);
}

deRfun showLine(long lowAt, long highAt, long count, long x, long y, long color, long dots): void {
  if (count > 16L) {
    count = 16L;
  }
  long step = obr::ui::advance(16L);
  long index = 0L;
  while (index < count) {
    long code = 42L;
    if (dots == 0L) {
      code = cellAt(lowAt, highAt, index);
    }
    if (code >= 32L && code <= 126L) {
      obr::ui::glyph(code, x + index * step, y, 16L, color, 255L);
    }
    index = index + 1L;
  }
}

deRfun sameSecret(): int {
  long expect = at(6848L);
  long got = at(7104L);
  if (expect < 1L || expect != got) {
    return 0;
  }
  long index = 0L;
  while (index < expect) {
    if (cellAt(6912L, 6976L, index) != cellAt(7168L, 7232L, index)) {
      return 0;
    }
    index = index + 1L;
  }
  return 1;
}

/* 退格是 -1。字母、数字、减号和下划线是码点。其它是 0。 */
deRfun typed(): long {
  long name = *(long*)4864;
  long unit = *(long*)4992;
  if (name == 0x6B636142L) {
    return 0L - 1L;
  }
  if (name % 16777216L == 0x79654BL) {
    if (unit >= 97L && unit <= 122L) {
      return unit;
    }
    if (unit >= 65L && unit <= 90L) {
      return unit;
    }
  }
  if (name % 1099511627776L == 0x7469676944L) {
    if (unit >= 48L && unit <= 57L) {
      return unit;
    }
  }
  if (name == 0x73756E694DL) {
    if (unit == 45L || unit == 95L) {
      return unit;
    }
  }
  return 0L;
}

/* 0 语言 1 国家 2 中文 3 中国 4 美国 5 日本 6 英国
   7 用户名 8 密码 9 下一步 10 创建用户 11 欢迎 12 锁屏
   13 桌面 14 开始 15 安装 16 不对 */
deRfun phrase(long kind, long x, long y, long color): void {
  long step = 17L;
  if (kind == 0L) {
    han(2L, x, y, color);
    han(3L, x + step, y, color);
    return;
  }
  if (kind == 1L) {
    han(6L, x, y, color);
    han(7L, x + step, y, color);
    return;
  }
  if (kind == 2L) {
    han(4L, x, y, color);
    han(5L, x + step, y, color);
    return;
  }
  if (kind == 3L) {
    han(4L, x, y, color);
    han(6L, x + step, y, color);
    return;
  }
  if (kind == 4L) {
    han(8L, x, y, color);
    han(6L, x + step, y, color);
    return;
  }
  if (kind == 5L) {
    han(9L, x, y, color);
    han(10L, x + step, y, color);
    return;
  }
  if (kind == 6L) {
    han(11L, x, y, color);
    han(6L, x + step, y, color);
    return;
  }
  if (kind == 7L) {
    han(12L, x, y, color);
    han(13L, x + step, y, color);
    han(14L, x + step * 2L, y, color);
    return;
  }
  if (kind == 8L) {
    han(15L, x, y, color);
    han(16L, x + step, y, color);
    return;
  }
  if (kind == 9L) {
    han(17L, x, y, color);
    han(18L, x + step, y, color);
    han(19L, x + step * 2L, y, color);
    return;
  }
  if (kind == 10L) {
    han(20L, x, y, color);
    han(21L, x + step, y, color);
    han(12L, x + step * 2L, y, color);
    han(13L, x + step * 3L, y, color);
    return;
  }
  if (kind == 11L) {
    han(22L, x, y, color);
    han(23L, x + step, y, color);
    return;
  }
  if (kind == 12L) {
    han(24L, x, y, color);
    han(25L, x + step, y, color);
    return;
  }
  if (kind == 13L) {
    han(26L, x, y, color);
    han(27L, x + step, y, color);
    return;
  }
  if (kind == 14L) {
    han(28L, x, y, color);
    han(29L, x + step, y, color);
    return;
  }
  if (kind == 15L) {
    han(0L, x, y, color);
    han(1L, x + step, y, color);
    return;
  }
  han(30L, x, y, color);
  han(31L, x + step, y, color);
}

deRfun caption(string english, long kind, long x, long y, long color): void {
  if (*(long*)6336 == 1L) {
    phrase(kind, x, y, color);
    return;
  }
  obr::ui::text(x, y, 16L, english, color, 255L);
}

deRfun backdrop(): void {
  long wide = obr::ui::width();
  long high = obr::ui::height();
  long phase = at(6080L);
  if (phase < 0L || phase > 23L) {
    phase = 0L;
  }
  obr::ui::clear(obr::ui::rgb(6L, 10L, 18L), 255L);
  glow(wide, high, phase);
}

deRfun account(long wx, long wy, long ww, long ink, long dim, long accent): void {
  long field = at(6464L);
  long nameCount = at(6656L);
  long passCount = at(6848L);
  long quiet = obr::ui::rgb(36L, 48L, 68L);
  caption("User name", 7L, wx + 24L, wy + 96L, dim);
  if (field == 0L) {
    obr::ui::round(wx + 16L, wy + 118L, ww - 32L, 28L, 6L, accent, 255L);
    showLine(6720L, 6784L, nameCount, wx + 28L, wy + 124L, ink, 0L);
    obr::ui::rect(wx + 28L + nameCount * obr::ui::advance(16L), wy + 128L, 2L, 12L, ink, 255L);
  } else {
    obr::ui::round(wx + 16L, wy + 118L, ww - 32L, 28L, 6L, quiet, 255L);
    showLine(6720L, 6784L, nameCount, wx + 28L, wy + 124L, dim, 0L);
  }
  caption("Password", 8L, wx + 24L, wy + 160L, dim);
  if (field == 1L) {
    obr::ui::round(wx + 16L, wy + 182L, ww - 32L, 28L, 6L, accent, 255L);
    showLine(6912L, 6976L, passCount, wx + 28L, wy + 188L, ink, 1L);
    obr::ui::rect(wx + 28L + passCount * obr::ui::advance(16L), wy + 192L, 2L, 12L, ink, 255L);
  } else {
    obr::ui::round(wx + 16L, wy + 182L, ww - 32L, 28L, 6L, quiet, 255L);
    showLine(6912L, 6976L, passCount, wx + 28L, wy + 188L, dim, 1L);
  }
  if (*(long*)6336 != 1L) {
    obr::ui::text(wx + 24L, wy + 224L, 16L, "Type, then Enter", dim, 255L);
  }
}

deRfun lineOf(long page, long index, long x, long y, long color): void {
  if (page == 0L) {
    if (index == 0L) {
      obr::ui::text(x, y, 16L, "English", color, 255L);
    } else {
      phrase(2L, x, y, color);
    }
    return;
  }
  if (index == 0L) {
    caption("China", 3L, x, y, color);
  } else if (index == 1L) {
    caption("United States", 4L, x, y, color);
  } else if (index == 2L) {
    caption("Japan", 5L, x, y, color);
  } else {
    caption("Britain", 6L, x, y, color);
  }
}

/* 安装窗口。没有关闭键。语言和地区用方向键。用户页自己打名字和密码。 */
deRfun install(): void {
  backdrop();
  long wide = obr::ui::width();
  long high = obr::ui::height();
  long ww = 440L;
  long wh = 320L;
  long wx = obr::ui::align(0L, wide, ww, obr::ui::Align::Center);
  long wy = obr::ui::align(0L, high, wh, obr::ui::Align::Center);
  long panel = obr::ui::rgb(18L, 24L, 34L);
  long line = obr::ui::rgb(48L, 64L, 88L);
  long ink = obr::ui::rgb(232L, 236L, 242L);
  long dim = obr::ui::rgb(150L, 164L, 184L);
  long accent = obr::ui::rgb(0L, 120L, 212L);
  obr::ui::round(wx, wy, ww, wh, 10L, panel, 255L);
  caption("ZerOS Setup", 15L, wx + 24L, wy + 18L, ink);
  obr::ui::rect(wx + 20L, wy + 44L, ww - 40L, 1L, line, 255L);
  long page = *(long*)6272;
  if (page == 0L) {
    caption("Language", 0L, wx + 24L, wy + 60L, ink);
  } else if (page == 1L) {
    caption("Country", 1L, wx + 24L, wy + 60L, ink);
  } else {
    caption("Create user", 10L, wx + 24L, wy + 60L, ink);
  }
  if (page == 2L) {
    account(wx, wy, ww, ink, dim, accent);
  } else {
    long n = 2L;
    long pick = *(long*)6336;
    if (page == 1L) {
      n = 4L;
      pick = *(long*)6400;
    }
    long row = 0L;
    while (row < n) {
      long y = wy + 96L + row * 32L;
      long color = dim;
      if (row == pick) {
        obr::ui::round(wx + 16L, y - 6L, ww - 32L, 28L, 6L, accent, 255L);
        color = ink;
      }
      lineOf(page, row, wx + 28L, y, color);
      row = row + 1L;
    }
  }
  caption("Enter", 9L, wx + 24L, wy + wh - 36L, dim);
  obr::ui::present();
}

/* 语言和国家各用自己的指针。用户页不改指针，名字打进 6656 那一组格子。 */
deRfun choose(): void {
  long name = *(long*)4864;
  long page = *(long*)6272;
  long unit = typed();
  if (*(long*)5056 != 0L && unit == 0L) {
    return;
  }
  if (page == 2L) {
    if (backward(name) == 1 || forward(name) == 1) {
      if (at(6464L) == 0L) {
        set(6464L, 1L);
      } else {
        set(6464L, 0L);
      }
      return;
    }
    if (unit < 0L) {
      if (at(6464L) == 0L) {
        popAt(6656L);
      } else {
        popAt(6848L);
      }
      return;
    }
    if (unit > 0L) {
      if (at(6464L) == 0L) {
        pushAt(6656L, 6720L, 6784L, unit);
      } else {
        pushAt(6848L, 6912L, 6976L, unit);
      }
      return;
    }
    if (name == 0x7265746e45L) {
      if (at(6464L) == 0L) {
        if (at(6656L) > 0L) {
          set(6464L, 1L);
        }
        return;
      }
      if (at(6656L) > 0L && at(6848L) > 0L) {
        set(7040L, 1L);
        set(7104L, 0L);
        set(7168L, 0L);
        set(7232L, 0L);
        set(7296L, 0L);
      }
    }
    return;
  }
  if (backward(name) == 1) {
    if (page == 0L) {
      long* lang = (long*)6336;
      *lang = *lang - 1L;
      if (*lang < 0L) {
        *lang = 1L;
      }
    }
    if (page == 1L) {
      long* country = (long*)6400;
      *country = *country - 1L;
      if (*country < 0L) {
        *country = 3L;
      }
    }
    return;
  }
  if (forward(name) == 1) {
    if (page == 0L) {
      long* lang = (long*)6336;
      *lang = *lang + 1L;
      if (*lang > 1L) {
        *lang = 0L;
      }
    }
    if (page == 1L) {
      long* country = (long*)6400;
      *country = *country + 1L;
      if (*country > 3L) {
        *country = 0L;
      }
    }
    return;
  }
  if (name == 0x7265746e45L && page < 2L) {
    long* step = (long*)6272;
    *step = page + 1L;
    if (page == 1L) {
      set(6464L, 0L);
    }
  }
}

deRfun lock(): void {
  backdrop();
  long wide = obr::ui::width();
  long high = obr::ui::height();
  long ww = 420L;
  long wh = 280L;
  long wx = obr::ui::align(0L, wide, ww, obr::ui::Align::Center);
  long wy = obr::ui::align(0L, high, wh, obr::ui::Align::Center);
  long panel = obr::ui::rgb(18L, 24L, 34L);
  long ink = obr::ui::rgb(232L, 236L, 242L);
  long dim = obr::ui::rgb(150L, 164L, 184L);
  long accent = obr::ui::rgb(0L, 120L, 212L);
  obr::ui::round(wx, wy, ww, wh, 10L, panel, 255L);
  caption("Welcome", 11L, wx + 28L, wy + 28L, ink);
  showLine(6720L, 6784L, at(6656L), wx + 28L, wy + 64L, ink, 0L);
  caption("Password", 8L, wx + 28L, wy + 108L, dim);
  obr::ui::round(wx + 20L, wy + 136L, ww - 40L, 28L, 6L, accent, 255L);
  showLine(7168L, 7232L, at(7104L), wx + 32L, wy + 142L, ink, 1L);
  obr::ui::rect(wx + 32L + at(7104L) * obr::ui::advance(16L), wy + 146L, 2L, 12L, ink, 255L);
  if (at(7296L) == 1L) {
    caption("Wrong", 16L, wx + 28L, wy + 180L, accent);
  }
  caption("Enter", 9L, wx + 28L, wy + wh - 36L, dim);
  obr::ui::present();
}

deRfun desk(): void {
  backdrop();
  long wide = obr::ui::width();
  long high = obr::ui::height();
  long ink = obr::ui::rgb(232L, 236L, 242L);
  long dim = obr::ui::rgb(180L, 190L, 205L);
  long panel = obr::ui::rgb(18L, 24L, 34L);
  long accent = obr::ui::rgb(0L, 120L, 212L);
  caption("Desktop", 13L, 36L, 36L, ink);
  long country = at(6400L);
  if (country == 0L) {
    caption("China", 3L, 36L, 64L, dim);
  } else if (country == 1L) {
    caption("United States", 4L, 36L, 64L, dim);
  } else if (country == 2L) {
    caption("Japan", 5L, 36L, 64L, dim);
  } else {
    caption("Britain", 6L, 36L, 64L, dim);
  }
  obr::ui::text(36L, 100L, 16L, "Esc", dim, 255L);
  caption("Lock", 12L, 80L, 100L, dim);
  obr::ui::rect(0L, high - 48L, wide, 48L, panel, 255L);
  obr::ui::round(12L, high - 40L, 100L, 32L, 8L, accent, 255L);
  caption("Start", 14L, 32L, high - 32L, ink);
  long count = at(6656L);
  long step = obr::ui::advance(16L);
  showLine(6720L, 6784L, count, wide - 24L - count * step, high - 32L, ink, 0L);
  obr::ui::present();
}

deRfun lockKey(): void {
  long name = *(long*)4864;
  long unit = typed();
  if (*(long*)5056 != 0L && unit == 0L) {
    return;
  }
  if (unit < 0L) {
    popAt(7104L);
    set(7296L, 0L);
    return;
  }
  if (unit > 0L) {
    pushAt(7104L, 7168L, 7232L, unit);
    set(7296L, 0L);
    return;
  }
  if (name == 0x7265746e45L) {
    if (sameSecret() == 1) {
      set(7040L, 2L);
      set(7296L, 0L);
      return;
    }
    set(7296L, 1L);
    set(7104L, 0L);
    set(7168L, 0L);
    set(7232L, 0L);
  }
}

deRfun deskKey(): void {
  if (*(long*)4864 == 0x657061637345L) {
    set(7040L, 1L);
    set(7104L, 0L);
    set(7168L, 0L);
    set(7232L, 0L);
    set(7296L, 0L);
  }
}

/* 找键盘口，然后一直轮询。红点不在这里换：这一循环的快慢会跟着读盘变。
   倒计时结束时只调度核心 3。核心 2 把各映像装完后把 5952 写成 1，这里才铺上全屏加载，并把 4096 写成 1。
   过渡的前 20 拍画得密一些，方标和拖影依次淡入。资源准备好且 6208 为 1 时，改画安装窗口。
   用户名和密码打进去之后进入锁屏。密码相符才铺桌面。Esc 回到锁屏。
   加载期间内核去准备资源并初始化。 */
deRfun main(): int {
  long* mode = (long*)4096;
  long* count = (long*)4352;
  long* wait = (long*)4416;
  long* port = (long*)4480;
  long* tick = (long*)5696;
  long* done = (long*)5952;
  long* armed = (long*)6016;
  gl::load();
  *mode = 0L;
  *count = 0L;
  *wait = 800L;
  *tick = 0L;
  *done = 0L;
  *armed = 0L;
  *(long*)6208 = 0L;
  *(long*)6272 = 0L;
  *(long*)6336 = 0L;
  *(long*)6400 = 0L;
  *(long*)6464 = 0L;
  *(long*)6528 = 0L;
  *(long*)6592 = 0L;
  *(long*)6656 = 0L;
  *(long*)6720 = 0L;
  *(long*)6784 = 0L;
  *(long*)6848 = 0L;
  *(long*)6912 = 0L;
  *(long*)6976 = 0L;
  *(long*)7040 = 0L;
  *(long*)7104 = 0L;
  *(long*)7168 = 0L;
  *(long*)7232 = 0L;
  *(long*)7296 = 0L;
  long index = 0L;
  long matched = 0L;
  while (index != 4L && matched == 0L) {
    if (port::state(index) == 2L && port::char(index, 0L) == 0x5AL && port::char(index, 1L) == 0x4BL && port::char(index, 2L) == 0x50L && port::char(index, 3L) == 0x31L) {
      *port = index;
      matched = 1L;
    } else {
      index = index + 1L;
    }
  }
  if (matched == 0L) {
    *port = 4L;
    clear();
    halt();
    return 0;
  }
  while (1) {
    int event = poll();
    long* installFlag = (long*)6208;
    long* introNow = (long*)6144;
    long* holdNow = (long*)6592;
    if (event == 1) {
      long faceNow = *(long*)7040;
      if (faceNow == 2L) {
        deskKey();
      } else if (faceNow == 1L) {
        lockKey();
      } else if ((*installFlag == 1L && *introNow >= 20L) || *holdNow >= 8L) {
        choose();
      } else {
        onkey();
      }
      long faceAfter = *(long*)7040;
      if (faceAfter == 2L) {
        desk();
      } else if (faceAfter == 1L) {
        lock();
      } else if ((*installFlag == 1L && *introNow >= 20L) || *holdNow >= 8L) {
        install();
      }
    }
    if (*mode == 2L) {
      if (event == 1) {
        paint();
        *tick = 0L;
      } else {
        *tick = *tick + 1L;
        if (*tick == 80L) {
          *tick = 0L;
          paint();
        }
      }
    } else if (*mode == 0L) {
      if (*armed == 0L) {
        *wait = *wait - 1L;
        if (*wait == 0L) {
          obr::os::schedule(3L);
          *armed = 1L;
        }
      } else if (*done != 0L) {
        *mode = 1L;
        *tick = 0L;
        long* phase = (long*)6080;
        long* intro = (long*)6144;
        *phase = 0L;
        *intro = 0L;
        loading();
      }
    } else if (*done != 0L) {
      *tick = *tick + 1L;
      long* intro = (long*)6144;
      long* flag = (long*)6208;
      long gap = 28L;
      if (*intro < 20L) {
        gap = 5L;
      }
      long* hold = (long*)6592;
      if (*flag == 1L && *intro >= 20L) {
        gap = 8L;
      }
      if (*tick >= gap) {
        *tick = 0L;
        if (*intro < 20L) {
          *intro = *intro + 1L;
        } else {
          *hold = *hold + 1L;
        }
        long* phase = (long*)6080;
        *phase = *phase + 1L;
        if (*phase >= 24L) {
          *phase = 0L;
        }
        /* 标记到了就进安装。标记没到，淡入后再转几拍也进，避免一直停在加载。
           7040 为 1 是锁屏，为 2 是桌面。密码相符才离开锁屏。 */
        if (*(long*)7040 == 2L) {
          desk();
        } else if (*(long*)7040 == 1L) {
          lock();
        } else if ((*flag == 1L && *intro >= 20L) || *hold >= 8L) {
          install();
        } else {
          loading();
        }
      }
    }
  }
}

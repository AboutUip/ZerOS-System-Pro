  }
  if (id == 8L) {
    if (row == 0L) { return 1040L; }
    if (row == 1L) { return 544L; }
    if (row == 2L) { return 4088L; }
    if (row == 3L) { return 128L; }
    if (row == 4L) { return 4088L; }
    if (row == 5L) { return 128L; }
    if (row == 6L) { return 8188L; }
    if (row == 7L) { return 128L; }
    if (row == 8L) { return 8188L; }
    if (row == 9L) { return 320L; }
    if (row == 10L) { return 1584L; }
    if (row == 11L) { return 6156L; }
    return 0L;

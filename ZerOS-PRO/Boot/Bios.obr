/* 画表里的一行。index 是核心或扩展口的循环下标。 */
deRfun show(long x, long y, long wide, long kind, long a, long b, long c, long index): long {
  long ink = obr::ui::rgb(232L, 236L, 242L);
  long dim = obr::ui::rgb(132L, 144L, 162L);
  if (kind == 1L) {
    say(x, y, 16L, a, ink);
    return y + b;
  }
  if (kind == 2L) {
    say(x, y, 16L, a, dim);
    return y + b;
  }
  if (kind == 3L) {
    return y + a;
  }
  if (kind == 4L || kind == 5L) {
    long field = c % 8L;
    long off = c / 8L;
    say(x, y, 16L, a, dim);
    if (kind == 4L) {
      putnum(x + off, y, query(b, field, index), ink);
    } else {
      putfield(x + off, y, b, field, 0L, ink);
    }
    return y + 24L;
  }
  if (kind == 8L) {
    long field = c % 8L;
    long color = (c / 8L) % 8L;
    long maxCode = (c / 64L) % 2L;
    long off = c / 128L;
    long maximum = 1000000000L;
    long fill = obr::ui::rgb(72L, 156L, 255L);
    long value = 0L;
    if (maxCode == 1L) {
      maximum = 1000L;
    }
    if (color == 1L) {
      fill = obr::ui::rgb(72L, 196L, 150L);
    } else if (color == 2L) {
      fill = obr::ui::rgb(214L, 164L, 72L);
    } else if (color == 3L) {
      fill = obr::ui::rgb(120L, 160L, 220L);
    }
    if (b == 1L && field == 6L && query(1L, 0L, 0L) == 0L) {
      value = 0L;
    } else {
      value = query(b, field, index);
    }
    if (a >= 0L) {
      say(x, y, 16L, a, dim);
      putnum(x + off, y, value, ink);
      y = y + 22L;
    }
    meterbar(x, y, wide, value, maximum, fill);
    return y + 22L;
  }
  if (kind == 9L) {
    say(x, y, 16L, a, dim);
    putnum(x + c, y, b, ink);
    return y + 24L;
  }
  if (kind == 15L) {
    long cores = query(1L, 0L, 0L);
    long run = 0L;
    long cursor = 0L;
    while (cursor != cores) {
      if (query(1L, 5L, cursor) != 0L) {
        run = run + 1L;
      }
      cursor = cursor + 1L;
    }
    say(x, y, 16L, 16L, dim);
    cursor = putnum(x + 40L, y, run, ink);
    obr::ui::glyph(47L, cursor, y, 16L, dim, 255L);
    putnum(cursor + obr::ui::advance(16L), y, cores, ink);
    y = y + 20L;
    if (cores > 0L) {
      meterbar(x, y, wide, run, cores, obr::ui::rgb(72L, 156L, 255L));
      y = y + 22L;
    }
    return y + 8L;
  }
  if (kind == 16L) {
    long count = query(0L, 1L, 0L);
    long cursor = 0L;
    while (cursor != count) {
      long tag = 38L;
      if (cursor == 0L) {
        tag = 37L;
      } else if (cursor == 1L) {
        tag = 6L;
      } else if (cursor == 2L) {
        tag = 7L;
      } else if (cursor == 3L) {
        tag = 30L;
      }
      say(x, y, 16L, tag, dim);
      putfield(x + 56L, y, 0L, 2L, cursor * 8L, ink);
      y = y + 24L;
      cursor = cursor + 1L;
    }
    return y;
  }
  if (kind == 17L) {
    say(x, y, 16L, a, dim);
    say(x + c, y, 16L, b, ink);
    return y + 24L;
  }
  if (kind == 18L) {
    long cursor = 0L;
    say(x, y, 16L, a, dim);
    cursor = putnum(x + c, y, query(b, 0L, 0L), ink);
    obr::ui::glyph(120L, cursor + obr::ui::advance(16L), y, 16L, dim, 255L);
    putnum(cursor + obr::ui::advance(16L) * 3L, y, query(b, 1L, 0L), ink);
    return y + 24L;
  }
  if (kind == 19L) {
    long cursor = 0L;
    say(x, y, 16L, 9L, dim);
    cursor = putnum(x + 80L, y, query(4L, 0L, 0L), ink);
    obr::ui::glyph(120L, cursor + obr::ui::advance(16L), y, 16L, dim, 255L);
    cursor = putnum(cursor + obr::ui::advance(16L) * 3L, y, query(4L, 1L, 0L), ink);
    say(cursor + 12L, y, 16L, 15L, dim);
    putnum(cursor + 40L, y, query(4L, 2L, 0L), ink);
    return y + 36L;
  }
  if (kind == 20L) {
    y = y + 16L;
    say(x, y, 16L, 41L, ink);
    putnum(x + 56L, y, index, ink);
    return y + 24L;
  }
  if (kind == 21L) {
    say(x, y, 16L, 25L, dim);
    if (query(1L, 5L, index) == 0L) {
      say(x + 64L, y, 16L, 45L, obr::ui::rgb(196L, 96L, 96L));
    } else {
      say(x + 64L, y, 16L, 16L, obr::ui::rgb(96L, 196L, 140L));
    }
    return y + 24L;
  }
  if (kind == 14L) {
    long* selection = (long*)5568;
    long state = query(5L, 0L, index);
    if (index == *selection) {
      obr::ui::rect(x - 8L, y - 4L, 280L, 48L, obr::ui::rgb(24L, 44L, 72L), 255L);
      obr::ui::rect(x - 8L, y - 4L, 3L, 48L, obr::ui::rgb(88L, 168L, 255L), 255L);
    }
    say(x, y, 16L, 30L, ink);
    putnum(x + 56L, y, index, ink);
    y = y + 22L;
    say(x, y, 16L, 25L, dim);
    putnum(x + 64L, y, state, ink);
    if (state != 0L) {
      putfield(x + 96L, y, 5L, 1L, index * 64L, ink);
    } else {
      say(x + 96L, y, 16L, 31L, dim);
    }
    return y + 32L;
  }
  if (kind == 22L) {
    long state = query(5L, 0L, index);
    say(x, y, 16L, 30L, ink);
    putnum(x + 56L, y, index, ink);
    y = y + 22L;
    say(x, y, 16L, 25L, dim);
    putnum(x + 64L, y, state, ink);
    y = y + 22L;
    if (state != 0L) {
      say(x, y, 16L, 36L, dim);
      putfield(x + 72L, y, 5L, 1L, index * 64L, ink);
      y = y + 22L;
      putfield(x, y, 5L, 2L, index * 64L, ink);
      return y + 28L;
    }
    say(x, y, 16L, 31L, dim);
    return y + 28L;
  }
  if (kind == 23L) {
    long* selection = (long*)5568;
    say(x, y, 16L, 30L, ink);
    putnum(x + 56L, y, *selection, ink);
    return y + 28L;
  }
  if (kind == 24L) {
    long* selection = (long*)5568;
    say(x, y, 16L, 25L, dim);
    putnum(x + 64L, y, query(5L, 0L, *selection), ink);
    return y + 24L;
  }
  if (kind == 25L) {
    long* selection = (long*)5568;
    long field = c % 8L;
    long off = c / 8L;
    say(x, y, 16L, a, dim);
    putfield(x + off, y, 5L, field, *selection * 64L, ink);
    return y + 24L;
  }
  return y;
}

/* 顺着当前页的行往下画。10 到 11 按核心重复，12 到 13 按四个扩展口重复。 */
deRfun rows(long x, long y, long wide, long page): long {
  long pc = at(12288L + page * 64L);
  long back = 0L;
  long index = 0L;
  long count = 0L;
  long step = 0L;
  while (step != 400L) {
    long kind = at(pc);
    step = step + 1L;
    if (kind == 0L) {
      return y;
    }
    if (kind == 10L) {
      back = pc + 256L;
      index = 0L;
      count = query(1L, 0L, 0L);
      pc = back;
      if (count == 0L) {
        while (at(pc) != 11L && at(pc) != 0L) {
          pc = pc + 256L;
        }
        if (at(pc) == 11L) {
          pc = pc + 256L;
        }
      }
      continue;
    }
    if (kind == 11L || kind == 13L) {
      index = index + 1L;
      if (index == count) {
        pc = pc + 256L;
        index = 0L;
      } else {
        pc = back;
      }
      continue;
    }
    if (kind == 12L) {
      back = pc + 256L;
      index = 0L;
      count = 4L;
      pc = back;
      continue;
    }
    y = show(x, y, wide, kind, at(pc + 64L), at(pc + 128L), at(pc + 192L), index);
    pc = pc + 256L;
  }
  return y;
}

deRfun pageOf(): long {
  long* category = (long*)5248;
  long* sub = (long*)4160;
  long* depth = (long*)5376;
  if (*category == 0L) {
    if (*sub == 5L && *depth != 0L) {
      return 6L;
    }
    return *sub;
  }
  return 7L + *sub;
}

/* 左侧一项。on 不是 0 时铺高亮，并在左缘留一条强调色。 */
deRfun sideRow(long y, long wide, long on, string name): void {
  long ink = obr::ui::rgb(132L, 144L, 162L);
  if (on != 0L) {
    obr::ui::rect(4L, y, wide - 8L, 30L, obr::ui::rgb(24L, 44L, 72L), 255L);
    obr::ui::rect(4L, y, 3L, 30L, obr::ui::rgb(88L, 168L, 255L), 255L);
    ink = obr::ui::rgb(232L, 236L, 242L);
  }
  obr::ui::text(16L, y + 7L, 16L, name, ink, 255L);
}

deRfun sideAt(long y, long wide, long on, long index): void {
  string* cell = (string*)(8192L + index * 64L);
  sideRow(y, wide, on, *cell);
}

/* 顶栏、左侧和右侧。滚动只平移右侧文字，栏本身不动。字和子页都从固定内存读。 */
deRfun paint(): void {
  if (at(5760L) == 0L) {
    fill();
  }
  long* phase = (long*)5888;
  *phase = *phase + 1L;
  long* focus = (long*)5184;
  long* category = (long*)5248;
  long* sub = (long*)4160;
  long* scroll = (long*)5312;
  long* limit = (long*)5632;
  long wide = obr::ui::width();
  long high = obr::ui::height();
  long top = 40L;
  long side = 136L;
  if (*scroll < 0L) {
    *scroll = 0L;
  }
  if (*scroll > *limit) {
    *scroll = *limit;
  }
  long panel = obr::ui::rgb(16L, 20L, 28L);
  long main = obr::ui::rgb(10L, 14L, 20L);
  long line = obr::ui::rgb(48L, 58L, 74L);
  long accent = obr::ui::rgb(88L, 168L, 255L);
  long ink = obr::ui::rgb(232L, 236L, 242L);
  long dim = obr::ui::rgb(132L, 144L, 162L);
  obr::ui::clear(obr::ui::rgb(8L, 10L, 14L), 255L);
  obr::ui::rect(0L, 0L, wide, top, panel, 255L);
  obr::ui::rect(0L, top, side, high - top, panel, 255L);
  obr::ui::rect(side, top, wide - side, high - top, main, 255L);
  obr::ui::rect(0L, top - 1L, wide, 1L, line, 255L);
  obr::ui::rect(side - 1L, top, 1L, high - top, line, 255L);
  long edge = line;
  if (*focus == 0L) {
    edge = accent;
  }
  obr::ui::rect(0L, 0L, wide, 2L, edge, 255L);
  obr::ui::rect(0L, top - 2L, wide, 2L, edge, 255L);
  edge = line;
  if (*focus == 1L) {
    edge = accent;
  }
  obr::ui::rect(0L, top, 2L, high - top, edge, 255L);
  obr::ui::rect(side - 2L, top, 2L, high - top, edge, 255L);
  edge = line;
  if (*focus == 2L) {
    edge = accent;
  }
  obr::ui::rect(side, top, wide - side, 2L, edge, 255L);
  obr::ui::rect(wide - 2L, top, 2L, high - top, edge, 255L);
  obr::ui::rect(side, high - 2L, wide - side, 2L, edge, 255L);
  long half = wide / 2L;
  long firm = dim;
  long about = dim;
  if (*category == 0L) {
    firm = ink;
    obr::ui::rect(12L, top - 4L, half - 24L, 2L, accent, 255L);
  } else {
    about = ink;
    obr::ui::rect(half + 12L, top - 4L, half - 24L, 2L, accent, 255L);
  }
  say(20L, 12L, 16L, 0L, firm);
  say(half + 20L, 12L, 16L, 1L, about);
  if (*focus == 0L) {
    say(wide - 48L, 12L, 16L, 2L, accent);
  } else if (*focus == 1L) {
    say(wide - 56L, 12L, 16L, 3L, accent);
  } else {
    say(wide - 56L, 12L, 16L, 4L, accent);
  }
  long row = top + 10L;
  if (*category == 0L) {
    long on = 0L;
    if (*sub == 0L) {
      on = 1L;
    }
    sideAt(row, side, on, 5L);
    row = row + 34L;
    on = 0L;
    if (*sub == 1L) {
      on = 1L;
    }
    sideAt(row, side, on, 6L);
    row = row + 34L;
    on = 0L;
    if (*sub == 2L) {
      on = 1L;
    }
    sideAt(row, side, on, 7L);
    row = row + 34L;
    on = 0L;
    if (*sub == 3L) {
      on = 1L;
    }
    sideAt(row, side, on, 8L);
    row = row + 34L;
    on = 0L;
    if (*sub == 4L) {
      on = 1L;
    }
    sideAt(row, side, on, 9L);
    row = row + 34L;
    on = 0L;
    if (*sub == 5L) {
      on = 1L;
    }
    sideAt(row, side, on, 10L);
  } else {
    long on = 0L;
    if (*sub == 0L) {
      on = 1L;
    }
    sideAt(row, side, on, 12L);
    row = row + 34L;
    on = 0L;
    if (*sub == 1L) {
      on = 1L;
    }
    sideAt(row, side, on, 13L);
    row = row + 34L;
    on = 0L;
    if (*sub == 2L) {
      on = 1L;
    }
    sideAt(row, side, on, 14L);
  }
  say(16L, high - 22L, 12L, 11L, dim);
  long body = wide - side - 36L;
  if (body < 40L) {
    body = 40L;
  }
  obr::ui::clip(side + 4L, top + 4L, wide - side - 12L, high - top - 8L);
  obr::ui::save();
  obr::ui::translate(0L, 0L - *scroll);
  long bottom = rows(side + 16L, top + 14L, body, pageOf());
  obr::ui::restore();
  obr::ui::unclip();
  panelFace();
  long max = bottom - (high - 4L);
  if (max < 0L) {
    max = 0L;
  }
  *limit = max;
  if (max > 0L) {
    long track = high - top - 16L;
    long thumb = 28L;
    long travel = track - thumb;
    if (travel < 1L) {
      travel = 1L;
    }
    long thumbY = top + 8L + *scroll * travel / max;
    obr::ui::rect(wide - 7L, top + 8L, 3L, track, line, 255L);
    obr::ui::rect(wide - 7L, thumbY, 3L, thumb, accent, 255L);
  }
  obr::ui::present();
}

/* 从收件箱取出一次按键。0 没有事件，1 是按下（按住后的重复也算），2 是松开或其它。
   4992 记下键值，5056 为 1 表示这次是按住后的重复。设置画面只用键位名和修饰位。 */
deRfun poll(): int {
  long* port = (long*)4480;
  long* count = (long*)4352;
  long* name = (long*)4864;
  long* mods = (long*)4928;
  while (1) {
    long word = 0L;
    long found = inbox(&word);
    if (found == 0L) {
      return 0;
    }
    if (*port == 4L) {
      return 0;
    }
    long next = xchg(*port, 0L, word);
    if (next != *count) {
      *count = next;
      if (xchg(*port, 1L, 1L) != 0L) {
        return 2;
      }
      *name = xchg(*port, 1L, 3L);
      *mods = xchg(*port, 1L, 6L);
      *(long*)4992 = xchg(*port, 1L, 2L);
      *(long*)5056 = xchg(*port, 1L, 4L);
      return 1;
    }
  }
}

/* 启动画面期间 F12 进入设置。结束标志写成 1 之后忽略。Tab 轮换焦点。方向键在当前块里移动。Esc 先退出详情，再离开设置。 */
deRfun onkey(): void {
  long* mode = (long*)4096;
  long* name = (long*)4864;
  long* mods = (long*)4928;
  long* focus = (long*)5184;
  long* category = (long*)5248;
  long* sub = (long*)4160;
  long* scroll = (long*)5312;
  long* depth = (long*)5376;
  long* selection = (long*)5568;
  if (*name == 0x323146L) {
    long* done = (long*)5952;
    if (*done != 0L) {
      return;
    }
    if (*mode != 2L) {
      *mode = 2L;
      *focus = 0L;
      *category = 0L;
      *sub = 0L;
      *scroll = 0L;
      *depth = 0L;
      *selection = 0L;
      if (at(5760L) == 0L) {
        fill();
      }
      *(long*)7552 = pointer::count();
    }
    return;
  }
  if (*mode != 2L) {
    return;
  }
  if (*name == 0x657061637345L) {
    if (*depth != 0L) {
      *depth = 0L;
      *scroll = 0L;
      return;
    }
    clear();
    /* 倒计时还没排上核心 3 时回到等待，否则完成标记来了也进不了加载。 */
    if (*(long*)6016 == 0L && *(long*)5952 == 0L) {
      *mode = 0L;
    } else {
      *mode = 1L;
    }
    return;
  }
  if (*name == 0x626154L) {
    long dir = 1L;
    if (*mods % 2L != 0L) {
      dir = 0L - 1L;
    }
    *focus = bump(*focus, dir, 3L);
    return;
  }
  if (*category == 0L && *sub == 4L && *depth == 0L && *focus == 2L) {
    if (panelKey() == 1) {
      return;
    }
  }
  if (*name == 0x7265746e45L) {
    if (*category == 0L && *sub == 5L && *depth == 0L) {
      if (query(5L, 0L, *selection) != 0L) {
        *depth = 1L;
        *scroll = 0L;
      }
    }
    return;
  }
  if (backward(*name) == 1) {
    if (*focus == 0L) {
      *category = bump(*category, 0L - 1L, 2L);
      *sub = 0L;
      *scroll = 0L;
      *depth = 0L;
    } else if (*focus == 1L) {
      *sub = bump(*sub, 0L - 1L, subcount());
      *scroll = 0L;
      *depth = 0L;
    } else if (*category == 0L && *sub == 5L && *depth == 0L) {
      *selection = bump(*selection, 0L - 1L, 4L);
    } else {
      nudge(0L - 1L);
    }
    return;
  }
  if (forward(*name) == 1) {
    if (*focus == 0L) {
      *category = bump(*category, 1L, 2L);
      *sub = 0L;
      *scroll = 0L;
      *depth = 0L;
    } else if (*focus == 1L) {
      *sub = bump(*sub, 1L, subcount());
      *scroll = 0L;
      *depth = 0L;
    } else if (*category == 0L && *sub == 5L && *depth == 0L) {
      *selection = bump(*selection, 1L, 4L);
    } else {
      nudge(1L);
    }
  }
}

/* 圆周上 24 个整点，半径 14。相邻两点靠得比笔触窄，叠起来是一段实心弧，不是散点。 */
deRfun orbit(long slot, long* dx, long* dy): void {
  long turn = slot;
  if (turn < 0L) {
    turn = 0L;
  }
  if (turn > 23L) {
    turn = 23L;
  }
  if (turn == 0L) { *dx = 14L; *dy = 0L; }
  else if (turn == 1L) { *dx = 14L; *dy = 4L; }
  else if (turn == 2L) { *dx = 12L; *dy = 7L; }
  else if (turn == 3L) { *dx = 10L; *dy = 10L; }
  else if (turn == 4L) { *dx = 7L; *dy = 12L; }
  else if (turn == 5L) { *dx = 4L; *dy = 14L; }
  else if (turn == 6L) { *dx = 0L; *dy = 14L; }
  else if (turn == 7L) { *dx = 0L - 4L; *dy = 14L; }
  else if (turn == 8L) { *dx = 0L - 7L; *dy = 12L; }
  else if (turn == 9L) { *dx = 0L - 10L; *dy = 10L; }
  else if (turn == 10L) { *dx = 0L - 12L; *dy = 7L; }
  else if (turn == 11L) { *dx = 0L - 14L; *dy = 4L; }
  else if (turn == 12L) { *dx = 0L - 14L; *dy = 0L; }
  else if (turn == 13L) { *dx = 0L - 14L; *dy = 0L - 4L; }
  else if (turn == 14L) { *dx = 0L - 12L; *dy = 0L - 7L; }
  else if (turn == 15L) { *dx = 0L - 10L; *dy = 0L - 10L; }
  else if (turn == 16L) { *dx = 0L - 7L; *dy = 0L - 12L; }
  else if (turn == 17L) { *dx = 0L - 4L; *dy = 0L - 14L; }
  else if (turn == 18L) { *dx = 0L; *dy = 0L - 14L; }
  else if (turn == 19L) { *dx = 4L; *dy = 0L - 14L; }
  else if (turn == 20L) { *dx = 7L; *dy = 0L - 12L; }
  else if (turn == 21L) { *dx = 10L; *dy = 0L - 10L; }
  else if (turn == 22L) { *dx = 12L; *dy = 0L - 7L; }
  else { *dx = 14L; *dy = 0L - 4L; }
}

/* 从尾画到头。每颗都盖住前一颗的边，透明度往后收，连成一段拖影。头在最上面。 */
deRfun smear(long cx, long cy, long head, long fade): void {
  if (fade < 1L) {
    return;
  }
  long ink = obr::ui::rgb(236L, 242L, 248L);
  long step = 9L;
  while (step >= 0L) {
    long slot = head - step;
    if (slot < 0L) {
      slot = slot + 24L;
    }
    long dx = 0L;
    long dy = 0L;
    orbit(slot, &dx, &dy);
    /* 靠近头的几颗全不透明，叠成实心。再往后才收成拖影。 */
    long alpha = 255L;
    if (step > 2L) {
      alpha = obr::ui::ease(255L, 0L, step - 2L, 7L);
    }
    alpha = alpha * fade / 255L;
    if (alpha > 0L) {
      obr::ui::ellipse(cx + dx - 4L, cy + dy - 4L, 8L, 8L, ink, alpha);
    }
    step = step - 1L;
  }
}

/* 四块同样的蓝色圆角方标，中间留一道缝。alpha 用来做淡入。 */
deRfun panes(long left, long top, long alpha): void {
  if (alpha < 1L) {
    return;
  }
  long blue = obr::ui::rgb(0L, 120L, 212L);
  long n = 26L;
  long jump = 34L;
  obr::ui::round(left, top, n, n, 3L, blue, alpha);
  obr::ui::round(left + jump, top, n, n, 3L, blue, alpha);
  obr::ui::round(left, top + jump, n, n, 3L, blue, alpha);
  obr::ui::round(left + jump, top + jump, n, n, 3L, blue, alpha);
}

/* 黑底。方标在上，实心拖影在下，整组居中。
   6144 是过渡拍，0 到 20：方标先淡入并上移，拖影晚几拍再淡入。
   6080 是拖影头部，0 到 23。客核心不发显卡。 */
deRfun loading(): void {
  long wide = obr::ui::width();
  long high = obr::ui::height();
  long* phase = (long*)6080;
  long* intro = (long*)6144;
  long head = *phase;
  if (head < 0L || head > 23L) {
    head = 0L;
    *phase = 0L;
  }
  long rise = *intro;
  if (rise < 0L) {
    rise = 0L;
  }
  if (rise > 12L) {
    rise = 12L;
  }
  long logoA = obr::ui::ease(0L, 255L, rise, 12L);
  long lift = obr::ui::ease(14L, 0L, rise, 12L);
  long spinA = 0L;
  if (*intro > 8L) {
    long gone = *intro - 8L;
    if (gone > 12L) {
      gone = 12L;
    }
    spinA = obr::ui::ease(0L, 255L, gone, 12L);
  }
  long block = 60L;
  long gap = 80L;
  long radius = 14L;
  long thick = 8L;
  long total = block + gap + radius * 2L + thick;
  long top = (high - total) / 2L;
  obr::ui::clear(0L, 255L);
  panes((wide - block) / 2L, top + lift, logoA);
  smear(wide / 2L, top + block + gap + radius + thick / 2L, head, spinA);
  obr::ui::present();
}

/* 预设宽度。0 到 4 分别是 640、800、1024、1280、1920。 */
deRfun sizeWidth(long index): long {
  if (index == 1L) {
    return 800L;
  }
  if (index == 2L) {
    return 1024L;
  }
  if (index == 3L) {
    return 1280L;
  }
  if (index == 4L) {
    return 1920L;
  }
  return 640L;
}

/* 这一档在原始比例下的高度。比例不是 0 时不用它。 */
deRfun sizeHeight(long index): long {
  if (index == 1L) {
    return 600L;
  }
  if (index == 2L) {
    return 768L;
  }
  if (index == 3L) {
    return 720L;
  }
  if (index == 4L) {
    return 1080L;
  }
  return 480L;
}

/* 0 用预设自己的高。1 是 4:3，2 是 16:9，3 是 16:10。宽仍是这一档的宽。 */
deRfun aspectHeight(long index, long aspect): long {
  long width = sizeWidth(index);
  if (aspect == 1L) {
    return width * 3L / 4L;
  }
  if (aspect == 2L) {
    return width * 9L / 16L;
  }
  if (aspect == 3L) {
    return width * 5L / 8L;
  }
  return sizeHeight(index);
}

/* 经显示器驱动把当前选择交给显卡。宽高是浮点加速参数。显卡换帧后，页面再改面板。 */
deRfun commitPanel(): void {
  long index = *(long*)7360;
  long aspect = *(long*)7424;
  long applied = panel::apply(sizeWidth(index), aspectHeight(index, aspect));
  /* 换帧会拆掉旧节点。4224 里的编号已经作废，清掉，免得离开设置时再摘一次。 */
  *(long*)4224 = 0L;
  if (applied != 0L) {
    return;
  }
}

/* 宽高对上哪一档。同一宽高先碰到原始比例。对上之后不是 640×480 原始就立刻应用。 */
deRfun matchPanel(long width, long height): void {
  long index = 0L;
  while (index < 5L) {
    long aspect = 0L;
    while (aspect < 4L) {
      if (sizeWidth(index) == width && aspectHeight(index, aspect) == height) {
        *(long*)7360 = index;
        *(long*)7424 = aspect;
        if (index != 0L || aspect != 0L) {
          commitPanel();
        }
        return;
      }
      aspect = aspect + 1L;
    }
    index = index + 1L;
  }
}

/* 读 /boot/display 的四个八位组。服务没起来或内容对不上就留着默认档。 */
deRfun loadPanel(): void {
  long kind = 0L;
  long size = 0L;
  long looked = obr::nas::stat("/boot/display", &kind, &size);
  if (looked != 0L || kind != 1L || size != 4L) {
    return;
  }
  long handle = 0L;
  long opened = obr::nas::open("/boot/display", 0L, &handle);
  if (opened != 0L) {
    return;
  }
  long got = 0L;
  long read = obr::nas::read(handle, 0L, 7872L, 4L, &got);
  long closed = obr::nas::close(handle);
  if (read != 0L || closed != 0L || got != 4L) {
    return;
  }
  long width = memory::loadOctet(7872L) + memory::loadOctet(7880L) * 256L;
  long height = memory::loadOctet(7888L) + memory::loadOctet(7896L) * 256L;
  matchPanel(width, height);
}

/* 固件类别里的显示器页。详情层不算。 */
deRfun onDisplay(): int {
  if (*(long*)5248 != 0L) {
    return 0;
  }
  if (*(long*)4160 != 4L) {
    return 0;
  }
  if (*(long*)5376 != 0L) {
    return 0;
  }
  return 1;
}

deRfun boxLeft(): long {
  return 152L;
}

deRfun boxWide(): long {
  return 220L;
}

deRfun sizeTop(long high): long {
  return high - 118L;
}

deRfun aspectTop(long high): long {
  return high - 70L;
}

/* 列表在选择条上方，第 0 项最靠上。 */
deRfun listTop(long boxTop, long count, long index): long {
  return boxTop - (count - index) * 26L;
}

deRfun drawSize(long index, long x, long y, long on): void {
  long ink = obr::ui::rgb(232L, 236L, 242L);
  long accent = obr::ui::rgb(88L, 168L, 255L);
  long wide = boxWide();
  if (index == 1L) {
    obr::widget::row(x, y, wide, on, "800 x 600", ink, accent);
    return;
  }
  if (index == 2L) {
    obr::widget::row(x, y, wide, on, "1024 x 768", ink, accent);
    return;
  }
  if (index == 3L) {
    obr::widget::row(x, y, wide, on, "1280 x 720", ink, accent);
    return;
  }
  if (index == 4L) {
    obr::widget::row(x, y, wide, on, "1920 x 1080", ink, accent);
    return;
  }
  obr::widget::row(x, y, wide, on, "640 x 480", ink, accent);
}

deRfun drawAspect(long index, long x, long y, long on): void {
  long ink = obr::ui::rgb(232L, 236L, 242L);
  long accent = obr::ui::rgb(88L, 168L, 255L);
  long wide = boxWide();
  if (index == 1L) {
    obr::widget::row(x, y, wide, on, "4:3", ink, accent);
    return;
  }
  if (index == 2L) {
    obr::widget::row(x, y, wide, on, "16:9", ink, accent);
    return;
  }
  if (index == 3L) {
    obr::widget::row(x, y, wide, on, "16:10", ink, accent);
    return;
  }
  obr::widget::row(x, y, wide, on, "Native", ink, accent);
}

deRfun drawSizeBar(long openFlag): void {
  long index = *(long*)7360;
  long x = boxLeft();
  long y = sizeTop(obr::ui::height());
  long ink = obr::ui::rgb(232L, 236L, 242L);
  long dim = obr::ui::rgb(132L, 144L, 162L);
  long accent = obr::ui::rgb(88L, 168L, 255L);
  long wide = boxWide();
  if (index == 1L) {
    obr::widget::bar(x, y, wide, openFlag, "800 x 600", ink, dim, accent);
    return;
  }
  if (index == 2L) {
    obr::widget::bar(x, y, wide, openFlag, "1024 x 768", ink, dim, accent);
    return;
  }
  if (index == 3L) {
    obr::widget::bar(x, y, wide, openFlag, "1280 x 720", ink, dim, accent);
    return;
  }
  if (index == 4L) {
    obr::widget::bar(x, y, wide, openFlag, "1920 x 1080", ink, dim, accent);
    return;
  }
  obr::widget::bar(x, y, wide, openFlag, "640 x 480", ink, dim, accent);
}

deRfun drawAspectBar(long openFlag): void {
  long index = *(long*)7424;
  long x = boxLeft();
  long y = aspectTop(obr::ui::height());
  long ink = obr::ui::rgb(232L, 236L, 242L);
  long dim = obr::ui::rgb(132L, 144L, 162L);
  long accent = obr::ui::rgb(88L, 168L, 255L);
  long wide = boxWide();
  if (index == 1L) {
    obr::widget::bar(x, y, wide, openFlag, "4:3", ink, dim, accent);
    return;
  }
  if (index == 2L) {
    obr::widget::bar(x, y, wide, openFlag, "16:9", ink, dim, accent);
    return;
  }
  if (index == 3L) {
    obr::widget::bar(x, y, wide, openFlag, "16:10", ink, dim, accent);
    return;
  }
  obr::widget::bar(x, y, wide, openFlag, "Native", ink, dim, accent);
}

/* 点中列表的第几项。没有点中是 -1。 */
deRfun hitList(long x, long y, long boxTop, long count): long {
  long row = 0L;
  while (row < count) {
    long top = listTop(boxTop, count, row);
    if (obr::ui::hit(x, y, boxLeft(), top, boxWide(), 26L) == 1L) {
      return row;
    }
    row = row + 1L;
  }
  return 0L - 1L;
}

/* 顶栏前两半是类别。右侧那几个字是焦点提示，点它不换类别。点中返回 1。 */
deRfun clickTop(long x, long y): int {
  long wide = obr::ui::width();
  if (obr::ui::hit(x, y, 0L, 0L, wide, 40L) == 0L) {
    return 0;
  }
  /* 右上角是当前焦点的名字。点它就换到下一块，而不是把这次点击吃掉。 */
  if (x >= wide - 64L) {
    set(5184L, bump(*(long*)5184, 1L, 3L));
    return 1;
  }
  long category = 0L;
  if (x >= wide / 2L) {
    category = 1L;
  }
  set(5248L, category);
  set(4160L, 0L);
  set(5312L, 0L);
  set(5376L, 0L);
  set(5184L, 0L);
  set(7488L, 0L);
  return 1;
}

/* 左侧每一项高 30，间隔 34，第一项在 50。点中就换子页。 */
deRfun clickSide(long x, long y): int {
  long count = subcount();
  long row = 0L;
  long top = 50L;
  while (row < count) {
    if (obr::ui::hit(x, y, 0L, top, 136L, 30L) == 1L) {
      set(4160L, row);
      set(5312L, 0L);
      set(5376L, 0L);
      set(5184L, 1L);
      set(7488L, 0L);
      return 1;
    }
    top = top + 34L;
    row = row + 1L;
  }
  return 0;
}

deRfun clickPanel(long x, long y): int {
  if (onDisplay() == 0) {
    return 0;
  }
  long open = *(long*)7488;
  long high = obr::ui::height();
  long left = boxLeft();
  long wide = boxWide();
  if (open == 1L) {
    long hit = hitList(x, y, sizeTop(high), 5L);
    if (hit >= 0L) {
      set(5184L, 2L);
      set(7360L, hit);
      set(7488L, 0L);
      commitPanel();
      return 1;
    }
  }
  if (open == 2L) {
    long hit = hitList(x, y, aspectTop(high), 4L);
    if (hit >= 0L) {
      set(5184L, 2L);
      set(7424L, hit);
      set(7488L, 0L);
      commitPanel();
      return 1;
    }
  }
  if (obr::ui::hit(x, y, left, sizeTop(high), wide, 28L) == 1L) {
    set(5184L, 2L);
    set(7616L, 0L);
    if (open == 1L) {
      set(7488L, 0L);
    } else {
      set(7488L, 1L);
    }
    return 1;
  }
  if (obr::ui::hit(x, y, left, aspectTop(high), wide, 28L) == 1L) {
    set(5184L, 2L);
    set(7616L, 1L);
    if (open == 2L) {
      set(7488L, 0L);
    } else {
      set(7488L, 2L);
    }
    return 1;
  }
  set(7488L, 0L);
  return 0;
}

/* 这一行把纵坐标推进多少。必须和 show 画完后的增量一致，命中才落在同一行上。 */
deRfun rowSpan(long kind, long a, long b, long c, long index): long {
  if (kind == 1L || kind == 2L) {
    return b;
  }
  if (kind == 3L) {
    return a;
  }
  if (kind == 4L || kind == 5L || kind == 9L || kind == 17L || kind == 18L || kind == 21L || kind == 24L || kind == 25L) {
    return 24L;
  }
  if (kind == 8L) {
    if (a >= 0L) {
      return 44L;
    }
    return 22L;
  }
  if (kind == 15L) {
    if (query(1L, 0L, 0L) > 0L) {
      return 50L;
    }
    return 28L;
  }
  if (kind == 16L) {
    return 24L * query(0L, 1L, 0L);
  }
  if (kind == 19L) {
    return 36L;
  }
  if (kind == 20L) {
    return 40L;
  }
  if (kind == 14L) {
    return 54L;
  }
  if (kind == 22L) {
    if (query(5L, 0L, index) != 0L) {
      return 94L;
    }
    return 72L;
  }
  if (kind == 23L) {
    return 28L;
  }
  return 0L;
}

/* 扩展口列表上的一张卡片。点中就选中；口里有设备时直接进入详情。 */
deRfun clickPort(long sx, long sy): int {
  if (*(long*)5248 != 0L || *(long*)4160 != 5L || *(long*)5376 != 0L) {
    return 0;
  }
  long cy = sy + *(long*)5312;
  long y = 54L;
  long x = 152L;
  long pc = at(12288L + 5L * 64L);
  long back = 0L;
  long index = 0L;
  long count = 0L;
  long step = 0L;
  while (step != 400L) {
    long kind = at(pc);
    step = step + 1L;
    if (kind == 0L) {
      return 0;
    }
    if (kind == 10L) {
      back = pc + 256L;
      index = 0L;
      count = query(1L, 0L, 0L);
      pc = back;
      if (count == 0L) {
        while (at(pc) != 11L && at(pc) != 0L) {
          pc = pc + 256L;
        }
        if (at(pc) == 11L) {
          pc = pc + 256L;
        }
      }
      continue;
    }
    if (kind == 11L || kind == 13L) {
      index = index + 1L;
      if (index == count) {
        pc = pc + 256L;
        index = 0L;
      } else {
        pc = back;
      }
      continue;
    }
    if (kind == 12L) {
      back = pc + 256L;
      index = 0L;
      count = 4L;
      pc = back;
      continue;
    }
    if (kind == 14L && obr::ui::hit(sx, cy, x - 8L, y - 4L, 280L, 48L) == 1L) {
      long state = query(5L, 0L, index);
      set(5568L, index);
      set(5184L, 2L);
      if (state != 0L) {
        set(5376L, 1L);
        set(5312L, 0L);
      }
      return 1;
    }
    y = y + rowSpan(kind, at(pc + 64L), at(pc + 128L), at(pc + 192L), index);
    pc = pc + 256L;
  }
  return 0;
}

/* 滑块顶端。和绘制用同一条式子。 */
deRfun thumbTop(): long {
  long high = obr::ui::height();
  long travel = high - 40L - 16L - 28L;
  long max = *(long*)5632;
  if (travel < 1L) {
    travel = 1L;
  }
  if (max < 1L) {
    return 48L;
  }
  return 48L + *(long*)5312 * travel / max;
}

/* 右侧 18 像素是滚动条的可点范围。没有可滚内容时让给正文。 */
deRfun clickScroll(long x, long y): int {
  long max = *(long*)5632;
  long wide = obr::ui::width();
  if (max < 1L || x < wide - 18L || y < 40L) {
    return 0;
  }
  long ty = thumbTop();
  if (obr::ui::hit(x, y, wide - 18L, ty, 18L, 28L) == 1L) {
    set(7936L, 1L);
    set(8000L, y);
    set(8064L, *(long*)5312);
    set(5184L, 2L);
    return 1;
  }
  long page = obr::ui::height() - 80L;
  if (page < 40L) {
    page = 40L;
  }
  long next = *(long*)5312;
  if (y < ty) {
    next = next - page;
  } else {
    next = next + page;
  }
  if (next < 0L) {
    next = 0L;
  }
  if (next > max) {
    next = max;
  }
  set(5312L, next);
  set(5184L, 2L);
  return 1;
}

deRfun dragScroll(long y): void {
  if (*(long*)7936 != 1L) {
    return;
  }
  long max = *(long*)5632;
  long travel = obr::ui::height() - 40L - 16L - 28L;
  if (travel < 1L) {
    travel = 1L;
  }
  long next = *(long*)8064 + (y - *(long*)8000) * max / travel;
  if (next < 0L) {
    next = 0L;
  }
  if (next > max) {
    next = max;
  }
  set(5312L, next);
}

/* 左键先点顶栏、左侧和滚动条，再点选择器或扩展口。其余落在栏里就把焦点放过去。 */
deRfun clickBios(long x, long y): void {
  set(7936L, 0L);
  if (clickTop(x, y) == 1) {
    return;
  }
  if (clickSide(x, y) == 1) {
    return;
  }
  if (y >= 40L && x < 136L) {
    set(5184L, 1L);
    return;
  }
  if (clickScroll(x, y) == 1) {
    return;
  }
  if (clickPanel(x, y) == 1) {
    return;
  }
  if (clickPort(x, y) == 1) {
    return;
  }
  long wide = obr::ui::width();
  long high = obr::ui::height();
  if (obr::ui::hit(x, y, 136L, 40L, wide - 136L, high - 40L) == 1L) {
    set(5184L, 2L);
  }
}

/* 指针是否落在已经打开的尺寸或比例列表上，含那条选择器本身。 */
deRfun overSelector(long x, long y): int {
  if (onDisplay() == 0) {
    return 0;
  }
  long open = *(long*)7488;
  long high = obr::ui::height();
  long left = boxLeft();
  long wide = boxWide();
  if (open == 1L) {
    if (obr::ui::hit(x, y, left, sizeTop(high), wide, 28L) == 1L) {
      return 1;
    }
    if (hitList(x, y, sizeTop(high), 5L) >= 0L) {
      return 1;
    }
  }
  if (open == 2L) {
    if (obr::ui::hit(x, y, left, aspectTop(high), wide, 28L) == 1L) {
      return 1;
    }
    if (hitList(x, y, aspectTop(high), 4L) >= 0L) {
      return 1;
    }
  }
  return 0;
}

/* 滚轮字的低 16 位是垂直分量，向下为正。 */
deRfun wheelDy(long raw): long {
  long dy = raw % 65536L;
  if (dy < 0L) {
    dy = 0L;
  }
  if (dy >= 32768L) {
    return dy - 65536L;
  }
  return dy;
}

/* 打开的选择器上，滚轮换当前项。其余位置滚动右侧正文，向下为正。 */
deRfun wheelBios(long x, long y, long raw): void {
  long dy = wheelDy(raw);
  if (dy == 0L) {
    return;
  }
  if (overSelector(x, y) == 1) {
    wheelPanel(x, y, raw);
    return;
  }
  if (dy > 0L) {
    nudge(1L);
    return;
  }
  nudge(0L - 1L);
}

deRfun wheelPanel(long x, long y, long raw): void {
  if (onDisplay() == 0) {
    return;
  }
  long dy = wheelDy(raw);
  if (dy == 0L) {
    return;
  }
  long step = 1L;
  if (dy < 0L) {
    step = 0L - 1L;
  }
  long open = *(long*)7488;
  if (open == 1L) {
    long next = *(long*)7360 + step;
    if (next < 0L) {
      next = 0L;
    }
    if (next > 4L) {
      next = 4L;
    }
    set(7360L, next);
    commitPanel();
    return;
  }
  if (open == 2L) {
    long next = *(long*)7424 + step;
    if (next < 0L) {
      next = 0L;
    }
    if (next > 3L) {
      next = 3L;
    }
    set(7424L, next);
    commitPanel();
  }
}

/* 显示器页底部两个选择器。打开的列表盖在选择条上面。 */
deRfun panelFace(): void {
  if (onDisplay() == 0) {
    set(7488L, 0L);
    return;
  }
  long high = obr::ui::height();
  long dim = obr::ui::rgb(132L, 144L, 162L);
  long left = boxLeft();
  long open = *(long*)7488;
  obr::ui::text(left, sizeTop(high) - 18L, 16L, "SIZE", dim, 255L);
  long sizeOpen = 0L;
  if (open == 1L) {
    sizeOpen = 1L;
  }
  drawSizeBar(sizeOpen);
  obr::ui::text(left, aspectTop(high) - 18L, 16L, "RATIO", dim, 255L);
  long aspectOpen = 0L;
  if (open == 2L) {
    aspectOpen = 1L;
  }
  drawAspectBar(aspectOpen);
  if (open == 0L) {
    long accent = obr::ui::rgb(88L, 168L, 255L);
    long mark = sizeTop(high) + 26L;
    if (*(long*)7616 != 0L) {
      mark = aspectTop(high) + 26L;
    }
    obr::ui::rect(left, mark, boxWide(), 2L, accent, 255L);
  }
  if (open == 1L) {
    long row = 0L;
    long pick = *(long*)7360;
    while (row < 5L) {
      long on = 0L;
      if (row == pick) {
        on = 1L;
      }
      drawSize(row, left, listTop(sizeTop(high), 5L, row), on);
      row = row + 1L;
    }
  }
  if (open == 2L) {
    long row = 0L;
    long pick = *(long*)7424;
    while (row < 4L) {
      long on = 0L;
      if (row == pick) {
        on = 1L;
      }
      drawAspect(row, left, listTop(aspectTop(high), 4L, row), on);
      row = row + 1L;
    }
  }
}

/* 焦点在右侧时才调用。7616 是当前选择器：0 尺寸，1 比例。回车打开或关上它。方向键在列表里换项并立刻应用；列表没开时只在两个选择器之间移动。 */
deRfun panelKey(): int {
  long name = *(long*)4864;
  long open = *(long*)7488;
  long field = *(long*)7616;
  if (name == 0x7265746e45L) {
    long which = 1L;
    if (field != 0L) {
      which = 2L;
    }
    if (open == which) {
      set(7488L, 0L);
    } else {
      set(7488L, which);
    }
    return 1;
  }
  long dir = 0L;
  if (backward(name) == 1) {
    dir = 0L - 1L;
  }
  if (forward(name) == 1) {
    dir = 1L;
  }
  if (dir == 0L) {
    return 0;
  }
  if (open == 0L) {
    if (dir < 0L) {
      set(7616L, 0L);
    } else {
      set(7616L, 1L);
    }
    return 1;
  }
  if (open == 1L) {
    long next = *(long*)7360 + dir;
    if (next < 0L) {
      next = 4L;
    }
    if (next > 4L) {
      next = 0L;
    }
    set(7360L, next);
    commitPanel();
    return 1;
  }
  long next = *(long*)7424 + dir;
  if (next < 0L) {
    next = 3L;
  }
  if (next > 3L) {
    next = 0L;
  }
  set(7424L, next);
  commitPanel();
  return 1;
}

/* 把还没看过的鼠标事件按顺序取完。左键点栏、滚动条、选择器和扩展口。
   移动时如果还按着滑块就跟着滚。滚轮在选择器上换项，别处滚动正文。看过才移出。 */
deRfun takePointer(): void {
  long guard = 0L;
  long used = 0L;
  while (pointer::depth() > 0L && guard < 32L) {
    long x = pointer::x();
    long y = pointer::y();
    *(long*)7680 = x;
    *(long*)7744 = y;
    *(long*)7808 = 1L;
    long kind = pointer::kind();
    if (kind == 1L && pointer::button() == 1L) {
      clickBios(x, y);
    }
    if (kind == 0L) {
      dragScroll(y);
    }
    if (kind == 2L && pointer::button() == 1L) {
      set(7936L, 0L);
    }
    if (kind == 3L) {
      wheelBios(x, y, pointer::wheel());
    }
    pointer::pop();
    used = 1L;
    guard = guard + 1L;
  }
  if (used == 1L && *(long*)4096 == 2L) {
    paint();
  }
}

/* 找键盘口，然后一直轮询。红点不在这里换：这一循环的快慢会跟着读盘变。
   倒计时结束时只调度核心 3。核心 2 把各映像装完后把 5952 写成 1，这里才铺上全屏加载，并把 4096 写成 1。
   过渡的前 20 拍画得密一些，方标和拖影依次淡入。淡入停住之后拖影继续转，不再换成别的画面。
   加载期间内核去准备资源并初始化。 */
deRfun main(): int {
  long* mode = (long*)4096;
  long* count = (long*)4352;
  long* wait = (long*)4416;
  long* port = (long*)4480;
  long* tick = (long*)5696;
  long* done = (long*)5952;
  long* armed = (long*)6016;
  gl::load();
  *mode = 0L;
  *count = 0L;
  *wait = 800L;
  *tick = 0L;
  *done = 0L;
  *armed = 0L;
  *(long*)7360 = 0L;
  *(long*)7424 = 0L;
  *(long*)7488 = 0L;
  *(long*)7552 = 0L;
  *(long*)7616 = 0L;
  *(long*)7680 = 0L;
  *(long*)7744 = 0L;
  *(long*)7808 = 0L;
  *(long*)7936 = 0L;
  *(long*)8000 = 0L;
  *(long*)8064 = 0L;
  loadPanel();
  long index = 0L;
  long matched = 0L;
  while (index != 4L && matched == 0L) {
    if (port::state(index) == 2L && port::char(index, 0L) == 0x5AL && port::char(index, 1L) == 0x4BL && port::char(index, 2L) == 0x50L && port::char(index, 3L) == 0x31L) {
      *port = index;
      matched = 1L;
    } else {
      index = index + 1L;
    }
  }
  if (matched == 0L) {
    *port = 4L;
    clear();
    halt();
    return 0;
  }
  while (1) {
    int event = poll();
    if (*(long*)4096 == 2L) {
      takePointer();
    }
    if (event == 1) {
      onkey();
    }
    /* 设置开着也继续倒计时。停在 CPU 页时核心 3 仍会装上内核，空转起来之后这一页才能看到 RUN。 */
    if (*armed == 0L && *done == 0L) {
      *wait = *wait - 1L;
      if (*wait == 0L) {
        obr::os::schedule(3L);
        *armed = 1L;
      }
    }
    if (*mode == 2L) {
      if (event == 1) {
        paint();
        *tick = 0L;
      } else {
        *tick = *tick + 1L;
        if (*tick == 80L) {
          *tick = 0L;
          paint();
        }
      }
    } else if (*mode == 0L) {
      if (*armed != 0L && *done != 0L) {
        *mode = 1L;
        *tick = 0L;
        long* phase = (long*)6080;
        long* intro = (long*)6144;
        *phase = 0L;
        *intro = 0L;
        loading();
      }
    } else if (*done != 0L) {
      long* intro = (long*)6144;
      if (*intro < 20L) {
        *intro = *intro + 1L;
      }
      long* phase = (long*)6080;
      *phase = *phase + 1L;
      if (*phase >= 24L) {
        *phase = 0L;
      }
      loading();
      /* 画完按墙钟等 40 毫秒。空转收件箱会在宿主上堆出短命对象，
         放两分钟后回收会把这一圈拖慢。淡入和匀速用同一拍，24 步大约一秒。 */
      obr::os::dwell(40L);
    }
  }
}

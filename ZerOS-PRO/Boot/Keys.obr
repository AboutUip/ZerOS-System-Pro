/* 键盘交给监督核。停笔之后、且不在设置里时，把按下写入 6528 起的环。
   不管设置页自己怎么处理方向键。格子地址记在 Bios.obr，这里不另抄一张表。 */
import firmware;

/* 停笔之后把这一次按下交给监督核。设置画面自己留着用，不写入环。
   先写两个字，再增加次数，读的一侧才不会拿到写了一半的槽。 */
deRfun keyOffer(): void {
  if (*(long*)4096 == 2L || *(long*)6336 == 0L) {
    return;
  }
  long count = *(long*)6528;
  long slot = count % 5L;
  long at = 6656L + slot * 128L;
  long unit = *(long*)4992;
  long mods = *(long*)4928;
  if (unit < 0L) {
    unit = 0L;
  }
  while (unit >= 65536L) {
    unit = unit - 65536L;
  }
  /* 低 16 位是键值，接着 16 位是修饰位；高 32 位放 ZKP1 关联号。
     内核只读低 32 位，高 32 位对终端透明。 */
  *(long*)at = unit + mods * 65536L + *(long*)5120 * 4294967296L;
  *(long*)(at + 64L) = *(long*)4864;
  /* 发布栅栏在 6592。地址记在 Bios.obr。先写这格，再让 6528 的新次数可见。 */
  *(long*)6592 = 0L;
  *(long*)6528 = count + 1L;
}

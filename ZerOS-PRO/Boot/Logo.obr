/* 上电画面。居中写出 BOOT，把盒子编号留在位地址 4224。 */
import firmware;
import gpu;

deRfun main(): int {
  long box = gpu::box(0, 0, 0, 640, 480, 0);
  long* kept = (long*)4224;
  *kept = box;
  long text = gpu::text(box, 0, 0, 640, 480);
  gpu::align(text, 1, 1);
  gpu::paint(text, 0xFFFFFF, 0);
  gpu::glyph(text, 0x42);
  gpu::glyph(text, 0x4F);
  gpu::glyph(text, 0x4F);
  gpu::glyph(text, 0x54);
  gpu::compose();
  gpu::present();
  return 0;
}

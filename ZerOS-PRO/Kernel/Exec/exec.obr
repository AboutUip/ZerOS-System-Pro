/* 执行层。引导时装驱动。spawn 在空闲核心上装第一份；核心已经因时间片停住时，先把当前这份抄进槽，再装下一份。一颗用户核能装多少，由任务表、上下文槽和堆池决定。
   程序正文暂存在监督核窗口的槽尾，也就是编译器映像之后，最长是这一段空档的全部八位组。 */
#LINK /start.obr
import proc;
import fs;
import sched;
import board;
import memory;
import obr.nas;
import obr.os;

/* 监督核槽尾。kSlot 减 kSpan 再除以 8，是这段空档的八位组数。 */
deRfun imageCap(): long {
  return (kSlot() - kSpan()) / 8L;
}

deRfun imageAt(): long {
  return kArena(2L) + kSpan();
}

deRfun drvPath(): long {
  return kArena(2L) + 32768L;
}

deRfun drvName(): long {
  return kArena(2L) + 34816L;
}

deRfun pullAt(long path, long* size): long {
  long kind = 0L;
  long bytes = 0L;
  long status = obr::nas::statAt(path, &kind, &bytes);
  if (status != 0L || kind != 1L || bytes < 1L || bytes > imageCap()) {
    return 1L;
  }
  long handle = 0L;
  status = obr::nas::openAt(path, 0L, &handle);
  if (status != 0L) {
    return status;
  }
  long offset = 0L;
  long base = imageAt();
  long span = 256L * 1024L;
  while (offset < bytes) {
    long count = bytes - offset;
    if (count > span) {
      count = span;
    }
    long got = 0L;
    status = obr::nas::read(handle, offset, base + offset * 8L, count, &got);
    if (status != 0L || got < 1L) {
      obr::nas::close(handle);
      return 1L;
    }
    offset = offset + got;
    if (got == span && span < 256L * 1024L * 1024L) {
      span = span * 2L;
    } else {
      span = 256L * 1024L;
    }
  }
  obr::nas::close(handle);
  *size = bytes;
  return 0L;
}

deRfun pull(string path, long* size): long {
  long kind = 0L;
  long bytes = 0L;
  long status = obr::nas::stat(path, &kind, &bytes);
  if (status != 0L || kind != 1L || bytes < 1L || bytes > imageCap()) {
    return 1L;
  }
  long handle = 0L;
  status = obr::nas::open(path, 0L, &handle);
  if (status != 0L) {
    return status;
  }
  long offset = 0L;
  long base = imageAt();
  long span = 256L * 1024L;
  while (offset < bytes) {
    long count = bytes - offset;
    if (count > span) {
      count = span;
    }
    long got = 0L;
    status = obr::nas::read(handle, offset, base + offset * 8L, count, &got);
    if (status != 0L || got < 1L) {
      obr::nas::close(handle);
      return 1L;
    }
    offset = offset + got;
    if (got == span && span < 256L * 1024L * 1024L) {
      span = span * 2L;
    } else {
      span = 256L * 1024L;
    }
  }
  obr::nas::close(handle);
  *size = bytes;
  return 0L;
}

/* 路径在 home+512。库从 NAS 读进暂存，再接到已经停住的调用者后面。成功时 +192 是第一个导出的指令编号。 */
deRfun loadLib(long caller, long home): long {
  long size = 0L;
  long status = pullAt(home + 16384L, &size);
  if (status != 0L) {
    return status;
  }
  long base = obr::os::attach(caller, imageAt(), size);
  memory::store64(base, home + 192L);
  return 0L;
}

/* 兼容尾区的起点。映射区到这里为止。前 4096 个八位组是陷入帧，任务从 4096 起。 */
deRfun compatTail(): long {
  return 2432696320L;
}

deRfun elfByte(long base, long offset): long {
  long value = memory::loadOctet(base + offset * 8L);
  if (value < 0L) {
    value = value + 256L;
  }
  return value;
}

deRfun elfHalf(long base, long offset): long {
  return elfByte(base, offset) + elfByte(base, offset + 1L) * 256L;
}

deRfun elfWord(long base, long offset): long {
  return memory::load64(base + offset * 8L);
}

/* 魔数 7F 45 4C 46。不是 ELF 就返回 0，调用方仍走原来的装入。 */
deRfun elfImage(long base): long {
  if (memory::loadOctet(base) != 127L) {
    return 0L;
  }
  if (memory::loadOctet(base + 8L) != 69L) {
    return 0L;
  }
  if (memory::loadOctet(base + 16L) != 76L) {
    return 0L;
  }
  if (memory::loadOctet(base + 24L) != 70L) {
    return 0L;
  }
  return 1L;
}

/* 描述符放在监督核窗口，驱动名字之后。四个字：入口、栈、空间长度、标志。 */
deRfun compatDesc(): long {
  return kArena(2L) + 36864L;
}

/*
 * 把 ELF64 小端、机器 62、没有解释器的可执行映像抄进尾区，再 admit。
 * 只接受 PT_LOAD。虚地址要落在 4096 到栈页之前。入口必须在一段可执行的装入里。
 * 栈页从 16773120 起，里面保持 0，当作空的 argc。失败时还没有 admit。
 */
deRfun compatPlace(long core, long base, long bytes): long {
  if (bytes < 64L) {
    return 4L;
  }
  if (memory::loadOctet(base + 32L) != 2L || memory::loadOctet(base + 40L) != 1L) {
    return 4L;
  }
  long kind = elfHalf(base, 16L);
  long machine = elfHalf(base, 18L);
  if ((kind != 2L && kind != 3L) || machine != 62L) {
    return 4L;
  }
  long entry = elfWord(base, 24L);
  long phoff = elfWord(base, 32L);
  long phentsize = elfHalf(base, 54L);
  long phnum = elfHalf(base, 56L);
  if (phoff < 64L || phentsize < 56L || phnum < 1L || phnum > 32L) {
    return 4L;
  }
  if (phoff + phentsize * phnum > bytes) {
    return 4L;
  }
  long index = 0L;
  long executable = 0L;
  while (index < phnum) {
    long header = base + (phoff + index * phentsize) * 8L;
    long packed = memory::load64(header);
    if (packed < 0L) {
      return 4L;
    }
    long type = packed % 4294967296L;
    long flags = packed / 4294967296L;
    if (type == 3L) {
      return 4L;
    }
    if (type == 1L) {
      long offset = memory::load64(header + 64L);
      long vaddr = memory::load64(header + 128L);
      long filesz = memory::load64(header + 256L);
      long memsz = memory::load64(header + 320L);
      if (offset < 0L || vaddr < 4096L || filesz < 0L || memsz < filesz) {
        return 4L;
      }
      if (vaddr + memsz > 16773120L || offset + filesz > bytes) {
        return 4L;
      }
      if (flags % 2L == 1L && entry >= vaddr && entry < vaddr + memsz) {
        executable = 1L;
      }
    }
    index = index + 1L;
  }
  if (executable == 0L) {
    return 4L;
  }
  index = 0L;
  while (index < phnum) {
    long header = base + (phoff + index * phentsize) * 8L;
    long packed = memory::load64(header);
    if (packed < 0L) {
      return 4L;
    }
    long type = packed % 4294967296L;
    if (type == 1L) {
      long offset = memory::load64(header + 64L);
      long vaddr = memory::load64(header + 128L);
      long filesz = memory::load64(header + 256L);
      long memsz = memory::load64(header + 320L);
      long cursor = 0L;
      long dest = compatTail() + vaddr * 8L;
      long src = base + offset * 8L;
      while (cursor < filesz) {
        long value = memory::loadOctet(src + cursor * 8L);
        if (value < 0L) {
          value = value + 256L;
        }
        memory::storeOctet(value, dest + cursor * 8L);
        cursor = cursor + 1L;
      }
      while (cursor < memsz) {
        memory::storeOctet(0L, dest + cursor * 8L);
        cursor = cursor + 1L;
      }
    }
    index = index + 1L;
  }
  long desc = compatDesc();
  memory::store64(entry, desc);
  memory::store64(16773120L, desc + 64L);
  memory::store64(16777216L, desc + 128L);
  memory::store64(0L, desc + 192L);
  obr::os::admit(core, desc, 32L);
  obr::os::bound(core, kArena(core), kSlot());
  return 0L;
}

deRfun placeAt(long path, long core): long {
  long size = 0L;
  long status = pullAt(path, &size);
  if (status != 0L) {
    return status;
  }
  if (elfImage(imageAt()) == 1L) {
    return compatPlace(core, imageAt(), size);
  }
  obr::os::install(core, imageAt(), size);
  obr::os::bound(core, kArena(core), kSlot());
  return 0L;
}

deRfun putDrv(long index, long value): void {
  memory::storeOctet(value, drvPath() + 64L + index * 8L);
}

deRfun fillDrv(long nameLen): long {
  long prefix = 12L;
  long total = prefix + nameLen;
  if (total > 240L) {
    return 7L;
  }
  memory::store64(total, drvPath());
  putDrv(0L, 47L);
  putDrv(1L, 107L);
  putDrv(2L, 101L);
  putDrv(3L, 114L);
  putDrv(4L, 110L);
  putDrv(5L, 101L);
  putDrv(6L, 108L);
  putDrv(7L, 47L);
  putDrv(8L, 100L);
  putDrv(9L, 114L);
  putDrv(10L, 118L);
  putDrv(11L, 47L);
  long index = 0L;
  while (index < nameLen) {
    long value = memory::loadOctet(drvName() + index * 8L);
    putDrv(prefix + index, value);
    index = index + 1L;
  }
  return 0L;
}

deRfun nameHasDot(long count): long {
  long index = 0L;
  while (index < count) {
    if (memory::loadOctet(drvName() + index * 8L) == 46L) {
      return 1L;
    }
    index = index + 1L;
  }
  return 0L;
}

/* 3 以及 4 至 7 可以装用户程序。0 是固件画面，2 是监督核。1 的数据窗留给沙盒客程序。 */
deRfun userCore(long core): long {
  if (core == 3L) {
    return 1L;
  }
  if (core >= 4L && core <= 7L) {
    return 1L;
  }
  return 0L;
}

deRfun freeCore(long core): long {
  if (userCore(core) == 0L) {
    return 0L;
  }
  if (taskCount(core) != 0L) {
    return 0L;
  }
  return 1L;
}

/* 表里还有空位，下一份任务才装得下。 */
deRfun taskRoom(): long {
  long index = 0L;
  while (index < taskLimit()) {
    if (taskAt(index).pid == 0L) {
      return 1L;
    }
    index = index + 1L;
  }
  return 0L;
}

/* 这颗核上还有空位，并且当前任务已经因为时间片停住。这时才能在装入前把旧任务抄进槽。 */
deRfun stoppedForSlice(long core): long {
  if (userCore(core) == 0L) {
    return 0L;
  }
  /* 已经停住时，只有时间片或让出才能再装一份。正在跑的可以，装入会先停在指令边界。 */
  if (query(1L, 5L, core) == 0L && query(1L, 11L, core) != 1L) {
    return 0L;
  }
  long count = taskCount(core);
  if (count < 1L) {
    return 0L;
  }
  long index = taskFind(core);
  if (index < 0L) {
    return 0L;
  }
  if (taskAt(index).state != TaskState::Running) {
    return 0L;
  }
  return 1L;
}

/* 11904 起六个字：1 号所在核心，还没放行的驱动个数，然后最多四颗核心。
   紧挨在 pid 字 12416 前面。驱动先调度起来，但放行字是 0，只按 30 Hz 空转，
   不发系统调用，免得和 1 号抢同一个保持位。放行字在该核心窗口 +960。 */
deRfun holdAt(long index): long {
  return 537931392L + index * 64L;
}

/* 驱动也是 1 号的子任务。它们的核心记在 holdAt(2) 起，最多四颗。shell 不在这张表里。 */
deRfun termDriver(long core): long {
  long count = memory::load64(holdAt(1L));
  long index = 0L;
  while (index < count && index < 4L) {
    if (memory::load64(holdAt(2L + index)) == core) {
      return 1L;
    }
    index = index + 1L;
  }
  return 0L;
}

/* 1 号直接派生的、又不是驱动的那份任务。还没有时是 0。空槽和僵尸不算。 */
deRfun termShell(): long {
  long index = 0L;
  while (index < taskLimit()) {
    Task* task = taskAt(index);
    if (task.pid > 1L && task.ppid == 1L && task.state != TaskState::Empty && task.state != TaskState::Zombie && termDriver(task.core) == 0L) {
      return task.pid;
    }
    index = index + 1L;
  }
  return 0L;
}

deRfun bootDriver(long core): long {
  long pid = taskSpawn(core, nextPid(), 0L, 0L, 0L, TaskState::Ready);
  if (pid == 0L) {
    return 0L;
  }
    obr::os::hertz(core, 30L);
    memory::store64(0L, kArena(core) + 960L);
    long count = memory::load64(holdAt(1L));
  if (count < 4L) {
    memory::store64(core, holdAt(2L + count));
    memory::store64(count + 1L, holdAt(1L));
  }
  return pid;
}

deRfun drvLoad(): void {
  memory::store64(0L, holdAt(0L));
  memory::store64(0L, holdAt(1L));
  if (obr::nas::ready() != 1L) {
    return;
  }
  long index = 0L;
  long core = 4L;
  while (index < 8L && core < 8L) {
    long got = 0L;
    long status = obr::nas::readdir("/kernel/drv", index, drvName(), 32L, &got);
    if (status != 0L) {
      return;
    }
    index = index + 1L;
    if (got < 1L || nameHasDot(got) == 1L) {
      continue;
    }
    if (fillDrv(got) != 0L) {
      continue;
    }
    while (core < 8L && freeCore(core) == 0L) {
      core = core + 1L;
    }
    if (core >= 8L) {
      return;
    }
    if (placeAt(drvPath(), core) == 0L) {
      long pid = bootDriver(core);
      if (pid != 0L) {
        devPublish(core, pid, drvName(), got);
      }
      core = core + 1L;
    }
  }
}

/* 清屏之后再拉起。映像在 /kernel/init，固定 pid 1，父任务是 0。uid 0，没有管理权。
   驱动已经占掉的核心跳过。没有空核心或读不到映像时，引导继续，只是没有 1 号。 */
deRfun bootInit(): void {
  if (obr::nas::ready() != 1L) {
    return;
  }
  long core = 4L;
  while (core < 8L && freeCore(core) == 0L) {
    core = core + 1L;
  }
  if (core >= 8L) {
    return;
  }
  long size = 0L;
  if (pull("/kernel/init", &size) != 0L) {
    return;
  }
  obr::os::install(core, imageAt(), size);
  obr::os::bound(core, kArena(core), kSlot());
  long pid = taskSpawn(core, 1L, 0L, 0L, 0L, TaskState::Ready);
  if (pid == 0L) {
    return;
  }
  taskAt(taskByPid(1L)).ppid = 0L;
  memory::store64(core, holdAt(0L));
  /* 30 太慢，写一行要等好几秒。这里拉高，字马上出来。 */
  obr::os::hertz(core, 1000000L);
  schedWake(core);
}

deRfun isSession(long path): long {
  if (memory::load64(path) != 11L) {
    return 0L;
  }
  if (memory::loadOctet(path + 64L) != 47L) {
    return 0L;
  }
  if (memory::loadOctet(path + 72L) != 111L) {
    return 0L;
  }
  if (memory::loadOctet(path + 80L) != 115L) {
    return 0L;
  }
  if (memory::loadOctet(path + 88L) != 47L) {
    return 0L;
  }
  if (memory::loadOctet(path + 96L) != 115L) {
    return 0L;
  }
  if (memory::loadOctet(path + 104L) != 101L) {
    return 0L;
  }
  if (memory::loadOctet(path + 112L) != 115L) {
    return 0L;
  }
  if (memory::loadOctet(path + 120L) != 115L) {
    return 0L;
  }
  if (memory::loadOctet(path + 128L) != 105L) {
    return 0L;
  }
  if (memory::loadOctet(path + 136L) != 111L) {
    return 0L;
  }
  if (memory::loadOctet(path + 144L) != 110L) {
    return 0L;
  }
  return 1L;
}

/* 装入程序停下之后，给没有任务的核心装上 /kernel/idle 并调度。30 Hz，保持执行中。 */
deRfun seatIdle(long core, long size): void {
  if (taskCount(core) != 0L) {
    return;
  }
  if (query(1L, 5L, core) != 0L) {
    return;
  }
  obr::os::install(core, imageAt(), size);
  obr::os::bound(core, kArena(core), kSlot());
  obr::os::hertz(core, 30L);
  obr::os::schedule(core);
}

deRfun bootIdle(): void {
  while (query(1L, 5L, 3L) != 0L) {
  }
  long size = 0L;
  if (pull("/kernel/idle", &size) != 0L) {
    return;
  }
  seatIdle(1L, size);
  seatIdle(3L, size);
  long core = 4L;
  while (core < 8L) {
    seatIdle(core, size);
    core = core + 1L;
  }
}

/* 驱动已经装好，放行字是 0。这里只调度，让它们按 30 Hz 空转。 */
deRfun bootArm(): void {
  long index = 0L;
  long count = memory::load64(holdAt(1L));
  while (index < count) {
    obr::os::schedule(memory::load64(holdAt(2L + index)));
    index = index + 1L;
  }
}

/* 1 号还没进入等待时先不放行驱动。它停在 wait 里，或根本没有 1 号，再逐个把放行字写成 1。
   结果写在 537931776：1 表示刚调度了驱动，调用方这时不要让出。
   任务表在 537985024，每份 1216 位，共 512 份，与 taskLimit 相同。状态在 +128。Sleeping 是 3。 */
deRfun bootPump(): void {
  __zap__ {
    load.64 r0, 537931456
    place r2, 1
    lt r1, r0, r2
    jnz r1, pumpNo
    load.64 r3, 537931392
    place r2, 0
    eq r1, r3, r2
    jnz r1, pumpGo
    place r4, 0
    pumpScan:
    place r2, 512
    lt r1, r4, r2
    jz r1, pumpGo
    place r2, 1216
    mul r0, r4, r2
    place r2, 537985024
    add r5, r0, r2
    ldi.64 r0, r5
    place r2, 1
    eq r1, r0, r2
    jnz r1, pumpHit
    place r2, 1
    add r4, r4, r2
    place r2, 1
    jnz r2, pumpScan
    pumpHit:
    place r2, 128
    add r5, r5, r2
    ldi.64 r0, r5
    place r2, 3
    eq r1, r0, r2
    jz r1, pumpNo
    pumpGo:
    place r0, 0
    store.64 r0, 537931840
    pumpLoop:
    load.64 r6, 537931840
    load.64 r7, 537931456
    lt r0, r6, r7
    jz r0, pumpDone
    place r2, 64
    mul r0, r6, r2
    place r2, 537931520
    add r0, r0, r2
    ldi.64 r1, r0
    place r2, 268435456
    mul r3, r1, r2
    place r2, 1048576
    add r3, r3, r2
    place r2, 960
    add r3, r3, r2
    place r0, 1
    sti.64 r0, r3
    load.64 r6, 537931840
    place r2, 1
    add r6, r6, r2
    store.64 r6, 537931840
    place r2, 1
    jnz r2, pumpLoop
    pumpDone:
    place r0, 0
    store.64 r0, 537931456
    place r0, 1
    place r2, 1
    jnz r2, pumpEnd
    pumpNo:
    place r0, 0
    pumpEnd:
    store.64 r0, 537931776
  }
}

deRfun execSpawn(long caller, long home): long {
  long taskIndex = taskFind(caller);
  if (taskIndex < 0L) {
    return -1L;
  }
  long status = vfsPrepare(caller, home + 16384L);
  if (status != 0L) {
    return status;
  }
  long core = memory::load64(home + 128L);
  long sharing = 0L;
  if (core == 0L) {
    core = 4L;
    while (core < 8L && freeCore(core) == 0L) {
      core = core + 1L;
    }
    if (core >= 8L && freeCore(3L) == 1L) {
      core = 3L;
    }
    if (core >= 8L) {
      core = 4L;
      while (core < 8L && stoppedForSlice(core) == 0L) {
        core = core + 1L;
      }
      if (core >= 8L && stoppedForSlice(3L) == 1L) {
        core = 3L;
      }
      sharing = 1L;
    }
  } else if (freeCore(core) == 0L) {
    if (stoppedForSlice(core) == 0L) {
      return 11L;
    }
    sharing = 1L;
  }
  if (userCore(core) == 0L) {
    return 11L;
  }
  long old = -1L;
  if (sharing == 1L) {
    if (taskRoom() == 0L) {
      return 7L;
    }
    old = taskFind(core);
    if (old < 0L) {
      return 11L;
    }
    /* 先抄旧任务。placeAt 里的 install 会清掉这颗核心上的私有栈。槽不够就先不装。 */
    long slot = slotHold(old);
    if (slot < 0L) {
      return 7L;
    }
    obr::os::capture(core, slot);
  }
  /* 内存文件不向 NAS 要。NAS 上的文件仍走原来的拉取。 */
  long size = 0L;
  long planted = vfsPlant(caller, home + 16384L, imageAt(), &size);
  if (planted == 0L) {
    if (elfImage(imageAt()) == 1L) {
      long placed = compatPlace(core, imageAt(), size);
      if (placed != 0L) {
        return placed;
      }
    } else {
      obr::os::install(core, imageAt(), size);
      obr::os::bound(core, kArena(core), kSlot());
    }
  } else if (planted != 1L) {
    return planted;
  } else {
    status = placeAt(scratch(), core);
    if (status != 0L) {
      return status;
    }
  }
  if (sharing == 1L) {
    Task* previous = taskAt(old);
    previous.state = TaskState::Ready;
  }
  Task* parent = taskAt(taskIndex);
  long pid = taskSpawn(core, nextPid(), parent.cred.uid, parent.cred.gid, parent.cap, TaskState::Running);
  if (pid == 0L) {
    if (sharing == 1L) {
      long back = taskAt(old).held - 1L;
      if (back >= 0L) {
        obr::os::restore(core, back);
      }
      Task* returned = taskAt(old);
      returned.state = TaskState::Running;
      obr::os::schedule(core);
    }
    return 7L;
  }
  Task* child = taskAt(taskByPid(pid));
  child.ppid = parent.pid;
  child.cred.euid = parent.cred.euid;
  child.cred.egid = parent.cred.egid;
  child.cap = parent.cap;
  vfsHand(taskIndex, taskByPid(pid));
  /* 会话只空转。30 Hz 时一拍长于 1 毫秒，宿主才会睡。其它程序仍用 1000000。
     再拉到 100000000 测过，按键仍是大约一秒，时间不在客程序的节拍上。 */
  if (isSession(home + 16384L) == 1L) {
    obr::os::hertz(core, 30L);
  } else {
    obr::os::hertz(core, 1000000L);
  }
  schedWake(core);
  memory::store64(pid, home + 192L);
  memory::store64(core, home + 256L);
  return 0L;
}

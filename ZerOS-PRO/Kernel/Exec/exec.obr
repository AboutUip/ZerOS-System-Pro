/* 执行层。引导时装驱动。spawn 在空闲核心上装第一份；核心已经因时间片停住且只有一份任务时，先把那份抄进槽，再装第二份。loadLib 把动态库接到调用者自己的序列后面。 */
#LINK /start.obr
import proc;
import fs;
import sched;
import board;
import memory;
import obr.nas;
import obr.os;

deRfun imageAt(): long {
  return 2560L * 1024L + 2L * kSlot() + 4096L;
}

deRfun drvPath(): long {
  return kArena(2L) + 32768L;
}

deRfun drvName(): long {
  return kArena(2L) + 34816L;
}

deRfun pullAt(long path, long* size): long {
  long kind = 0L;
  long bytes = 0L;
  long status = obr::nas::statAt(path, &kind, &bytes);
  if (status != 0L || kind != 1L || bytes < 1L || bytes > 131072L) {
    return 1L;
  }
  long handle = 0L;
  status = obr::nas::openAt(path, 0L, &handle);
  if (status != 0L) {
    return status;
  }
  long offset = 0L;
  long base = imageAt();
  long span = 256L * 1024L;
  while (offset < bytes) {
    long count = bytes - offset;
    if (count > span) {
      count = span;
    }
    long got = 0L;
    status = obr::nas::read(handle, offset, base + offset * 8L, count, &got);
    if (status != 0L || got < 1L) {
      obr::nas::close(handle);
      return 1L;
    }
    offset = offset + got;
    if (got == span && span < 256L * 1024L * 1024L) {
      span = span * 2L;
    } else {
      span = 256L * 1024L;
    }
  }
  obr::nas::close(handle);
  *size = bytes;
  return 0L;
}

deRfun pull(string path, long* size): long {
  long kind = 0L;
  long bytes = 0L;
  long status = obr::nas::stat(path, &kind, &bytes);
  if (status != 0L || kind != 1L || bytes < 1L || bytes > 131072L) {
    return 1L;
  }
  long handle = 0L;
  status = obr::nas::open(path, 0L, &handle);
  if (status != 0L) {
    return status;
  }
  long offset = 0L;
  long base = imageAt();
  long span = 256L * 1024L;
  while (offset < bytes) {
    long count = bytes - offset;
    if (count > span) {
      count = span;
    }
    long got = 0L;
    status = obr::nas::read(handle, offset, base + offset * 8L, count, &got);
    if (status != 0L || got < 1L) {
      obr::nas::close(handle);
      return 1L;
    }
    offset = offset + got;
    if (got == span && span < 256L * 1024L * 1024L) {
      span = span * 2L;
    } else {
      span = 256L * 1024L;
    }
  }
  obr::nas::close(handle);
  *size = bytes;
  return 0L;
}

/* 路径在 home+512。库从 NAS 读进暂存，再接到已经停住的调用者后面。成功时 +192 是第一个导出的指令编号。 */
deRfun loadLib(long caller, long home): long {
  long size = 0L;
  long status = pullAt(home + 512L, &size);
  if (status != 0L) {
    return status;
  }
  long base = obr::os::attach(caller, imageAt(), size);
  memory::store64(base, home + 192L);
  return 0L;
}

deRfun placeAt(long path, long core): long {
  long size = 0L;
  long status = pullAt(path, &size);
  if (status != 0L) {
    return status;
  }
  obr::os::install(core, imageAt(), size);
  obr::os::bound(core, kArena(core), kSpan());
  return 0L;
}

deRfun putDrv(long index, long value): void {
  memory::storeOctet(value, drvPath() + 64L + index * 8L);
}

deRfun fillDrv(long nameLen): long {
  long prefix = 12L;
  long total = prefix + nameLen;
  if (total > 240L) {
    return 7L;
  }
  memory::store64(total, drvPath());
  putDrv(0L, 47L);
  putDrv(1L, 107L);
  putDrv(2L, 101L);
  putDrv(3L, 114L);
  putDrv(4L, 110L);
  putDrv(5L, 101L);
  putDrv(6L, 108L);
  putDrv(7L, 47L);
  putDrv(8L, 100L);
  putDrv(9L, 114L);
  putDrv(10L, 118L);
  putDrv(11L, 47L);
  long index = 0L;
  while (index < nameLen) {
    long value = memory::loadOctet(drvName() + index * 8L);
    putDrv(prefix + index, value);
    index = index + 1L;
  }
  return 0L;
}

deRfun nameHasDot(long count): long {
  long index = 0L;
  while (index < count) {
    if (memory::loadOctet(drvName() + index * 8L) == 46L) {
      return 1L;
    }
    index = index + 1L;
  }
  return 0L;
}

deRfun freeCore(long core): long {
  if (core < 4L || core > 7L) {
    return 0L;
  }
  if (taskCount(core) != 0L) {
    return 0L;
  }
  if (query(1L, 5L, core) != 0L) {
    return 0L;
  }
  return 1L;
}

/* 表里还有空位，第二份任务才装得下。 */
deRfun taskRoom(): long {
  long index = 0L;
  while (index < 8L) {
    if (taskAt(index).pid == 0L) {
      return 1L;
    }
    index = index + 1L;
  }
  return 0L;
}

/* 只有一份任务，并且已经因为时间片停住。这时才能在装入前把旧任务抄进槽。 */
deRfun stoppedForSlice(long core): long {
  if (core < 4L || core > 7L) {
    return 0L;
  }
  if (query(1L, 5L, core) != 0L) {
    return 0L;
  }
  if (query(1L, 11L, core) != 1L) {
    return 0L;
  }
  if (taskCount(core) != 1L) {
    return 0L;
  }
  long index = taskFind(core);
  if (index < 0L) {
    return 0L;
  }
  if (taskAt(index).state != TaskState::Running) {
    return 0L;
  }
  return 1L;
}

/* 11904 起六个字：1 号所在核心，还没拉起的驱动个数，然后最多四颗核心。
   紧挨在 pid 字 12416 前面。驱动先装上不调度，免得和 1 号的第一次系统调用抢同一个保持位。 */
deRfun holdAt(long index): long {
  return 17837696L + index * 64L;
}

deRfun bootDriver(long core): long {
  long pid = taskSpawn(core, nextPid(), 0L, 0L, 0L, TaskState::Ready);
  if (pid == 0L) {
    return 0L;
  }
  obr::os::hertz(core, 30L);
  long count = memory::load64(holdAt(1L));
  if (count < 4L) {
    memory::store64(core, holdAt(2L + count));
    memory::store64(count + 1L, holdAt(1L));
  }
  return pid;
}

deRfun drvLoad(): void {
  memory::store64(0L, holdAt(0L));
  memory::store64(0L, holdAt(1L));
  if (obr::nas::ready() != 1L) {
    return;
  }
  long index = 0L;
  long core = 4L;
  while (index < 8L && core < 8L) {
    long got = 0L;
    long status = obr::nas::readdir("/kernel/drv", index, drvName(), 32L, &got);
    if (status != 0L) {
      return;
    }
    index = index + 1L;
    if (got < 1L || nameHasDot(got) == 1L) {
      continue;
    }
    if (fillDrv(got) != 0L) {
      continue;
    }
    while (core < 8L && freeCore(core) == 0L) {
      core = core + 1L;
    }
    if (core >= 8L) {
      return;
    }
    if (placeAt(drvPath(), core) == 0L) {
      long pid = bootDriver(core);
      if (pid != 0L) {
        devPublish(core, pid, drvName(), got);
      }
      core = core + 1L;
    }
  }
}

/* 清屏之后再拉起。映像在 /kernel/init，固定 pid 1，父任务是 0。uid 0，没有管理权。
   驱动已经占掉的核心跳过。没有空核心或读不到映像时，引导继续，只是没有 1 号。 */
deRfun bootInit(): void {
  if (obr::nas::ready() != 1L) {
    return;
  }
  long core = 4L;
  while (core < 8L && freeCore(core) == 0L) {
    core = core + 1L;
  }
  if (core >= 8L) {
    return;
  }
  long size = 0L;
  if (pull("/kernel/init", &size) != 0L) {
    return;
  }
  obr::os::install(core, imageAt(), size);
  obr::os::bound(core, kArena(core), kSpan());
  long pid = taskSpawn(core, 1L, 0L, 0L, 0L, TaskState::Ready);
  if (pid == 0L) {
    return;
  }
  taskAt(taskByPid(1L)).ppid = 0L;
  memory::store64(core, holdAt(0L));
  /* 30 太慢，写一行要等好几秒。这里拉高，字马上出来。 */
  obr::os::hertz(core, 1000000L);
  schedWake(core);
}

/* 1 号还没进入等待时先不拉驱动。它停在 wait 里，或根本没有 1 号，再把记下的核心一次调度起来。
   结果写在 17838080：1 表示刚调度了驱动，调用方这时不要让出。
   任务表在 17891328，每份 1216 位，状态在 +128。Sleeping 是 3。 */
deRfun bootPump(): void {
  __zap__ {
    load.64 r0, 17837760
    place r2, 1
    lt r1, r0, r2
    jnz r1, pumpNo
    load.64 r3, 17837696
    place r2, 0
    eq r1, r3, r2
    jnz r1, pumpGo
    place r4, 0
    pumpScan:
    place r2, 8
    lt r1, r4, r2
    jz r1, pumpGo
    place r2, 1216
    mul r0, r4, r2
    place r2, 17891328
    add r5, r0, r2
    ldi.64 r0, r5
    place r2, 1
    eq r1, r0, r2
    jnz r1, pumpHit
    place r2, 1
    add r4, r4, r2
    place r2, 1
    jnz r2, pumpScan
    pumpHit:
    place r2, 128
    add r5, r5, r2
    ldi.64 r0, r5
    place r2, 3
    eq r1, r0, r2
    jz r1, pumpNo
    pumpGo:
    place r0, 0
    store.64 r0, 17838144
    pumpLoop:
    load.64 r6, 17838144
    load.64 r7, 17837760
    lt r0, r6, r7
    jz r0, pumpDone
    place r2, 64
    mul r0, r6, r2
    place r2, 17837824
    add r0, r0, r2
    ldi.64 r1, r0
    call schedWake
    load.64 r6, 17838144
    place r2, 1
    add r6, r6, r2
    store.64 r6, 17838144
    place r2, 1
    jnz r2, pumpLoop
    pumpDone:
    place r0, 0
    store.64 r0, 17837760
    place r0, 1
    place r2, 1
    jnz r2, pumpEnd
    pumpNo:
    place r0, 0
    pumpEnd:
    store.64 r0, 17838080
  }
}

deRfun execSpawn(long caller, long home): long {
  long taskIndex = taskFind(caller);
  if (taskIndex < 0L) {
    return -1L;
  }
  long status = vfsPrepare(caller, home + 512L);
  if (status != 0L) {
    return status;
  }
  long core = memory::load64(home + 128L);
  long sharing = 0L;
  if (core == 0L) {
    core = 4L;
    while (core < 8L && freeCore(core) == 0L) {
      core = core + 1L;
    }
    if (core >= 8L) {
      core = 4L;
      while (core < 8L && stoppedForSlice(core) == 0L) {
        core = core + 1L;
      }
      sharing = 1L;
    }
  } else if (freeCore(core) == 0L) {
    if (stoppedForSlice(core) == 0L) {
      return 11L;
    }
    sharing = 1L;
  }
  if (core < 4L || core > 7L) {
    return 11L;
  }
  long old = -1L;
  if (sharing == 1L) {
    if (taskRoom() == 0L) {
      return 7L;
    }
    old = taskFind(core);
    if (old < 0L) {
      return 11L;
    }
    /* 先抄旧任务。placeAt 里的 install 会清掉这颗核心上的私有栈。 */
    obr::os::capture(core, old);
  }
  status = placeAt(scratch(), core);
  if (status != 0L) {
    return status;
  }
  if (sharing == 1L) {
    Task* previous = taskAt(old);
    previous.held = 1L;
    previous.state = TaskState::Ready;
  }
  Task* parent = taskAt(taskIndex);
  long pid = taskSpawn(core, nextPid(), parent.cred.uid, parent.cred.gid, parent.cap, TaskState::Running);
  if (pid == 0L) {
    if (sharing == 1L) {
      obr::os::restore(core, old);
      Task* back = taskAt(old);
      back.state = TaskState::Running;
      obr::os::schedule(core);
    }
    return 7L;
  }
  Task* child = taskAt(taskByPid(pid));
  child.ppid = parent.pid;
  child.cred.euid = parent.cred.euid;
  child.cred.egid = parent.cred.egid;
  child.cap = parent.cap;
  /* 30 太慢，用户程序写一行要等很久。拉高之后马上能看见。 */
  obr::os::hertz(core, 1000000L);
  schedWake(core);
  memory::store64(pid, home + 192L);
  memory::store64(core, home + 256L);
  return 0L;
}

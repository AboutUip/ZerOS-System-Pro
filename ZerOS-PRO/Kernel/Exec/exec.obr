/* 映像。把程序放进监督核槽尾，认出 ELF，装上一颗核。
   不管引导先装谁，不管参数和创建子任务。
   程序正文在编译器映像之后，末尾 90176 个八位组留给目录窗。 */
#LINK /start.obr, /boot.obr, /spawn.obr
import proc;
import memory;
import obr.nas;
import obr.os;

/* 监督核槽尾。末尾 90176 个八位组是 obr.nas 的目录窗，程序映像不能占用。 */
deRfun imageCap(): long {
  return (kSlot() - kSpan()) / 8L - 90176L;
}

deRfun imageAt(): long {
  return kArena(2L) + kSpan();
}

deRfun drvPath(): long {
  return kArena(2L) + 32768L;
}

deRfun drvName(): long {
  return kArena(2L) + 34816L;
}

deRfun pullAt(long path, long* size): long {
  long kind = 0L;
  long bytes = 0L;
  long status = obr::nas::statAt(path, &kind, &bytes);
  if (status != 0L || kind != 1L || bytes < 1L || bytes > imageCap()) {
    return 1L;
  }
  long handle = 0L;
  status = obr::nas::openAt(path, 0L, &handle);
  if (status != 0L) {
    return status;
  }
  long offset = 0L;
  long base = imageAt();
  long span = 256L * 1024L;
  while (offset < bytes) {
    long count = bytes - offset;
    if (count > span) {
      count = span;
    }
    long got = 0L;
    status = obr::nas::read(handle, offset, base + offset * 8L, count, &got);
    if (status != 0L || got < 1L) {
      obr::nas::close(handle);
      return 1L;
    }
    offset = offset + got;
    if (got == span && span < 256L * 1024L * 1024L) {
      span = span * 2L;
    } else {
      span = 256L * 1024L;
    }
  }
  obr::nas::close(handle);
  *size = bytes;
  return 0L;
}

deRfun pull(string path, long* size): long {
  long kind = 0L;
  long bytes = 0L;
  long status = obr::nas::stat(path, &kind, &bytes);
  if (status != 0L || kind != 1L || bytes < 1L || bytes > imageCap()) {
    return 1L;
  }
  long handle = 0L;
  status = obr::nas::open(path, 0L, &handle);
  if (status != 0L) {
    return status;
  }
  long offset = 0L;
  long base = imageAt();
  long span = 256L * 1024L;
  while (offset < bytes) {
    long count = bytes - offset;
    if (count > span) {
      count = span;
    }
    long got = 0L;
    status = obr::nas::read(handle, offset, base + offset * 8L, count, &got);
    if (status != 0L || got < 1L) {
      obr::nas::close(handle);
      return 1L;
    }
    offset = offset + got;
    if (got == span && span < 256L * 1024L * 1024L) {
      span = span * 2L;
    } else {
      span = 256L * 1024L;
    }
  }
  obr::nas::close(handle);
  *size = bytes;
  return 0L;
}

/* 路径在 home+512。库从 NAS 读进暂存，再接到已经停住的调用者后面。成功时 +192 是第一个导出的指令编号。 */
deRfun loadLib(long caller, long home): long {
  long size = 0L;
  long status = pullAt(home + 16384L, &size);
  if (status != 0L) {
    return status;
  }
  long base = obr::os::attach(caller, imageAt(), size);
  memory::store64(base, home + 192L);
  return 0L;
}

/* 兼容尾区的起点。映射区到这里为止。前 4096 个八位组是陷入帧，任务从 4096 起。 */
deRfun compatTail(): long {
  return 2432696320L;
}

deRfun elfByte(long base, long offset): long {
  long value = memory::loadOctet(base + offset * 8L);
  if (value < 0L) {
    value = value + 256L;
  }
  return value;
}

deRfun elfHalf(long base, long offset): long {
  return elfByte(base, offset) + elfByte(base, offset + 1L) * 256L;
}

deRfun elfWord(long base, long offset): long {
  return memory::load64(base + offset * 8L);
}

/* 魔数 7F 45 4C 46。不是 ELF 就返回 0，调用方仍走原来的装入。 */
deRfun elfImage(long base): long {
  if (memory::loadOctet(base) != 127L) {
    return 0L;
  }
  if (memory::loadOctet(base + 8L) != 69L) {
    return 0L;
  }
  if (memory::loadOctet(base + 16L) != 76L) {
    return 0L;
  }
  if (memory::loadOctet(base + 24L) != 70L) {
    return 0L;
  }
  return 1L;
}

/* 描述符放在监督核窗口，驱动名字之后。四个字：入口、栈、空间长度、标志。 */
deRfun compatDesc(): long {
  return kArena(2L) + 36864L;
}

/*
 * 把 ELF64 小端、机器 62、没有解释器的可执行映像抄进尾区，再 admit。
 * 只接受 PT_LOAD。虚地址要落在 4096 到栈页之前。入口必须在一段可执行的装入里。
 * 栈页从 16773120 起，里面保持 0，当作空的 argc。失败时还没有 admit。
 */
deRfun compatPlace(long core, long base, long bytes): long {
  if (bytes < 64L) {
    return 4L;
  }
  if (memory::loadOctet(base + 32L) != 2L || memory::loadOctet(base + 40L) != 1L) {
    return 4L;
  }
  long kind = elfHalf(base, 16L);
  long machine = elfHalf(base, 18L);
  if ((kind != 2L && kind != 3L) || machine != 62L) {
    return 4L;
  }
  long entry = elfWord(base, 24L);
  long phoff = elfWord(base, 32L);
  long phentsize = elfHalf(base, 54L);
  long phnum = elfHalf(base, 56L);
  if (phoff < 64L || phentsize < 56L || phnum < 1L || phnum > 32L) {
    return 4L;
  }
  if (phoff + phentsize * phnum > bytes) {
    return 4L;
  }
  long index = 0L;
  long executable = 0L;
  while (index < phnum) {
    long header = base + (phoff + index * phentsize) * 8L;
    long packed = memory::load64(header);
    if (packed < 0L) {
      return 4L;
    }
    long type = packed % 4294967296L;
    long flags = packed / 4294967296L;
    if (type == 3L) {
      return 4L;
    }
    if (type == 1L) {
      long offset = memory::load64(header + 64L);
      long vaddr = memory::load64(header + 128L);
      long filesz = memory::load64(header + 256L);
      long memsz = memory::load64(header + 320L);
      if (offset < 0L || vaddr < 4096L || filesz < 0L || memsz < filesz) {
        return 4L;
      }
      if (vaddr + memsz > 16773120L || offset + filesz > bytes) {
        return 4L;
      }
      if (flags % 2L == 1L && entry >= vaddr && entry < vaddr + memsz) {
        executable = 1L;
      }
    }
    index = index + 1L;
  }
  if (executable == 0L) {
    return 4L;
  }
  index = 0L;
  while (index < phnum) {
    long header = base + (phoff + index * phentsize) * 8L;
    long packed = memory::load64(header);
    if (packed < 0L) {
      return 4L;
    }
    long type = packed % 4294967296L;
    if (type == 1L) {
      long offset = memory::load64(header + 64L);
      long vaddr = memory::load64(header + 128L);
      long filesz = memory::load64(header + 256L);
      long memsz = memory::load64(header + 320L);
      long cursor = 0L;
      long dest = compatTail() + vaddr * 8L;
      long src = base + offset * 8L;
      while (cursor < filesz) {
        long value = memory::loadOctet(src + cursor * 8L);
        if (value < 0L) {
          value = value + 256L;
        }
        memory::storeOctet(value, dest + cursor * 8L);
        cursor = cursor + 1L;
      }
      while (cursor < memsz) {
        memory::storeOctet(0L, dest + cursor * 8L);
        cursor = cursor + 1L;
      }
    }
    index = index + 1L;
  }
  long desc = compatDesc();
  memory::store64(entry, desc);
  memory::store64(16773120L, desc + 64L);
  memory::store64(16777216L, desc + 128L);
  memory::store64(0L, desc + 192L);
  obr::os::admit(core, desc, 32L);
  obr::os::bound(core, kArena(core), kSlot());
  return 0L;
}

deRfun placeAt(long path, long core): long {
  long size = 0L;
  long status = pullAt(path, &size);
  if (status != 0L) {
    return status;
  }
  if (elfImage(imageAt()) == 1L) {
    return compatPlace(core, imageAt(), size);
  }
  obr::os::install(core, imageAt(), size);
  obr::os::bound(core, kArena(core), kSlot());
  return 0L;
}

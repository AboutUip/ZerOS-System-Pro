/* 创建子任务，并把调用者的参数交过去。
   不管引导顺序。参数布局和 Resource/Bin/arg.obr 是同一张。 */
#LINK /start.obr, /boot.obr, /loader.obr
import proc;
import fs;
import exec;
import sched;
import board;
import memory;
import obr.os;

/* 参数和环境放在界限起点 +4194304。客程序和 Resource/Bin/arg.obr 用同一张布局。
   字 0 个数，字 1 环境条数，字 2 参数八位组数，字 3 环境八位组数。
   +256 起 64 个参数长度，+4352 起 64 个环境长度。
   参数八位组从 +8448 起，环境从 +73984 起，相邻隔 8 位。整段 139520 位。 */
deRfun argAt(long home): long {
  return home + 4194304L;
}

deRfun argSpan(): long {
  return 139520L;
}

deRfun argOk(long home): long {
  long base = argAt(home);
  long argc = memory::load64(base);
  long envc = memory::load64(base + 64L);
  long argBytes = memory::load64(base + 128L);
  long envBytes = memory::load64(base + 192L);
  if (argc < 0L || argc > 64L || envc < 0L || envc > 64L) {
    return 0L;
  }
  if (argBytes < 0L || argBytes > 8192L || envBytes < 0L || envBytes > 8192L) {
    return 0L;
  }
  return 1L;
}

deRfun clearArgs(long home): void {
  long at = argAt(home);
  long index = 0L;
  while (index < argSpan()) {
    memory::store64(0L, at + index);
    index = index + 64L;
  }
}

/* 按字抄 count 个 64 位。count 为 0 时不进循环。 */
deRfun copyWords(long from, long to, long count): void {
  long index = 0L;
  while (index < count) {
    memory::store64(memory::load64(from + index * 64L), to + index * 64L);
    index = index + 1L;
  }
}

/* 用不到的长度槽写成 0。读参数的人若越过 argc 去看槽，不会拿到上一个任务的长度。 */
deRfun zeroWords(long to, long count): void {
  long index = 0L;
  while (index < count) {
    memory::store64(0L, to + index * 64L);
    index = index + 1L;
  }
}

/* 八位组按声明的个数抄。loadOctet 是补码，写入前与 255 相与。 */
deRfun copyOctets(long from, long to, long count): void {
  long index = 0L;
  while (index < count) {
    memory::storeOctet(memory::loadOctet(from + index * 8L) & 255L, to + index * 8L);
    index = index + 1L;
  }
}

/* 父任务窗口里已经声明的参数和环境抄进子任务。调用前要先 argOk。
   头四个字、用到的长度、参数八位组和环境八位组按个数抄。
   用不到的长度字写成 0，这样按长度去读不会走进上一个任务留下的八位组。
   八位组尾部不整段清零：清掉剩下的 8192 和原来按 2180 个字整段抄是同一笔开销。
   argLen、envLen 先看条数，条数之外的槽已经是 0，读不到那段尾部。 */
deRfun handArgs(long from, long to): void {
  long src = argAt(from);
  long dst = argAt(to);
  long argc = memory::load64(src);
  long envc = memory::load64(src + 64L);
  long argBytes = memory::load64(src + 128L);
  long envBytes = memory::load64(src + 192L);
  copyWords(src, dst, 4L);
  copyWords(src + 256L, dst + 256L, argc);
  zeroWords(dst + 256L + argc * 64L, 64L - argc);
  copyWords(src + 4352L, dst + 4352L, envc);
  zeroWords(dst + 4352L + envc * 64L, 64L - envc);
  if (argBytes > 0L) {
    copyOctets(src + 8448L, dst + 8448L, argBytes);
  }
  if (envBytes > 0L) {
    copyOctets(src + 73984L, dst + 73984L, envBytes);
  }
}

deRfun execSpawn(long caller, long home): long {
  long taskIndex = taskFind(caller);
  if (taskIndex < 0L) {
    return -1L;
  }
  if (argOk(home) == 0L) {
    return 13L;
  }
  long status = vfsPrepare(caller, home + 16384L);
  if (status != 0L) {
    return status;
  }
  long core = memory::load64(home + 128L);
  long sharing = 0L;
  if (core == 0L) {
    core = 4L;
    while (core < 8L && freeCore(core) == 0L) {
      core = core + 1L;
    }
    if (core >= 8L && freeCore(3L) == 1L) {
      core = 3L;
    }
    if (core >= 8L) {
      core = 4L;
      while (core < 8L && stoppedForSlice(core) == 0L) {
        core = core + 1L;
      }
      if (core >= 8L && stoppedForSlice(3L) == 1L) {
        core = 3L;
      }
      sharing = 1L;
    }
  } else if (freeCore(core) == 0L) {
    if (stoppedForSlice(core) == 0L) {
      return 11L;
    }
    sharing = 1L;
  }
  if (userCore(core) == 0L) {
    return 11L;
  }
  long old = -1L;
  if (sharing == 1L) {
    if (taskRoom() == 0L) {
      return 7L;
    }
    old = taskFind(core);
    if (old < 0L) {
      return 11L;
    }
    /* 先抄旧任务。placeAt 里的 install 会清掉这颗核心上的私有栈。槽不够就先不装。 */
    long slot = slotHold(old);
    if (slot < 0L) {
      return 7L;
    }
    obr::os::capture(core, slot);
  }
  /* 内存文件不向 NAS 要。NAS 上的文件仍走原来的拉取。 */
  long size = 0L;
  long planted = vfsPlant(caller, home + 16384L, imageAt(), &size);
  if (planted == 0L) {
    if (elfImage(imageAt()) == 1L) {
      long placed = compatPlace(core, imageAt(), size);
      if (placed != 0L) {
        return placed;
      }
    } else {
      obr::os::install(core, imageAt(), size);
      obr::os::bound(core, kArena(core), kSlot());
    }
  } else if (planted != 1L) {
    return planted;
  } else {
    status = placeAt(scratch(), core);
    if (status != 0L) {
      return status;
    }
  }
  /* 映像已经在核心上，而且核心还停着。导入名要在调度进 main 之前装上。 */
  long bytes = size;
  if (planted == 1L) {
    bytes = lastPull(0L, 0L);
  }
  if (elfImage(imageAt()) == 0L) {
    long bound = bindLibs(core, home, bytes);
    if (bound != 0L) {
      if (sharing == 1L) {
        long back = taskAt(old).held - 1L;
        if (back >= 0L) {
          obr::os::restore(core, back);
          Task* returned = taskAt(old);
          taskAccount(old, TaskState::Running);
          returned.state = TaskState::Running;
          /* 被换下来的就是调用者时，回复要等它回到核上再交，免得子任务把状态取走。
             换下来的不是调用者时，调用者还停在自己的核上，回复由返回值带回去。 */
          if (old == taskIndex) {
            obr::os::pass(core, bound);
            obr::os::schedule(core);
            return -1L;
          }
          obr::os::schedule(core);
        }
      }
      return bound;
    }
  }
  /* 独占这颗核时，清掉上一个程序留下的 static。
     和父任务共用窗口时不能清，父任务还要回到这些格子上。 */
  if (sharing == 0L && elfImage(imageAt()) == 0L) {
    wipeStatics(kArena(core));
  }
  if (sharing == 1L) {
    Task* previous = taskAt(old);
    taskAccount(old, TaskState::Ready);
    previous.state = TaskState::Ready;
  }
  Task* parent = taskAt(taskIndex);
  long pid = taskSpawn(core, nextPid(), parent.cred.uid, parent.cred.gid, parent.cap, TaskState::Running);
  if (pid == 0L) {
    if (sharing == 1L) {
      long back = taskAt(old).held - 1L;
      if (back >= 0L) {
        obr::os::restore(core, back);
        Task* returned = taskAt(old);
        taskAccount(old, TaskState::Running);
        returned.state = TaskState::Running;
        if (old == taskIndex) {
          obr::os::pass(core, 7L);
          obr::os::schedule(core);
          return -1L;
        }
        obr::os::schedule(core);
      }
    }
    return 7L;
  }
  Task* child = taskAt(taskByPid(pid));
  child.ppid = parent.pid;
  child.cred.euid = parent.cred.euid;
  child.cred.egid = parent.cred.egid;
  child.cap = parent.cap;
  child.cwd = parent.cwd;
  /* 子任务继承父任务的档。1 号在引导时写成前台，交互任务顺着这条链下来。
     内核不按路径把某一个程序单独抬上去。 */
  rankSet(taskByPid(pid), rankGet(taskIndex));
  commFromPath(taskByPid(pid), home + 16384L);
  vfsHand(taskIndex, taskByPid(pid));
  /* handArgs 按声明的条数和八位组数交接，不必先把 139520 位整段清零。
     用子任务所在核心的窗口起点，而不是 query(1,8,core)：子任务还没调度时，
     那颗核心上的 home 仍是上一个任务，参数会抄到旧窗口。 */
  handArgs(home, kArena(core));
  /* 1 号的直接子任务起来之后停在 core()。
     频率低于 1000 时，宿主才把这种空转停住。其它程序用 1000000。
     有效指令不受这个数限制，时间片仍按大约 1 毫秒让出。 */
  if (parent.pid == 1L) {
    obr::os::hertz(core, 30L);
  } else {
    obr::os::hertz(core, 1000000L);
  }
  schedWake(core);
  memory::store64(pid, home + 192L);
  memory::store64(core, home + 256L);
  if (sharing == 1L && old == taskIndex) {
    /* 父任务在槽里，核上现在是子任务。spawn 的回复值先记在父任务上，
       等父任务被 restore 回来、真正要跑之前再 pass，避免子任务把回复取走。
       槽里是别的任务时不能记在它身上，否则调用者永远等不到这次回复。 */
    taskAt(old).code = -2L;
    return -1L;
  }
  return 0L;
}


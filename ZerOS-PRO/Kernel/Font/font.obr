/* 系统字体目录。文件在 NAS 的 /font，监督核引导时记下在不在和八位组数。
   表在本窗口 +20480。+12416 起是 pid 和光标，+12800 是控制台暂存的调用者窗口，+32768 起是驱动路径。
   两份，每份两个字：在不在，八位组数。0 号是更纱黑体 SC，1 号是枫 Mono CN。
   引导只登记路径。shell 起来之后先把 0 号映进映射区，固件仍转圈；答应停笔之后再建立 16 像素的字体面。终端格子由监督核绘制。 */
#LINK /start.obr
import memory;
import fs;
import obr.font;
import obr.nas;
import obr.os;

deRfun fontBase(): long {
  return 1048576L + 2L * 268435456L + 20480L;
}

deRfun fontCount(): long {
  return 2L;
}

deRfun fontPath(long index): string {
  if (index == 0L) {
    return "/font/sarasa-mono-sc.ttf";
  }
  return "/font/maple-mono-cn.ttf";
}

/* 路径按计数字符串写到调用者窗口 +512：长度字，八位组从 +64 起、相邻隔 8 位。 */
deRfun fontWrite(long home, string path): void {
  int raw = length(path);
  long count = raw;
  memory::store64(count, home + 512L);
  int step = 0;
  while (step < raw) {
    long code = path[step];
    memory::storeOctet(code, home + 512L + 64L + step * 8L);
    step = step + 1;
  }
}

deRfun fontNote(long index, string path): void {
  long kind = 0L;
  long size = 0L;
  long status = obr::nas::stat(path, &kind, &size);
  long present = 0L;
  if (status == 0L && kind == 1L && size >= 1L) {
    present = 1L;
  } else {
    size = 0L;
  }
  long at = fontBase() + index * 128L;
  memory::store64(present, at);
  memory::store64(size, at + 64L);
}

deRfun fontCensus(): void {
  fontNote(0L, fontPath(0L));
  fontNote(1L, fontPath(1L));
}

/* 窗口开头是下标。-1 只回复份数。越界回复 -1。
   成功回复 0：+128 为 1 表示引导时是普通文件，+192 是八位组数，+512 是路径。 */
deRfun fontQuery(long home): long {
  long index = memory::load64(home);
  if (index == -1L) {
    return fontCount();
  }
  if (index < 0L || index >= fontCount()) {
    return -1L;
  }
  long at = fontBase() + index * 128L;
  memory::store64(memory::load64(at), home + 128L);
  memory::store64(memory::load64(at + 64L), home + 192L);
  fontWrite(home, fontPath(index));
  return 0L;
}

/* 字体表后面：阶段、字体面、映射起点、八位组数。标量从再往后 256 位起，相邻隔 32 位。 */
deRfun termSlot(long index): long {
  return fontBase() + 512L + index * 64L;
}

deRfun termPhase(): long {
  return memory::load64(termSlot(0L));
}

deRfun termSet(long value): void {
  memory::store64(value, termSlot(0L));
}

/* 字体表占两个字，阶段从 +512 起。中间这个字留给映射句柄，映射页还要靠它调入。 */
deRfun termHandle(): long {
  return fontBase() + 256L;
}

/* 把 0 号更纱读进映射。超过 16777216 个八位组就留给方标。
   这一步只有网络读，不碰显卡，固件继续转圈。失败时不写 6272。 */
deRfun termMap(): long {
  if (memory::load64(fontBase()) != 1L) {
    return 0L;
  }
  long octets = memory::load64(fontBase() + 64L);
  if (octets < 1L || octets > 16777216L) {
    return 0L;
  }
  long handle = 0L;
  if (obr::nas::open(fontPath(0L), 0L, &handle) != 0L) {
    return 0L;
  }
  long address = obr::os::mmap(2L, handle, octets);
  if (address < 8L) {
    obr::nas::close(handle);
    return 0L;
  }
  memory::store64(address, termSlot(2L));
  memory::store64(octets, termSlot(3L));
  memory::store64(handle, termHandle());
  return 1L;
}

/* 映射已经在。固件答应停笔之后再建立字体面，两边不同时画。 */
deRfun termFont(): long {
  long address = memory::load64(termSlot(2L));
  long octets = memory::load64(termSlot(3L));
  long handle = memory::load64(termHandle());
  long face = obr::font::face(address, octets, 16L);
  if (face < 1L) {
    obr::os::munmap(address, octets);
    if (handle != 0L) {
      obr::nas::close(handle);
    }
    return 0L;
  }
  memory::store64(face, termSlot(1L));
  return 1L;
}

/* 格子已经由写入放好。这里只把脏行画出来。字号 16，一格 8 像素宽、18 像素高。 */
deRfun termShow(): void {
  conPaint();
}

/* 文件层。目录项和索引节点在监督核的窗口里。NAS 只负责字节，属主和权限位在这里。
   种类 1 是 NAS 上的文件，2 是 NAS 上的目录，3 是字符设备，4 是只活在这张表里的目录。/dev 是种类 4。
   种类 5 是内存文件，6 是内存目录。根在 NAS 没就绪，或 /boot/root 正好是 mem 时，用种类 6。
   索引节点 11 个字、704 位。末尾三个字是访问、修改、状态时间，从 Unix 纪元起的毫秒。
   描述符可以复制。几个描述符共用同一个打开对象时，关掉一个不关掉其余的。
   派生会把调用者已经打开的描述符交给子任务，两边各算一份。 */
#LINK /start.obr, /exec.obr, /task.obr, /font.obr
import proc;
import sched;
import trap;
import board;
import memory;
import obr.ui;
import obr.font;
import obr.nas;

struct Inode {
  long used;
  long kind;
  long mode;
  long uid;
  long gid;
  long size;
  long parent;
  long nlink;
  /* 从 Unix 纪元起的毫秒。atime 访问，mtime 修改，ctime 状态。 */
  long atime;
  long mtime;
  long ctime;
}

struct Dentry {
  long used;
  long parent;
  long ino;
  long nameLen;
}

struct File {
  long used;
  long ino;
  long offset;
  long flags;
  long handle;
}

struct Pipe {
  long used;
  long readers;
  long writers;
  long head;
  long count;
  long readWait;
  long writeWait;
}

/* 12 个字。环不在这个结构里，按设备下标排在设备头后面。每条环 ringRoom 个八位组。 */
struct Dev {
  long used;
  long core;
  long pid;
  long ino;
  long upHead;
  long upCount;
  long downHead;
  long downCount;
  long userReadWait;
  long userWriteWait;
  long drvRecvWait;
  long drvSendWait;
}

deRfun vfsBase(): long {
  return tableBase() + taskLimit() * taskStride();
}

deRfun inodeCount(): long {
  return 128L;
}

deRfun dentryCount(): long {
  return 256L;
}

/* 512 份任务、每份 8 个描述符。 */
deRfun fileCount(): long {
  return 4096L;
}

deRfun pipeCount(): long {
  return 64L;
}

/* 管道和设备环同一长度。一次系统调用可以写满一整条。 */
deRfun ringRoom(): long {
  return 4096L;
}

deRfun pipeRoom(): long {
  return ringRoom();
}

/* 调用者窗口里的读写字节。+4096 到调用帧之间只剩约 1024 个八位组，写满管道就会盖住路径。
   改放到路径之后。一次最多 262144 个八位组，和 NAS 批量读取的下界一样。 */
deRfun byteAt(long home): long {
  return home + 131072L;
}

deRfun byteRoom(): long {
  return 262144L;
}

/* 兼容任务的 write。个数先受这扇窗口的限制。描述符不对时返回 -9，个数不对返回 -22。 */
deRfun compatWrite(long caller, long home, long fd, long src, long count): long {
  if (count < 0L || count > byteRoom()) {
    return -22L;
  }
  memory::store64(fd, home + 128L);
  memory::store64(count, home + 256L);
  long index = 0L;
  long dst = byteAt(home);
  while (index < count) {
    long value = memory::loadOctet(src + index * 8L);
    if (value < 0L) {
      value = value + 256L;
    }
    memory::storeOctet(value, dst + index * 8L);
    index = index + 1L;
  }
  long status = doRead(caller, home, 1L);
  if (status == 0L) {
    return memory::load64(home + 320L);
  }
  if (status == 5L) {
    return -9L;
  }
  if (status == 7L) {
    return -22L;
  }
  return -38L;
}

deRfun devCount(): long {
  return 16L;
}

/* 一个路径分量最长 512 个八位组。名字槽按这个宽度排。 */
deRfun nameStride(): long {
  return 4096L;
}

/* 从根数到叶子，最多 128 层。32 层盖不住现在的目录嵌套。 */
deRfun pathDepth(): long {
  return 128L;
}

/* pathOf 拼出来的整条路径。一个分量放得下，多层短名字也放得下。 */
deRfun scratchRoom(): long {
  return 8192L;
}

/* 128 个索引节点，每个 11 个字、704 位。路径分量的 512 个八位组不在这个步长里。 */
deRfun inodeBytes(): long {
  return inodeCount() * 704L;
}

deRfun dentryBytes(): long {
  return dentryCount() * 256L;
}

deRfun nameBase(): long {
  return vfsBase() + inodeBytes() + dentryBytes();
}

deRfun nameBytes(): long {
  return dentryCount() * nameStride();
}

deRfun fileBase(): long {
  return nameBase() + nameBytes();
}

deRfun fileBytes(): long {
  return fileCount() * 320L;
}

deRfun scratchBytes(): long {
  return 64L + scratchRoom() * 8L;
}

deRfun scratch(): long {
  return fileBase() + fileBytes();
}

deRfun stackAt(): long {
  return scratch() + scratchBytes();
}

deRfun pipeBase(): long {
  return stackAt() + pathDepth() * 64L;
}

deRfun pipeBytes(): long {
  return pipeCount() * 448L;
}

deRfun pipeDataBase(): long {
  return pipeBase() + pipeBytes();
}

deRfun pipeDataBytes(): long {
  return pipeCount() * pipeRoom() * 8L;
}

deRfun devBase(): long {
  return pipeDataBase() + pipeDataBytes();
}

/* 任务上界在监督核窗口 +13248。紧挨着放两个字：0 是文件系统末址，1 是字符格起点。
   这两处都是常量。每次按键若重新乘一遍，光算地址就要几万条指令。 */
deRfun layoutWord(long slot): long {
  return kArena(2L) + 13312L + slot * 64L;
}

deRfun vfsEnd(): long {
  long cached = memory::load64(layoutWord(0L));
  if (cached != 0L) {
    return cached;
  }
  long base = devRingBase() + devCount() * 2L * ringRoom() * 8L;
  memory::store64(base, layoutWord(0L));
  return base;
}

/* 设备头 12 个字。两条环另排在所有设备头后面，不再挤在 2048 位的槽里。 */
deRfun devStride(): long {
  return 768L;
}

deRfun devAt(long index): Dev* {
  return (Dev*)(devBase() + index * devStride());
}

deRfun devRingBase(): long {
  return devBase() + devCount() * devStride();
}

deRfun devUp(long index): long {
  return devRingBase() + index * 2L * ringRoom() * 8L;
}

deRfun devDown(long index): long {
  return devUp(index) + ringRoom() * 8L;
}

deRfun inodeAt(long index): Inode* {
  return (Inode*)(vfsBase() + index * 704L);
}

deRfun dentryAt(long index): Dentry* {
  return (Dentry*)(vfsBase() + inodeBytes() + index * 256L);
}

deRfun nameAt(long index): long {
  return nameBase() + index * nameStride();
}

deRfun fileAt(long slot): File* {
  return (File*)(fileBase() + slot * 320L);
}

deRfun pipeAt(long index): Pipe* {
  return (Pipe*)(pipeBase() + index * 448L);
}

deRfun pipeData(long index): long {
  return pipeDataBase() + index * pipeRoom() * 8L;
}

deRfun octetAt(long address, long index): long {
  return memory::loadOctet(address + 64L + index * 8L);
}

deRfun scratchClear(): void {
  memory::store64(0L, scratch());
}

deRfun scratchPush(long value): long {
  long at = scratch();
  long count = memory::load64(at);
  if (count >= scratchRoom()) {
    return 7L;
  }
  memory::storeOctet(value, at + 64L + count * 8L);
  memory::store64(count + 1L, at);
  return 0L;
}

deRfun modeFile(): long {
  return 420L;
}

deRfun modeDir(): long {
  return 493L;
}

deRfun modeDev(): long {
  return 438L;
}

deRfun isDir(long kind): long {
  if (kind == 2L || kind == 4L || kind == 6L) {
    return 1L;
  }
  return 0L;
}

/* 监督核 query(0, 3, 0)。宿主 Date.now() 的毫秒，和三个文件时间同一单位。 */
deRfun nowMillis(): long {
  return query(0L, 3L, 0L);
}

deRfun stampCreate(Inode* node): void {
  long now = nowMillis();
  node.atime = now;
  node.mtime = now;
  node.ctime = now;
}

deRfun stampWrite(Inode* node): void {
  long now = nowMillis();
  node.mtime = now;
  node.ctime = now;
}

deRfun stampStatus(Inode* node): void {
  node.ctime = nowMillis();
}

/* 只有普通文件。目录、字符设备和终端的读不改访问时间。 */
deRfun stampAccess(Inode* node): void {
  if (node.kind == 1L || node.kind == 5L) {
    node.atime = nowMillis();
  }
}

/* 内存文件的槽号表紧挨在设备环后面。每个索引节点一个字，-1 表示没有正文。
   正文 6 份，每份 1048576 个八位组。以前一份只有 262144，连入口映像都放不下。
   份数停在编译器栈之前，栈在窗口 +67125248。 */
deRfun memSlotAt(long ino): long {
  return vfsEnd() + ino * 64L;
}

deRfun memBody(long slot): long {
  return vfsEnd() + inodeCount() * 64L + slot * memCap() * 8L;
}

deRfun memCap(): long {
  return 1048576L;
}

deRfun memSlots(): long {
  return 6L;
}

/* 放下这一份正文。索引节点还在不在，由调用方决定。 */
deRfun memDrop(long ino): void {
  if (ino < 0L || ino >= inodeCount()) {
    return;
  }
  memory::store64(-1L, memSlotAt(ino));
}

/* 六份里还没被任何索引节点指着的那一格。没有就回复 -1。 */
deRfun memTake(): long {
  long slot = 0L;
  while (slot < memSlots()) {
    long ino = 0L;
    long held = 0L;
    while (ino < inodeCount()) {
      if (memory::load64(memSlotAt(ino)) == slot) {
        held = 1L;
      }
      ino = ino + 1L;
    }
    if (held == 0L) {
      return slot;
    }
    slot = slot + 1L;
  }
  return -1L;
}

/* 在内存文件和调用窗口之间搬八位组。偏移和个数仍由调用者放在 +192、+256。 */
deRfun memMove(File* file, long home, long writing): long {
  long slot = memory::load64(memSlotAt(file.ino));
  if (slot < 0L || slot >= memSlots()) {
    return 5L;
  }
  long offset = memory::load64(home + 192L);
  long count = memory::load64(home + 256L);
  if (offset < 0L || count < 0L) {
    return 13L;
  }
  if (count > byteRoom()) {
    return 7L;
  }
  Inode* node = inodeAt(file.ino);
  long cap = memCap();
  long got = 0L;
  long stop = 0L;
  while (got < count && stop == 0L) {
    long at = offset + got;
    if (at < 0L || at >= cap) {
      stop = 1L;
    } else if (writing == 0L && at >= node.size) {
      stop = 1L;
    } else if (writing == 0L) {
      long value = memory::loadOctet(memBody(slot) + at * 8L);
      memory::storeOctet(value, byteAt(home) + got * 8L);
      got = got + 1L;
    } else {
      long value = memory::loadOctet(byteAt(home) + got * 8L);
      memory::storeOctet(value, memBody(slot) + at * 8L);
      got = got + 1L;
    }
  }
  if (writing == 1L && offset + got > node.size) {
    if (offset + got <= cap) {
      node.size = offset + got;
    } else if (offset < cap) {
      node.size = cap;
    }
  }
  file.offset = offset + got;
  memory::store64(got, home + 320L);
  return 0L;
}

/* /boot/root 正好三个八位组 mem，或 NAS 还没就绪，根就用内存目录。
   文件不在、读不到、内容不是 mem，根仍是 NAS 上的目录。 */
deRfun memoryRoot(): long {
  if (obr::nas::ready() != 1L) {
    return 1L;
  }
  long kind = 0L;
  long bytes = 0L;
  long status = obr::nas::stat("/boot/root", &kind, &bytes);
  if (status != 0L || kind != 1L || bytes != 3L) {
    return 0L;
  }
  long handle = 0L;
  status = obr::nas::open("/boot/root", 0L, &handle);
  if (status != 0L) {
    return 0L;
  }
  long got = 0L;
  status = obr::nas::read(handle, 0L, scratch() + 64L, 3L, &got);
  obr::nas::close(handle);
  if (status != 0L || got != 3L) {
    return 0L;
  }
  if (memory::loadOctet(scratch() + 64L) != 109L) {
    return 0L;
  }
  if (memory::loadOctet(scratch() + 72L) != 101L) {
    return 0L;
  }
  if (memory::loadOctet(scratch() + 80L) != 109L) {
    return 0L;
  }
  return 1L;
}

deRfun vfsInit(): void {
  long index = 0L;
  while (index < inodeCount()) {
    Inode* node = inodeAt(index);
    node.used = 0L;
    node.kind = 0L;
    node.mode = 0L;
    node.uid = 0L;
    node.gid = 0L;
    node.size = 0L;
    node.parent = 0L;
    node.nlink = 0L;
    node.atime = 0L;
    node.mtime = 0L;
    node.ctime = 0L;
    memory::store64(-1L, memSlotAt(index));
    Dentry* dent = dentryAt(index);
    dent.used = 0L;
    dent.parent = -1L;
    dent.ino = 0L;
    dent.nameLen = 0L;
    index = index + 1L;
  }
  while (index < dentryCount()) {
    Dentry* dent = dentryAt(index);
    dent.used = 0L;
    dent.parent = -1L;
    dent.ino = 0L;
    dent.nameLen = 0L;
    index = index + 1L;
  }
  index = 0L;
  while (index < fileCount()) {
    File* file = fileAt(index);
    file.used = 0L;
    file.ino = 0L;
    file.offset = 0L;
    file.flags = 0L;
    file.handle = 0L;
    index = index + 1L;
  }
  index = 0L;
  while (index < pipeCount()) {
    Pipe* pipe = pipeAt(index);
    pipe.used = 0L;
    pipe.readers = 0L;
    pipe.writers = 0L;
    pipe.head = 0L;
    pipe.count = 0L;
    pipe.readWait = -1L;
    pipe.writeWait = -1L;
    index = index + 1L;
  }
  Inode* root = inodeAt(0L);
  root.used = 1L;
  root.kind = 2L;
  root.mode = modeDir();
  root.uid = 0L;
  root.gid = 0L;
  root.nlink = 1L;
  if (memoryRoot() == 1L) {
    root.kind = 6L;
  }
  stampCreate(root);
  Dentry* top = dentryAt(0L);
  top.used = 1L;
  top.parent = -1L;
  top.ino = 0L;
  index = 0L;
  while (index < devCount()) {
    Dev* dev = devAt(index);
    dev.used = 0L;
    dev.pid = 0L;
    dev.userReadWait = -1L;
    dev.userWriteWait = -1L;
    dev.drvRecvWait = -1L;
    dev.drvSendWait = -1L;
    index = index + 1L;
  }
  scratchClear();
  scratchPush(100L);
  scratchPush(101L);
  scratchPush(118L);
  takeChild(0L, scratch(), 0L, 3L, 4L, 0L, 0L, 0L, modeDir());
  scratchClear();
}

deRfun classBits(long mode, long which): long {
  if (which == 0L) {
    return (mode / 64L) % 8L;
  }
  if (which == 1L) {
    return (mode / 8L) % 8L;
  }
  return mode % 8L;
}

deRfun bitOk(long have, long want, long bit): long {
  if (want / bit % 2L == 1L && have / bit % 2L != 1L) {
    return 0L;
  }
  return 1L;
}

/* want：1 执行，2 写，4 读。根直接通过。其余按属主、同组、其他人取 3 位。 */
deRfun may(long taskIndex, long ino, long want): long {
  Task* task = taskAt(taskIndex);
  Inode* node = inodeAt(ino);
  if (node.used == 0L) {
    return 0L;
  }
  if (task.cred.euid == 0L) {
    return 1L;
  }
  long which = 2L;
  if (task.cred.euid == node.uid) {
    which = 0L;
  } else if (task.cred.egid == node.gid) {
    which = 1L;
  }
  long have = classBits(node.mode, which);
  if (bitOk(have, want, 4L) == 0L || bitOk(have, want, 2L) == 0L || bitOk(have, want, 1L) == 0L) {
    return 0L;
  }
  return 1L;
}

deRfun nameEq(long dent, long path, long from, long count): long {
  Dentry* entry = dentryAt(dent);
  if (entry.nameLen != count) {
    return 0L;
  }
  long index = 0L;
  while (index < count) {
    long left = memory::loadOctet(nameAt(dent) + index * 8L);
    if (left != octetAt(path, from + index)) {
      return 0L;
    }
    index = index + 1L;
  }
  return 1L;
}

deRfun findChild(long parent, long path, long from, long count): long {
  if (count == 1L && octetAt(path, from) == 46L) {
    return parent;
  }
  if (count == 2L && octetAt(path, from) == 46L && octetAt(path, from + 1L) == 46L) {
    long up = dentryAt(parent).parent;
    if (up < 0L) {
      return 0L;
    }
    return up;
  }
  long index = 1L;
  while (index < dentryCount()) {
    Dentry* entry = dentryAt(index);
    if (entry.used == 1L && entry.parent == parent && nameEq(index, path, from, count) == 1L) {
      return index;
    }
    index = index + 1L;
  }
  return -1L;
}

deRfun pathOf(long dent): long {
  scratchClear();
  long status = scratchPush(47L);
  if (dent == 0L || status != 0L) {
    return status;
  }
  long depth = 0L;
  long cursor = dent;
  while (cursor > 0L && depth < pathDepth()) {
    memory::store64(cursor, stackAt() + depth * 64L);
    depth = depth + 1L;
    cursor = dentryAt(cursor).parent;
  }
  if (cursor > 0L) {
    return 7L;
  }
  long index = depth - 1L;
  long first = 1L;
  while (index >= 0L && status == 0L) {
    if (first == 0L) {
      status = scratchPush(47L);
    }
    first = 0L;
    long item = memory::load64(stackAt() + index * 64L);
    long count = dentryAt(item).nameLen;
    long step = 0L;
    while (step < count && status == 0L) {
      status = scratchPush(memory::loadOctet(nameAt(item) + step * 8L));
      step = step + 1L;
    }
    index = index - 1L;
  }
  return status;
}

deRfun scratchAdd(long path, long from, long count): long {
  long at = scratch();
  long have = memory::load64(at);
  long status = 0L;
  if (have > 1L) {
    status = scratchPush(47L);
  }
  long index = 0L;
  while (index < count && status == 0L) {
    status = scratchPush(octetAt(path, from + index));
    index = index + 1L;
  }
  return status;
}

deRfun copyName(long dent, long path, long from, long count): void {
  long index = 0L;
  while (index < count) {
    long value = octetAt(path, from + index);
    memory::storeOctet(value, nameAt(dent) + index * 8L);
    index = index + 1L;
  }
  dentryAt(dent).nameLen = count;
}

deRfun allocInode(): long {
  long index = 1L;
  while (index < inodeCount()) {
    if (inodeAt(index).used == 0L) {
      return index;
    }
    index = index + 1L;
  }
  return -1L;
}

deRfun allocDentry(): long {
  long index = 1L;
  while (index < dentryCount()) {
    if (dentryAt(index).used == 0L) {
      return index;
    }
    index = index + 1L;
  }
  return -1L;
}

deRfun fillNode(long ino, long parent, long kind, long mode, long uid, long gid, long size): void {
  Inode* node = inodeAt(ino);
  node.used = 1L;
  node.kind = kind;
  node.mode = mode;
  node.uid = uid;
  node.gid = gid;
  node.size = size;
  node.parent = parent;
  node.nlink = 1L;
  stampCreate(node);
}

deRfun takeChild(long parent, long path, long from, long count, long kind, long size, long uid, long gid, long mode): long {
  long ino = allocInode();
  long dent = allocDentry();
  if (ino < 0L || dent < 0L) {
    return -1L;
  }
  long parentIno = dentryAt(parent).ino;
  fillNode(ino, parentIno, kind, mode, uid, gid, size);
  Dentry* entry = dentryAt(dent);
  entry.used = 1L;
  entry.parent = parent;
  entry.ino = ino;
  copyName(dent, path, from, count);
  return dent;
}

/* 目录项里没有时向 NAS 要。没有这个路径时返回 2。成功时 *out 是目录项编号。 */
deRfun attachChild(long parent, long path, long from, long count, long* out): long {
  long built = pathOf(parent);
  if (built != 0L) {
    return built;
  }
  built = scratchAdd(path, from, count);
  if (built != 0L) {
    return built;
  }
  long kind = 0L;
  long size = 0L;
  long status = obr::nas::statAt(scratch(), &kind, &size);
  if (status != 0L) {
    return status;
  }
  long mode = modeFile();
  if (kind == 2L) {
    mode = modeDir();
  }
  long dent = takeChild(parent, path, from, count, kind, size, 0L, 0L, mode);
  if (dent < 0L) {
    return 7L;
  }
  *out = dent;
  return 0L;
}

deRfun resolve(long parent, long path, long from, long count, long* out): long {
  long child = findChild(parent, path, from, count);
  if (child >= 0L) {
    *out = child;
    return 0L;
  }
  long parentKind = inodeAt(dentryAt(parent).ino).kind;
  if (parentKind == 4L || parentKind == 6L) {
    return 2L;
  }
  return attachChild(parent, path, from, count, out);
}

/* 走到最后一段之前。*from 与 *count 是最后一段；count 为 0 表示路径就是当前目录。 */
deRfun walkParent(long taskIndex, long path, long* parent, long* from, long* count): long {
  long len = memory::load64(path);
  if (len < 1L || len > scratchRoom()) {
    return 6L;
  }
  long dent = 0L;
  long index = 0L;
  if (octetAt(path, 0L) != 47L) {
    dent = taskAt(taskIndex).cwd;
  } else {
    index = 1L;
  }
  long lastFrom = 0L;
  long lastCount = 0L;
  long seen = 0L;
  while (index < len) {
    while (index < len && octetAt(path, index) == 47L) {
      index = index + 1L;
    }
    if (index >= len) {
      break;
    }
    long start = index;
    while (index < len && octetAt(path, index) != 47L) {
      index = index + 1L;
    }
    long span = index - start;
    if (span > 512L) {
      return 6L;
    }
    if (seen == 1L) {
      if (may(taskIndex, dentryAt(dent).ino, 1L) == 0L) {
        return -1L;
      }
      long next = 0L;
      long status = resolve(dent, path, lastFrom, lastCount, &next);
      if (status != 0L) {
        return status;
      }
      dent = next;
    }
    lastFrom = start;
    lastCount = span;
    seen = 1L;
  }
  if (seen == 1L && may(taskIndex, dentryAt(dent).ino, 1L) == 0L) {
    return -1L;
  }
  *parent = dent;
  *from = lastFrom;
  *count = lastCount;
  return 0L;
}

/* 请求路径在调用者窗口 +16384，整段最长 8192 个八位组，一个分量最长 512。 */
deRfun walk(long taskIndex, long path, long* out): long {
  long parent = 0L;
  long from = 0L;
  long count = 0L;
  long status = walkParent(taskIndex, path, &parent, &from, &count);
  if (status != 0L) {
    return status;
  }
  if (count == 0L) {
    *out = parent;
    return 0L;
  }
  return resolve(parent, path, from, count, out);
}

deRfun slotOf(long taskIndex, long fd): long {
  if (fd < 0L || fd > 7L || taskIndex < 0L) {
    return -1L;
  }
  return taskIndex * 8L + fd;
}

deRfun allocFd(long taskIndex): long {
  long fd = 0L;
  while (fd < 8L) {
    if (fileAt(slotOf(taskIndex, fd)).used == 0L) {
      return fd;
    }
    fd = fd + 1L;
  }
  return -1L;
}

deRfun vfsForgetTask(long taskIndex): void {
  if (taskIndex < 0L) {
    return;
  }
  long fd = 0L;
  while (fd < 8L) {
    long slot = slotOf(taskIndex, fd);
    /* 占用的格和 close 走同一条释放，复制过的句柄只在最后一格真正关闭。
       空格仍把句柄写成 0，丢掉任务时和以前一样。 */
    if (fileAt(slot).used == 1L) {
      releaseFd(taskIndex, fd);
    } else {
      File* file = fileAt(slot);
      file.used = 0L;
      file.handle = 0L;
    }
    fd = fd + 1L;
  }
}

deRfun vfsForget(long core): void {
  vfsForgetTask(taskFind(core));
}

deRfun dropDent(long dent): void {
  if (dent <= 0L) {
    return;
  }
  Dentry* entry = dentryAt(dent);
  long ino = entry.ino;
  entry.used = 0L;
  entry.nameLen = 0L;
  long fd = 0L;
  while (fd < fileCount()) {
    if (fileAt(fd).used == 1L && fileAt(fd).ino == ino) {
      return;
    }
    fd = fd + 1L;
  }
  inodeAt(ino).used = 0L;
  if (inodeAt(ino).kind == 5L) {
    memDrop(ino);
  }
}

deRfun wantOf(long flags): long {
  if (flags == 0L) {
    return 4L;
  }
  if (flags == 2L) {
    return 6L;
  }
  return 2L;
}

deRfun nasBusy(): long {
  return 0L;
}

deRfun pipeShut(long index, long flags): void {
  Pipe* pipe = pipeAt(index);
  if (flags == 0L && pipe.readers > 0L) {
    pipe.readers = pipe.readers - 1L;
  }
  if (flags != 0L && pipe.writers > 0L) {
    pipe.writers = pipe.writers - 1L;
  }
  if (pipe.readers > 0L || pipe.writers > 0L) {
    pipeFinish(index);
  }
  if (pipe.writers == 0L && pipe.readWait >= 0L && pipe.count == 0L) {
    long waiter = pipe.readWait;
    pipe.readWait = -1L;
    memory::store64(0L, query(1L, 8L, waiter) + 320L);
    reply(waiter, 0L);
  }
  if (pipe.readers == 0L && pipe.writeWait >= 0L) {
    long waiter = pipe.writeWait;
    pipe.writeWait = -1L;
    reply(waiter, 5L);
  }
  if (pipe.readers == 0L && pipe.writers == 0L) {
    pipe.used = 0L;
    pipe.count = 0L;
    pipe.readWait = -1L;
    pipe.writeWait = -1L;
  }
}

/* 又有一个描述符握住这条管道端。关闭只减一份，最后一份才把端拆掉。 */
deRfun pipeHold(long index, long flags): void {
  Pipe* pipe = pipeAt(index);
  if (flags == 0L) {
    pipe.readers = pipe.readers + 1L;
  }
  if (flags != 0L) {
    pipe.writers = pipe.writers + 1L;
  }
}

/* 把已经堵在这条管道上的另一端放行。读端要有字节才醒，写端要有空位才醒。 */
deRfun pipeFinish(long slot): void {
  long pass = 0L;
  while (pass < 2L) {
    Pipe* pipe = pipeAt(slot);
    if (pipe.readWait >= 0L && pipe.count > 0L) {
      long waiter = pipe.readWait;
      pipe.readWait = -1L;
      long home = query(1L, 8L, waiter);
      long count = memory::load64(home + 256L);
      long got = 0L;
      while (got < count && pipe.count > 0L) {
        long value = memory::loadOctet(pipeData(slot) + pipe.head * 8L);
        memory::storeOctet(value, byteAt(home) + got * 8L);
        pipe.head = pipe.head + 1L;
        if (pipe.head == pipeRoom()) {
          pipe.head = 0L;
        }
        pipe.count = pipe.count - 1L;
        got = got + 1L;
      }
      memory::store64(got, home + 320L);
      reply(waiter, 0L);
    }
    pipe = pipeAt(slot);
    if (pipe.writeWait >= 0L && pipe.count < pipeRoom() && pipe.readers > 0L) {
      long waiter = pipe.writeWait;
      pipe.writeWait = -1L;
      long home = query(1L, 8L, waiter);
      long count = memory::load64(home + 256L);
      long got = 0L;
      while (got < count && pipe.count < pipeRoom()) {
        long value = memory::loadOctet(byteAt(home) + got * 8L);
        long at = pipe.head + pipe.count;
        if (at >= pipeRoom()) {
          at = at - pipeRoom();
        }
        memory::storeOctet(value, pipeData(slot) + at * 8L);
        pipe.count = pipe.count + 1L;
        got = got + 1L;
      }
      memory::store64(got, home + 320L);
      reply(waiter, 0L);
    }
    pass = pass + 1L;
  }
}

deRfun pipeCopy(File* file, long home, long writing, long caller): long {
  Pipe* pipe = pipeAt(file.handle);
  if (pipe.used == 0L) {
    return 5L;
  }
  long count = memory::load64(home + 256L);
  if (count < 0L) {
    return 13L;
  }
  long got = 0L;
  if (writing == 0L) {
    while (got < count && pipe.count > 0L) {
      long value = memory::loadOctet(pipeData(file.handle) + pipe.head * 8L);
      memory::storeOctet(value, byteAt(home) + got * 8L);
      pipe.head = pipe.head + 1L;
      if (pipe.head == pipeRoom()) {
        pipe.head = 0L;
      }
      pipe.count = pipe.count - 1L;
      got = got + 1L;
    }
  } else {
    if (pipe.readers == 0L) {
      return 5L;
    }
    while (got < count && pipe.count < pipeRoom()) {
      long value = memory::loadOctet(byteAt(home) + got * 8L);
      long at = pipe.head + pipe.count;
      if (at >= pipeRoom()) {
        at = at - pipeRoom();
      }
      memory::storeOctet(value, pipeData(file.handle) + at * 8L);
      pipe.count = pipe.count + 1L;
      got = got + 1L;
    }
  }
  memory::store64(got, home + 320L);
  pipeFinish(file.handle);
  if (writing == 0L && got == 0L && pipeAt(file.handle).writers > 0L) {
    if (pipeAt(file.handle).readWait >= 0L) {
      return 11L;
    }
    pipeAt(file.handle).readWait = caller;
    schedSleep(caller);
    return -2L;
  }
  if (writing == 1L && got == 0L && count > 0L && pipeAt(file.handle).readers > 0L) {
    if (pipeAt(file.handle).writeWait >= 0L) {
      return 11L;
    }
    pipeAt(file.handle).writeWait = caller;
    schedSleep(caller);
    return -2L;
  }
  return 0L;
}

deRfun doPipe(long caller, long home): long {
  long taskIndex = taskFind(caller);
  long slot = 0L;
  while (slot < pipeCount() && pipeAt(slot).used == 1L) {
    slot = slot + 1L;
  }
  if (slot >= pipeCount()) {
    return 7L;
  }
  long readFd = allocFd(taskIndex);
  if (readFd < 0L) {
    return 7L;
  }
  File* reading = fileAt(slotOf(taskIndex, readFd));
  reading.used = 1L;
  long writeFd = allocFd(taskIndex);
  if (writeFd < 0L) {
    reading.used = 0L;
    return 7L;
  }
  Pipe* pipe = pipeAt(slot);
  pipe.used = 1L;
  pipe.readers = 1L;
  pipe.writers = 1L;
  pipe.head = 0L;
  pipe.count = 0L;
  pipe.readWait = -1L;
  pipe.writeWait = -1L;
  reading.ino = -1L;
  reading.offset = 0L;
  reading.flags = 0L;
  reading.handle = slot;
  File* writing = fileAt(slotOf(taskIndex, writeFd));
  writing.used = 1L;
  writing.ino = -1L;
  writing.offset = 0L;
  writing.flags = 1L;
  writing.handle = slot;
  memory::store64(readFd, home + 128L);
  memory::store64(writeFd, home + 192L);
  return 0L;
}

deRfun vfsPrepare(long caller, long path): long {
  long taskIndex = taskFind(caller);
  if (taskIndex < 0L) {
    return -1L;
  }
  long dent = 0L;
  long status = walk(taskIndex, path, &dent);
  if (status != 0L) {
    return status;
  }
  long ino = dentryAt(dent).ino;
  if (inodeAt(ino).kind != 1L && inodeAt(ino).kind != 5L) {
    return 4L;
  }
  if (may(taskIndex, ino, 1L) == 0L) {
    return -1L;
  }
  return pathOf(dent);
}

/* 子任务的描述符表一开始是空的。这里按号抄过去，管道和 NAS 句柄各多记一份。 */
deRfun vfsHand(long fromTask, long toTask): void {
  if (fromTask < 0L || toTask < 0L || fromTask == toTask) {
    return;
  }
  long fd = 0L;
  while (fd < 8L) {
    long fromSlot = slotOf(fromTask, fd);
    if (fileAt(fromSlot).used == 1L) {
      shareFd(fromSlot, slotOf(toTask, fd));
    }
    fd = fd + 1L;
  }
}

/* 只抄种类 5。正文按八位组放到 dest，相邻隔 8 位，和 NAS 读进暂存的排法一样。 */
deRfun vfsPlant(long caller, long path, long dest, long* size): long {
  long taskIndex = taskFind(caller);
  long dent = 0L;
  long status = walk(taskIndex, path, &dent);
  if (status != 0L) {
    return status;
  }
  long ino = dentryAt(dent).ino;
  Inode* node = inodeAt(ino);
  if (node.kind != 5L) {
    return 1L;
  }
  if (node.size < 1L || node.size > memCap()) {
    return 4L;
  }
  long slot = memory::load64(memSlotAt(ino));
  if (slot < 0L || slot >= memSlots()) {
    return 5L;
  }
  long index = 0L;
  while (index < node.size) {
    long value = memory::loadOctet(memBody(slot) + index * 8L);
    memory::storeOctet(value, dest + index * 8L);
    index = index + 1L;
  }
  *size = node.size;
  stampAccess(node);
  return 0L;
}

deRfun doStat(long caller, long home): long {
  long dent = 0L;
  long status = walk(taskFind(caller), home + 16384L, &dent);
  if (status != 0L) {
    return status;
  }
  Inode* node = inodeAt(dentryAt(dent).ino);
  memory::store64(node.kind, home + 128L);
  memory::store64(node.size, home + 192L);
  memory::store64(node.mode, home + 256L);
  memory::store64(node.uid, home + 320L);
  memory::store64(node.gid, home + 384L);
  memory::store64(node.atime, home + 448L);
  memory::store64(node.mtime, home + 576L);
  memory::store64(node.ctime, home + 640L);
  return 0L;
}

deRfun doOpen(long caller, long home): long {
  long taskIndex = taskFind(caller);
  long parent = 0L;
  long from = 0L;
  long count = 0L;
  long status = walkParent(taskIndex, home + 16384L, &parent, &from, &count);
  if (status != 0L) {
    return status;
  }
  long flags = memory::load64(home + 128L);
  if (flags < 0L || flags > 3L || count == 0L) {
    return 13L;
  }
  long dent = 0L;
  status = resolve(parent, home + 16384L, from, count, &dent);
  if (status == 2L && flags != 0L) {
    if (inodeAt(dentryAt(parent).ino).kind == 4L) {
      return 2L;
    }
    if (may(taskIndex, dentryAt(parent).ino, 3L) == 0L) {
      return -1L;
    }
    if (inodeAt(dentryAt(parent).ino).kind == 6L) {
      long slot = memTake();
      if (slot < 0L) {
        return 7L;
      }
      Task* made = taskAt(taskIndex);
      dent = takeChild(parent, home + 16384L, from, count, 5L, 0L, made.cred.euid, made.cred.egid, modeFile());
      if (dent < 0L) {
        return 7L;
      }
      memory::store64(slot, memSlotAt(dentryAt(dent).ino));
      long fresh = allocFd(taskIndex);
      if (fresh < 0L) {
        dropDent(dent);
        return 7L;
      }
      File* madeFile = fileAt(slotOf(taskIndex, fresh));
      madeFile.used = 1L;
      madeFile.ino = dentryAt(dent).ino;
      madeFile.offset = 0L;
      madeFile.flags = flags;
      madeFile.handle = slot;
      memory::store64(fresh, home + 192L);
      return 0L;
    }
    long built = pathOf(parent);
    if (built != 0L) {
      return built;
    }
    built = scratchAdd(home + 16384L, from, count);
    if (built != 0L) {
      return built;
    }
    long handle = 0L;
    status = obr::nas::openAt(scratch(), flags, &handle);
    if (status != 0L) {
      return status;
    }
    Task* task = taskAt(taskIndex);
    dent = takeChild(parent, home + 16384L, from, count, 1L, 0L, task.cred.euid, task.cred.egid, modeFile());
    if (dent < 0L) {
      obr::nas::close(handle);
      return 7L;
    }
    long fd = allocFd(taskIndex);
    if (fd < 0L) {
      obr::nas::close(handle);
      dropDent(dent);
      return 7L;
    }
    File* file = fileAt(slotOf(taskIndex, fd));
    file.used = 1L;
    file.ino = dentryAt(dent).ino;
    file.offset = 0L;
    file.flags = flags;
    file.handle = handle;
    memory::store64(fd, home + 192L);
    return 0L;
  }
  if (status != 0L) {
    return status;
  }
  Inode* node = inodeAt(dentryAt(dent).ino);
  if (isDir(node.kind) == 1L) {
    return 4L;
  }
  if (node.kind == 3L) {
    if (flags == 3L) {
      return 13L;
    }
    if (may(taskIndex, dentryAt(dent).ino, wantOf(flags)) == 0L) {
      return -1L;
    }
    long slot = 0L;
    while (slot < devCount() && (devAt(slot).used == 0L || devAt(slot).ino != dentryAt(dent).ino)) {
      slot = slot + 1L;
    }
    if (slot >= devCount()) {
      return 5L;
    }
    long fd = allocFd(taskIndex);
    if (fd < 0L) {
      return 7L;
    }
    File* opened = fileAt(slotOf(taskIndex, fd));
    opened.used = 1L;
    opened.ino = dentryAt(dent).ino;
    opened.offset = 0L;
    opened.flags = flags;
    opened.handle = slot;
    memory::store64(fd, home + 192L);
    return 0L;
  }
  if (may(taskIndex, dentryAt(dent).ino, wantOf(flags)) == 0L) {
    return -1L;
  }
  if (node.kind == 5L) {
    if (flags == 1L) {
      node.size = 0L;
      stampWrite(node);
    }
    long fd = allocFd(taskIndex);
    if (fd < 0L) {
      return 7L;
    }
    long body = memory::load64(memSlotAt(dentryAt(dent).ino));
    File* kept = fileAt(slotOf(taskIndex, fd));
    kept.used = 1L;
    kept.ino = dentryAt(dent).ino;
    kept.offset = 0L;
    kept.flags = flags;
    kept.handle = body;
    memory::store64(fd, home + 192L);
    return 0L;
  }
  long built = pathOf(dent);
  if (built != 0L) {
    return built;
  }
  long handle = 0L;
  status = obr::nas::openAt(scratch(), flags, &handle);
  if (status != 0L) {
    return status;
  }
  if (flags == 1L) {
    node.size = 0L;
    stampWrite(node);
  }
  long fd = allocFd(taskIndex);
  if (fd < 0L) {
    obr::nas::close(handle);
    return 7L;
  }
  File* file = fileAt(slotOf(taskIndex, fd));
  file.used = 1L;
  file.ino = dentryAt(dent).ino;
  file.offset = 0L;
  file.flags = flags;
  file.handle = handle;
  memory::store64(fd, home + 192L);
  return 0L;
}

/* 这个 NAS 句柄是否还被别的普通文件描述符握着。skip 是正要关掉的那一格，它还标着占用，不能把自己算进去。
   设备槽号和句柄都是小整数，数值碰巧相同也不算同一份打开。管道的索引节点号是负的，进不了这里。 */
deRfun nasHeld(long handle, long skip): long {
  long index = 0L;
  while (index < fileCount()) {
    if (index != skip) {
      File* other = fileAt(index);
      if (other.used == 1L && other.ino >= 0L && other.handle == handle) {
        long otherKind = inodeAt(other.ino).kind;
        if (otherKind != 3L && otherKind != 5L) {
          return 1L;
        }
      }
    }
    index = index + 1L;
  }
  return 0L;
}

/* 关掉任务里的一个描述符。管道按端上的计数减一。设备只放下这一格，设备本身还在。
   普通文件要等没有别的描述符还握着同一个 NAS 句柄，才向 NAS 关闭。先关再清这一格，单独打开时和原来的 close 一样。
   号码不在 0 到 7，或这一格是空的，回复 5。 */
deRfun releaseFd(long taskIndex, long fd): long {
  long slot = slotOf(taskIndex, fd);
  if (slot < 0L) {
    return 5L;
  }
  if (fileAt(slot).used == 0L) {
    return 5L;
  }
  long ino = fileAt(slot).ino;
  long flags = fileAt(slot).flags;
  long handle = fileAt(slot).handle;
  if (ino < 0L) {
    pipeShut(handle, flags);
    File* file = fileAt(slot);
    file.used = 0L;
    file.handle = 0L;
    return 0L;
  }
  if (inodeAt(ino).kind == 3L) {
    File* file = fileAt(slot);
    file.used = 0L;
    file.handle = 0L;
    return 0L;
  }
  long status = 0L;
  long kind = inodeAt(ino).kind;
  if (kind != 5L && handle != 0L && nasHeld(handle, slot) == 0L) {
    status = obr::nas::close(handle);
  }
  File* file = fileAt(slot);
  file.used = 0L;
  file.handle = 0L;
  long still = 0L;
  long index = 0L;
  while (index < fileCount()) {
    if (fileAt(index).used == 1L && fileAt(index).ino == ino) {
      still = 1L;
    }
    index = index + 1L;
  }
  if (still == 0L) {
    long dent = 1L;
    long live = 0L;
    while (dent < dentryCount()) {
      if (dentryAt(dent).used == 1L && dentryAt(dent).ino == ino) {
        live = 1L;
      }
      dent = dent + 1L;
    }
    if (live == 0L) {
      if (kind == 5L) {
        memDrop(ino);
      }
      inodeAt(ino).used = 0L;
    }
  }
  return status;
}

deRfun doClose(long caller, long home): long {
  return releaseFd(taskFind(caller), memory::load64(home + 128L));
}

/* 新格记下同一份打开对象，不向 NAS 再要句柄。文件共用句柄，管道多记一份读者或写者，设备仍指着原来的槽。
   同一格再记一份会把管道计数加错，直接留下。 */
deRfun shareFd(long fromSlot, long toSlot): void {
  if (fromSlot == toSlot) {
    return;
  }
  File* from = fileAt(fromSlot);
  long ino = from.ino;
  long offset = from.offset;
  long flags = from.flags;
  long handle = from.handle;
  File* into = fileAt(toSlot);
  into.used = 1L;
  into.ino = ino;
  into.offset = offset;
  into.flags = flags;
  into.handle = handle;
  if (ino < 0L) {
    pipeHold(handle, flags);
  }
}

/* 24。新描述符是该任务最小的空位。没有空位回复 7，和打开、管道用尽同一号。旧的不存在回复 -1。 */
deRfun doDup(long caller, long home): long {
  long taskIndex = taskFind(caller);
  long fd = memory::load64(home + 128L);
  long slot = slotOf(taskIndex, fd);
  if (slot < 0L) {
    return -1L;
  }
  if (fileAt(slot).used == 0L) {
    return -1L;
  }
  long fresh = allocFd(taskIndex);
  if (fresh < 0L) {
    return 7L;
  }
  shareFd(slot, slotOf(taskIndex, fresh));
  memory::store64(fresh, home + 192L);
  return 0L;
}

/* 25。目标不在 0 到 7 回复 -1。两个号码相同则什么也不做，这一格开没开都不关。
   旧的不存在也回复 -1，并且不去关目标，避免把还要用的描述符拆掉。
   目标已经打开就先按 close 释放。释放得到非 0 时把这个状态交回去，目标不再占用。 */
deRfun doDup2(long caller, long home): long {
  long taskIndex = taskFind(caller);
  long from = memory::load64(home + 128L);
  long to = memory::load64(home + 192L);
  if (to < 0L || to > 7L) {
    return -1L;
  }
  if (from == to) {
    return 0L;
  }
  long fromSlot = slotOf(taskIndex, from);
  if (fromSlot < 0L || fileAt(fromSlot).used == 0L) {
    return -1L;
  }
  long toSlot = slotOf(taskIndex, to);
  if (fileAt(toSlot).used == 1L) {
    long closed = releaseFd(taskIndex, to);
    if (closed != 0L) {
      return closed;
    }
  }
  shareFd(fromSlot, toSlot);
  return 0L;
}

deRfun doRead(long caller, long home, long writing): long {
  long taskIndex = taskFind(caller);
  long fd = memory::load64(home + 128L);
  long slot = slotOf(taskIndex, fd);
  if (slot < 0L) {
    return 5L;
  }
  File* file = fileAt(slot);
  /* 1 号的第一行不依赖打开。描述符还没挂上时，写就直接画到控制台。 */
  if (file.used == 0L) {
    if (writing == 1L && taskIndex >= 0L && taskAt(taskIndex).pid == 1L) {
      conEmit(home);
      return 0L;
    }
    return 5L;
  }
  if (file.ino < 0L) {
    if (writing == 0L && file.flags != 0L) {
      return -1L;
    }
    if (writing == 1L && file.flags == 0L) {
      return -1L;
    }
    return pipeCopy(file, home, writing, caller);
  }
  if (inodeAt(file.ino).kind == 3L) {
    if (writing == 0L && file.flags != 0L && file.flags != 2L) {
      return -1L;
    }
    if (writing == 1L && file.flags == 0L) {
      return -1L;
    }
    /* 监督核上的控制台。写进格子，读不到字节就睡到键盘送来。 */
    if (devAt(file.handle).core == 2L) {
      if (writing == 0L) {
        long pulled = conPull(caller, home);
        if (pulled == -2L) {
          schedSleep(caller);
        }
        return pulled;
      }
      conEmit(home);
      stampWrite(inodeAt(file.ino));
      return 0L;
    }
    if (writing == 0L) {
      return devMove(file.handle, home, 0L, 0L, caller, 1L);
    }
    long wrote = devMove(file.handle, home, 1L, 1L, caller, 2L);
    if (wrote == 0L) {
      stampWrite(inodeAt(file.ino));
    }
    return wrote;
  }
  if (writing == 0L && file.flags != 0L && file.flags != 2L) {
    return -1L;
  }
  if (writing == 1L && file.flags == 0L) {
    return -1L;
  }
  if (inodeAt(file.ino).kind == 5L) {
    long moved = memMove(file, home, writing);
    if (moved == 0L) {
      if (writing == 1L) {
        stampWrite(inodeAt(file.ino));
      } else {
        stampAccess(inodeAt(file.ino));
      }
    }
    return moved;
  }
  long offset = memory::load64(home + 192L);
  long count = memory::load64(home + 256L);
  if (count > byteRoom()) {
    return 7L;
  }
  long got = 0L;
  long status = 0L;
  if (writing == 0L) {
    status = obr::nas::read(file.handle, offset, byteAt(home), count, &got);
  } else {
    status = obr::nas::write(file.handle, offset, byteAt(home), count, &got);
  }
  if (status != 0L) {
    return status;
  }
  file.offset = offset + got;
  if (writing == 1L) {
    Inode* node = inodeAt(file.ino);
    if (offset + got > node.size) {
      node.size = offset + got;
    }
    stampWrite(node);
  } else {
    stampAccess(inodeAt(file.ino));
  }
  memory::store64(got, home + 320L);
  return 0L;
}

deRfun doReaddir(long caller, long home): long {
  long taskIndex = taskFind(caller);
  long dent = 0L;
  long status = walk(taskIndex, home + 16384L, &dent);
  if (status != 0L) {
    return status;
  }
  Inode* node = inodeAt(dentryAt(dent).ino);
  if (isDir(node.kind) == 0L) {
    return 3L;
  }
  if (may(taskIndex, dentryAt(dent).ino, 5L) == 0L) {
    return -1L;
  }
  if (node.kind == 4L || node.kind == 6L) {
    return devList(dent, home);
  }
  status = pathOf(dent);
  if (status != 0L) {
    return status;
  }
  long got = 0L;
  status = obr::nas::readdirAt(scratch(), memory::load64(home + 128L), byteAt(home), memory::load64(home + 192L), &got);
  if (status != 0L) {
    return status;
  }
  memory::store64(got, home + 256L);
  return 0L;
}

deRfun doMkdir(long caller, long home): long {
  long taskIndex = taskFind(caller);
  long parent = 0L;
  long from = 0L;
  long count = 0L;
  long status = walkParent(taskIndex, home + 16384L, &parent, &from, &count);
  if (status != 0L) {
    return status;
  }
  if (count == 0L) {
    return 11L;
  }
  if (inodeAt(dentryAt(parent).ino).kind == 6L) {
    if (findChild(parent, home + 16384L, from, count) >= 0L) {
      return 11L;
    }
    if (may(taskIndex, dentryAt(parent).ino, 3L) == 0L) {
      return -1L;
    }
    Task* task = taskAt(taskIndex);
    long dent = takeChild(parent, home + 16384L, from, count, 6L, 0L, task.cred.euid, task.cred.egid, modeDir());
    if (dent < 0L) {
      return 7L;
    }
    return 0L;
  }
  if (inodeAt(dentryAt(parent).ino).kind == 4L) {
    return 13L;
  }
  if (findChild(parent, home + 16384L, from, count) >= 0L) {
    return 11L;
  }
  if (may(taskIndex, dentryAt(parent).ino, 3L) == 0L) {
    return -1L;
  }
  status = pathOf(parent);
  if (status != 0L) {
    return status;
  }
  status = scratchAdd(home + 16384L, from, count);
  if (status != 0L) {
    return status;
  }
  status = obr::nas::mkdirAt(scratch());
  if (status != 0L) {
    return status;
  }
  Task* task = taskAt(taskIndex);
  long dent = takeChild(parent, home + 16384L, from, count, 2L, 0L, task.cred.euid, task.cred.egid, modeDir());
  if (dent < 0L) {
    return 7L;
  }
  return 0L;
}

deRfun doUnlink(long caller, long home): long {
  long taskIndex = taskFind(caller);
  long parent = 0L;
  long from = 0L;
  long count = 0L;
  long status = walkParent(taskIndex, home + 16384L, &parent, &from, &count);
  if (status != 0L) {
    return status;
  }
  if (count == 0L) {
    return 13L;
  }
  if (may(taskIndex, dentryAt(parent).ino, 3L) == 0L) {
    return -1L;
  }
  long dent = 0L;
  status = resolve(parent, home + 16384L, from, count, &dent);
  if (status != 0L) {
    return status;
  }
  if (inodeAt(dentryAt(dent).ino).kind == 4L) {
    return 3L;
  }
  if (inodeAt(dentryAt(dent).ino).kind == 6L) {
    long child = 1L;
    while (child < dentryCount()) {
      if (dentryAt(child).used == 1L && dentryAt(child).parent == dent) {
        return 11L;
      }
      child = child + 1L;
    }
    dropDent(dent);
    return 0L;
  }
  if (inodeAt(dentryAt(dent).ino).kind == 5L) {
    dropDent(dent);
    return 0L;
  }
  if (inodeAt(dentryAt(dent).ino).kind == 3L) {
    dropDent(dent);
    return 0L;
  }
  status = pathOf(dent);
  if (status != 0L) {
    return status;
  }
  status = obr::nas::unlinkAt(scratch());
  if (status != 0L) {
    return status;
  }
  dropDent(dent);
  return 0L;
}

deRfun doChmod(long caller, long home): long {
  long taskIndex = taskFind(caller);
  long dent = 0L;
  long status = walk(taskIndex, home + 16384L, &dent);
  if (status != 0L) {
    return status;
  }
  Inode* node = inodeAt(dentryAt(dent).ino);
  Task* task = taskAt(taskIndex);
  if (task.cred.euid != 0L && task.cred.euid != node.uid) {
    return -1L;
  }
  node.mode = memory::load64(home + 128L) % 512L;
  stampStatus(node);
  return 0L;
}

deRfun doChown(long caller, long home): long {
  long taskIndex = taskFind(caller);
  if (taskAt(taskIndex).cred.euid != 0L) {
    return -1L;
  }
  long dent = 0L;
  long status = walk(taskIndex, home + 16384L, &dent);
  if (status != 0L) {
    return status;
  }
  Inode* node = inodeAt(dentryAt(dent).ino);
  node.uid = memory::load64(home + 128L);
  node.gid = memory::load64(home + 192L);
  stampStatus(node);
  return 0L;
}

/* 服务 31。+128、+192 不是 0 时，分别采用 +256 的访问时间和 +320 的修改时间。
   给出 0 的那一项保持原值。状态时间改成这次读到的现在。属主或根才能改。 */
deRfun doUtime(long caller, long home): long {
  long setAccess = memory::load64(home + 128L);
  long setModify = memory::load64(home + 192L);
  long access = memory::load64(home + 256L);
  long modify = memory::load64(home + 320L);
  long taskIndex = taskFind(caller);
  long dent = 0L;
  long status = walk(taskIndex, home + 16384L, &dent);
  if (status != 0L) {
    return status;
  }
  Inode* node = inodeAt(dentryAt(dent).ino);
  Task* task = taskAt(taskIndex);
  if (task.cred.euid != 0L && task.cred.euid != node.uid) {
    return -1L;
  }
  if (setAccess != 0L) {
    node.atime = access;
  }
  if (setModify != 0L) {
    node.mtime = modify;
  }
  stampStatus(node);
  return 0L;
}

/* 从当前目录项走到绝对路径，抄到调用者的字节区。长度在 +256。 */
deRfun doGetcwd(long caller, long home): long {
  long taskIndex = taskFind(caller);
  if (taskIndex < 0L) {
    return -1L;
  }
  long status = pathOf(taskAt(taskIndex).cwd);
  if (status != 0L) {
    return status;
  }
  long count = memory::load64(scratch());
  if (count < 1L || count > scratchRoom()) {
    return 7L;
  }
  memory::store64(count, home + 256L);
  long index = 0L;
  long from = scratch() + 64L;
  long to = byteAt(home);
  while (index < count) {
    memory::storeOctet(memory::loadOctet(from + index * 8L), to + index * 8L);
    index = index + 1L;
  }
  return 0L;
}

deRfun doChdir(long caller, long home): long {
  long taskIndex = taskFind(caller);
  long dent = 0L;
  long status = walk(taskIndex, home + 16384L, &dent);
  if (status != 0L) {
    return status;
  }
  if (isDir(inodeAt(dentryAt(dent).ino).kind) == 0L) {
    return 3L;
  }
  if (may(taskIndex, dentryAt(dent).ino, 1L) == 0L) {
    return -1L;
  }
  taskAt(taskIndex).cwd = dent;
  return 0L;
}

deRfun devBytes(long index, long which): long {
  if (which == 0L) {
    return devUp(index);
  }
  return devDown(index);
}

deRfun devLive(Dev* dev): long {
  if (dev.used == 0L || dev.pid == 0L) {
    return 0L;
  }
  if (taskByPid(dev.pid) < 0L) {
    return 0L;
  }
  return 1L;
}

/* into 为 0 时从环里取出，为 1 时放进环。which 为 0 是发给用户的那条，为 1 是用户发来的那条。 */
deRfun ringMove(Dev* dev, long index, long which, long addr, long count, long into): long {
  long got = 0L;
  while (got < count) {
    long have = dev.upCount;
    long head = dev.upHead;
    if (which == 1L) {
      have = dev.downCount;
      head = dev.downHead;
    }
    if (into == 0L && have < 1L) {
      return got;
    }
    if (into == 1L && have >= ringRoom()) {
      return got;
    }
    long at = head;
    if (into == 1L) {
      at = head + have;
      if (at >= ringRoom()) {
        at = at - ringRoom();
      }
      memory::storeOctet(memory::loadOctet(addr + got * 8L), devBytes(index, which) + at * 8L);
      have = have + 1L;
    } else {
      memory::storeOctet(memory::loadOctet(devBytes(index, which) + at * 8L), addr + got * 8L);
      head = head + 1L;
      if (head == ringRoom()) {
        head = 0L;
      }
      have = have - 1L;
    }
    if (which == 0L) {
      dev.upHead = head;
      dev.upCount = have;
    } else {
      dev.downHead = head;
      dev.downCount = have;
    }
    got = got + 1L;
  }
  return got;
}

/* 有字节或有空位时，把堵着的那一端放行。一次调用至多搬满一条环。 */
deRfun devWake(long index): void {
  long pass = 0L;
  while (pass < 2L) {
    Dev* dev = devAt(index);
    if (dev.userReadWait >= 0L && dev.upCount > 0L) {
      long waiter = dev.userReadWait;
      dev.userReadWait = -1L;
      long home = query(1L, 8L, waiter);
      long got = ringMove(dev, index, 0L, byteAt(home), memory::load64(home + 256L), 0L);
      memory::store64(got, home + 320L);
      reply(waiter, 0L);
    }
    dev = devAt(index);
    if (dev.drvRecvWait >= 0L && dev.downCount > 0L) {
      long waiter = dev.drvRecvWait;
      dev.drvRecvWait = -1L;
      long home = query(1L, 8L, waiter);
      long got = ringMove(dev, index, 1L, byteAt(home), memory::load64(home + 256L), 0L);
      memory::store64(got, home + 320L);
      reply(waiter, 0L);
    }
    dev = devAt(index);
    if (dev.userWriteWait >= 0L && dev.downCount < ringRoom()) {
      long waiter = dev.userWriteWait;
      dev.userWriteWait = -1L;
      long home = query(1L, 8L, waiter);
      long got = ringMove(dev, index, 1L, byteAt(home), memory::load64(home + 256L), 1L);
      memory::store64(got, home + 320L);
      reply(waiter, 0L);
    }
    dev = devAt(index);
    if (dev.drvSendWait >= 0L && dev.upCount < ringRoom()) {
      long waiter = dev.drvSendWait;
      dev.drvSendWait = -1L;
      long home = query(1L, 8L, waiter);
      long got = ringMove(dev, index, 0L, byteAt(home), memory::load64(home + 256L), 1L);
      memory::store64(got, home + 320L);
      reply(waiter, 0L);
    }
    pass = pass + 1L;
  }
}

/* waitKind：1 用户读，2 用户写，3 驱动取，4 驱动送。into 与 ringMove 相同。 */
deRfun devMove(long index, long home, long which, long into, long caller, long waitKind): long {
  if (index < 0L || index >= devCount()) {
    return 5L;
  }
  Dev* dev = devAt(index);
  if (dev.used == 0L) {
    return 5L;
  }
  long count = memory::load64(home + 256L);
  if (count < 0L) {
    return 13L;
  }
  if (into == 1L && waitKind == 2L && devLive(dev) == 0L) {
    return 5L;
  }
  long got = ringMove(dev, index, which, byteAt(home), count, into);
  memory::store64(got, home + 320L);
  devWake(index);
  dev = devAt(index);
  if (got > 0L || count == 0L) {
    return 0L;
  }
  if (waitKind < 3L && devLive(dev) == 0L) {
    if (waitKind == 2L) {
      return 5L;
    }
    return 0L;
  }
  long waiting = dev.userReadWait;
  if (waitKind == 2L) {
    waiting = dev.userWriteWait;
  }
  if (waitKind == 3L) {
    waiting = dev.drvRecvWait;
  }
  if (waitKind == 4L) {
    waiting = dev.drvSendWait;
  }
  if (waiting >= 0L) {
    return 11L;
  }
  if (waitKind == 1L) {
    dev.userReadWait = caller;
  }
  if (waitKind == 2L) {
    dev.userWriteWait = caller;
  }
  if (waitKind == 3L) {
    dev.drvRecvWait = caller;
  }
  if (waitKind == 4L) {
    dev.drvSendWait = caller;
  }
  schedSleep(caller);
  return -2L;
}

deRfun devIo(long caller, long home): long {
  long taskIndex = taskFind(caller);
  if (taskIndex < 0L) {
    return -1L;
  }
  long pid = taskAt(taskIndex).pid;
  long index = 0L;
  while (index < devCount() && (devAt(index).used == 0L || devAt(index).pid != pid)) {
    index = index + 1L;
  }
  if (index >= devCount()) {
    return -1L;
  }
  long dir = memory::load64(home + 128L);
  if (dir == 0L) {
    return devMove(index, home, 1L, 0L, caller, 3L);
  }
  if (dir == 1L) {
    return devMove(index, home, 0L, 1L, caller, 4L);
  }
  return 13L;
}

deRfun devList(long dent, long home): long {
  long nth = memory::load64(home + 128L);
  long cap = memory::load64(home + 192L);
  if (nth < 0L || cap < 0L) {
    return 13L;
  }
  long seen = 0L;
  long index = 1L;
  while (index < dentryCount()) {
    Dentry* entry = dentryAt(index);
    if (entry.used == 1L && entry.parent == dent) {
      if (seen == nth) {
        if (cap < entry.nameLen) {
          return 6L;
        }
        long step = 0L;
        while (step < entry.nameLen) {
          memory::storeOctet(memory::loadOctet(nameAt(index) + step * 8L), byteAt(home) + step * 8L);
          step = step + 1L;
        }
        memory::store64(entry.nameLen, home + 256L);
        return 0L;
      }
      seen = seen + 1L;
    }
    index = index + 1L;
  }
  memory::store64(0L, home + 256L);
  return 0L;
}

/* 引导时第一个目录项就是 /dev。 */
deRfun devDir(): long {
  return 1L;
}

/* 终端格子紧挨内存文件正文。头 1024 位，行长到 4096，输入队列到 8192，格子到 253952。
   一次写入只把脏行画出来，再呈现一帧。抽键不呈现。 */
deRfun gridBase(): long {
  long cached = memory::load64(layoutWord(1L));
  if (cached != 0L) {
    return cached;
  }
  long base = vfsEnd() + inodeCount() * 64L + memSlots() * memCap() * 8L;
  memory::store64(base, layoutWord(1L));
  return base;
}

/* 命令名不进任务的 19 个字。终端格子用到 +253952，这里从 +262144 起，中间留一截。
   每份先是长度字，再 32 个八位组。512 份大约 16 万位，仍在编译器栈 +67125248 之前。 */
deRfun commBase(long index): long {
  return gridBase() + 262144L + index * 320L;
}

deRfun commClear(long index): void {
  if (index < 0L || index >= taskLimit()) {
    return;
  }
  memory::store64(0L, commBase(index));
}

deRfun commPut(long index, long addr, long count): void {
  if (index < 0L || index >= taskLimit()) {
    return;
  }
  if (count < 0L) {
    count = 0L;
  }
  if (count > 32L) {
    count = 32L;
  }
  long at = commBase(index);
  memory::store64(count, at);
  long step = 0L;
  while (step < count) {
    long value = memory::loadOctet(addr + step * 8L);
    if (value < 0L) {
      value = value + 256L;
    }
    memory::storeOctet(value, at + 64L + step * 8L);
    step = step + 1L;
  }
}

/* 路径是计数字符串。去掉末尾的斜杠，只留下最后一段，超长就留末尾 32 个八位组。 */
deRfun commFromPath(long index, long path): void {
  long len = memory::load64(path);
  if (len < 1L || len > 8192L) {
    commClear(index);
    return;
  }
  long end = len;
  while (end > 0L) {
    long value = memory::loadOctet(path + 64L + (end - 1L) * 8L);
    if (value < 0L) {
      value = value + 256L;
    }
    if (value != 47L) {
      break;
    }
    end = end - 1L;
  }
  long start = end;
  while (start > 0L) {
    long value = memory::loadOctet(path + 64L + (start - 1L) * 8L);
    if (value < 0L) {
      value = value + 256L;
    }
    if (value == 47L) {
      break;
    }
    start = start - 1L;
  }
  long count = end - start;
  if (count > 32L) {
    start = end - 32L;
    count = 32L;
  }
  commPut(index, path + 64L + start * 8L, count);
}

deRfun commNamed(long index, long which): void {
  long at = commBase(index);
  if (index < 0L || index >= taskLimit()) {
    return;
  }
  if (which == 0L) {
    memory::store64(4L, at);
    memory::storeOctet(105L, at + 64L);
    memory::storeOctet(110L, at + 72L);
    memory::storeOctet(105L, at + 80L);
    memory::storeOctet(116L, at + 88L);
    return;
  }
  if (which == 1L) {
    memory::store64(5L, at);
    memory::storeOctet(112L, at + 64L);
    memory::storeOctet(117L, at + 72L);
    memory::storeOctet(108L, at + 80L);
    memory::storeOctet(115L, at + 88L);
    memory::storeOctet(101L, at + 96L);
    return;
  }
  memory::store64(0L, at);
}

deRfun commLen(long index): long {
  if (index < 0L || index >= taskLimit()) {
    return 0L;
  }
  long count = memory::load64(commBase(index));
  if (count < 0L) {
    return 0L;
  }
  if (count > 32L) {
    return 32L;
  }
  return count;
}

deRfun commByte(long index, long at): long {
  if (index < 0L || index >= taskLimit() || at < 0L || at >= commLen(index)) {
    return 0L;
  }
  long value = memory::loadOctet(commBase(index) + 64L + at * 8L);
  if (value < 0L) {
    value = value + 256L;
  }
  return value;
}

deRfun termFace(): long {
  return 1048576L + 2L * 268435456L + 20480L + 576L;
}

deRfun conOctet(long addr): long {
  return memory::loadOctet(addr) & 255L;
}

deRfun conInit(): void {
  long base = gridBase();
  if (memory::load64(base) == 1L) {
    return;
  }
  long index = 0L;
  while (index < 16L) {
    memory::store64(0L, base + index * 64L);
    index = index + 1L;
  }
  index = 0L;
  while (index < 48L) {
    memory::store64(0L, base + 1024L + index * 64L);
    index = index + 1L;
  }
  memory::store64(1L, base);
  memory::store64(-1L, base + 384L);
}

deRfun conCols(): long {
  return memory::load64(gridBase() + 64L);
}

deRfun conRows(): long {
  return memory::load64(gridBase() + 128L);
}

deRfun conMeasure(): void {
  long wide = obr::ui::width();
  long high = obr::ui::height();
  long cols = 80L;
  long rows = 24L;
  if (wide >= 32L && high >= 32L) {
    cols = (wide - 16L) / 8L;
    rows = (high - 16L) / 18L;
  }
  if (cols < 1L) {
    cols = 1L;
  }
  if (rows < 1L) {
    rows = 1L;
  }
  if (cols > 160L) {
    cols = 160L;
  }
  if (rows > 48L) {
    rows = 48L;
  }
  memory::store64(cols, gridBase() + 64L);
  memory::store64(rows, gridBase() + 128L);
}

/* 脏行收在一个字里。低 6 位是个数，后面每 6 位一个行号。
   个数 63 表示整屏。移位只保留 32 位，第 32 行以后的标记会缠回低位，
   于是按一个键就把每一行都画一遍，回读将近整帧。这里只用乘除。 */
deRfun conMark(long row): void {
  if (row < 0L || row >= 48L) {
    return;
  }
  long packed = memory::load64(gridBase() + 320L);
  long count = packed % 64L;
  if (count == 63L) {
    return;
  }
  long seen = packed / 64L;
  long index = 0L;
  while (index < count) {
    if (seen % 64L == row) {
      return;
    }
    seen = seen / 64L;
    index = index + 1L;
  }
  if (count >= 8L) {
    memory::store64(63L, gridBase() + 320L);
    return;
  }
  long scale = 64L;
  index = 0L;
  while (index < count) {
    scale = scale * 64L;
    index = index + 1L;
  }
  memory::store64(packed + 1L + row * scale, gridBase() + 320L);
}

deRfun conMarkAll(): void {
  memory::store64(63L, gridBase() + 320L);
}

deRfun conRowLen(long row): long {
  return memory::load64(gridBase() + 1024L + row * 64L);
}

deRfun conSetRow(long row, long len): void {
  memory::store64(len, gridBase() + 1024L + row * 64L);
}

deRfun conCell(long row, long col): long {
  return gridBase() + 8192L + (row * 160L + col) * 32L;
}

deRfun conCursor(long row, long col): void {
  memory::store64(row, gridBase() + 192L);
  memory::store64(col, gridBase() + 256L);
}

deRfun conScroll(): void {
  long rows = conRows();
  long row = 0L;
  while (row + 1L < rows) {
    long col = 0L;
    while (col < 160L) {
      memory::store32(memory::load32(conCell(row + 1L, col)), conCell(row, col));
      col = col + 1L;
    }
    conSetRow(row, conRowLen(row + 1L));
    row = row + 1L;
  }
  if (rows > 0L) {
    conSetRow(rows - 1L, 0L);
    conCursor(rows - 1L, 0L);
  }
  conMarkAll();
}

deRfun conPlace(long scalar): void {
  long row = memory::load64(gridBase() + 192L);
  long col = memory::load64(gridBase() + 256L);
  long cols = conCols();
  long rows = conRows();
  if (cols < 1L || rows < 1L) {
    return;
  }
  if (row < 0L) {
    row = 0L;
  }
  if (row >= rows) {
    conScroll();
    return;
  }
  if (col < 0L) {
    col = 0L;
  }
  if (col >= cols) {
    col = 0L;
    row = row + 1L;
    if (row >= rows) {
      conScroll();
      row = conRows() - 1L;
      col = 0L;
    }
  }
  memory::store32(scalar, conCell(row, col));
  if (col + 1L > conRowLen(row)) {
    conSetRow(row, col + 1L);
  }
  conMark(row);
  col = col + 1L;
  if (col >= cols) {
    col = 0L;
    row = row + 1L;
    if (row >= rows) {
      conScroll();
      return;
    }
  }
  conCursor(row, col);
}

deRfun conNewline(): void {
  long row = memory::load64(gridBase() + 192L);
  conMark(row);
  row = row + 1L;
  if (row >= conRows()) {
    conScroll();
    return;
  }
  conCursor(row, 0L);
  conMark(row);
}

deRfun conReturn(): void {
  long row = memory::load64(gridBase() + 192L);
  conCursor(row, 0L);
  conMark(row);
}

deRfun conBack(): void {
  long row = memory::load64(gridBase() + 192L);
  long col = memory::load64(gridBase() + 256L);
  if (col > 0L) {
    conCursor(row, col - 1L);
    conMark(row);
  }
}

deRfun conClearGrid(): void {
  long row = 0L;
  while (row < 48L) {
    conSetRow(row, 0L);
    row = row + 1L;
  }
  conCursor(0L, 0L);
  memory::store64(0L, gridBase() + 832L);
  conMarkAll();
}

deRfun conTab(): void {
  long col = memory::load64(gridBase() + 256L);
  long stop = 8L;
  if (col % 8L != 0L) {
    stop = 8L - col % 8L;
  }
  while (stop > 0L) {
    conPlace(32L);
    stop = stop - 1L;
  }
}

deRfun conScalar(long value): void {
  if (value < 32L || value > 1114111L || (value >= 55296L && value <= 57343L)) {
    return;
  }
  conPlace(value);
}

deRfun conByte(long value): void {
  value = value & 255L;
  long base = gridBase();
  long need = memory::load64(base + 704L);
  if (need > 0L) {
    if (value >= 128L && value <= 191L) {
      long acc = memory::load64(base + 768L);
      acc = (acc << 6L) | (value & 63L);
      need = need - 1L;
      memory::store64(acc, base + 768L);
      memory::store64(need, base + 704L);
      if (need == 0L) {
        long minimum = memory::load64(base + 896L);
        if (acc >= minimum) {
          conScalar(acc);
        }
      }
      return;
    }
    memory::store64(0L, base + 704L);
  }
  if (value == 10L) {
    conNewline();
    return;
  }
  if (value == 13L) {
    conReturn();
    return;
  }
  if (value == 8L || value == 127L) {
    conBack();
    return;
  }
  if (value == 12L) {
    conClearGrid();
    return;
  }
  if (value == 9L) {
    conTab();
    return;
  }
  if (value < 32L) {
    return;
  }
  if (value < 128L) {
    conPlace(value);
    return;
  }
  if (value >= 194L && value <= 223L) {
    memory::store64(value & 31L, base + 768L);
    memory::store64(1L, base + 704L);
    memory::store64(128L, base + 896L);
  } else if (value >= 224L && value <= 239L) {
    memory::store64(value & 15L, base + 768L);
    memory::store64(2L, base + 704L);
    memory::store64(2048L, base + 896L);
  } else if (value >= 240L && value <= 244L) {
    memory::store64(value & 7L, base + 768L);
    memory::store64(3L, base + 704L);
    memory::store64(65536L, base + 896L);
  }
}

deRfun qPush(long value): long {
  long base = gridBase();
  long count = memory::load64(base + 640L);
  if (count >= 512L) {
    return 1L;
  }
  long head = memory::load64(base + 576L);
  long at = head + count;
  if (at >= 512L) {
    at = at - 512L;
  }
  memory::storeOctet(value, base + 4096L + at * 8L);
  memory::store64(count + 1L, base + 640L);
  return 0L;
}

deRfun qPull(): long {
  long base = gridBase();
  long count = memory::load64(base + 640L);
  if (count < 1L) {
    return -1L;
  }
  long head = memory::load64(base + 576L);
  long value = conOctet(base + 4096L + head * 8L);
  head = head + 1L;
  if (head >= 512L) {
    head = 0L;
  }
  memory::store64(head, base + 576L);
  memory::store64(count - 1L, base + 640L);
  return value;
}

deRfun conCopyOut(long home, long count): long {
  long got = 0L;
  while (got < count) {
    long value = qPull();
    if (value < 0L) {
      return got;
    }
    memory::storeOctet(value, byteAt(home) + got * 8L);
    got = got + 1L;
  }
  return got;
}

/* 打断正在跑的程序。键盘等待若就是这颗核，清掉，免得稍后 reply 到已经卸下的核。
   光标不在 0 列就换一行。提示符由父进程醒来之后再画，这里只拨光标。 */
deRfun conInterrupt(long core): void {
  long base = gridBase();
  if (memory::load64(base + 384L) == core) {
    memory::store64(-1L, base + 384L);
  }
  if (memory::load64(base + 256L) != 0L) {
    conByte(10L);
  }
}

deRfun conWake(): void {
  long base = gridBase();
  long waiter = memory::load64(base + 384L);
  /* 等键盘的那颗核已经收掉时，队列里即使还有字节也不能再 reply。 */
  if (waiter >= 0L && taskFind(waiter) < 0L) {
    memory::store64(-1L, base + 384L);
    return;
  }
  if (waiter < 0L || memory::load64(base + 640L) < 1L) {
    return;
  }
  long home = memory::load64(base + 448L);
  long need = memory::load64(base + 512L);
  long got = conCopyOut(home, need);
  if (got < 1L) {
    return;
  }
  memory::store64(got, home + 320L);
  memory::store64(-1L, base + 384L);
  reply(waiter, 0L);
}

deRfun conPull(long caller, long home): long {
  conInit();
  long count = memory::load64(home + 256L);
  if (count <= 0L) {
    memory::store64(0L, home + 320L);
    return 0L;
  }
  if (memory::load64(gridBase() + 384L) >= 0L) {
    return 11L;
  }
  long got = conCopyOut(home, count);
  if (got > 0L) {
    memory::store64(got, home + 320L);
    return 0L;
  }
  long base = gridBase();
  memory::store64(caller, base + 384L);
  memory::store64(home, base + 448L);
  memory::store64(count, base + 512L);
  return -2L;
}

deRfun conPaintRow(long row, long wide, long paper, long ink, long face): void {
  long y = 8L + row * 18L;
  obr::ui::rect(0L, y, wide, 18L, paper, 255L);
  long len = conRowLen(row);
  if (len > conCols()) {
    len = conCols();
  }
  if (len > 0L) {
    /* 纸色矩形会把当前墨色留成纸色。字形图章沿用它，不先换成浅色就和纸融在一起。
       左缘点一颗再盖回去，只为换色。笔位是基线，格顶再往下 14 像素。 */
    obr::ui::rect(0L, y, 1L, 1L, ink, 255L);
    obr::font::select(face, 8L, y + 14L);
    obr::font::draw(conCell(row, 0L), len);
    obr::ui::rect(0L, y, 1L, 1L, paper, 255L);
  }
}

deRfun conPaint(): void {
  conInit();
  long face = memory::load64(termFace());
  if (face < 1L) {
    return;
  }
  /* 列数已经量过就用它还原像素宽度，避免每个键都再问一次显卡。 */
  long colsNow = conCols();
  long wide = colsNow * 8L + 16L;
  if (colsNow < 1L) {
    wide = obr::ui::width();
  }
  long paper = obr::ui::rgb(30L, 30L, 30L);
  long ink = obr::ui::rgb(230L, 230L, 230L);
  long base = gridBase();
  if (memory::load64(base + 832L) == 0L) {
    if (conCols() < 1L) {
      conMeasure();
    }
    long rows = conRows();
    long cols = conCols();
    long row = memory::load64(base + 192L);
    long col = memory::load64(base + 256L);
    if (row < 0L || row >= rows) {
      row = 0L;
    }
    if (col < 0L || col > cols) {
      col = 0L;
    }
    conCursor(row, col);
    obr::ui::clear(paper, 255L);
    memory::store64(1L, base + 832L);
    conMarkAll();
  }
  long rows = conRows();
  long packed = memory::load64(base + 320L);
  long count = packed % 64L;
  memory::store64(0L, base + 320L);
  if (count == 63L) {
    long row = 0L;
    while (row < rows) {
      conPaintRow(row, wide, paper, ink, face);
      row = row + 1L;
    }
  } else {
    long seen = packed / 64L;
    long index = 0L;
    while (index < count) {
      long row = seen % 64L;
      seen = seen / 64L;
      if (row >= 0L && row < rows) {
        conPaintRow(row, wide, paper, ink, face);
      }
      index = index + 1L;
    }
  }
  long col = memory::load64(base + 256L);
  long crow = memory::load64(base + 192L);
  if (crow >= 0L && crow < rows && col >= 0L && col <= conCols()) {
    obr::ui::rect(8L + col * 8L, 8L + crow * 18L, 2L, 16L, ink, 255L);
  }
  obr::ui::present();
}

deRfun conEmit(long home): void {
  conInit();
  if (conCols() < 1L) {
    conMeasure();
  }
  long count = memory::load64(home + 256L);
  if (count < 0L) {
    memory::store64(0L, home + 320L);
    return;
  }
  if (count > 4096L) {
    count = 4096L;
  }
  long index = 0L;
  long bytes = byteAt(home);
  while (index < count) {
    conByte(conOctet(bytes + index * 8L));
    index = index + 1L;
  }
  memory::store64(count, home + 320L);
  if (count > 0L) {
    conPaint();
  }
}

deRfun pushSeq(long first, long second, long third, long fourth, long count): void {
  if (count >= 1L && qPush(first) != 0L) {
    return;
  }
  if (count >= 2L && qPush(second) != 0L) {
    return;
  }
  if (count >= 3L && qPush(third) != 0L) {
    return;
  }
  if (count >= 4L) {
    qPush(fourth);
  }
}

deRfun conKey(long at): void {
  long packed = memory::load64(at);
  long name = memory::load64(at + 64L);
  long unit = packed % 65536L;
  long mods = packed / 65536L;
  if (name == 0x7265746e45L) {
    qPush(10L);
    return;
  }
  if (name == 0x6b636142L) {
    qPush(127L);
    return;
  }
  if (name == 0x7466654cL) {
    pushSeq(27L, 91L, 68L, 0L, 3L);
    return;
  }
  if (name == 0x7468676952L) {
    pushSeq(27L, 91L, 67L, 0L, 3L);
    return;
  }
  if (name == 0x7055L) {
    pushSeq(27L, 91L, 65L, 0L, 3L);
    return;
  }
  if (name == 0x6e776f44L) {
    pushSeq(27L, 91L, 66L, 0L, 3L);
    return;
  }
  if (name == 0x656d6f48L) {
    pushSeq(27L, 91L, 72L, 0L, 3L);
    return;
  }
  if (name == 0x646e45L) {
    pushSeq(27L, 91L, 70L, 0L, 3L);
    return;
  }
  if (name == 0x6574656c6544L) {
    pushSeq(27L, 91L, 51L, 126L, 4L);
    return;
  }
  if (name == 0x626154L) {
    return;
  }
  long ctrl = (mods / 2L) % 2L;
  /* 小写减 96、大写减 64。只有这一下会变成字节 3 的 Ctrl+C 才问进程层。
     有人正在等子进程就不入队；没有则仍是字节 3，行编辑照旧。别的控制字节不走这条。 */
  if (ctrl == 1L && unit >= 97L && unit <= 122L) {
    long value = unit - 96L;
    if (value == 3L && procBreak() != 0L) {
      return;
    }
    qPush(value);
    return;
  }
  if (ctrl == 1L && unit >= 65L && unit <= 90L) {
    long value = unit - 64L;
    if (value == 3L && procBreak() != 0L) {
      return;
    }
    qPush(value);
    return;
  }
  if (ctrl == 1L) {
    return;
  }
  if (unit >= 32L && unit <= 126L) {
    qPush(unit);
  }
}

deRfun conPump(): void {
  conInit();
  long written = memory::load64(6528L);
  long base = gridBase();
  long seen = memory::load64(base + 960L);
  if (written < seen) {
    seen = 0L;
  }
  if (written > seen + 5L) {
    seen = written - 5L;
  }
  while (seen < written) {
    conKey(6656L + (seen % 5L) * 128L);
    seen = seen + 1L;
  }
  memory::store64(seen, base + 960L);
  conWake();
}

/* 4096 是固件模式。0 仍是启动点，加载画面是 1，设置是 2。
   设置开着时不能干等加载画面，否则空转和驱动都排不上去，CPU 页会一直是 STOP。
   离开启动点就继续。这里不能 yield：引导还没进主循环，让出之后没有人再把监督核叫醒。
   这一步不再往控制台写字。 */
deRfun conShow(): void {
  __zap__ {
    conWait:
    place r1, 4096
    ldi.64 r0, r1
    place r2, 0
    eq r0, r0, r2
    jnz r0, conWait
  }
}

/* /dev/con 挂在监督核上。名字先放在驱动名暂存 537954304，drvLoad 之后会盖掉。
   旧的两个光标字清掉，终端格子改在内存文件正文之后。
   四个参数都在寄存器里：核心、pid、名字、长度。长度是 3，不能再塞进栈针。
   这段不展开进 main，免得占满入口映像。 */
deRfun conPublish(): void {
  __zap__ {
    place r0, 99
    store.octet r0, 537954304
    place r0, 111
    store.octet r0, 537954312
    place r0, 110
    store.octet r0, 537954320
    place r0, 0
    store.64 r0, 537931968
    store.64 r0, 537932032
    store.64 r0, 537932096
    store.64 r0, 537932160
    store.64 r0, 537932224
    store.64 r0, 537932288
    store.64 r0, 537932352
    store.64 r0, 537932416
    store.64 r0, 537932480
    store.64 r0, 537932544
    store.64 r0, 537932608
    store.64 r0, 537932672
    place r1, 2
    place r2, 1
    place r3, 537954304
    place r4, 3
    call devPublish
  }
}

/* 导出是为了让 conPublish 的机器码能按名字调用。标号挡住内联，避免再复制一份。 */
export deRfun devPublish(long core, long pid, long name, long nameLen): long {
  __zap__ {
    conKeep:
  }
  if (pid < 1L || nameLen < 1L || nameLen > 32L) {
    return 6L;
  }
  if (core != 2L && (core < 4L || core > 7L)) {
    return 6L;
  }
  long dir = devDir();
  if (dir < 0L) {
    return 7L;
  }
  scratchClear();
  memory::store64(nameLen, scratch());
  long step = 0L;
  while (step < nameLen) {
    memory::storeOctet(memory::loadOctet(name + step * 8L), scratch() + 64L + step * 8L);
    step = step + 1L;
  }
  if (findChild(dir, scratch(), 0L, nameLen) >= 0L) {
    scratchClear();
    return 0L;
  }
  long slot = 0L;
  while (slot < devCount() && devAt(slot).used == 1L) {
    slot = slot + 1L;
  }
  if (slot >= devCount()) {
    scratchClear();
    return 7L;
  }
  long dent = takeChild(dir, scratch(), 0L, nameLen, 3L, 0L, 0L, 0L, modeDev());
  scratchClear();
  if (dent < 0L) {
    return 7L;
  }
  Dev* dev = devAt(slot);
  dev.used = 1L;
  dev.core = core;
  dev.pid = pid;
  dev.ino = dentryAt(dent).ino;
  dev.upHead = 0L;
  dev.upCount = 0L;
  dev.downHead = 0L;
  dev.downCount = 0L;
  dev.userReadWait = -1L;
  dev.userWriteWait = -1L;
  dev.drvRecvWait = -1L;
  dev.drvSendWait = -1L;
  return 0L;
}

deRfun devDrop(long pid): void {
  if (pid < 1L) {
    return;
  }
  long index = 0L;
  while (index < devCount()) {
    Dev* dev = devAt(index);
    if (dev.used == 1L && dev.pid == pid) {
      if (dev.userReadWait >= 0L) {
        long waiter = dev.userReadWait;
        dev.userReadWait = -1L;
        memory::store64(0L, query(1L, 8L, waiter) + 320L);
        reply(waiter, 0L);
      }
      if (dev.userWriteWait >= 0L) {
        long waiter = dev.userWriteWait;
        dev.userWriteWait = -1L;
        reply(waiter, 5L);
      }
      dev.drvRecvWait = -1L;
      dev.drvSendWait = -1L;
      dev.pid = 0L;
    }
    index = index + 1L;
  }
}

deRfun vfsCall(long caller, long service): long {
  if (nasBusy() == 1L) {
    return 8L;
  }
  long home = query(1L, 8L, caller);
  if (service == 4L) {
    return doStat(caller, home);
  }
  if (service == 5L) {
    return doOpen(caller, home);
  }
  if (service == 6L) {
    return doClose(caller, home);

/* 进程层。任务表、凭证、信号和等待。表放在监督核窗口里。 */
#LINK /start.obr, /sched.obr, /vfs.obr, /exec.obr, /mm.obr
import proc;
import fs;
import sched;
import trap;
import board;
import memory;
import obr.os;

deRfun kFloor(): long {
  return 1024L * 1024L;
}

deRfun kSlot(): long {
  return 268435456L;
}

deRfun kSpan(): long {
  return 137904128L;
}

deRfun kArena(long core): long {
  return kFloor() + core * kSlot();
}

deRfun fsCore(): long {
  return 4L;
}

deRfun taskLimit(): long {
  return 512L;
}

/* 优先级不进 Task 的 19 个字。每个任务一个八位组，落在兼容描述之后、任务表 65536 之前。
   0 是空，1 是后台，2 是前台。前台同一档轮转；后台只在没有更高档就绪时才上核。
   49152 起再留 8 个八位组，一核一个，给宿主看这颗核上正在跑的是哪一档。 */
deRfun rankAt(long index): long {
  return kArena(2L) + 45056L + index * 8L;
}

deRfun rankGet(long index): long {
  long value = memory::loadOctet(rankAt(index));
  if (value < 0L) {
    value = value + 256L;
  }
  return value;
}

deRfun rankSet(long index, long rank): void {
  if (index < 0L || index >= taskLimit()) {
    return;
  }
  memory::storeOctet(rank, rankAt(index));
}

/* 已占用下标的上界，不含这一格。放在控制台暂存清零区之后、字体表 +20480 之前。
   调度每一圈都要扫表。空槽一直扫到 512 时，按一个键要等十几秒。
   新任务从低位往上占，扫到这里就够。释放后不把上界往回缩，中间的空槽仍算在里面。 */
deRfun taskSpan(): long {
  return kArena(2L) + 13248L;
}

deRfun taskScanEnd(): long {
  long end = memory::load64(taskSpan());
  if (end < 0L) {
    return 0L;
  }
  if (end > taskLimit()) {
    return taskLimit();
  }
  return end;
}

deRfun taskNote(long index): void {
  if (index + 1L > memory::load64(taskSpan())) {
    memory::store64(index + 1L, taskSpan());
  }
}

/* 协议把一颗实现的上下文槽定在 1 至 256。官方标定取满 256。 */
deRfun slotLimit(): long {
  return 256L;
}

/* 与 proc.mr 里 Task 的 19 个字一致。 */
deRfun taskStride(): long {
  return 19L * 64L;
}

/* 低地址留给调用帧和引导用的几个字。表从这里排 512 份。 */
deRfun tableBase(): long {
  return kArena(2L) + 65536L;
}

/* 12416 是下一个 pid。终端格子改放在内存文件正文之后，这里的两个字不再当光标。
   +20480 起是系统字体表，每份两个字，字体层使用。+32768 起是驱动路径。 */
deRfun pidWord(): long {
  return kArena(2L) + 12416L;
}

deRfun taskAt(long index): Task* {
  return (Task*)(tableBase() + index * taskStride());
}

/* 正在跑的优先，其次是堵在系统调用里的，再其次是还没收掉的僵尸。就绪的只在没有这三类时才返回。 */
deRfun taskFind(long core): long {
  long index = 0L;
  long sleeping = -1L;
  long zombie = -1L;
  long other = -1L;
  long end = taskScanEnd();
  while (index < end) {
    Task* task = taskAt(index);
    if (task.pid != 0L && task.core == core) {
      if (task.state == TaskState::Running) {
        return index;
      }
      if (task.state == TaskState::Sleeping && sleeping < 0L) {
        sleeping = index;
      }
      if (task.state == TaskState::Zombie && zombie < 0L) {
        zombie = index;
      }
      if (other < 0L) {
        other = index;
      }
    }
    index = index + 1L;
  }
  if (sleeping >= 0L) {
    return sleeping;
  }
  if (zombie >= 0L) {
    return zombie;
  }
  return other;
}

/* 监督核把这颗核心上正在跑的档写出去。宿主按这一档决定让不让、给多大一块。 */
deRfun rankPublish(long core): void {
  if (core < 0L || core > 7L) {
    return;
  }
  long rank = 0L;
  long index = taskFind(core);
  if (index >= 0L) {
    rank = rankGet(index);
  }
  memory::storeOctet(rank, kArena(2L) + 49152L + core * 8L);
}

deRfun taskCount(long core): long {
  long count = 0L;
  long index = 0L;
  long end = taskScanEnd();
  while (index < end) {
    Task* task = taskAt(index);
    if (task.pid != 0L && task.core == core) {
      count = count + 1L;
    }
    index = index + 1L;
  }
  return count;
}

/* except 是正在让出的那一格。-1 表示从第 0 格找。只返回已经抄进槽的就绪任务。
   从 except 的下一格起绕一圈，先等到的先跑，不总是表里最靠前的那一格。 */
deRfun taskReady(long core, long except): long {
  long end = taskScanEnd();
  long start = 0L;
  if (except >= 0L) {
    start = except + 1L;
  }
  long step = 0L;
  while (step < end) {
    long index = start + step;
    if (index >= end) {
      index = index - end;
    }
    if (index != except) {
      Task* task = taskAt(index);
      if (task.pid != 0L && task.core == core && task.state == TaskState::Ready && task.held > 0L) {
        return index;
      }
    }
    step = step + 1L;
  }
  return -1L;
}

/* 只在指定的一档里绕圈。同一档的前台这样分一颗核，不总是表里最靠前的那一格。 */
deRfun taskReadyRank(long core, long except, long rank): long {
  long end = taskScanEnd();
  long start = 0L;
  if (except >= 0L) {
    start = except + 1L;
  }
  long step = 0L;
  while (step < end) {
    long index = start + step;
    if (index >= end) {
      index = index - end;
    }
    if (index != except) {
      Task* task = taskAt(index);
      if (task.pid != 0L && task.core == core && task.state == TaskState::Ready && task.held > 0L && rankGet(index) == rank) {
        return index;
      }
    }
    step = step + 1L;
  }
  return -1L;
}

/* 就绪且已经进槽的任务里，最高的那一档。没有就返回 -1。正在跑的那一格不算。 */
deRfun taskBestRank(long core, long except): long {
  long best = 0L;
  long found = 0L;
  long end = taskScanEnd();
  long index = 0L;
  while (index < end) {
    if (index != except) {
      Task* task = taskAt(index);
      if (task.pid != 0L && task.core == core && task.state == TaskState::Ready && task.held > 0L) {
        long rank = rankGet(index);
        if (found == 0L || rank > best) {
          best = rank;
          found = 1L;
        }
      }
    }
    index = index + 1L;
  }
  if (found == 0L) {
    return -1L;
  }
  return best;
}

/* 壳停在读键盘时，任务都在睡。这时候不必每圈都问宿主谁还在跑。 */
deRfun schedIdle(): long {
  long index = 0L;
  long end = taskScanEnd();
  while (index < end) {
    long state = taskAt(index).state;
    if (state == TaskState::Running || state == TaskState::Ready) {
      return 0L;
    }
    index = index + 1L;
  }
  return 1L;
}

/* 有档就只在最高档里挑。没有分档的旧任务仍走原来的绕圈。 */
deRfun taskPrefer(long core, long except): long {
  long best = taskBestRank(core, except);
  if (best < 1L) {
    return taskReady(core, except);
  }
  return taskReadyRank(core, except, best);
}

deRfun taskClear(): void {
  memory::store64(0L, taskSpan());
  long index = 0L;
  while (index < taskLimit()) {
    Task* task = taskAt(index);
    task.pid = 0L;
    task.ppid = 0L;
    task.state = TaskState::Empty;
    task.core = -1L;
    task.cred.uid = 0L;
    task.cred.gid = 0L;
    task.cred.euid = 0L;
    task.cred.egid = 0L;
    task.mm.origin = 0L;
    task.mm.length = 0L;
    task.mm.brk = 0L;
    task.mm.freeHead = 0L;
    task.mm.heap = 0L;
    task.cap = 0L;
    task.cwd = 0L;
    task.sig = 0L;
    task.code = 0L;
    task.waitFor = 0L;
    task.held = 0L;
    rankSet(index, 0L);
    index = index + 1L;
  }
  long core = 0L;
  while (core < 8L) {
    memory::storeOctet(0L, kArena(2L) + 49152L + core * 8L);
    core = core + 1L;
  }
  memory::store64(1L, pidWord());
}

/* 1 号留给用户态 init。之后 nextPid 从 2 起，驱动不会占掉 1。 */
deRfun reserveOne(): void {
  memory::store64(2L, pidWord());
}

deRfun taskRelease(long index): void {
  if (index < 0L) {
    return;
  }
  vfsForgetTask(index);
  long pid = taskAt(index).pid;
  devDrop(pid);
  long other = 0L;
  long end = taskScanEnd();
  while (other < end) {
    if (other != index && taskAt(other).ppid == pid && pid != 0L) {
      taskAt(other).ppid = 1L;
    }
    other = other + 1L;
  }
  Task* task = taskAt(index);
  if (task.core >= 3L && task.mm.heap != 0L && task.mm.length > 0L) {
    poolGive(task.core, task.mm.heap, task.mm.length);
    task.mm.heap = 0L;
    task.mm.length = 0L;
  }
  task.pid = 0L;
  task.ppid = 0L;
  task.state = TaskState::Empty;
  task.core = -1L;
  task.code = 0L;
  task.waitFor = 0L;
  task.held = 0L;
  task.mm.freeHead = 0L;
  task.sig = 0L;
  rankSet(index, 0L);
}

deRfun taskDrop(long core): void {
  taskRelease(taskFind(core));
}

deRfun nextPid(): long {
  long at = pidWord();
  long value = memory::load64(at);
  if (value < 1L) {
    value = 1L;
  }
  memory::store64(value + 1L, at);
  return value;
}

/* 编译器映像占窗口前 137904128 位。后面到槽尾是这一核的堆池，约 16316416 个八位组。
   不再按份切死。先给 4194304 个八位组，池里不够就先给 65536，之后紧挨着的空闲块还能长。 */
deRfun heapGrant(): long {
  return 33554432L;
}

deRfun heapMinimum(): long {
  return 524288L;
}

deRfun poolBase(long core): long {
  return kArena(core) + kSpan();
}

deRfun poolLimit(long core): long {
  return kArena(core) + kSlot();
}

deRfun poolHead(long core): long {
  return poolBase(core) + 64L;
}

/* 池头一个字是 1 表示已经切开。空闲块从池头 +128 起，头两个字是位数和下一格。 */
deRfun poolReady(long core): void {
  long base = poolBase(core);
  if (memory::load64(base) == 1L) {
    return;
  }
  memory::store64(1L, base);
  long block = base + 128L;
  long room = poolLimit(core) - block;
  memory::store64(room - 128L, block);
  memory::store64(0L, block + 64L);
  memory::store64(block, poolHead(core));
}

deRfun poolTake(long core, long need): long {
  if (core < 3L || core > 7L || need < 64L) {
    return 0L;
  }
  poolReady(core);
  long prev = 0L;
  long cursor = memory::load64(poolHead(core));
  while (cursor != 0L) {
    long span = memory::load64(cursor);
    long next = memory::load64(cursor + 64L);
    if (span >= need) {
      long remain = span - need;
      if (remain >= 192L) {
        memory::store64(need, cursor);
        long rest = cursor + 128L + need;
        memory::store64(remain - 128L, rest);
        memory::store64(next, rest + 64L);
        if (prev == 0L) {
          memory::store64(rest, poolHead(core));
        } else {
          memory::store64(rest, prev + 64L);
        }
      } else if (prev == 0L) {
        memory::store64(next, poolHead(core));
      } else {
        memory::store64(next, prev + 64L);
      }
      return cursor + 128L;
    }
    prev = cursor;
    cursor = next;
  }
  return 0L;
}

deRfun poolGive(long core, long origin, long span): void {
  if (core < 3L || core > 7L || origin == 0L || span < 64L) {
    return;
  }
  long block = origin - 128L;
  if (block < poolBase(core) + 128L || origin + span > poolLimit(core)) {
    return;
  }
  memory::store64(span, block);
  long prev = 0L;
  long cursor = memory::load64(poolHead(core));
  while (cursor != 0L && cursor < block) {
    prev = cursor;
    cursor = memory::load64(cursor + 64L);
  }
  memory::store64(cursor, block + 64L);
  if (prev == 0L) {
    memory::store64(block, poolHead(core));
  } else {
    memory::store64(block, prev + 64L);
  }
  long payload = memory::load64(block);
  long nxt = memory::load64(block + 64L);
  if (nxt != 0L && block + 128L + payload == nxt) {
    long merged = payload + 128L + memory::load64(nxt);
    memory::store64(merged, block);
    memory::store64(memory::load64(nxt + 64L), block + 64L);
  }
  if (prev != 0L) {
    long prevSpan = memory::load64(prev);
    if (prev + 128L + prevSpan == block) {
      long merged = prevSpan + 128L + memory::load64(block);
      memory::store64(merged, prev);
      memory::store64(memory::load64(block + 64L), prev + 64L);
    }
  }
}

/* 当前堆正好顶到一块空闲区时，把相邻的位数并进来。并不到就回复 0。 */
deRfun poolGrow(long core, long extra): long {
  long index = taskFind(core);
  if (index < 0L || extra < 64L) {
    return 0L;
  }
  Task* task = taskAt(index);
  if (task.core < 3L || task.mm.heap == 0L) {
    return 0L;
  }
  long block = task.mm.origin + task.mm.length;
  long prev = 0L;
  long cursor = memory::load64(poolHead(core));
  while (cursor != 0L && cursor != block) {
    prev = cursor;
    cursor = memory::load64(cursor + 64L);
  }
  if (cursor == 0L) {
    return 0L;
  }
  long payload = memory::load64(cursor);
  long next = memory::load64(cursor + 64L);
  long whole = payload + 128L;
  if (whole < extra) {
    return 0L;
  }
  long take = extra;
  if (whole - extra < 192L) {
    take = whole;
  }
  if (prev == 0L) {
    memory::store64(next, poolHead(core));
  } else {
    memory::store64(next, prev + 64L);
  }
  task.mm.length = task.mm.length + take;
  long left = whole - take;
  if (left >= 192L) {
    long rest = block + take;
    memory::store64(left - 128L, rest);
    memory::store64(next, rest + 64L);
    if (prev == 0L) {
      memory::store64(rest, poolHead(core));
    } else {
      memory::store64(rest, prev + 64L);
    }
  }
  return 1L;
}

deRfun heapOf(long core): long {
  if (core == 2L) {
    return vfsEnd();
  }
  if (core < 3L || core > 7L) {
    return 0L;
  }
  long got = poolTake(core, heapGrant());
  if (got == 0L) {
    got = poolTake(core, heapMinimum());
  }
  return got;
}

/* 0 至 255 优先用和下标相同的槽。256 至 511 以及被占的下标，领任意一格空槽。领不到是 -1。 */
deRfun slotBusy(long slot): long {
  long index = 0L;
  long end = taskScanEnd();
  while (index < end) {
    if (taskAt(index).held == slot + 1L) {
      return 1L;
    }
    index = index + 1L;
  }
  return 0L;
}

deRfun slotPick(long index): long {
  if (index >= 0L && index < slotLimit() && slotBusy(index) == 0L) {
    return index;
  }
  long slot = 0L;
  while (slot < slotLimit()) {
    if (slotBusy(slot) == 0L) {
      return slot;
    }
    slot = slot + 1L;
  }
  return -1L;
}

/* 已经抄过就用原来的槽。否则领一格并记成槽号加 1，0 仍表示还没进槽。 */
deRfun slotHold(long index): long {
  if (index < 0L) {
    return -1L;
  }
  long have = taskAt(index).held;
  if (have > 0L) {
    return have - 1L;
  }
  long slot = slotPick(index);
  if (slot < 0L) {
    return -1L;
  }
  taskAt(index).held = slot + 1L;
  return slot;
}

deRfun taskSpawn(long core, long pid, long uid, long gid, long cap, long state): long {
  if (core < 2L || core > 7L || pid < 1L) {
    return 0L;
  }
  /* 监督核只有一份。用户核不再按份数封顶，堆池或任务表用尽才拒绝。 */
  if (core == 2L && taskFind(core) >= 0L) {
    return 0L;
  }
  long index = 0L;
  while (index < taskLimit() && taskAt(index).pid != 0L) {
    index = index + 1L;
  }
  if (index >= taskLimit()) {
    return 0L;
  }
  long heap = heapOf(core);
  if (heap == 0L) {
    return 0L;
  }
  Task* task = taskAt(index);
  task.pid = pid;
  task.ppid = 1L;
  task.state = state;
  task.core = core;
  task.cred.uid = uid;
  task.cred.gid = gid;
  task.cred.euid = uid;
  task.cred.egid = gid;
  if (core == 2L) {
    task.mm.origin = kArena(core);
    task.mm.length = kSpan();
  } else {
    task.mm.origin = heap;
    task.mm.length = memory::load64(heap - 128L);
  }
  task.mm.heap = heap;
  task.mm.brk = task.mm.heap;
  task.mm.freeHead = 0L;
  task.cap = cap;
  task.cwd = 0L;
  task.sig = 0L;
  task.code = 0L;
  task.waitFor = 0L;
  task.held = 0L;
  /* 新任务先当后台。交互壳和它等着的子任务再升到前台。 */
  rankSet(index, 1L);
  taskNote(index);
  return pid;
}

/* 没有任务就拒绝。装入和卸下要管理权的最低位。只有 euid 0、没有这一位，不能装入。 */
deRfun taskAllows(long core, long service): long {
  long index = taskFind(core);
  if (index < 0L) {
    return 0L;
  }
  Task* task = taskAt(index);
  if (task.pid == 0L || task.state == TaskState::Empty) {
    return 0L;
  }
  if (service == 12L || service == 13L) {
    if (task.cap % 2L == 1L) {
      return 1L;
    }
    return 0L;
  }
  return 1L;
}

deRfun taskByPid(long pid): long {
  long index = 0L;
  long end = taskScanEnd();
  while (index < end) {
    if (taskAt(index).pid == pid && pid != 0L) {
      return index;
    }
    index = index + 1L;
  }
  return -1L;
}

deRfun sigMask(long sig): long {
  long bit = 1L;
  long step = 1L;
  while (step < sig) {
    bit = bit * 2L;
    step = step + 1L;
  }
  return bit;
}

deRfun sigPendingKill(long core): long {
  long index = taskFind(core);
  if (index < 0L) {
    return 0L;
  }
  long mask = sigMask(9L);
  if (taskAt(index).sig / mask % 2L == 1L) {
    return 1L;
  }
  return 0L;
}

deRfun sigRaise(long caller, long pid, long sig): long {
  if (sig < 0L || sig > 31L || pid == 1L) {
    return -1L;
  }
  long target = taskByPid(pid);
  long from = taskFind(caller);
  if (target < 0L || from < 0L) {
    return 2L;
  }
  Task* who = taskAt(from);
  Task* task = taskAt(target);
  if (who.cred.euid != 0L && who.cred.euid != task.cred.uid && who.cred.euid != task.cred.euid) {
    return -1L;
  }
  if (sig == 0L) {
    return 0L;
  }
  long mask = sigMask(sig);
  if (task.sig / mask % 2L == 0L) {
    task.sig = task.sig + mask;
  }
  return 0L;
}

deRfun sigTake(long caller): long {
  long index = taskFind(caller);
  if (index < 0L) {
    return 0L;
  }
  Task* task = taskAt(index);
  long sig = 1L;
  while (sig <= 31L) {
    if (sig != 9L) {
      long mask = sigMask(sig);
      if (task.sig / mask % 2L == 1L) {
        task.sig = task.sig - mask;
        return sig;
      }
    }
    sig = sig + 1L;
  }
  return 0L;
}

/* 丢掉指定的那一格。这颗核心上还有别的任务时不卸下，留给调度把下一份放回去。 */
deRfun reapIndex(long index): void {
  if (index < 0L) {
    return;
  }
  long core = taskAt(index).core;
  taskRelease(index);
  if (taskCount(core) == 0L) {
    obr::os::release(core);
  }
}

/* 停住的核心变成僵尸。1 号自己退出就收掉。父任务不在时改挂到 1 号；1 号也不在就立刻收掉。
   父任务正在等它，就把退出码交回去再收掉。否则留着，等以后的 wait。 */
deRfun procExit(long core, long code): void {
  long index = taskFind(core);
  if (index < 0L) {
    return;
  }
  Task* task = taskAt(index);
  if (task.state == TaskState::Zombie || task.state == TaskState::Empty) {
    return;
  }
  task.state = TaskState::Zombie;
  task.code = code;
  /* 不会再被放回去。槽交还给还没领到槽的任务。 */
  task.held = 0L;
  long pid = task.pid;
  if (pid == 1L) {
    reapIndex(index);
    return;
  }
  long parent = task.ppid;
  if (taskByPid(parent) < 0L) {
    if (taskByPid(1L) >= 0L) {
      task.ppid = 1L;
      parent = 1L;
    } else {
      reapIndex(index);
      return;
    }
  }
  long parentIndex = taskByPid(parent);
  Task* owner = taskAt(parentIndex);
  if (owner.state != TaskState::Sleeping) {
    return;
  }
  if (owner.waitFor != -1L && owner.waitFor != pid) {
    return;
  }
  long parentCore = owner.core;
  long home = query(1L, 8L, parentCore);
  memory::store64(code, home + 192L);
  owner.waitFor = 0L;
  reapIndex(index);
  reply(parentCore, pid);
}

/* 等一个子任务。home+128 是 pid，0 表示任意一个。成功时回复 pid，退出码写在 +192。没有子任务回复 2。子任务还在跑则先睡下，回复 -2 表示先不要应答这次调用。 */
deRfun procWait(long caller, long home): long {
  long self = taskFind(caller);
  if (self < 0L) {
    return -1L;
  }
  Task* me = taskAt(self);
  long want = memory::load64(home + 128L);
  if (want < 0L) {
    return 13L;
  }
  long live = 0L;
  long index = 0L;
  long end = taskScanEnd();
  while (index < end) {
    Task* child = taskAt(index);
    if (child.pid != 0L && child.ppid == me.pid && (want == 0L || want == child.pid)) {
      if (child.state == TaskState::Zombie) {
        long pid = child.pid;
        long code = child.code;
        reapIndex(index);
        memory::store64(code, home + 192L);
        return pid;
      }
      live = 1L;
    }
    index = index + 1L;
  }
  if (live == 0L) {
    return 2L;
  }
  if (want == 0L) {
    me.waitFor = -1L;
  } else {
    me.waitFor = want;
  }
  schedSleep(caller);
  return -2L;
}

/* 监督核的保持位里如果正是这颗核刚交上的调用，丢掉。
   正停在系统调用里时，调用可能还没被 take。先卸核心再派，会打到已经收掉的任务上。
   空保持位取不到。不是这颗核的调用原样放回去，高 32 位仍是原来的核心号。 */
deRfun dropOwnCall(long core): void {
  long value = 0L;
  if (obr::os::take(&value) != 1L) {
    return;
  }
  if (value / 4294967296L != core) {
    obr::os::pass(obr::os::core(), value);
  }
}

/* Ctrl+C 要停掉正在被等的子进程。只认一个 Sleeping 且 waitFor 不是 0 的任务。
   没有，或者没能停掉，返回 0，键盘仍入队字节 3。真正停掉才返回 1，这次不要入队。
   1 号自己一直在 wait，行编辑时壳的 waitFor 仍是 0。把 1 号算成等待者的话，字节 3 永远进不了队列。
   所以 1 号不作这次的等待者，也不杀 pid 1。
   waitFor 大于 0 就是那个 pid。等于 -1 时，找 ppid 是这个等待者、还没成僵尸的子进程，只停第一个。
   子进程若在等待者自己那颗核上，或就在监督核上，不停。
   退出码是 130，即 128 加中断信号 2。不另设信号 9，免得同一圈 schedSweep 再按 9 收一次。
   不把子进程改成就绪，也不再 schedule。
   停止原因 2 是正停在系统调用里。空转把执行位留成 1，原因仍是 2，所以先看原因。
   这条不 capture。正在跑才先拿槽再 capture，停在下一条。已经停着的直接收。
   拿不到槽就不停。父任务正在等时，procExit 会把 130 回复过去。
   procExit 收的是这颗核上 taskFind 的那一格。对不上这个子进程就不动。 */
deRfun procBreak(): long {
  long index = 0L;
  long end = taskScanEnd();
  long waiter = -1L;
  while (index < end) {
    Task* task = taskAt(index);
    if (task.pid > 1L && task.state == TaskState::Sleeping && task.waitFor != 0L) {
      waiter = index;
      break;
    }
    index = index + 1L;
  }
  if (waiter < 0L) {
    return 0L;
  }
  Task* parent = taskAt(waiter);
  long parentPid = parent.pid;
  long parentCore = parent.core;
  long want = parent.waitFor;
  long child = -1L;
  if (want > 0L) {
    child = taskByPid(want);
  } else if (want == -1L) {
    long scan = 0L;
    while (scan < end) {
      Task* task = taskAt(scan);
      if (task.pid > 1L && task.ppid == parentPid && task.state != TaskState::Zombie) {
        child = scan;
        break;
      }
      scan = scan + 1L;
    }
  }
  if (child < 0L) {
    return 0L;
  }
  Task* who = taskAt(child);
  if (who.pid <= 1L || who.state == TaskState::Zombie || who.state == TaskState::Empty) {
    return 0L;
  }
  long core = who.core;
  if (core == parentCore || core == obr::os::core()) {
    return 0L;
  }
  if (taskFind(core) != child) {
    return 0L;
  }
  long running = query(1L, 5L, core);
  long why = query(1L, 11L, core);
  if (why != 2L && running != 0L) {
    long slot = slotHold(child);
    if (slot < 0L) {
      return 0L;
    }
    obr::os::capture(core, slot);
  }
  dropOwnCall(core);
  procExit(core, 130L);
  return 1L;
}

/* 父任务已经不在的僵尸，能挂到 1 号就挂过去，留给它的 wait。1 号也不在才收掉。 */
deRfun procCollect(): void {
  long index = 0L;
  long end = taskScanEnd();
  while (index < end) {
    Task* task = taskAt(index);
    if (task.state == TaskState::Zombie && task.pid != 1L && taskByPid(task.ppid) < 0L) {
      if (taskByPid(1L) >= 0L) {
        task.ppid = 1L;
      } else {
        reapIndex(index);
      }
    }
    index = index + 1L;
  }
}

/* 任务表。凭证、名次、槽和任务的生灭。表放在监督核窗口里。
   不管客核堆池，不管信号、退出和等待。 */
#LINK /start.obr, /sched.obr, /vfs.obr, /exec.obr, /mm.obr, /pipe.obr, /dev.obr, /console.obr, /comm.obr, /pool.obr, /sig.obr, /boot.obr, /spawn.obr
import proc;
import fs;
import memory;

deRfun kFloor(): long {
  return 1024L * 1024L;
}

deRfun kSlot(): long {
  return 268435456L;
}

deRfun kSpan(): long {
  return 137904128L;
}

deRfun kArena(long core): long {
  return kFloor() + core * kSlot();
}

deRfun fsCore(): long {
  return 4L;
}

deRfun taskLimit(): long {
  return 512L;
}

/* 优先级不进 Task 的 19 个字。每个任务一个八位组，落在兼容描述之后、任务表 65536 之前。
   0 是空，1 是后台，2 是前台。前台同一档轮转；后台只在没有更高档就绪时才上核。
   49152 起再留 8 个八位组，一核一个，给宿主看这颗核上正在跑的是哪一档。
   紧接着的一个八位组是停机字。写成 1 表示 1 号被信号打中，宿主据此画失败帧。
   49280 起的一个字是堆的颗粒游标，由堆使用，不是任务的第 20 个字。
   49344 起的一个字是这一轮消息上限。没有前台在跑或就绪时是 16777216，有前台时是 268435456。
   这是上限，不是每次必须送满的长度。宿主满一段再加倍，没有前台就收回默认值。 */
deRfun rankAt(long index): long {
  return kArena(2L) + 45056L + index * 8L;
}

deRfun rankGet(long index): long {
  long value = memory::loadOctet(rankAt(index));
  if (value < 0L) {
    value = value + 256L;
  }
  return value;
}

deRfun rankSet(long index, long rank): void {
  if (index < 0L || index >= taskLimit()) {
    return;
  }
  memory::storeOctet(rank, rankAt(index));
}

/* 已占用下标的上界，不含这一格。放在控制台暂存清零区之后、字体表 +20480 之前。
   调度每一圈都要扫表。空槽一直扫到 512 时，按一个键要等十几秒。
   新任务从低位往上占，扫到这里就够。释放后不把上界往回缩，中间的空槽仍算在里面。 */
deRfun taskSpan(): long {
  return kArena(2L) + 13248L;
}

deRfun taskScanEnd(): long {
  long end = memory::load64(taskSpan());
  if (end < 0L) {
    return 0L;
  }
  if (end > taskLimit()) {
    return taskLimit();
  }
  return end;
}

deRfun taskNote(long index): void {
  if (index + 1L > memory::load64(taskSpan())) {
    memory::store64(index + 1L, taskSpan());
  }
}

/* 协议把一颗实现的上下文槽定在 1 至 256。官方标定取满 256。 */
deRfun slotLimit(): long {
  return 256L;
}

/* 与 proc.mr 里 Task 的 19 个字一致。 */
deRfun taskStride(): long {
  return 19L * 64L;
}

/* 低地址留给调用帧和引导用的几个字。表从这里排 512 份。 */
deRfun tableBase(): long {
  return kArena(2L) + 65536L;
}

/* 12416 是下一个 pid。终端格子改放在内存文件正文之后，这里的两个字不再当光标。
   +20480 起是系统字体表，每份两个字，字体层使用。+32768 起是驱动路径。 */
deRfun pidWord(): long {
  return kArena(2L) + 12416L;
}

deRfun taskAt(long index): Task* {
  return (Task*)(tableBase() + index * taskStride());
}

/* 正在跑的优先，其次是堵在系统调用里的，再其次是还没收掉的僵尸。就绪的只在没有这三类时才返回。 */
deRfun taskFind(long core): long {
  long index = 0L;
  long sleeping = -1L;
  long zombie = -1L;
  long other = -1L;
  long end = taskScanEnd();
  while (index < end) {
    Task* task = taskAt(index);
    if (task.pid != 0L && task.core == core) {
      if (task.state == TaskState::Running) {
        return index;
      }
      if (task.state == TaskState::Sleeping && sleeping < 0L) {
        sleeping = index;
      }
      if (task.state == TaskState::Zombie && zombie < 0L) {
        zombie = index;
      }
      if (other < 0L) {
        other = index;
      }
    }
    index = index + 1L;
  }
  if (sleeping >= 0L) {
    return sleeping;
  }
  if (zombie >= 0L) {
    return zombie;
  }
  return other;
}

/* 这一轮允许的消息上限。有前台在跑或就绪时，宿主可以一路加到 256MB。否则停在 16MB。 */
deRfun spanMark(): long {
  return kArena(2L) + 49344L;
}

deRfun spanChoose(): long {
  long index = 0L;
  long end = taskScanEnd();
  while (index < end) {
    Task* task = taskAt(index);
    if (task.pid != 0L) {
      long state = task.state;
      if (state == TaskState::Running || state == TaskState::Ready) {
        if (rankGet(index) >= 2L) {
          return 268435456L;
        }
      }
    }
    index = index + 1L;
  }
  return 16777216L;
}

deRfun spanPublish(): void {
  long next = spanChoose();
  long mark = spanMark();
  if (memory::load64(mark) == next) {
    return;
  }
  memory::store64(next, mark);
}

/* 监督核把这颗核心上正在跑的档写出去。宿主按这一档决定让不让、给多大一块。
   先写下这一轮的消息上限，调度把脏字送出之后，客程序第一次缺页就已经能用新上限。 */
deRfun rankPublish(long core): void {
  spanPublish();
  if (core < 0L || core > 7L) {
    return;
  }
  long rank = 0L;
  long index = taskFind(core);
  if (index >= 0L) {
    rank = rankGet(index);
  }
  memory::storeOctet(rank, kArena(2L) + 49152L + core * 8L);
}

deRfun taskCount(long core): long {
  long count = 0L;
  long index = 0L;
  long end = taskScanEnd();
  while (index < end) {
    Task* task = taskAt(index);
    if (task.pid != 0L && task.core == core) {
      count = count + 1L;
    }
    index = index + 1L;
  }
  return count;
}

/* except 是正在让出的那一格。-1 表示从第 0 格找。只返回已经抄进槽的就绪任务。
   从 except 的下一格起绕一圈，先等到的先跑，不总是表里最靠前的那一格。 */
deRfun taskReady(long core, long except): long {
  long end = taskScanEnd();
  long start = 0L;
  if (except >= 0L) {
    start = except + 1L;
  }
  long step = 0L;
  while (step < end) {
    long index = start + step;
    if (index >= end) {
      index = index - end;
    }
    if (index != except) {
      Task* task = taskAt(index);
      if (task.pid != 0L && task.core == core && task.state == TaskState::Ready && task.held > 0L) {
        return index;
      }
    }
    step = step + 1L;
  }
  return -1L;
}

/* 只在指定的一档里绕圈。同一档的前台这样分一颗核，不总是表里最靠前的那一格。 */
deRfun taskReadyRank(long core, long except, long rank): long {
  long end = taskScanEnd();
  long start = 0L;
  if (except >= 0L) {
    start = except + 1L;
  }
  long step = 0L;
  while (step < end) {
    long index = start + step;
    if (index >= end) {
      index = index - end;
    }
    if (index != except) {
      Task* task = taskAt(index);
      if (task.pid != 0L && task.core == core && task.state == TaskState::Ready && task.held > 0L && rankGet(index) == rank) {
        return index;
      }
    }
    step = step + 1L;
  }
  return -1L;
}

/* 就绪且已经进槽的任务里，最高的那一档。没有就返回 -1。正在跑的那一格不算。 */
deRfun taskBestRank(long core, long except): long {
  long best = 0L;
  long found = 0L;
  long end = taskScanEnd();
  long index = 0L;
  while (index < end) {
    if (index != except) {
      Task* task = taskAt(index);
      if (task.pid != 0L && task.core == core && task.state == TaskState::Ready && task.held > 0L) {
        long rank = rankGet(index);
        if (found == 0L || rank > best) {
          best = rank;
          found = 1L;
        }
      }
    }
    index = index + 1L;
  }
  if (found == 0L) {
    return -1L;
  }
  return best;
}

/* 壳停在读键盘时，任务都在睡。这时候不必每圈都问宿主谁还在跑。 */
deRfun schedIdle(): long {
  long index = 0L;
  long end = taskScanEnd();
  while (index < end) {
    long state = taskAt(index).state;
    if (state == TaskState::Running || state == TaskState::Ready) {
      return 0L;
    }
    index = index + 1L;
  }
  return 1L;
}

/* 有档就只在最高档里挑。没有分档的旧任务仍走原来的绕圈。 */
deRfun taskPrefer(long core, long except): long {
  long best = taskBestRank(core, except);
  if (best < 1L) {
    return taskReady(core, except);
  }
  return taskReadyRank(core, except, best);
}

/* 只在引导调用一次。上电后的内存每个八位组都是 0，Empty、身份、档和命令名不用再写。
   核心号 0 是一颗真的核，空任务写成 -1，才不会看起来坐在核心 0 上。
   pid 从 1 起。spanPublish 把这一轮的搬运上限交出去。 */
deRfun taskClear(): void {
  long index = 0L;
  while (index < taskLimit()) {
    Task* task = taskAt(index);
    task.core = -1L;
    index = index + 1L;
  }
  memory::store64(1L, pidWord());
  spanPublish();
}

/* 1 号留给用户态 init。之后 nextPid 从 2 起，驱动不会占掉 1。 */
deRfun reserveOne(): void {
  memory::store64(2L, pidWord());
}

deRfun taskRelease(long index): void {
  if (index < 0L) {
    return;
  }
  vfsForgetTask(index);
  long pid = taskAt(index).pid;
  devDrop(pid);
  long other = 0L;
  long end = taskScanEnd();
  while (other < end) {
    if (other != index && taskAt(other).ppid == pid && pid != 0L) {
      taskAt(other).ppid = 1L;
    }
    other = other + 1L;
  }
  Task* task = taskAt(index);
  if (task.core >= 3L && task.mm.heap != 0L && task.mm.length > 0L) {
    poolGive(task.core, task.mm.heap, task.mm.length);
    task.mm.heap = 0L;
    task.mm.length = 0L;
  }
  task.pid = 0L;
  task.ppid = 0L;
  task.state = TaskState::Empty;
  task.core = -1L;
  task.code = 0L;
  task.waitFor = 0L;
  task.held = 0L;
  task.mm.freeHead = 0L;
  task.sig = 0L;
  rankSet(index, 0L);
  commClear(index);
}

deRfun taskDrop(long core): void {
  taskRelease(taskFind(core));
}

deRfun nextPid(): long {
  long at = pidWord();
  long value = memory::load64(at);
  if (value < 1L) {
    value = 1L;
  }
  memory::store64(value + 1L, at);
  return value;
}


/* 0 至 255 优先用和下标相同的槽。256 至 511 以及被占的下标，领任意一格空槽。领不到是 -1。 */
deRfun slotBusy(long slot): long {
  long index = 0L;
  long end = taskScanEnd();
  while (index < end) {
    if (taskAt(index).held == slot + 1L) {
      return 1L;
    }
    index = index + 1L;
  }
  return 0L;
}

deRfun slotPick(long index): long {
  if (index >= 0L && index < slotLimit() && slotBusy(index) == 0L) {
    return index;
  }
  long slot = 0L;
  while (slot < slotLimit()) {
    if (slotBusy(slot) == 0L) {
      return slot;
    }
    slot = slot + 1L;
  }
  return -1L;
}

/* 已经抄过就用原来的槽。否则领一格并记成槽号加 1，0 仍表示还没进槽。 */
deRfun slotHold(long index): long {
  if (index < 0L) {
    return -1L;
  }
  long have = taskAt(index).held;
  if (have > 0L) {
    return have - 1L;
  }
  long slot = slotPick(index);
  if (slot < 0L) {
    return -1L;
  }
  taskAt(index).held = slot + 1L;
  return slot;
}

deRfun taskSpawn(long core, long pid, long uid, long gid, long cap, long state): long {
  if (core < 2L || core > 7L || pid < 1L) {
    return 0L;
  }
  /* 监督核只有一份。用户核不再按份数封顶，堆池或任务表用尽才拒绝。 */
  if (core == 2L && taskFind(core) >= 0L) {
    return 0L;
  }
  long index = 0L;
  while (index < taskLimit() && taskAt(index).pid != 0L) {
    index = index + 1L;
  }
  if (index >= taskLimit()) {
    return 0L;
  }
  long heap = heapOf(core);
  if (heap == 0L) {
    return 0L;
  }
  Task* task = taskAt(index);
  task.pid = pid;
  task.ppid = 1L;
  task.state = state;
  task.core = core;
  task.cred.uid = uid;
  task.cred.gid = gid;
  task.cred.euid = uid;
  task.cred.egid = gid;
  if (core == 2L) {
    task.mm.origin = kArena(core);
    task.mm.length = kSpan();
  } else {
    task.mm.origin = heap;
    task.mm.length = memory::load64(heap - 128L);
  }
  task.mm.heap = heap;
  task.mm.brk = task.mm.heap;
  task.mm.freeHead = 0L;
  task.cap = cap;
  task.cwd = 0L;
  task.sig = 0L;
  task.code = 0L;
  task.waitFor = 0L;
  task.held = 0L;
  /* 新任务先当后台。交互壳和它等着的子任务再升到前台。 */
  rankSet(index, 1L);
  taskNote(index);
  return pid;
}

/* 没有任务就拒绝。装入和卸下要管理权的最低位。只有 euid 0、没有这一位，不能装入。 */
deRfun taskAllows(long core, long service): long {
  long index = taskFind(core);
  if (index < 0L) {
    return 0L;
  }
  Task* task = taskAt(index);
  if (task.pid == 0L || task.state == TaskState::Empty) {
    return 0L;
  }
  if (service == 12L || service == 13L) {
    if (task.cap % 2L == 1L) {
      return 1L;
    }
    return 0L;
  }
  return 1L;
}

/* 服务 32。身份就在凭证里，不另开字段。 */
deRfun doIdent(long caller, long home): long {
  long taskIndex = taskFind(caller);
  if (taskIndex < 0L) {
    return -1L;
  }
  Task* task = taskAt(taskIndex);
  memory::store64(task.cred.uid, home + 128L);
  memory::store64(task.cred.gid, home + 192L);
  memory::store64(task.cred.euid, home + 256L);
  memory::store64(task.cred.egid, home + 320L);
  return 0L;
}

deRfun stateCode(long index): long {
  if (taskAt(index).state == TaskState::Running) {
    return 1L;
  }
  if (taskAt(index).state == TaskState::Ready) {
    return 2L;
  }
  if (taskAt(index).state == TaskState::Sleeping) {
    return 3L;
  }
  if (taskAt(index).state == TaskState::Stopped) {
    return 4L;
  }
  if (taskAt(index).state == TaskState::Zombie) {
    return 5L;
  }
  return 0L;
}

/* 服务 33。任何有任务的客程序都能扫。名字在格子后面的表里，不在这 19 个字中。 */
deRfun doTask(long caller, long home): long {
  if (taskFind(caller) < 0L) {
    return -1L;
  }
  long index = memory::load64(home + 128L);
  if (index < 0L) {
    index = 0L;
  }
  long end = taskScanEnd();
  while (index < end) {
    Task* task = taskAt(index);
    if (task.pid != 0L && task.state != TaskState::Empty) {
      long bytes = home + 131072L;
      memory::store64(task.pid, bytes);
      memory::store64(task.ppid, bytes + 64L);
      memory::store64(stateCode(index), bytes + 128L);
      memory::store64(task.core, bytes + 192L);
      memory::store64(task.cred.uid, bytes + 256L);
      memory::store64(task.cred.gid, bytes + 320L);
      memory::store64(task.cred.euid, bytes + 384L);
      memory::store64(task.cred.egid, bytes + 448L);
      memory::store64(task.mm.origin, bytes + 512L);
      memory::store64(task.mm.length, bytes + 576L);
      memory::store64(rankGet(index), bytes + 640L);
      long nameLen = commLen(index);
      memory::store64(nameLen, bytes + 704L);
      long step = 0L;
      while (step < nameLen) {
        memory::storeOctet(commByte(index, step), bytes + 768L + step * 8L);
        step = step + 1L;
      }
      memory::store64(index, home + 192L);
      memory::store64(index + 1L, home + 320L);
      return 0L;
    }
    index = index + 1L;
  }
  memory::store64(taskLimit(), home + 320L);
  return 2L;
}

deRfun taskByPid(long pid): long {
  long index = 0L;
  long end = taskScanEnd();
  while (index < end) {
    if (taskAt(index).pid == pid && pid != 0L) {
      return index;
    }
    index = index + 1L;
  }
  return -1L;
}

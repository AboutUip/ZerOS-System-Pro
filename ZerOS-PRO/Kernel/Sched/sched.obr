/* 调度。用户核上的任务数不再按核封顶。同一核上前台优先：更高档立刻抢占，同一档轮转。
   后台只有在没有更高档就绪时才换上。前台自己停住或时间片让出之后，后台马上可以上。
   停在系统调用里的不换。停机的交给进程层。领不到槽的不换。跨核的让法在宿主，不在这一圈。 */
#LINK /start.obr, /exec.obr, /vfs.obr, /task.obr, /pipe.obr, /dev.obr, /sig.obr, /boot.obr, /spawn.obr
import proc;
import board;
import obr.os;

export deRfun schedWake(long core): void {
  long index = taskFind(core);
  if (index < 0L) {
    return;
  }
  Task* task = taskAt(index);
  task.state = TaskState::Running;
  rankPublish(core);
  obr::os::schedule(core);
}

deRfun schedSleep(long core): void {
  long index = taskFind(core);
  if (index < 0L) {
    return;
  }
  taskAt(index).state = TaskState::Sleeping;
}

deRfun schedStop(long core): void {
  long index = taskFind(core);
  if (index < 0L) {
    return;
  }
  taskAt(index).state = TaskState::Stopped;
}

/* 槽号由进程层分配，不必等于任务表下标。放回后仍要 schedule 才会跑。没有就绪的兄弟就什么也不做。 */
deRfun schedResume(long core): void {
  long next = taskPrefer(core, -1L);
  if (next < 0L) {
    return;
  }
  long slot = taskAt(next).held - 1L;
  if (slot < 0L) {
    return;
  }
  obr::os::restore(core, slot);
  taskAt(next).state = TaskState::Running;
  rankPublish(core);
  obr::os::schedule(core);
}

deRfun schedSweep(): void {
  procCollect();
  long core = 3L;
  while (core < 8L) {
    long index = taskFind(core);
    if (index >= 0L) {
      long running = query(1L, 5L, core);
      long why = query(1L, 11L, core);
      long state = taskAt(index).state;
      if (running == 0L && sigPendingKill(core) == 1L) {
        procExit(core, 9L);
        /* 停在系统调用里时不能换任务，否则稍后的回复会落到另一份上。 */
        if (why != 2L) {
          schedResume(core);
        }
      } else if (running == 0L && why == 0L && state == TaskState::Running) {
        procExit(core, 0L);
        schedResume(core);
      } else if (running == 0L && why == 1L && state != TaskState::Sleeping && state != TaskState::Zombie && state != TaskState::Empty) {
        long next = -1L;
        if (state == TaskState::Running) {
          next = taskPrefer(core, index);
        }
        if (next >= 0L) {
          long from = slotHold(index);
          long to = taskAt(next).held - 1L;
          if (from >= 0L && to >= 0L) {
            obr::os::capture(core, from);
            taskAt(index).state = TaskState::Ready;
            obr::os::restore(core, to);
            taskAt(next).state = TaskState::Running;
            rankPublish(core);
            obr::os::schedule(core);
          }
        } else {
          taskAt(index).state = TaskState::Ready;
          obr::os::schedule(core);
          taskAt(index).state = TaskState::Running;
          rankPublish(core);
        }
      }
    }
    core = core + 1L;
  }
}

/* 30 Hz 空转前调用一次。核心还在取指，且同核有一份在槽里的就绪任务，capture 会先停在下一条再抄走。 */
deRfun schedTick(): void {
  long core = 3L;
  while (core < 8L) {
    long index = taskFind(core);
    if (index >= 0L) {
      long running = query(1L, 5L, core);
      long why = query(1L, 11L, core);
      long state = taskAt(index).state;
      if (running == 1L && why != 2L && state == TaskState::Running) {
        long mine = rankGet(index);
        long best = taskBestRank(core, index);
        /* 更高档抢占。同一档轮转，多个前台分这颗核。更低档让着，等前台自己停。 */
        if (best > mine || (best == mine && best > 0L)) {
          long next = taskReadyRank(core, index, best);
          if (next >= 0L) {
            long from = slotHold(index);
            long to = taskAt(next).held - 1L;
            if (from >= 0L && to >= 0L) {
              obr::os::capture(core, from);
              taskAt(index).state = TaskState::Ready;
              obr::os::restore(core, to);
              taskAt(next).state = TaskState::Running;
              rankPublish(core);
              obr::os::schedule(core);
            }
          }
        }
      }
    }
    core = core + 1L;
  }
}

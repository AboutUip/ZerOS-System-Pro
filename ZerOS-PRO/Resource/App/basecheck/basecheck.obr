#DYN
/* 键盘 continuity 的 base 断言：base 必须 > 0（旧实例导出过）。
   250 = base 0，253 = 服务 59 没有 32 字节状态，0 = 通过。 */
import memory;
import obr.os;
import obr.proc;

deRfun main(): int {
  long home = obr::proc::home();
  obr::os::dwell(200L);
  memory::store64(2L, home + 64L);
  long count = obr::os::svc(59L);
  if (count != 32L) {
    memory::store64(253L, home + 128L);
    obr::os::svc(28L);
    return 0;
  }
  long base = memory::load64(home + 131136L);
  long code = 0L;
  if (base < 1L) {
    code = 250L;
  }
  memory::store64(code, home + 128L);
  obr::os::svc(28L);
  return 0;
}

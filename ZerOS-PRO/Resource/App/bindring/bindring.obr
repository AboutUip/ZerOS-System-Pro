#DYN
/* 导出 core-3 legacy bind ring 到 /temp/bindring.bin（64 字节）。 */
import memory;
import obr.os;
import obr.proc;

deRfun setPath(long home, string path): void {
  long count = length(path);
  memory::store64(count, home + 16384L);
  long index = 0L;
  while (index < count) {
    memory::storeOctet(path[index], home + 16384L + 64L + index * 8L);
    index = index + 1L;
  }
}

deRfun main(): int {
  long home = obr::proc::home();
  long got = obr::os::svc(79L);
  if (got != 64L) {
    home = obr::proc::home();
    memory::store64(1L, home + 128L);
    obr::os::svc(28L);
    return 0;
  }
  home = obr::proc::home();
  setPath(home, "/temp/bindring.bin");
  memory::store64(1L, home + 128L);
  if (obr::os::svc(5L) != 0L) {
    home = obr::proc::home();
    memory::store64(2L, home + 128L);
    obr::os::svc(28L);
    return 0;
  }
  long fd = memory::load64(home + 192L);
  memory::store64(fd, home + 128L);
  memory::store64(0L, home + 192L);
  memory::store64(512L, home + 256L);
  obr::os::svc(8L);
  memory::store64(fd, home + 128L);
  obr::os::svc(6L);
  home = obr::proc::home();
  memory::store64(0L, home + 128L);
  obr::os::svc(28L);
  return 0;
}
#DYN
/* 服务 64（指针环累计计数）写到 /temp/count64.txt（8 字节小端）。 */
import memory;
import obr.os;
import obr.proc;

deRfun setPath(long home, string path): void {
  long count = length(path);
  memory::store64(count, home + 16384L);
  long index = 0L;
  while (index < count) {
    memory::storeOctet(path[index], home + 16384L + 64L + index * 8L);
    index = index + 1L;
  }
}

deRfun main(): int {
  long value = obr::os::svc(64L);
  long home = obr::os::svc(65L);
  setPath(home, "/temp/count64.txt");
  memory::store64(1L, home + 128L);
  long code = 0L;
  if (obr::os::svc(5L) == 0L) {
    long fd = memory::load64(home + 192L);
    long word = value;
    long index = 0L;
    while (index < 8L) {
      memory::storeOctet(word % 256L, home + 131072L + index * 8L);
      word = word / 256L;
      index = index + 1L;
    }
    memory::store64(fd, home + 128L);
    memory::store64(0L, home + 192L);
    memory::store64(8L, home + 256L);
    obr::os::svc(8L);
    memory::store64(fd, home + 128L);
    obr::os::svc(6L);
  } else {
    code = 253L;
  }
  home = obr::os::svc(65L);
  memory::store64(value % 256L, home + 128L);
  obr::os::svc(28L);
  return 0;
}
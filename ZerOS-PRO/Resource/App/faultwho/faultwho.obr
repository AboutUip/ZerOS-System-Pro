#DYN
/* 读取 core 3 的 fault pid，写到 /temp/faultwho.txt（8 字节小端），
   退出码 = pid 低 8 位。253 表示服务没有回复。 */
import memory;
import obr.os;
import obr.proc;

deRfun setPath(long home, string path): void {
  long count = length(path);
  memory::store64(count, home + 16384L);
  long index = 0L;
  while (index < count) {
    memory::storeOctet(path[index], home + 16384L + 64L + index * 8L);
    index = index + 1L;
  }
}

deRfun main(): int {
  long home = obr::proc::home();
  memory::store64(3L, home + 128L);
  long pid = obr::os::svc(81L);
  home = obr::proc::home();
  setPath(home, "/temp/faultwho.txt");
  memory::store64(1L, home + 128L);
  long code = pid % 256L;
  if (obr::os::svc(5L) == 0L) {
    long fd = memory::load64(home + 192L);
    long word = pid;
    long index = 0L;
    while (index < 8L) {
      memory::storeOctet(word % 256L, home + 131072L + index * 8L);
      word = word / 256L;
      index = index + 1L;
    }
    memory::store64(fd, home + 128L);
    memory::store64(0L, home + 192L);
    memory::store64(8L, home + 256L);
    obr::os::svc(8L);
    memory::store64(fd, home + 128L);
    obr::os::svc(6L);
  } else {
    code = 253L;
  }
  home = obr::proc::home();
  memory::store64(code, home + 128L);
  obr::os::svc(28L);
  return 0;
}
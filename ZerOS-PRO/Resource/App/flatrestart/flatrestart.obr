#DYN
/* Stage C restart 验证：装 nic-v1，运行 2 秒，再用服务 55 换成 nic-v2。
   退出码 0 = 两次装入都成功；1 = 首次失败；2 = 重启失败。 */
import memory;
import obr.os;
import obr.print;
import obr.proc;

deRfun setPath(long home, string path): void {
  long count = length(path);
  memory::store64(count, home + 16384L);
  long index = 0L;
  while (index < count) {
    memory::storeOctet(path[index], home + 16384L + 64L + index * 8L);
    index = index + 1L;
  }
}

deRfun main(): int {
  long home = obr::proc::home();
  setPath(home, "/drivers/nic-v1.zo");
  long first = obr::os::svc(46L);
  if (first != 0L) {
    return 1;
  }
  long oldPid = obr::proc::slot(home, 192L);
  obr::os::dwell(1000L);
  obr::os::dwell(1000L);
  setPath(home, "/drivers/nic-v2.zo");
  long rounds = 0L;
  long status = 1L;
  while (rounds < 200L) {
    memory::store64(oldPid, home + 128L);
    status = obr::os::svc(55L);
    if (status == 0L) {
      break;
    }
    obr::os::dwell(100L);
    rounds = rounds + 1L;
  }
  if (status != 0L) {
    return 2;
  }
  obr::os::dwell(1000L);
  obr::os::dwell(1000L);
  obr::print::text(home, "restart ok\n");
  obr::print::flush(home);
  return 0;
}

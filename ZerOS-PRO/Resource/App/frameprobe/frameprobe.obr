#DYN
/* 诊断：服务 37 帧号在 500ms 内的增量（0..200）。 */
import memory;
import obr.os;
import obr.proc;

deRfun main(): int {
  long home = obr::proc::home();
  long first = obr::os::svc(37L);
  obr::os::dwell(500L);
  home = obr::proc::home();
  long second = obr::os::svc(37L);
  long delta = 0L;
  if (second > first) {
    delta = second - first;
  }
  if (delta > 200L) {
    delta = 200L;
  }
  home = obr::proc::home();
  memory::store64(delta, home + 128L);
  obr::os::svc(28L);
  return 0;
}
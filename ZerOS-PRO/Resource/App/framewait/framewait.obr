#DYN
/* 诊断：连续 5 次 frameWait，退出码 = 非负返回次数（0..5）。 */
import memory;
import obr.os;
import obr.proc;

deRfun main(): int {
  long ok = 0L;
  long rounds = 0L;
  while (rounds < 5L) {
    long value = obr::os::svc(38L);
    if (value >= 0L) {
      ok = ok + 1L;
    }
    rounds = rounds + 1L;
  }
  long home = obr::proc::home();
  memory::store64(ok, home + 128L);
  obr::os::svc(28L);
  return 0;
}
#DYN
/* GPU continuity 检查：轮询服务 69，最多 3 秒。
   42 = base>0 且 frames>base。250/251/253 表示 base=0、没有新帧、读不到状态。
   成功时在同一轮立即写退出码，避免最后一次 home/store 的边界。 */
import memory;
import obr.os;
import obr.proc;

deRfun main(): int {
  long code = 253L;
  long rounds = 0L;
  long home = obr::proc::home();
  while (rounds < 60L) {
    home = obr::proc::home();
    memory::store64(2L, home + 64L);
    long count = obr::os::svc(69L);
    if (count == 16L) {
      long frames = memory::load64(home + 131072L);
      long base = memory::load64(home + 131136L);
      if (base < 1L) {
        code = 250L;
      } else if (frames <= base) {
        code = 251L;
      } else {
        memory::store64(42L, home + 128L);
        obr::os::svc(28L);
        return 0;
      }
    }
    obr::os::dwell(50L);
    rounds = rounds + 1L;
  }
  if (home != 0L) {
    memory::store64(code, home + 128L);
  }
  obr::os::svc(28L);
  return 0;
}

#DYN
/* 诊断：服务 69 的 frames（0..200）作为退出码；253 表示读不到状态。 */
import memory;
import obr.os;
import obr.proc;

deRfun main(): int {
  long home = obr::proc::home();
  memory::store64(2L, home + 64L);
  long got = obr::os::svc(69L);
  long code = 253L;
  if (got == 16L) {
    code = memory::load64(home + 131072L);
    if (code > 200L) {
      code = 200L;
    }
  }
  home = obr::proc::home();
  memory::store64(code, home + 128L);
  obr::os::svc(28L);
  return 0;
}
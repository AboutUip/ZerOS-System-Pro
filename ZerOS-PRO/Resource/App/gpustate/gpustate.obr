#DYN
/* 服务 69 的 frames/base 写到 /temp/gpustate.txt（16 字节小端）。 */
import memory;
import obr.os;
import obr.proc;

deRfun setPath(long home, string path): void {
  long count = length(path);
  memory::store64(count, home + 16384L);
  long index = 0L;
  while (index < count) {
    memory::storeOctet(path[index], home + 16384L + 64L + index * 8L);
    index = index + 1L;
  }
}

deRfun putWord(long home, long at, long value): void {
  long index = 0L;
  while (index < 8L) {
    memory::storeOctet(value % 256L, home + at + index * 8L);
    value = value / 256L;
    index = index + 1L;
  }
}

deRfun main(): int {
  long home = obr::proc::home();
  memory::store64(2L, home + 64L);
  long got = obr::os::svc(69L);
  long frames = 0L;
  long base = 0L;
  long code = 253L;
  if (got == 16L) {
    frames = memory::load64(home + 131072L);
    base = memory::load64(home + 131136L);
    code = 0L;
  }
  home = obr::proc::home();
  setPath(home, "/temp/gpustate.txt");
  memory::store64(1L, home + 128L);
  if (obr::os::svc(5L) == 0L) {
    long fd = memory::load64(home + 192L);
    putWord(home, 131072L, frames);
    putWord(home, 131136L, base);
    memory::store64(fd, home + 128L);
    memory::store64(0L, home + 192L);
    memory::store64(16L, home + 256L);
    obr::os::svc(8L);
    memory::store64(fd, home + 128L);
    obr::os::svc(6L);
  }
  home = obr::proc::home();
  memory::store64(code, home + 128L);
  obr::os::svc(28L);
  return 0;
}
#DYN
/* 诊断：连续 50 次 svc65，退出码 = 返回 0 的次数（0..50）。
   253 表示最后一次取 home 失败。 */
import memory;
import obr.os;
import obr.proc;

deRfun main(): int {
  long zeros = 0L;
  long rounds = 0L;
  while (rounds < 50L) {
    long value = obr::os::svc(65L);
    if (value == 0L) {
      zeros = zeros + 1L;
    }
    obr::os::dwell(1L);
    rounds = rounds + 1L;
  }
  long home = obr::proc::home();
  long code = zeros;
  if (home == 0L) {
    code = 253L;
  } else {
    memory::store64(code, home + 128L);
  }
  obr::os::svc(28L);
  return 0;
}
#DYN
/* 诊断：最近一次 svc65 返回的 home 高位（bit20 起 8 位）。0 表示 home=0。 */
import memory;
import obr.os;
import obr.proc;

deRfun main(): int {
  long value = obr::os::svc(67L);
  long code = (value / 1048576L) % 256L;
  long home = obr::proc::home();
  memory::store64(code, home + 128L);
  obr::os::svc(28L);
  return 0;
}

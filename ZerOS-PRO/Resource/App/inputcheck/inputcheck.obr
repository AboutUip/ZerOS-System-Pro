#DYN
/* 输入/GPU 状态 continuity 检查：
   装 inputdev，等 400ms，state 必须为空；
   restart（SIGTERM 导出 24 字节）后 state 必须是 24 字节且 frame>0；
   再跑 400ms 再 restart，frame 必须更大。
   成功返回 0，失败返回阶段号。 */
import memory;
import obr.os;
import obr.print;
import obr.proc;

deRfun setPath(long home, string path): void {
  long count = length(path);
  memory::store64(count, home + 16384L);
  long index = 0L;
  while (index < count) {
    memory::storeOctet(path[index], home + 16448L + index * 8L);
    index = index + 1L;
  }
}

deRfun state(long home): long {
  memory::store64(2L, home + 64L);
  return obr::os::svc(57L);
}

deRfun restart(long home): long {
  setPath(home, "/drivers/inputdev.zo");
  memory::store64(0L, home + 128L);
  memory::store64(3L, home + 64L);
  long status = obr::os::svc(56L);
  long rounds = 0L;
  long waits = 0L;
  while ((status == 11L || status == 12L) && rounds < 80L) {
    if (status == 12L) {
      waits = waits + 1L;
      if (waits > 10L) {
        memory::store64(1L, home + 2048L);
        memory::store64(6L, home + 64L);
      }
    }
    obr::os::dwell(100L);
    status = obr::os::svc(56L);
    rounds = rounds + 1L;
  }
  return status;
}

deRfun main(): int {
  long home = obr::proc::home();
  setPath(home, "/drivers/inputdev.zo");
  memory::store64(1L, home + 64L);
  if (obr::os::svc(56L) != 0L) {
    return 1;
  }
  obr::os::dwell(400L);
  if (state(home) != -1L) {
    return 2;
  }
  if (restart(home) != 0L) {
    return 3;
  }
  obr::os::dwell(200L);
  if (state(home) != 24L) {
    return 4;
  }
  long frame1 = memory::load64(home + 131072L);
  long x1 = memory::load64(home + 131136L);
  long y1 = memory::load64(home + 131200L);
  if (frame1 < 1L || x1 < 0L || x1 >= 80L || y1 < 0L || y1 >= 24L) {
    return 5;
  }
  obr::os::dwell(400L);
  if (restart(home) != 0L) {
    return 6;
  }
  obr::os::dwell(200L);
  if (state(home) != 24L) {
    return 7;
  }
  long frame2 = memory::load64(home + 131072L);
  if (frame2 <= frame1) {
    return 8;
  }
  obr::print::text(home, "input continuity ok\n");
  obr::print::flush(home);
  return 0;
}

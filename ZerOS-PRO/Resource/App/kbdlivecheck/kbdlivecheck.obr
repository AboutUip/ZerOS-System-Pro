#DYN
/* 真实键盘驱动实时状态检查：轮询服务 59（驱动状态）和服务 60（镜像累计写入）。
   断言：
     base > 0            旧实例导出过状态，restart 不是从零开始
     events > base       新实例确实处理了 restart 之后的事件
     events == head      镜像环里没有未处理字节，事件零丢失
     line > 0            真实换行被处理过
   成功 exit 42，失败 exit 1/2 并带具体码。 */
import memory;
import obr.os;
import obr.print;
import obr.proc;

deRfun main(): int {
  long home = obr::proc::home();
  long bad = 1L;
  long rounds = 0L;
  while (rounds < 50L) {
    memory::store64(2L, home + 64L);
    long count = obr::os::svc(59L);
    long head = obr::os::svc(60L);
    if (count == 32L) {
      long events = memory::load64(home + 131072L);
      long base = memory::load64(home + 131136L);
      long line = memory::load64(home + 131200L);
      long col = memory::load64(home + 131264L);
      if (base < 1L) {
        bad = 3L;
      } else if (events <= base) {
        bad = 4L;
      } else if (events != head) {
        bad = 6L;
      } else if (line < 1L || col < 0L) {
        bad = 5L;
      } else {
        bad = 0L;
      }
    }
    if (bad == 0L) {
      break;
    }
    obr::os::dwell(50L);
    rounds = rounds + 1L;
  }
  if (bad != 0L) {
    memory::store64(bad, home + 128L);
    obr::os::svc(28L);
    return 2;
  }
  obr::print::text(home, "kbd live continuity ok\n");
  obr::print::flush(home);
  memory::store64(42L, home + 128L);
  obr::os::svc(28L);
  return 0;
}

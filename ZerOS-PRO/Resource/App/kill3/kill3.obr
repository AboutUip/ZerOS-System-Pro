#DYN
/* 诊断：杀掉核 3 上除 shell（pid 5）以外的任务，看核心 3 能否变成可复用核。 */
import memory;
import obr.os;
import obr.proc;

deRfun main(): int {
  long home = obr::proc::home();
  long start = 0L;
  long killed = 0L;
  while (1L) {
    long status = obr::proc::task(home, start);
    if (status != 0L) {
      break;
    }
    long next = obr::proc::slot(home, 320L);
    long base = home + 131072L;
    long pid = memory::load64(base);
    long core = memory::load64(base + 192L);
    if (core == 3L && pid > 5L) {
      memory::store64(pid, home + 128L);
      memory::store64(9L, home + 192L);
      obr::os::svc(18L);
      killed = killed + 1L;
    }
    if (next == 0L) {
      break;
    }
    start = next;
  }
  memory::store64(killed, home + 128L);
  obr::os::svc(28L);
  return 0;
}

#DYN
/* 诊断：读本任务窗口 +3904 起的装载阶段。shell 和 CLI 共用旧布局窗口。退出码 = 20 + stage。 */
import memory;
import obr.os;

deRfun main(): int {
  long home = obr::os::svc(65L);
  long stage = 0L;
  long origin = 0L;
  long idle = 0L;
  long count = 0L;
  long running = 0L;
  long why = 0L;
  long core = 0L;
  if (home != 0L) {
    stage = memory::load64(home + 3904L);
    origin = memory::load64(home + 3968L);
    idle = memory::load64(home + 4032L);
    count = memory::load64(home + 4096L);
    running = memory::load64(home + 4160L);
    why = memory::load64(home + 4224L);
    core = memory::load64(home + 4288L);
    long code = stage;
    if (code < 0L) {
      code = 0L;
    }
    if (code > 200L) {
      code = 200L;
    }
    memory::store64(20L + code, home + 128L);
    memory::store64(origin, home + 192L);
    memory::store64(idle, home + 256L);
    memory::store64(count, home + 320L);
    memory::store64(running, home + 384L);
    memory::store64(why, home + 448L);
    memory::store64(core, home + 512L);
  }
  obr::os::svc(28L);
  return 0;
}

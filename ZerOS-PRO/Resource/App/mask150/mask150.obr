#DYN
/* 诊断：位图 23（核 3/4/5/7）装 150 个 flatloop，退出码 40 + 实际用到核的 mask。
   50 = 没装够 150，51 = 有创建但位图外落点。 */
import memory;
import obr.os;
import obr.proc;

deRfun setPath(long home, string path): void {
  long count = length(path);
  memory::store64(count, home + 16384L);
  long index = 0L;
  while (index < count) {
    memory::storeOctet(path[index], home + 16384L + 64L + index * 8L);
    index = index + 1L;
  }
}

deRfun main(): int {
  long home = obr::proc::home();
  obr::os::svc(51L);
  long core = 3L;
  while (core < 8L) {
    memory::store64(0L, home + 640L + core * 64L);
    core = core + 1L;
  }
  setPath(home, "/drivers/flatloop.zo");
  memory::store64(23L, home + 1024L);
  long made = 0L;
  long rounds = 0L;
  while (made < 150L && rounds < 80L) {
    memory::store64(150L - made, home + 448L);
    long fresh = obr::os::svc(47L);
    if (fresh > 0L) {
      made = made + fresh;
    }
    obr::os::dwell(200L);
    rounds = rounds + 1L;
  }
  long mask = 0L;
  core = 3L;
  while (core < 8L) {
    long count = memory::load64(home + 640L + core * 64L);
    if (count > 0L) {
      long bit = 1L;
      long step = 0L;
      while (step < core - 3L) {
        bit = bit * 2L;
        step = step + 1L;
      }
      mask = mask + bit;
    }
    core = core + 1L;
  }
  long code = 50L;
  if (made >= 150L) {
    code = 40L + mask;
  }
  memory::store64(code, home + 128L);
  obr::os::svc(28L);
  return 0;
}

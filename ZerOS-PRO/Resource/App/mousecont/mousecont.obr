#DYN
/* 鼠标 restart continuity 检查。
   1. 先在 /temp/mouse.ok 写 0，避免旧结果被当成新结果；
   2. SIGTERM 旧驱动，等它真正退出，必要时 SIGKILL；
   3. 重新装入 /drivers/mouse.zo；
   4. 服务 83 读 (events<<32)|base，只有 base>0、events>=base 才写 42。
   退出码仍写 home+128；判定结果同时落盘，供不重启驱动的 mouseverify 读取。 */
import board;
import memory;
import obr.os;
import obr.proc;

deRfun setPath(long home, string path): void {
  long count = length(path);
  memory::store64(count, home + 16384L);
  long index = 0L;
  while (index < count) {
    memory::storeOctet(path[index], home + 16384L + 64L + index * 8L);
    index = index + 1L;
  }
}

deRfun stamp(long home, long value): void {
  setPath(home, "/temp/mouse.ok");
  if (obr::proc::open(home, 1L) != 0L) {
    return;
  }
  long fd = obr::proc::slot(home, 192L);
  memory::store64(value, obr::proc::bytes(home));
  obr::proc::write(home, fd, 0L, 8L);
  obr::proc::close(home, fd);
}

deRfun liveCount(long home): long {
  memory::store64(10L, home + 64L);
  return obr::os::svc(56L);
}

deRfun waitGone(long home): void {
  long rounds = 0L;
  while (rounds < 200L && liveCount(home) > 0L) {
    obr::os::dwell(50L);
    rounds = rounds + 1L;
  }
}

deRfun main(): int {
  long home = obr::os::svc(65L);
  stamp(home, 0L);
  long packed = obr::os::svc(83L);
  long before = packed >> 32L;
  memory::store64(0L, home + 128L);
  memory::store64(8L, home + 64L);
  obr::os::svc(56L);
  waitGone(home);
  if (liveCount(home) > 0L) {
    memory::store64(0L, home + 128L);
    memory::store64(2L, home + 64L);
    obr::os::svc(56L);
    waitGone(home);
  }
  setPath(home, "/drivers/mouse.zo");
  long status = 11L;
  long tries = 0L;
  while (status == 11L && tries < 30L) {
    memory::store64(0L, home + 128L);
    memory::store64(1L, home + 64L);
    status = obr::os::svc(56L);
    if (status == 11L) {
      obr::os::dwell(100L);
    }
    tries = tries + 1L;
  }
  long code = 253L;
  if (status != 0L) {
    code = 254L;
  } else {
    obr::os::dwell(800L);
    long rounds = 0L;
    while (rounds < 100L) {
      packed = obr::os::svc(83L);
      long base = packed & 4294967295L;
      long events = packed >> 32L;
      if (base > 0L) {
        if (base < before) {
          code = 251L;
        } else if (events < base) {
          code = 252L;
        } else {
          code = 42L;
        }
        break;
      }
      obr::os::dwell(50L);
      rounds = rounds + 1L;
    }
  }
  if (code == 42L) {
    stamp(home, 42L);
  }
  memory::store64(code, home + 128L);
  obr::os::svc(28L);
  while (1L) {
    obr::os::dwell(1000L);
  }
  return 0;
}

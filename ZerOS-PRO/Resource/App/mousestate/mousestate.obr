#DYN
/* 鼠标状态诊断：退出码 = events - base（0..200）；250 base=0，253 无状态。 */
import memory;
import obr.os;
import obr.proc;

deRfun main(): int {
  long home = obr::proc::home();
  obr::os::dwell(300L);
  memory::store64(2L, home + 64L);
  long count = obr::os::svc(62L);
  long code = 253L;
  if (count == 32L) {
    long events = memory::load64(home + 131072L);
    long base = memory::load64(home + 131136L);
    if (base < 1L) {
      code = 250L;
    } else {
      long delta = events - base;
      if (delta < 0L) {
        delta = 0L;
      }
      if (delta > 200L) {
        delta = 200L;
      }
      code = delta;
    }
  }
  memory::store64(code, home + 128L);
  obr::os::svc(28L);
  return 0;
}

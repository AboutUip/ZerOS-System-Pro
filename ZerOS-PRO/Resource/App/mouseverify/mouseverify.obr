#DYN
/* 读取 mousecont 落在 /temp/mouse.ok 的判定。42 = 最近一次 restart 后
   base>0 且 events>=base；250/251 = 文件缺失或不是 42。
   本命令不重启驱动，退出码走普通命令窗口。 */
import memory;
import obr.os;
import obr.proc;

deRfun setPath(long home, string path): void {
  long count = length(path);
  memory::store64(count, home + 16384L);
  long index = 0L;
  while (index < count) {
    memory::storeOctet(path[index], home + 16384L + 64L + index * 8L);
    index = index + 1L;
  }
}

deRfun main(): int {
  long home = obr::os::svc(65L);
  long code = 250L;
  setPath(home, "/temp/mouse.ok");
  if (obr::proc::open(home, 0L) == 0L) {
    long fd = obr::proc::slot(home, 192L);
    if (obr::proc::read(home, fd, 0L, 8L) == 0L) {
      long value = memory::load64(obr::proc::bytes(home));
      if (value == 42L) {
        code = 42L;
      } else {
        code = 251L;
      }
    }
    obr::proc::close(home, fd);
  }
  memory::store64(code, home + 128L);
  obr::os::svc(28L);
  return 0;
}

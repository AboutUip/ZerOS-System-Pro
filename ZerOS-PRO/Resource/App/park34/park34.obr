#DYN
/* 诊断：服务 54 依次 park 核 3 和核 4。退出码 = 20 + 核3状态×10 + 核4状态。 */
import memory;
import obr.os;
import obr.proc;

deRfun main(): int {
  long home = obr::proc::home();
  memory::store64(3L, home + 448L);
  long three = obr::os::svc(54L);
  memory::store64(4L, home + 448L);
  long four = obr::os::svc(54L);
  memory::store64(20L + three * 10L + four, home + 128L);
  obr::os::svc(28L);
  return 0;
}

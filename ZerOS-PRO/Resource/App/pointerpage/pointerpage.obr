#DYN
/* 固件鼠标页快照诊断：退出码 = bit0（7808 有事件）+ bit1（7552 完成数>0）。 */
import memory;
import obr.os;
import obr.proc;

deRfun main(): int {
  long home = obr::proc::home();
  obr::os::dwell(800L);
  memory::store64(2L, home + 64L);
  long got = obr::os::svc(63L);
  long code = 0L;
  if (got == 4L) {
    long flag = memory::load64(home + 131200L);
    long count = memory::load64(home + 131264L);
    if (flag != 0L) {
      code = code + 1L;
    }
    if (count > 0L) {
      code = code + 2L;
    }
  } else {
    code = 9L;
  }
  memory::store64(code, home + 128L);
  obr::os::svc(28L);
  return 0;
}

#DYN
/* 诊断：500ms 内共享页指针环计数增量（0..200），0 表示环没有新事件。 */
import memory;
import obr.os;
import obr.proc;

deRfun main(): int {
  long home = obr::proc::home();
  memory::store64(2L, home + 64L);
  long got = obr::os::svc(63L);
  long first = 0L;
  if (got == 4L) {
    first = memory::load64(home + 131264L);
  }
  obr::os::dwell(500L);
  home = obr::proc::home();
  memory::store64(2L, home + 64L);
  got = obr::os::svc(63L);
  long delta = 0L;
  if (got == 4L) {
    long second = memory::load64(home + 131264L);
    if (second > first) {
      delta = second - first;
    }
  }
  if (delta > 200L) {
    delta = 200L;
  }
  home = obr::proc::home();
  memory::store64(delta, home + 128L);
  obr::os::svc(28L);
  return 0;
}
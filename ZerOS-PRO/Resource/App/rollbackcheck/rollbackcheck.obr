#DYN
/* 多级 rollback 检查：load A → restart B → restart C → rollback 1 → B
   → rollback 1 → A；再 load/restart 到 C，rollback 2 → A。
   成功返回 0，失败返回阶段号。 */
import memory;
import obr.oct;
import obr.os;
import obr.print;
import obr.proc;

deRfun setPath(long home, string path): void {
  long count = length(path);
  memory::store64(count, home + 16384L);
  long index = 0L;
  while (index < count) {
    memory::storeOctet(path[index], home + 16448L + index * 8L);
    index = index + 1L;
  }
}

deRfun callRetry(long home, long op): long {
  memory::store64(op, home + 64L);
  long status = obr::os::svc(56L);
  long rounds = 0L;
  while (status == 11L && rounds < 50L) {
    obr::os::dwell(100L);
    status = obr::os::svc(56L);
    rounds = rounds + 1L;
  }
  return status;
}

deRfun load(long home, string path): long {
  setPath(home, path);
  return callRetry(home, 1L);
}

deRfun restart(long home, string path): long {
  setPath(home, path);
  memory::store64(0L, home + 128L);
  return callRetry(home, 3L);
}

deRfun rollback(long home, long level): long {
  memory::store64(0L, home + 128L);
  memory::store64(level, home + 2112L);
  return callRetry(home, 4L);
}

deRfun samePath(long home, string path): long {
  long want = length(path);
  if (memory::load64(home + 16384L) != want) {
    return 0L;
  }
  return obr::oct::eq(home + 16448L, want, path);
}

deRfun current(long home): long {
  memory::store64(7L, home + 64L);
  return obr::os::svc(56L);
}

deRfun main(): int {
  long home = obr::proc::home();
  if (load(home, "/drivers/plaina.zo") != 0L) {
    return 1;
  }
  obr::os::dwell(100L);
  if (restart(home, "/drivers/plainb.zo") != 0L) {
    return 2;
  }
  obr::os::dwell(100L);
  if (restart(home, "/drivers/plainc.zo") != 0L) {
    return 3;
  }
  obr::os::dwell(100L);
  if (current(home) != 18L || samePath(home, "/drivers/plainc.zo") == 0L) {
    return 4;
  }
  if (rollback(home, 1L) != 0L) {
    return 5;
  }
  obr::os::dwell(100L);
  if (samePath(home, "/drivers/plainb.zo") == 0L) {
    return 6;
  }
  if (rollback(home, 1L) != 0L) {
    return 7;
  }
  obr::os::dwell(100L);
  if (samePath(home, "/drivers/plaina.zo") == 0L) {
    return 8;
  }
  /* 多级跳跃：A → B → C，rollback 2 直接回 A。 */
  if (restart(home, "/drivers/plainb.zo") != 0L) {
    return 9;
  }
  obr::os::dwell(100L);
  if (restart(home, "/drivers/plainc.zo") != 0L) {
    return 10;
  }
  obr::os::dwell(100L);
  if (rollback(home, 2L) != 0L) {
    return 11;
  }
  obr::os::dwell(100L);
  if (samePath(home, "/drivers/plaina.zo") == 0L) {
    return 12;
  }
  obr::print::text(home, "multi-level rollback ok\n");
  obr::print::flush(home);
  return 0;
}

/* 流程类特殊内建：: . break continue eval exec exit return。
   eval 和 . 复用 runText 重解析执行；exec 借 runWord 派生命令后让壳退出。
   只有 exit/return/eval/. 能改变壳的走向，其余只回状态。 */
#DYN
#LINK /sh.obr, /draw.obr, /work.obr, /span.obr, /env.obr, /cd.obr, /run.obr, /complete.obr, /parse.obr, /builtin.obr, /expand.obr, /edit-check.obr, /bcore.obr, /bstate.obr, /bvar.obr, /bflow.obr, /bopt.obr, /bjob.obr, /bcmd.obr, /bio.obr, /builtin-check.obr
import memory;
import obr.proc;
import bcore;
import bstate;
import span;
import parse;
import run;
import draw;
import bflow;


deRfun bfExit(long home, long bs, long state, long work, long out, long env, long envTmp, long body, long cmd, long command, long status, long* leaving): long {
  long code = status;
  if (cmdArgc(cmd) > command + 1L) {
    if (bcDec(cmdArgAt(cmd, command + 1L), cmdArgLen(cmd, command + 1L), &code) != 0L) {
      sayErr(home, "sh: exit: numeric argument required\n");
      code = 2L;
    }
  }
  *leaving = 1L;
  return code;
}


/* 取一个十进制计数参数（break/continue 的 n、return 的 n）。没有取到用缺省。 */
deRfun bfCountArg(long cmd, long command, long fallback, long* bad): long {
  *bad = 0L;
  if (cmdArgc(cmd) <= command + 1L) {
    return fallback;
  }
  long value = 0L;
  if (bcDec(cmdArgAt(cmd, command + 1L), cmdArgLen(cmd, command + 1L), &value) != 0L) {
    *bad = 1L;
    return fallback;
  }
  return value;
}


/* break/continue：本壳没有循环，明确报错，不假装成功。 */
deRfun bfBreak(long home, long bs, long state, long work, long out, long env, long envTmp, long body, long cmd, long command, long status, long* leaving): long {
  long bad = 0L;
  bfCountArg(cmd, command, 1L, &bad);
  sayErr(home, "sh: break: not in a loop\n");
  return 2L;
}


deRfun bfContinue(long home, long bs, long state, long work, long out, long env, long envTmp, long body, long cmd, long command, long status, long* leaving): long {
  long bad = 0L;
  bfCountArg(cmd, command, 1L, &bad);
  sayErr(home, "sh: continue: not in a loop\n");
  return 2L;
}


/* return [n]：只在 . 的脚本里有意义，设标志让 bfDot 提前收尾。 */
deRfun bfReturn(long home, long bs, long state, long work, long out, long env, long envTmp, long body, long cmd, long command, long status, long* leaving): long {
  if (bsSource(bs) < 1L) {
    sayErr(home, "sh: return: not in a sourced script\n");
    return 2L;
  }
  long bad = 0L;
  long code = bfCountArg(cmd, command, status, &bad);
  if (bad == 1L) {
    sayErr(home, "sh: return: numeric argument required\n");
    return 2L;
  }
  bsReturnSet(bs, code);
  return code;
}


/* 把参数用空格接成一行，写到 buf（容量 8192）。返回长度。 */
deRfun bfJoinArgs(long buf, long cmd, long command): long {
  long at = 0L;
  long index = command + 1L;
  while (index < cmdArgc(cmd)) {
    if (at > 0L) {
      bcPut(buf, at, 32L);
      at = at + 1L;
    }
    bcCopy(cmdArgAt(cmd, index), buf + at * 8L, cmdArgLen(cmd, index));
    at = at + cmdArgLen(cmd, index);
    index = index + 1L;
  }
  return at;
}


/* eval [参数...]：接成一行后重新解析执行。空 eval 回 0。 */
deRfun bfEval(long home, long bs, long state, long work, long out, long env, long envTmp, long body, long cmd, long command, long status, long* leaving): long {
  if (cmdArgc(cmd) <= command + 1L) {
    return 0L;
  }
  long buf = runScratch(home, work);
  long len = bfJoinArgs(buf, cmd, command);
  return runText(home, bs, state, work, env, envTmp, buf, len, status, leaving);
}


/* exec [命令 [参数...]]：
   没有命令时只处理重定向。持久重定向在本壳做不了，明确报错。
   有命令时不带别名派生命令，命令结束壳就退出，状态就是命令的状态。 */
deRfun bfExec(long home, long bs, long state, long work, long out, long env, long envTmp, long body, long cmd, long command, long status, long* leaving): long {
  if (cmdArgc(cmd) <= command + 1L) {
    if (cmdRedir(cmd) != 0L) {
      sayErr(home, "sh: exec: persistent redirection is not supported\n");
      return 1L;
    }
    return 0L;
  }
  long code = runWord(home, bs, state, work, out, env, envTmp, body, cmd, command + 1L, status, leaving, 0L);
  *leaving = 1L;
  return code;
}


/* . 文件：按 PATH 或斜杠找文件，逐行重新解析执行。
   行末的 return 提前收尾。这里不支持行内 here-document，明确报错。 */
deRfun bfDot(long home, long bs, long state, long work, long out, long env, long envTmp, long body, long cmd, long command, long status, long* leaving): long {
  if (cmdArgc(cmd) <= command + 1L) {
    sayErr(home, "sh: .: filename argument required\n");
    return 2L;
  }
  long got = resolve(home, bs, work, env, cmdArgAt(cmd, command + 1L), cmdArgLen(cmd, command + 1L));
  if (got < 1L) {
    sayErrMissing(home, "sh: .: ", cmdArgAt(cmd, command + 1L), cmdArgLen(cmd, command + 1L), ": cannot open\n");
    return 127L;
  }
  plantRaw(home, destAt(work), got);
  if (obr::proc::open(home, 0L) != 0L) {
    sayErrMissing(home, "sh: .: ", cmdArgAt(cmd, command + 1L), cmdArgLen(cmd, command + 1L), ": cannot open\n");
    return 127L;
  }
  long fd = obr::proc::slot(home, 192L);
  long fill = 65536L;
  long buf = obr::proc::alloc(home, fill * 8L);
  if (buf == 0L) {
    obr::proc::close(home, fd);
    sayErr(home, "sh: .: out of memory\n");
    return 1L;
  }
  bsSourceIn(bs);
  long code = 0L;
  long total = 0L;
  long offset = 0L;
  while (1) {
    long got2 = obr::proc::read(home, fd, offset, 4096L);
    long chunk = obr::proc::slot(home, 320L);
    if (got2 != 0L || chunk < 1L) {
      break;
    }
    if (total + chunk > fill) {
      chunk = fill - total;
    }
    bcCopy(obr::proc::bytes(home), buf + total * 8L, chunk);
    total = total + chunk;
    offset = offset + chunk;
    if (total >= fill) {
      break;
    }
  }
  obr::proc::close(home, fd);
  long at = 0L;
  while (at < total && bsReturnHit(bs) == 0L && *leaving == 0L) {
    long start = at;
    while (at < total && bcU8(buf + at * 8L) != 10L) {
      at = at + 1L;
    }
    code = runText(home, bs, state, work, env, envTmp, buf + start * 8L, at - start, code, leaving);
    at = at + 1L;
  }
  if (bsReturnHit(bs) == 1L) {
    code = bsReturnTake(bs);
  }
  bsSourceOut(bs);
  return code;
}

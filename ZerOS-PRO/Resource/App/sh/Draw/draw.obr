/* 壳的画面和标准输出。
   只负责把一行画出来。不解析命令，不派生进程。
   画面缓冲在工作区的 screenAt 里，不用 static：#DYN 程序和 .zdll 共用静态区，
   同槽位会互相覆盖（见 work.obr 的布局注释）。
   标准输出直接写描述符 1：内核的 write 按给出的位移写（pwrite），
   fd 1 是普通文件时位移要接在文件已有内容之后，流位移记在工作区（outOffAt）。
   不走 obr.print：壳的输出横跨终端和重定向文件，库里那条流位移从进程启动累计，
   拿它当文件位移会在文件里写出一截 0 洞；壳也不再挂 obr.print.zdll。
   键入、退格和提示符画完就交出，避免停在写上等下一行。
   列数和原先壳里的算法相同：128 到 191 的续字节不加列，其余每个八位组加一列。 */
#DYN
import memory;
import obr.proc;
import obr.line;
import obr.oct;
import draw;
import work;

/* 空 __zap__ 块是内联护栏：导入调用只留在这一层包装里。
   ZAP 映像的导入调用点上限 256，包装被内联展开会把每个调用点都变成一次导入引用。 */
deRfun octetAt(long addr): long {
  __zap__ {
  }
  return obr::oct::get(addr);
}

deRfun columnCount(long addr, long count): long {
  long index = 0L;
  long total = 0L;
  while (index < count) {
    long value = octetAt(addr + index * 8L);
    if (value < 128L || value >= 192L) {
      total = total + 1L;
    }
    index = index + 1L;
  }
  return total;
}

deRfun placeText(long addr, long at, string text): long {
  int raw = length(text);
  int index = 0;
  while (index < raw) {
    memory::storeOctet(text[index], addr + (at + index) * 8L);
    index = index + 1;
  }
  long next = at + raw;
  return next;
}

/* 空 __zap__ 块是内联护栏：导入调用只留在这一层包装里。 */
deRfun moveOctets(long from, long to, long count): void {
  __zap__ {
  }
  obr::oct::copy(from, to, count);
}

/* 标准输出的写出：八位组先摆进派生窗口的字节区，一次交给描述符 1。
   write 按位移写，位移从 outOffAt 起接续；一次写不完（环满、管道阻塞）就按
   内核交回的个数续写。写失败就丢下没写走的部分：管道没有读者时字节就该丢，
   不能像缓冲流那样留到下一次输出再冒出来。 */
deRfun outSend(long home, long work, long count): void {
  long place = memory::load64(outOffAt(work));
  long offset = 0L;
  while (offset < count) {
    long left = count - offset;
    if (obr::proc::write(home, 1L, place + offset, left) != 0L) {
      return;
    }
    long wrote = obr::proc::slot(home, 320L);
    if (wrote < 1L || wrote > left) {
      return;
    }
    offset = offset + wrote;
  }
  memory::store64(place + count, outOffAt(work));
}


deRfun outText(long home, long work, string text): void {
  int raw = length(text);
  long count = raw;
  long index = 0L;
  while (index < count) {
    memory::storeOctet(text[index], obr::proc::bytes(home) + index * 8L);
    index = index + 1L;
  }
  outSend(home, work, count);
}


deRfun outSpan(long home, long work, long addr, long count): void {
  long index = 0L;
  while (index < count) {
    memory::storeOctet(octetAt(addr + index * 8L), obr::proc::bytes(home) + index * 8L);
    index = index + 1L;
  }
  outSend(home, work, count);
}

/* 空 __zap__ 块是内联护栏：输出包装不参与内联。调用点上百处，
   展开会把生成面（数据重定位）顶爆，导入调用也留在包装层。 */
deRfun say(long home, long work, string text): void {
  __zap__ {
  }
  outText(home, work, text);
}

/* 空 __zap__ 块是内联护栏：输出包装不参与内联。 */
deRfun saySpan(long home, long work, long addr, long count): void {
  __zap__ {
  }
  if (count < 1L) {
    return;
  }
  outSpan(home, work, addr, count);
}

/* 空 __zap__ 块是内联护栏：输出包装不参与内联。 */
deRfun sayByte(long home, long work, long value): void {
  __zap__ {
  }
  memory::storeOctet(value, obr::proc::bytes(home));
  outSend(home, work, 1L);
}

deRfun sayBack(long home, long work): void {
  long paint = screenAt(work);
  memory::storeOctet(8L, paint);
  memory::storeOctet(32L, paint + 8L);
  memory::storeOctet(8L, paint + 16L);
  saySpan(home, work, paint, 3L);
}

deRfun sayMissing(long home, long work, string lead, long addr, long count, string tail): void {
  say(home, work, lead);
  saySpan(home, work, addr, count);
  say(home, work, tail);
}

/* 标准错误：诊断直接写描述符 2，不经 obr.print 的缓冲。 */
deRfun errPut(long home, long addr, long count): void {
  long offset = 0L;
  while (offset < count) {
    long chunk = count - offset;
    if (chunk > 4096L) {
      chunk = 4096L;
    }
    long index = 0L;
    while (index < chunk) {
      memory::storeOctet(octetAt(addr + (offset + index) * 8L), obr::proc::bytes(home) + index * 8L);
      index = index + 1L;
    }
    obr::proc::write(home, 2L, 0L, chunk);
    offset = offset + chunk;
  }
}

deRfun sayErr(long home, string text): void {
  int raw = length(text);
  long count = raw;
  if (count > 2000L) {
    count = 2000L;
  }
  if (count < 1L) {
    return;
  }
  long index = 0L;
  while (index < count) {
    memory::storeOctet(text[index], obr::proc::bytes(home) + index * 8L);
    index = index + 1L;
  }
  obr::proc::write(home, 2L, 0L, count);
}

deRfun sayErrSpan(long home, long addr, long count): void {
  if (count > 0L) {
    errPut(home, addr, count);
  }
}

deRfun sayErrByte(long home, long value): void {
  memory::storeOctet(value, obr::proc::bytes(home));
  obr::proc::write(home, 2L, 0L, 1L);
}

deRfun sayErrMissing(long home, string lead, long addr, long count, string tail): void {
  sayErr(home, lead);
  sayErrSpan(home, addr, count);
  sayErr(home, tail);
}

/* 提示符加当前行，再抹掉变短的尾巴，光标退回到插入点。一次交给流。 */
deRfun paintEdit(long home, long state, long work): void {
  long paint = screenAt(work);
  long at = 0L;
  memory::storeOctet(13L, paint);
  at = 1L;
  if (obr::line::editBody(state) == 1L) {
    at = placeText(paint, at, "> ");
  } else {
    at = placeText(paint, at, "root@zeros:");
    long cwdLen = memory::load64(cwdLenAt(work));
    moveOctets(cwdAt(work), paint + at * 8L, cwdLen);
    at = at + cwdLen;
    at = placeText(paint, at, "# ");
  }
  long promptCols = columnCount(paint + 8L, at - 1L);
  long lineLen = obr::line::editLen(state);
  moveOctets(obr::line::lineBytes(state), paint + at * 8L, lineLen);
  long lineCols = columnCount(obr::line::lineBytes(state), lineLen);
  long cursorCols = columnCount(obr::line::lineBytes(state), obr::line::editCursor(state));
  at = at + lineLen;
  long shown = promptCols + lineCols;
  long prev = memory::load64(prevAt(work));
  long pad = 0L;
  if (prev > shown) {
    pad = prev - shown;
  }
  long spaces = 0L;
  while (spaces < pad && at < 2000L) {
    memory::storeOctet(32L, paint + at * 8L);
    at = at + 1L;
    spaces = spaces + 1L;
  }
  long backs = pad + (lineCols - cursorCols);
  long step = 0L;
  while (step < backs && at < 2000L) {
    memory::storeOctet(8L, paint + at * 8L);
    at = at + 1L;
    step = step + 1L;
  }
  saySpan(home, work, paint, at);
  memory::store64(shown, prevAt(work));
}

/* 普通按键只追加或删掉行尾一个字节。整行重画会把提示符再送一遍。
   光标不在行尾、或一次删掉不止一个字节时，仍走整行。长度和光标都没变就不画。 */
deRfun paintStep(long home, long state, long work, long beforeLen, long beforeCur): void {
  long afterLen = obr::line::editLen(state);
  long afterCur = obr::line::editCursor(state);
  if (afterLen == beforeLen && afterCur == beforeCur) {
    return;
  }
  if (afterCur == afterLen && beforeCur == beforeLen && afterLen == beforeLen + 1L) {
    long added = obr::line::editAt(state, afterLen - 1L);
    sayByte(home, work, added);
    long cols = 1L;
    if (added >= 128L && added < 192L) {
      cols = 0L;
    }
    memory::store64(memory::load64(prevAt(work)) + cols, prevAt(work));
    return;
  }
  if (afterCur == afterLen && beforeCur == beforeLen && beforeLen > 0L && afterLen == beforeLen - 1L) {
    sayBack(home, work);
    long shown = memory::load64(prevAt(work));
    if (shown > 0L) {
      memory::store64(shown - 1L, prevAt(work));
    }
    return;
  }
  paintEdit(home, state, work);
}

/* 收 here-document 时不画正常提示符，只写 > 和一个空格。 */
deRfun paintMark(long home, long work): void {
  say(home, work, "> ");
  memory::store64(2L, prevAt(work));
}

deRfun paintPrompt(long home, long work): void {
  long paint = screenAt(work);
  long at = placeText(paint, 0L, "root@zeros:");
  long cwdLen = memory::load64(cwdLenAt(work));
  moveOctets(cwdAt(work), paint + at * 8L, cwdLen);
  at = at + cwdLen;
  at = placeText(paint, at, "# ");
  saySpan(home, work, paint, at);
  memory::store64(columnCount(paint, at), prevAt(work));
  /* 提示符画完，发一次 no-op 服务 35。宿主在 svc 边界记 prompt 事件。 */
  obr::proc::prompt(home);
}

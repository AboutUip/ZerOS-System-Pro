/* 浜や簰寮?shell銆傛簮鐮佸湪 Resource/App/sh锛屾寜瀛愮洰褰曞垎寮€锛岀紪鎴愬璺緞 /os/sh銆?   涓诲惊鐜槸鎻愮ず绗︺€佽琛屻€佽В鏋愩€佹淳鐢熴€佺瓑寰呫€傝缂栬緫鍦?obr.line锛岀敾闈㈠拰鏍囧噯杈撳嚭鍦?Draw銆?   鎻愮ず绗︽槸 root@zeros:銆佸綋鍓嶇洰褰曘€佸啀鍔?# 銆傚唴鏍稿彧浜ゅ師濮嬫寜閿€?   涓婃柟鍚戦敭鏄?ArrowUp锛屼笅鏂瑰悜閿槸 Down锛涜缂栬緫鎶婂畠浠敹鎴愬巻鍙层€?   Tab 鍦ㄥ懡浠ょ殑浣嶇疆琛ュ唴寤哄拰 PATH 閲岀殑绋嬪簭锛屽叾浣欒ˉ璺緞銆?   鍐呯疆 cd銆乪xit銆乭istory銆乧lear銆俥cho 鍜?pwd 鍦?/bin銆?   cd 鎸?POSIX.1-2017 鐨勫崄姝ヨ蛋銆?L 鏄己鐪侊紝-L 涓?-P 浠ュ悗鍐欑殑涓哄噯銆傛病鏈夋搷浣滄暟灏辩敤 HOME锛岀┖鎴栨湭璁剧疆鍒欏け璐ャ€?   cd - 绛夊悓 cd "$OLDPWD"锛屾垚鍔熸椂鎶婃柊鐨勭粷瀵硅矾寰勫啓鍒版爣鍑嗚緭鍑恒€傜浉瀵硅矾寰勪笖棣栦釜鍒嗛噺涓嶆槸 . 鎴?.. 鏃舵墠鏌?CDPATH锛?   鏈缃殑 CDPATH 褰撴垚绌轰覆銆傜┖娈靛拰鍗曠嫭涓€涓偣琛ㄧず褰撳墠鐩綍锛屽懡涓椂涓嶆墦鍗帮紱鍏跺畠闈炵┖鍒嗛噺鍛戒腑鎵嶆墦鍗般€?   澶辫触鏃跺伐浣滅洰褰曞拰 PWD 閮戒笉鍙樸€傝瘖鏂湪鏍囧噯閿欒锛屽墠缂€鏄?sh: cd:銆傛病鏈夌鍙烽摼鎺ャ€?   .. 鍦ㄨ繘鐩綍鍓嶆寜瀛楅潰鍒犳帀锛屽墠涓€娈靛繀椤诲凡缁忔槸鐩綍锛涙牴涓婄殑 .. 浠嶅仠鍦ㄦ牴銆傝矾寰勮秴杩?512 涓叓浣嶇粍灏卞け璐ャ€?   瑙勮寖绗?9 姝ヨ鎶婅繃闀跨殑缁濆璺緞鏀规垚鐩稿璺緞鍐?chdir锛岃繖閲屽仛涓嶅埌锛歅WD 浠嶅緱璁颁笅閭ｆ潯缁濆璺緞锛岀幆澧冨€兼渶闀夸篃鏄?512銆?   $? 鍙湪鏁磋瘝銆佷笖杩欎釜璇嶆病鏈夊崟寮曞彿瀛楄妭鏃舵崲鎴愪笂涓€鏉＄姸鎬併€?   澶栭儴鍛戒护鐨勫弬鏁板湪娲剧敓鍓嶅仛璺緞灞曞紑銆傛湭鍔犲紩鍙枫€佷篃娌¤鍙嶆枩鏉犳尅浣忕殑 *銆? 鍜屾垚瀵圭殑鏂规嫭鍙锋墠鏄ā寮忋€?   寮曞彿閲岀殑杩欏嚑涓瓧淇濇寔鍘熸牱銆備竴涓悕瀛楅兘瀵逛笉涓婃椂锛屽師璇嶇収鏃т氦缁欏懡浠ゃ€?   灞曞紑鍚庤秴杩?64 涓弬鏁版垨 8192 涓叓浣嶇粍灏变笉娲剧敓锛屽苟鍐?sh: argument list too long銆?   鐐瑰紑澶寸殑鐩綍椤癸紝鍙湁杩欎竴娈垫ā寮忎篃浠ョ偣寮€澶存墠瀵瑰緱涓娿€傚唴寤哄懡浠や笉灞曞紑銆?   绠￠亾鍜岄噸瀹氬悜鐢辫繖閲屾敼鎻忚堪绗︺€傛病鏈夋枩鏉犵殑鍚嶅瓧鎸?PATH 鎵撅紝缂虹渷鏄?/bin:/os:/kernel銆?   << 鍜?<<- 鐨勬鏂囧湪鍛戒护琛屾崲琛屼箣鍚庨€愯璇诲叆銆傝繖涓€杞鏂囦笉鍋氬弬鏁板睍寮€銆佸懡浠ゆ浛鎹㈠拰绠楁湳灞曞紑銆?   鍙傛暟鍜岀幆澧冨啓杩涚晫闄愯捣鐐?+4194304锛屽竷灞€鍜屽唴鏍哥殑 argAt 鐩稿悓銆傚懡浠ゅ墠鐨?NAME=value 鍙氦缁欒繖涓€娆℃淳鐢熴€?   鎵撲笉寮€鎺у埗鍙板氨鍋滃湪璁╁嚭涓婏紝鐩戠潱鏍告墠璁ゅ緱鍑鸿繖浠戒换鍔°€?   鎷嗚瘝鍦?Parse锛岃矾寰勫睍寮€鍦?Expand锛岀幆澧冨湪 Env锛宑d 鍦?Cd锛岃ˉ鍏ㄥ湪 Complete锛屾淳鐢熷湪 Run锛岀敾闈㈠湪 Draw銆?   琛岀紪杈戞槸 obr.line锛岃矾寰勬槸 obr.path锛屽叓浣嶇粍鏄?obr.oct銆備笉瀵煎叆杩欎簺搴撶殑绋嬪簭浠嶇洿鎺ヨ皟鐢ㄥ唴鏍告湇鍔℃惉瀛楄妭銆?*/
#DYN
import memory;
import obr.os;
import obr.proc;
import obr.line;
import obr.oct;
import span;
import env;
import run;
import complete;
import parse;
import draw;
import work;
import bstate;


/* 绌?__zap__ 鍧楁槸鍐呰仈鎶ゆ爮锛氬鍏ヨ皟鐢ㄥ彧鐣欏湪杩欎竴灞傚寘瑁呴噷銆?   ZAP 鏄犲儚鐨勫鍏ヨ皟鐢ㄧ偣涓婇檺 256锛屽寘瑁呰鍐呰仈灞曞紑浼氭妸姣忎釜璋冪敤鐐归兘鍙樻垚涓€娆″鍏ュ紩鐢ㄣ€?*/
deRfun u8(long addr): long {
  __zap__ {
  }
  return obr::oct::get(addr);
}


deRfun linger(): void {
  while (1) {
    obr::os::yield();
  }
}


deRfun attach(long home): long {
  if (putText(obr::proc::path(home) + 64L, 0L, "/dev/con") < 1L) {
    return 1L;
  }
  memory::store64(8L, obr::proc::path(home));
  long opened = obr::proc::open(home, 2L);
  if (opened != 0L) {
    return 1L;
  }
  long fd = obr::proc::slot(home, 192L);
  if (obr::proc::dup2(home, fd, 0L) != 0L || obr::proc::dup2(home, fd, 1L) != 0L || obr::proc::dup2(home, fd, 2L) != 0L) {
    return 1L;
  }
  if (fd > 2L) {
    obr::proc::close(home, fd);
  }
  return 0L;
}


/* 璇诲埌鎻愪氦銆丆trl-D 鎴?Ctrl-C 鎵嶈繑鍥炪€傛竻灞忓拰琛ュ叏鐣欏湪杩欎竴琛岄噷銆?   1 鎻愪氦锛? Ctrl-D锛? Ctrl-C锛? 鏄绔凡缁忓叧鎺夛紝-1 鏄澶辫触銆?*/
deRfun readLine(long home, long state, long work, long env, long gathering): long {
  while (1) {
    long status = obr::proc::read(home, 0L, 0L, 1L);
    if (status != 0L) {
      return -1L;
    }
    if (obr::proc::slot(home, 320L) < 1L) {
      return 0L;
    }
    long unit = u8(obr::proc::bytes(home));
    long beforeLen = obr::line::editLen(state);
    long beforeCur = obr::line::editCursor(state);
    long action = obr::line::editFeed(state, unit);
    if (action == 1L) {
      sayByte(home, work, 10L);
      return 1L;
    }
    if (action == 2L) {
      return 2L;
    }
    if (action == 3L) {
      return 3L;
    }
    if (action == 4L) {
      sayByte(home, work, 12L);
      memory::store64(0L, prevAt(work));
      paintEdit(home, state, work);
    } else if (action == 5L) {
      if (gathering == 0L) {
        completeLine(home, state, work, env);
        paintEdit(home, state, work);
      }
    } else {
      paintStep(home, state, work, beforeLen, beforeCur);
    }
  }
  return -1L;
}


/* EXIT 鍔ㄤ綔鍦ㄥ３閫€鍑哄墠璺戜竴娆°€傚姩浣滈噷鐨勯€€鍑轰笉鍐嶉€掑綊璺?EXIT銆?*/
deRfun exitTrap(long home, long bs, long state, long work, long env, long envTmp, long code): long {
  if (bsTrapState(bs, 0L) == 2L) {
    long leaving = 0L;
    return runText(home, bs, state, work, env, envTmp, bsTrapActionAt(bs, 0L), bsTrapActionLen(bs, 0L), code, &leaving);
  }
  return code;
}


/* 鎸傜潃鐨勪俊鍙锋敹涓嬫潵璺戝姩浣溿€傜姸鎬?1 鏄拷鐣ャ€? 鏄己鐪侊紝閮戒笉鍋氫簨銆?*/
deRfun sigTrap(long home, long bs, long state, long work, long env, long envTmp, long code, long* leaving): void {
  long sig = obr::proc::sigtake();
  long rounds = 0L;
  while (sig > 0L && sig <= 31L && rounds < 8L) {
    if (bsTrapState(bs, sig) == 2L) {
      runText(home, bs, state, work, env, envTmp, bsTrapActionAt(bs, sig), bsTrapActionLen(bs, sig), code, leaving);
    }
    sig = obr::proc::sigtake();
    rounds = rounds + 1L;
  }
}


/* 鍑嗗濂芥帶鍒跺彴銆佺幆澧冨拰褰撳墠鐩綍涔嬪悗锛屽惊鐜氨鏄彁绀虹銆佽琛屻€佽В鏋愩€佹淳鐢熴€佺瓑寰呫€?*/
deRfun main(): int {
  long home = obr::proc::home();
  if (attach(home) != 0L) {
    linger();
    return 0;
  }
  long state = obr::proc::alloc(home, 131072L);
  long out = obr::proc::alloc(home, 262144L);
  long work = obr::proc::alloc(home, 65536L);
  long env = obr::proc::alloc(home, envSpan());
  long envTmp = obr::proc::alloc(home, envSpan());
  long body = obr::proc::alloc(home, 131072L);
  long bs = obr::proc::alloc(home, bsSpan());
  if (state == 0L || out == 0L || work == 0L || env == 0L || envTmp == 0L || body == 0L || bs == 0L) {
    linger();
    return 0;
  }
  bsInit(bs);
  obr::line::editInit(state);
  memory::store64(0L, env);
  memory::store64(0L, envTmp);
  memory::storeOctet(47L, cwdAt(work));
  memory::store64(1L, cwdLenAt(work));
  memory::store64(0L, prevAt(work));
  memory::store64(0L, poolAt(work));
  memory::store64(0L, nestAt(work));
  memory::store64(0L, scratchBufAt(work));
  memory::store64(0L, lineBufAt(work));
  memory::store64(0L, outOffAt(work));
  memory::store64(0L, trackAt(work, 0L));
  memory::store64(0L, trackAt(work, 1L));
  memory::store64(0L, trackAt(work, 2L));
  long name = paintAt(work);
  long nameLen = putText(name, 0L, "PATH");
  long value = scratchAt(work);
  long valueLen = putText(value, 0L, "/bin:/os:/kernel");
  envSet(env, name, nameLen, value, valueLen);
  nameLen = putText(name, 0L, "PWD");
  memory::storeOctet(47L, value);
  envSet(env, name, nameLen, value, 1L);
  paintPrompt(home, work);
  long code = 0L;
  long gathering = 0L;
  long hdCursor = 0L;
  long tooBig = 0L;
  while (1) {
    long pending = 0L;
    sigTrap(home, bs, state, work, env, envTmp, code, &pending);
    if (pending == 1L) {
      code = exitTrap(home, bs, state, work, env, envTmp, code);
      return 0;
    }
    long action = readLine(home, state, work, env, gathering);
    if (action < 0L) {
      linger();
      return 0;
    }
    if (action == 0L) {
      exitTrap(home, bs, state, work, env, envTmp, code);
      return 0;
    }
    if (action == 2L) {
      if (gathering == 1L) {
        gathering = 0L;
        obr::line::editBodySet(state, 0L);
        obr::line::editClear(state);
        say(home, work, "sh: here-document not terminated\n");
        code = 1L;
        paintPrompt(home, work);
      } else {
        exitTrap(home, bs, state, work, env, envTmp, code);
        return 0;
      }
    } else if (action == 3L) {
      gathering = 0L;
      obr::line::editBodySet(state, 0L);
      say(home, work, "^C\n");
      paintPrompt(home, work);
    } else if (gathering == 1L) {
      long closed = absorbLine(state, out, body, hdCursor, &tooBig);
      obr::line::editClear(state);
      if (closed == 1L) {
        hdCursor = hdCursor + 1L;
        if (hdCursor >= hdCount(out)) {
          gathering = 0L;
          obr::line::editBodySet(state, 0L);
          if (tooBig == 1L) {
            say(home, work, "sh: here-document too large\n");
            code = 1L;
            paintPrompt(home, work);
          } else {
            long leaving = 0L;
            code = runParsed(home, bs, state, work, out, env, envTmp, code, body, &leaving);
            if (leaving == 1L) {
              code = exitTrap(home, bs, state, work, env, envTmp, code);
              return 0;
            }
            paintPrompt(home, work);
          }
        } else {
          paintMark(home, work);
        }
      } else {
        paintMark(home, work);
      }
    } else if (parseLine(obr::line::lineBytes(state), obr::line::editLen(state), out, code) != 0L) {
      say(home, work, "sh: syntax error\n");
      code = 2L;
      obr::line::editClear(state);
      paintPrompt(home, work);
    } else if (hdCount(out) > 0L) {
      obr::line::editBodySet(state, 1L);
      obr::line::editClear(state);
      gathering = 1L;
      hdCursor = 0L;
      tooBig = 0L;
      paintMark(home, work);
    } else {
      long leaving = 0L;
      code = runParsed(home, bs, state, work, out, env, envTmp, code, body, &leaving);
      obr::line::editClear(state);
      if (leaving == 1L) {
        code = exitTrap(home, bs, state, work, env, envTmp, code);
        return 0;
      }
      paintPrompt(home, work);
    }
  }
  return 0;
}

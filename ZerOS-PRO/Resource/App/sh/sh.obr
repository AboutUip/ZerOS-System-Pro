/* 交互式 shell。源码在 Resource/App/sh，按子目录分开，编成客路径 /os/sh。
   主循环是提示符、读行、解析、派生、等待。行编辑在 obr.line，画面和标准输出在 Draw。
   提示符是 root@zeros:、当前目录、再加 # 。内核只交原始按键。
   上方向键是 ArrowUp，下方向键是 Down；行编辑把它们收成历史。
   Tab 在命令的位置补内建和 PATH 里的程序，其余补路径。
   内置 cd、exit、history、clear。echo 和 pwd 在 /bin。
   cd 按 POSIX.1-2017 的十步走。-L 是缺省，-L 与 -P 以后写的为准。没有操作数就用 HOME，空或未设置则失败。
   cd - 等同 cd "$OLDPWD"，成功时把新的绝对路径写到标准输出。相对路径且首个分量不是 . 或 .. 时才查 CDPATH；
   未设置的 CDPATH 当成空串。空段和单独一个点表示当前目录，命中时不打印；其它非空分量命中才打印。
   失败时工作目录和 PWD 都不变。诊断在标准错误，前缀是 sh: cd:。没有符号链接。
   .. 在进目录前按字面删掉，前一段必须已经是目录；根上的 .. 仍停在根。路径超过 512 个八位组就失败。
   规范第 9 步要把过长的绝对路径改成相对路径再 chdir，这里做不到：PWD 仍得记下那条绝对路径，环境值最长也是 512。
   $? 只在整词、且这个词没有单引号字节时换成上一条状态。
   管道和重定向由这里改描述符。没有斜杠的名字按 PATH 找，缺省是 /bin:/os:/kernel。
   << 和 <<- 的正文在命令行换行之后逐行读入。这一轮正文不做参数展开、命令替换和算术展开。
   参数和环境写进界限起点 +4194304，布局和内核的 argAt 相同。命令前的 NAME=value 只交给这一次派生。
   打不开控制台就停在让出上，监督核才认得出这份任务。
   拆词在 Parse，环境在 Env，cd 在 Cd，补全在 Complete，派生在 Run，画面在 Draw。
   行编辑是 obr.line，路径是 obr.path，八位组是 obr.oct。不导入这些库的程序仍直接调用内核服务搬字节。 */
#DYN
import memory;
import obr.os;
import obr.proc;
import obr.line;
import obr.oct;
import span;
import env;
import run;
import complete;
import parse;
import draw;
import work;


deRfun u8(long addr): long {
  return obr::oct::get(addr);
}


deRfun linger(): void {
  while (1) {
    obr::os::yield();
  }
}


deRfun attach(long home): long {
  if (putText(obr::proc::path(home) + 64L, 0L, "/dev/con") < 1L) {
    return 1L;
  }
  memory::store64(8L, obr::proc::path(home));
  long opened = obr::proc::open(home, 2L);
  if (opened != 0L) {
    return 1L;
  }
  long fd = obr::proc::slot(home, 192L);
  if (obr::proc::dup2(home, fd, 0L) != 0L || obr::proc::dup2(home, fd, 1L) != 0L || obr::proc::dup2(home, fd, 2L) != 0L) {
    return 1L;
  }
  if (fd > 2L) {
    obr::proc::close(home, fd);
  }
  return 0L;
}


/* 读到提交、Ctrl-D 或 Ctrl-C 才返回。清屏和补全留在这一行里。
   1 提交，2 Ctrl-D，3 Ctrl-C，0 是读端已经关掉，-1 是读失败。 */
deRfun readLine(long home, long state, long work, long env, long gathering): long {
  while (1) {
    long status = obr::proc::read(home, 0L, 0L, 1L);
    if (status != 0L) {
      return -1L;
    }
    if (obr::proc::slot(home, 320L) < 1L) {
      return 0L;
    }
    long unit = u8(obr::proc::bytes(home));
    long beforeLen = obr::line::editLen(state);
    long beforeCur = obr::line::editCursor(state);
    long action = obr::line::editFeed(state, unit);
    if (action == 1L) {
      sayByte(home, 10L);
      return 1L;
    }
    if (action == 2L) {
      return 2L;
    }
    if (action == 3L) {
      return 3L;
    }
    if (action == 4L) {
      sayByte(home, 12L);
      memory::store64(0L, prevAt(work));
      paintEdit(home, state, work);
    } else if (action == 5L) {
      if (gathering == 0L) {
        completeLine(home, state, work, env);
        paintEdit(home, state, work);
      }
    } else {
      paintStep(home, state, work, beforeLen, beforeCur);
    }
  }
  return -1L;
}


/* 准备好控制台、环境和当前目录之后，循环就是提示符、读行、解析、派生、等待。 */
deRfun main(): int {
  long home = obr::proc::home();
  if (attach(home) != 0L) {
    linger();
    return 0;
  }
  long state = obr::proc::alloc(home, 131072L);
  long out = obr::proc::alloc(home, 131072L);
  long work = obr::proc::alloc(home, 65536L);
  long env = obr::proc::alloc(home, envSpan());
  long envTmp = obr::proc::alloc(home, envSpan());
  long body = obr::proc::alloc(home, 131072L);
  if (state == 0L || out == 0L || work == 0L || env == 0L || envTmp == 0L || body == 0L) {
    linger();
    return 0;
  }
  obr::line::editInit(state);
  memory::store64(0L, env);
  memory::store64(0L, envTmp);
  memory::storeOctet(47L, cwdAt(work));
  memory::store64(1L, cwdLenAt(work));
  memory::store64(0L, prevAt(work));
  long name = paintAt(work);
  long nameLen = putText(name, 0L, "PATH");
  long value = scratchAt(work);
  long valueLen = putText(value, 0L, "/bin:/os:/kernel");
  envSet(env, name, nameLen, value, valueLen);
  nameLen = putText(name, 0L, "PWD");
  memory::storeOctet(47L, value);
  envSet(env, name, nameLen, value, 1L);
  paintPrompt(home, work);
  long code = 0L;
  long gathering = 0L;
  long hdCursor = 0L;
  long tooBig = 0L;
  while (1) {
    long action = readLine(home, state, work, env, gathering);
    if (action < 0L) {
      linger();
      return 0;
    }
    if (action == 0L) {
      return 0;
    }
    if (action == 2L) {
      if (gathering == 1L) {
        gathering = 0L;
        obr::line::editBodySet(state, 0L);
        obr::line::editClear(state);
        say(home, "sh: here-document not terminated\n");
        code = 1L;
        paintPrompt(home, work);
      } else {
        return 0;
      }
    } else if (action == 3L) {
      gathering = 0L;
      obr::line::editBodySet(state, 0L);
      say(home, "^C\n");
      paintPrompt(home, work);
    } else if (gathering == 1L) {
      long closed = absorbLine(state, out, body, hdCursor, &tooBig);
      obr::line::editClear(state);
      if (closed == 1L) {
        hdCursor = hdCursor + 1L;
        if (hdCursor >= hdCount(out)) {
          gathering = 0L;
          obr::line::editBodySet(state, 0L);
          if (tooBig == 1L) {
            say(home, "sh: here-document too large\n");
            code = 1L;
            paintPrompt(home, work);
          } else {
            long leaving = 0L;
            code = runParsed(home, state, work, out, env, envTmp, code, body, &leaving);
            if (leaving == 1L) {
              return 0;
            }
            paintPrompt(home, work);
          }
        } else {
          paintMark(home, work);
        }
      } else {
        paintMark(home, work);
      }
    } else if (parseLine(obr::line::lineBytes(state), obr::line::editLen(state), out, code) != 0L) {
      say(home, "sh: syntax error\n");
      code = 2L;
      obr::line::editClear(state);
      paintPrompt(home, work);
    } else if (hdCount(out) > 0L) {
      obr::line::editBodySet(state, 1L);
      obr::line::editClear(state);
      gathering = 1L;
      hdCursor = 0L;
      tooBig = 0L;
      paintMark(home, work);
    } else {
      long leaving = 0L;
      code = runParsed(home, state, work, out, env, envTmp, code, body, &leaving);
      obr::line::editClear(state);
      if (leaving == 1L) {
        return 0;
      }
      paintPrompt(home, work);
    }
  }
  return 0;
}

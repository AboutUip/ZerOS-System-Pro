#DYN
/* 诊断：本核旧布局 kSp 单元的真实内存值。0 -> exit 1，非 0 -> exit 2。 */
import memory;
import obr.os;
import obr.proc;

deRfun main(): int {
  long home = obr::proc::home();
  long value = obr::os::svc(68L);
  long code = 2L;
  if (value == 0L) {
    code = 1L;
  }
  home = obr::proc::home();
  memory::store64(code, home + 128L);
  obr::os::svc(28L);
  return 0;
}
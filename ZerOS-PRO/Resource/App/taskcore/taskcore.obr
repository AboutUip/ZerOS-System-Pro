#DYN
/* 诊断：查 pid 5 的任务记录，把 core 字段作为退出码（10 + core）。
   pid 不在表里返回 9。 */
import memory;
import obr.os;
import obr.proc;

deRfun main(): int {
  long home = obr::proc::home();
  long start = 0L;
  long found = 9L;
  while (found == 9L) {
    long status = obr::proc::task(home, start);
    if (status != 0L) {
      break;
    }
    long next = obr::proc::slot(home, 320L);
    long base = home + 131072L;
    long pid = memory::load64(base);
    if (pid == 5L) {
      found = 10L + memory::load64(base + 192L);
    }
    if (next == 0L) {
      break;
    }
    start = next;
  }
  memory::store64(found, home + 128L);
  obr::os::svc(28L);
  return 0;
}

/* POSIX.1-2017 awk（utilities/awk.html）。
   程序来自 -f 或首操作数。BEGIN/END 各一次；无模式或 /字面/ 动作；print、print $0、
   print NR、print length；NR 从 1 递增；length 为当前行八位组数。
   system 写 awk: system not supported。缺程序 awk: missing program 退出 1。
   正则只做子串匹配。其它语句未实现。 */
#DYN
import memory;
import obr.oct;
import obr.os;
import obr.proc;
import arg;

struct Awk {
  long home;
  long prog;
  long progLen;
  long line;
  long lineLen;
  long nr;
  long fnr;
  long nf;
  long fileOff;
  map[string, string] arr;
  array[long] fields;
  array[long] fieldLen;
  long fs;
  long beginStart;
  long beginLen;
  long endStart;
  long endLen;
}

deRfun u8(long addr): long {
  return obr::oct::get(addr);
}

deRfun copySpan(long from, long to, long count): void {
  long index = 0L;
  while (index < count) {
    memory::storeOctet(u8(from + index * 8L), to + index * 8L);
    index = index + 1L;
  }
}

deRfun writeErr(long home, string text): void {
  int raw = length(text);
  long count = raw;
  long index = 0L;
  int cursor = 0;
  while (index < count) {
    memory::storeOctet(text[cursor], obr::proc::bytes(home) + index * 8L);
    index = index + 1L;
    cursor = cursor + 1;
  }
  if (count > 0L) {
    obr::proc::write(home, 2L, 0L, count);
  }
}

deRfun finish(long home, long code): int {
  obr::proc::exit(home, code);
  return 0;
}

deRfun plantPath(long home, long addr, long count): void {
  memory::store64(count, obr::proc::path(home));
  copySpan(addr, obr::proc::path(home) + 64L, count);
}

deRfun splitFields(Awk* a): void {
  a.nf = 0L;
  long start = 0L;
  long index = 0L;
  while (index <= a.lineLen) {
    if (index == a.lineLen || u8(a.line + index * 8L) == a.fs) {
      long len = index - start;
      if (a.nf < 64L) {
        long buf = obr::proc::alloc(a.home, len * 8L);
        copySpan(a.line + start * 8L, buf, len);
        a.fields[a.nf] = buf;
        a.fieldLen[a.nf] = len;
        a.nf = a.nf + 1L;
      }
      start = index + 1L;
    }
    index = index + 1L;
  }
}

deRfun fieldText(Awk* a, long n): long {
  if (n < 1L || n > a.nf) {
    return 0L;
  }
  return a.fields[n - 1L];
}

deRfun fieldLen(Awk* a, long n): long {
  if (n < 1L || n > a.nf) {
    return 0L;
  }
  return a.fieldLen[n - 1L];
}

deRfun writeBytes(long home, long addr, long count): void {
  long off = 0L;
  while (off < count) {
    long chunk = count - off;
    if (chunk > 4096L) {
      chunk = 4096L;
    }
    copySpan(addr + off * 8L, obr::proc::bytes(home), chunk);
    obr::proc::write(home, 1L, 0L, chunk);
    off = off + chunk;
  }
}

deRfun runPrint(Awk* a, long what): void {
  if (what == 0L) {
    writeBytes(a.home, a.line, a.lineLen);
  } else {
    long fd = fieldText(a, what);
    long fl = fieldLen(a, what);
    writeBytes(a.home, fd, fl);
  }
  memory::storeOctet(10L, obr::proc::bytes(a.home));
  obr::proc::write(a.home, 1L, 0L, 1L);
}

deRfun patMatch(Awk* a, long pat, long plen): long {
  if (plen < 1L) {
    return 1L;
  }
  long start = 0L;
  while (start + plen <= a.lineLen) {
    long ok = 1L;
    long k = 0L;
    while (k < plen) {
      if (u8(a.line + (start + k) * 8L) != u8(pat + k * 8L)) {
        ok = 0L;
      }
      k = k + 1L;
    }
    if (ok == 1L) {
      return 1L;
    }
    start = start + 1L;
  }
  return 0L;
}

deRfun writeNumLine(long home, long val): void {
  long buf = obr::proc::bytes(home);
  if (val == 0L) {
    memory::storeOctet(48L, buf);
    memory::storeOctet(10L, buf + 8L);
    obr::proc::write(home, 1L, 0L, 2L);
    return;
  }
  long tmp = val;
  if (tmp < 0L) {
    tmp = 0L - tmp;
  }
  long digits = 0L;
  long t = tmp;
  while (t > 0L) {
    digits = digits + 1L;
    t = t / 10L;
  }
  t = tmp;
  long at = digits;
  while (at > 0L) {
    at = at - 1L;
    memory::storeOctet(48L + (t % 10L), buf + at * 8L);
    t = t / 10L;
  }
  memory::storeOctet(10L, buf + digits * 8L);
  obr::proc::write(home, 1L, 0L, digits + 1L);
}

deRfun skipProgWs(Awk* a, long* pos): void {
  while (*pos < a.progLen) {
    long c = u8(a.prog + *pos * 8L);
    if (c != 32L && c != 9L && c != 10L && c != 13L) {
      return;
    }
    *pos = *pos + 1L;
  }
}

deRfun wordAtAddr(long text, long tlen, long pos, string word): long {
  int raw = length(word);
  long k = 0L;
  int cursor = 0;
  while (k < (long)raw) {
    if (pos + k >= tlen) {
      return 0L;
    }
    long bit = u8(text + (pos + k) * 8L);
    char ch = word[cursor];
    long sc = ch;
    if (bit != sc) {
      return 0L;
    }
    k = k + 1L;
    cursor = cursor + 1;
  }
  return 1L;
}

deRfun wordAt(Awk* a, long pos, string word): long {
  return wordAtAddr(a.prog, a.progLen, pos, word);
}

deRfun takeBraceBody(Awk* a, long* pos, long* bodyStart, long* bodyLen): long {
  skipProgWs(a, pos);
  if (*pos >= a.progLen || u8(a.prog + *pos * 8L) != 123L) {
    return 0L;
  }
  *pos = *pos + 1L;
  *bodyStart = *pos;
  long depth = 1L;
  while (*pos < a.progLen && depth > 0L) {
    long c = u8(a.prog + *pos * 8L);
    if (c == 123L) {
      depth = depth + 1L;
    }
    if (c == 125L) {
      depth = depth - 1L;
      if (depth == 0L) {
        break;
      }
    }
    *pos = *pos + 1L;
  }
  if (depth != 0L) {
    return 0L;
  }
  *bodyLen = *pos - *bodyStart;
  *pos = *pos + 1L;
  return 1L;
}

deRfun parseSpecial(Awk* a): void {
  a.beginStart = 0L;
  a.beginLen = 0L;
  a.endStart = 0L;
  a.endLen = 0L;
  long pos = 0L;
  while (pos < a.progLen) {
    skipProgWs(a, &pos);
    if (pos >= a.progLen) {
      break;
    }
    if (wordAt(a, pos, "BEGIN") == 1L) {
      pos = pos + 5L;
      long bs = 0L;
      long bl = 0L;
      if (takeBraceBody(a, &pos, &bs, &bl) == 1L) {
        a.beginStart = bs;
        a.beginLen = bl;
      }
      continue;
    }
    if (wordAt(a, pos, "END") == 1L) {
      pos = pos + 3L;
      long bs = 0L;
      long bl = 0L;
      if (takeBraceBody(a, &pos, &bs, &bl) == 1L) {
        a.endStart = bs;
        a.endLen = bl;
      }
      continue;
    }
    pos = pos + 1L;
  }
}

deRfun runRule(Awk* a, long body, long blen): void {
  long pos = 0L;
  while (pos < blen) {
    if (pos + 5L <= blen && u8(body + pos * 8L) == 112L && u8(body + (pos + 1L) * 8L) == 114L
        && u8(body + (pos + 2L) * 8L) == 105L && u8(body + (pos + 3L) * 8L) == 110L
        && u8(body + (pos + 4L) * 8L) == 116L) {
      pos = pos + 5L;
      while (pos < blen && u8(body + pos * 8L) == 32L) {
        pos = pos + 1L;
      }
      if (pos < blen && u8(body + pos * 8L) == 36L) {
        pos = pos + 1L;
        if (pos < blen && u8(body + pos * 8L) == 48L) {
          pos = pos + 1L;
        }
        runPrint(a, 0L);
        continue;
      }
      if (wordAtAddr(body, blen, pos, "length") == 1L) {
        pos = pos + 6L;
        writeNumLine(a.home, a.lineLen);
        continue;
      }
      if (wordAtAddr(body, blen, pos, "NR") == 1L) {
        pos = pos + 2L;
        writeNumLine(a.home, a.nr);
        continue;
      }
      runPrint(a, 0L);
      continue;
    }
    if (pos + 6L <= blen && u8(body + pos * 8L) == 115L && u8(body + (pos + 1L) * 8L) == 121L
        && u8(body + (pos + 2L) * 8L) == 115L && u8(body + (pos + 3L) * 8L) == 116L
        && u8(body + (pos + 4L) * 8L) == 101L && u8(body + (pos + 5L) * 8L) == 109L) {
      writeErr(a.home, "awk: system not supported\n");
      pos = pos + 6L;
      continue;
    }
    if (wordAtAddr(body, blen, pos, "length") == 1L) {
      pos = pos + 6L;
      writeNumLine(a.home, a.lineLen);
      continue;
    }
    pos = pos + 1L;
  }
}

deRfun inSpecial(Awk* a, long start, long len): long {
  if (a.beginLen > 0L && start >= a.beginStart && start + len <= a.beginStart + a.beginLen) {
    return 1L;
  }
  if (a.endLen > 0L && start >= a.endStart && start + len <= a.endStart + a.endLen) {
    return 1L;
  }
  return 0L;
}

deRfun runRules(Awk* a): void {
  long pos = 0L;
  while (pos < a.progLen) {
    skipProgWs(a, &pos);
    if (pos >= a.progLen) {
      break;
    }
    if (wordAt(a, pos, "BEGIN") == 1L) {
      pos = pos + 5L;
      long bs = 0L;
      long bl = 0L;
      takeBraceBody(a, &pos, &bs, &bl);
      continue;
    }
    if (wordAt(a, pos, "END") == 1L) {
      pos = pos + 3L;
      long bs = 0L;
      long bl = 0L;
      takeBraceBody(a, &pos, &bs, &bl);
      continue;
    }
    if (u8(a.prog + pos * 8L) == 123L) {
      pos = pos + 1L;
      long bs = pos;
      long depth = 1L;
      while (pos < a.progLen && depth > 0L) {
        long c = u8(a.prog + pos * 8L);
        if (c == 123L) {
          depth = depth + 1L;
        }
        if (c == 125L) {
          depth = depth - 1L;
          if (depth == 0L) {
            break;
          }
        }
        pos = pos + 1L;
      }
      long blen = pos - bs;
      if (inSpecial(a, bs, blen) != 1L) {
        runRule(a, a.prog + bs * 8L, blen);
      }
      if (pos < a.progLen) {
        pos = pos + 1L;
      }
      continue;
    }
    if (u8(a.prog + pos * 8L) == 47L) {
      long ps = pos + 1L;
      pos = ps;
      while (pos < a.progLen && u8(a.prog + pos * 8L) != 47L) {
        pos = pos + 1L;
      }
      if (pos >= a.progLen) {
        return;
      }
      long plen = pos - ps;
      pos = pos + 1L;
      skipProgWs(a, &pos);
      if (pos < a.progLen && u8(a.prog + pos * 8L) == 123L) {
        pos = pos + 1L;
        long bs = pos;
        long depth = 1L;
        while (pos < a.progLen && depth > 0L) {
          long c = u8(a.prog + pos * 8L);
          if (c == 123L) {
            depth = depth + 1L;
          }
          if (c == 125L) {
            depth = depth - 1L;
            if (depth == 0L) {
              break;
            }
          }
          pos = pos + 1L;
        }
        long blen = pos - bs;
        if (patMatch(a, a.prog + ps * 8L, plen) == 1L) {
          runRule(a, a.prog + bs * 8L, blen);
        }
        if (pos < a.progLen) {
          pos = pos + 1L;
        }
      }
      continue;
    }
    pos = pos + 1L;
  }
}

deRfun runProg(Awk* a): void {
  runRules(a);
}

deRfun readLine(Awk* a, long fd): long {
  long buf = obr::proc::alloc(a.home, 8192L * 8L);
  long filled = 0L;
  while (filled < 8192L) {
    if (obr::proc::read(a.home, fd, a.fileOff, 1L) != 0L) {
      return 0L;
    }
    long n = obr::proc::slot(a.home, 320L);
    if (n < 1L) {
      return 2L;
    }
    a.fileOff = a.fileOff + n;
    long bit = u8(obr::proc::bytes(a.home));
    if (bit == 10L) {
      break;
    }
    memory::storeOctet(bit, buf + filled * 8L);
    filled = filled + 1L;
  }
  a.line = buf;
  a.lineLen = filled;
  return 1L;
}

deRfun process(Awk* a, long fd): void {
  a.fileOff = 0L;
  long more = 1L;
  while (more == 1L) {
    long st = readLine(a, fd);
    if (st == 2L) {
      more = 0L;
      break;
    }
    if (st != 1L) {
      more = 0L;
      break;
    }
    a.nr = a.nr + 1L;
    a.fnr = a.fnr + 1L;
    splitFields(a);
    runProg(a);
  }
}

deRfun main(): int {
  long home = obr::proc::home();
  Awk a;
  a.home = home;
  a.nr = 0L;
  a.fnr = 0L;
  a.fs = 32L;
  a.fields = new array[long](64);
  a.fieldLen = new array[long](64);
  a.arr = new map[string, string]();
  a.progLen = 0L;
  long index = 1L;
  if (index < argc(home)) {
    long at = argPtr(home, index);
    long len = argLen(home, index);
    if (len >= 2L && u8(at) == 45L && u8(at + 8L) == 102L) {
      index = index + 1L;
      if (index >= argc(home)) {
        writeErr(home, "awk: missing program\n");
        return finish(home, 1L);
      }
      long pa = argPtr(home, index);
      long pl = argLen(home, index);
      plantPath(home, pa, pl);
      if (obr::proc::open(home, 0L) != 0L) {
        writeErr(home, "awk: missing program\n");
        return finish(home, 1L);
      }
      long fd = obr::proc::slot(home, 192L);
      long off = 0L;
      long buf = obr::proc::alloc(home, 16384L * 8L);
      a.prog = buf;
      while (obr::proc::read(home, fd, off, 4096L) == 0L) {
        long n = obr::proc::slot(home, 320L);
        if (n < 1L) {
          break;
        }
        copySpan(obr::proc::bytes(home), a.prog + a.progLen * 8L, n);
        a.progLen = a.progLen + n;
        off = off + n;
      }
      if (fd != 0L) {
        obr::proc::close(home, fd);
      }
      index = index + 1L;
    } else {
      a.prog = argPtr(home, index);
      a.progLen = len;
      index = index + 1L;
    }
  } else {
    writeErr(home, "awk: missing program\n");
    return finish(home, 1L);
  }
  if (a.progLen < 1L) {
    writeErr(home, "awk: missing program\n");
    return finish(home, 1L);
  }
  parseSpecial(&a);
  if (a.beginLen > 0L) {
    a.lineLen = 0L;
    a.nr = 0L;
    runRule(&a, a.prog + a.beginStart * 8L, a.beginLen);
  }
  if (index >= argc(home)) {
    process(&a, 0L);
  }
  while (index < argc(home)) {
    long at = argPtr(home, index);
    long len = argLen(home, index);
    a.fnr = 0L;
    if (len == 1L && u8(at) == 45L) {
      process(&a, 0L);
    } else {
      plantPath(home, at, len);
      if (obr::proc::open(home, 0L) == 0L) {
        long fd = obr::proc::slot(home, 192L);
        process(&a, fd);
        if (fd != 0L) {
          obr::proc::close(home, fd);
        }
      }
    }
    index = index + 1L;
  }
  if (a.endLen > 0L) {
    runRule(&a, a.prog + a.endStart * 8L, a.endLen);
  }
  return finish(home, 0L);
}

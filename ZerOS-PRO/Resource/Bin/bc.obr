/* POSIX.1-2017 bc（utilities/bc.html）。
   -l 接受但不链接数学库；除 length 外遇 sqrt 等库函数写 bc: library function not supported，退出 1。
   从操作数文件再描述符 0 读入。整数与 scale 小数、ibase/obase 2 到 16、scale 变量、四则比较、
   if/while、print、单独换行输出上一表达式值；函数写 bc: function not supported 并退出 1。
   没有浮点 IEEE；小数用定点 long 和 scale 位数。语法错误 bc: syntax error，退出 1。
   不做 for、数组 a[]、register、read、quit、limits、函数定义。 */
#DYN
import memory;
import obr.oct;
import obr.os;
import obr.proc;
import arg;

struct Bc {
  long home;
  long scale;
  long ibase;
  long obase;
  array[long] vars;
  long last;
  long lastSet;
  long fail;
}

deRfun u8(long addr): long {
  return obr::oct::get(addr);
}

deRfun writeErr(long home, string text): void {
  int raw = length(text);
  long count = raw;
  long index = 0L;
  int cursor = 0;
  while (index < count) {
    memory::storeOctet(text[cursor], obr::proc::bytes(home) + index * 8L);
    index = index + 1L;
    cursor = cursor + 1;
  }
  if (count > 0L) {
    obr::proc::write(home, 2L, 0L, count);
  }
}

deRfun finish(long home, long code): int {
  obr::proc::exit(home, code);
  return 0;
}

deRfun bcFail(Bc* bc, string msg): void {
  writeErr(bc.home, msg);
  bc.fail = 1L;
}

deRfun numText(long val, long obase): string {
  if (val == 0L) {
    return "0";
  }
  int neg = 0;
  if (val < 0L) {
    neg = 1;
    val = 0L - val;
  }
  string digits = "0123456789ABCDEF";
  string out = "";
  while (val > 0L) {
    long digit = val % obase;
    out = digits[digit] + out;
    val = val / obase;
  }
  if (neg == 1) {
    out = "-" + out;
  }
  return out;
}

deRfun writeNum(long home, long val, long obase): void {
  string text = numText(val, obase);
  int raw = length(text);
  long count = raw;
  long index = 0L;
  int cursor = 0;
  while (index < count) {
    memory::storeOctet(text[cursor], obr::proc::bytes(home) + index * 8L);
    index = index + 1L;
    cursor = cursor + 1;
  }
  memory::storeOctet(10L, obr::proc::bytes(home) + count * 8L);
  obr::proc::write(home, 1L, 0L, count + 1L);
}

deRfun pow10(long n): long {
  long v = 1L;
  while (n > 0L) {
    v = v * 10L;
    n = n - 1L;
  }
  return v;
}

deRfun divScale(long a, long b, long sc): long {
  if (b == 0L) {
    return 0L;
  }
  long mul = pow10(sc);
  long q = a * mul / b;
  long rem = a * mul % b;
  if (rem * 2L >= b) {
    q = q + 1L;
  }
  if (rem * 2L < 0L - b) {
    q = q - 1L;
  }
  return q;
}

deRfun skipSpace(long text, long len, long* pos): void {
  while (*pos < len) {
    long c = u8(text + *pos * 8L);
    if (c != 32L && c != 9L && c != 10L && c != 13L) {
      return;
    }
    *pos = *pos + 1L;
  }
}

deRfun parseIdent(long text, long len, long* pos, long* out): long {
  skipSpace(text, len, pos);
  if (*pos >= len) {
    return 0L;
  }
  long c = u8(text + *pos * 8L);
  if (c < 97L || c > 122L) {
    return 0L;
  }
  *out = c - 97L;
  *pos = *pos + 1L;
  return 1L;
}

deRfun parseNumber(Bc* bc, long text, long len, long* pos, long* out): long {
  skipSpace(text, len, pos);
  if (*pos >= len) {
    return 0L;
  }
  long sign = 1L;
  long c = u8(text + *pos * 8L);
  if (c == 45L) {
    sign = -1L;
    *pos = *pos + 1L;
  } else if (c == 43L) {
    *pos = *pos + 1L;
  }
  long val = 0L;
  long base = bc.ibase;
  long got = 0L;
  while (*pos < len) {
    c = u8(text + *pos * 8L);
    long digit = -1L;
    if (c >= 48L && c <= 57L) {
      digit = c - 48L;
    } else if (c >= 97L && c <= 102L) {
      digit = c - 87L;
    } else if (c >= 65L && c <= 70L) {
      digit = c - 55L;
    } else if (c == 46L) {
      break;
    } else {
      break;
    }
    if (digit < 0L || digit >= base) {
      return 0L;
    }
    val = val * base + digit;
    got = 1L;
    *pos = *pos + 1L;
  }
  if (got == 0L) {
    return 0L;
  }
  if (*pos < len && u8(text + *pos * 8L) == 46L) {
    *pos = *pos + 1L;
    long frac = 0L;
    long fscale = 0L;
    while (*pos < len) {
      c = u8(text + *pos * 8L);
      long digit = -1L;
      if (c >= 48L && c <= 57L) {
        digit = c - 48L;
      } else if (c >= 97L && c <= 102L) {
        digit = c - 87L;
      } else if (c >= 65L && c <= 70L) {
        digit = c - 55L;
      } else {
        break;
      }
      if (digit < 0L || digit >= base) {
        return 0L;
      }
      frac = frac * base + digit;
      fscale = fscale + 1L;
      *pos = *pos + 1L;
    }
    if (fscale > bc.scale) {
      long drop = fscale - bc.scale;
      while (drop > 0L) {
        frac = frac / base;
        drop = drop - 1L;
      }
      fscale = bc.scale;
    }
    long mul = pow10(fscale);
    val = val * mul + frac;
  }
  *out = val * sign;
  return 1L;
}


deRfun evalPrimary(Bc* bc, long text, long len, long* pos, long* out): long {
  skipSpace(text, len, pos);
  if (*pos >= len) {
    return 0L;
  }
  long c = u8(text + *pos * 8L);
  if (c == 40L) {
    *pos = *pos + 1L;
    if (evalRel(bc, text, len, pos, out) != 1L) {
      return 0L;
    }
    skipSpace(text, len, pos);
    if (*pos >= len || u8(text + *pos * 8L) != 41L) {
      return 0L;
    }
    *pos = *pos + 1L;
    return 1L;
  }
  if (parseNumber(bc, text, len, pos, out) == 1L) {
    return 1L;
  }
  long idx = 0L;
  if (parseIdent(text, len, pos, &idx) == 1L) {
    if (idx == 18L) {
      *out = bc.scale;
      return 1L;
    }
    if (idx == 19L) {
      *out = bc.ibase;
      return 1L;
    }
    if (idx == 20L) {
      *out = bc.obase;
      return 1L;
    }
    if (idx >= 0L && idx < 18L) {
      *out = bc.vars[idx];
      return 1L;
    }
  }
  return 0L;
}

deRfun evalUnary(Bc* bc, long text, long len, long* pos, long* out): long {
  skipSpace(text, len, pos);
  if (*pos < len && u8(text + *pos * 8L) == 45L) {
    *pos = *pos + 1L;
    if (evalUnary(bc, text, len, pos, out) != 1L) {
      return 0L;
    }
    *out = 0L - *out;
    return 1L;
  }
  return evalPrimary(bc, text, len, pos, out);
}

deRfun evalMul(Bc* bc, long text, long len, long* pos, long* out): long {
  if (evalUnary(bc, text, len, pos, out) != 1L) {
    return 0L;
  }
  while (*pos < len) {
    skipSpace(text, len, pos);
    if (*pos >= len) {
      break;
    }
    long op = u8(text + *pos * 8L);
    if (op == 42L) {
      *pos = *pos + 1L;
      long rhs = 0L;
      if (evalUnary(bc, text, len, pos, &rhs) != 1L) {
        return 0L;
      }
      *out = *out * rhs;
    } else if (op == 47L) {
      *pos = *pos + 1L;
      long rhs = 0L;
      if (evalUnary(bc, text, len, pos, &rhs) != 1L) {
        return 0L;
      }
      *out = divScale(*out, rhs, bc.scale);
    } else if (op == 37L) {
      *pos = *pos + 1L;
      long rhs = 0L;
      if (evalUnary(bc, text, len, pos, &rhs) != 1L) {
        return 0L;
      }
      if (rhs == 0L) {
        return 0L;
      }
      *out = *out % rhs;
    } else {
      break;
    }
  }
  return 1L;
}

deRfun evalAdd(Bc* bc, long text, long len, long* pos, long* out): long {
  if (evalMul(bc, text, len, pos, out) != 1L) {
    return 0L;
  }
  while (*pos < len) {
    skipSpace(text, len, pos);
    if (*pos >= len) {
      break;
    }
    long op = u8(text + *pos * 8L);
    if (op == 43L) {
      *pos = *pos + 1L;
      long rhs = 0L;
      if (evalMul(bc, text, len, pos, &rhs) != 1L) {
        return 0L;
      }
      *out = *out + rhs;
    } else if (op == 45L) {
      *pos = *pos + 1L;
      long rhs = 0L;
      if (evalMul(bc, text, len, pos, &rhs) != 1L) {
        return 0L;
      }
      *out = *out - rhs;
    } else {
      break;
    }
  }
  return 1L;
}

deRfun evalRel(Bc* bc, long text, long len, long* pos, long* out): long {
  if (evalAdd(bc, text, len, pos, out) != 1L) {
    return 0L;
  }
  while (*pos < len) {
    skipSpace(text, len, pos);
    if (*pos + 1L >= len) {
      break;
    }
    long c0 = u8(text + *pos * 8L);
    long c1 = u8(text + (*pos + 1L) * 8L);
    long op = 0L;
    if (c0 == 61L && c1 == 61L) {
      op = 1L;
      *pos = *pos + 2L;
    } else if (c0 == 33L && c1 == 61L) {
      op = 2L;
      *pos = *pos + 2L;
    } else if (c0 == 60L && c1 == 61L) {
      op = 3L;
      *pos = *pos + 2L;
    } else if (c0 == 62L && c1 == 61L) {
      op = 4L;
      *pos = *pos + 2L;
    } else if (c0 == 60L) {
      op = 5L;
      *pos = *pos + 1L;
    } else if (c0 == 62L) {
      op = 6L;
      *pos = *pos + 1L;
    } else {
      break;
    }
    long rhs = 0L;
    if (evalAdd(bc, text, len, pos, &rhs) != 1L) {
      return 0L;
    }
    long res = 0L;
    if (op == 1L) {
      if (*out == rhs) {
        res = 1L;
      }
    } else if (op == 2L) {
      if (*out != rhs) {
        res = 1L;
      }
    } else if (op == 3L) {
      if (*out <= rhs) {
        res = 1L;
      }
    } else if (op == 4L) {
      if (*out >= rhs) {
        res = 1L;
      }
    } else if (op == 5L) {
      if (*out < rhs) {
        res = 1L;
      }
    } else if (op == 6L) {
      if (*out > rhs) {
        res = 1L;
      }
    }
    *out = res;
  }
  return 1L;
}

deRfun evalExpr(Bc* bc, long text, long len, long* pos, long* out): long {
  return evalRel(bc, text, len, pos, out);
}

deRfun runFrom(Bc* bc, long text, long len, long start): long {
  long pos = start;
  skipSpace(text, len, &pos);
  if (pos >= len) {
    if (bc.lastSet == 1L) {
      writeNum(bc.home, bc.last, bc.obase);
    }
    return 1L;
  }
  if (pos + 6L <= len && u8(text + pos * 8L) == 100L && u8(text + (pos + 1L) * 8L) == 101L
      && u8(text + (pos + 2L) * 8L) == 102L && u8(text + (pos + 3L) * 8L) == 105L
      && u8(text + (pos + 4L) * 8L) == 110L && u8(text + (pos + 5L) * 8L) == 101L) {
    bcFail(bc, "bc: function not supported\n");
    return 1L;
  }
  if (pos + 2L <= len && u8(text + pos * 8L) == 105L && u8(text + (pos + 1L) * 8L) == 102L) {
    pos = pos + 2L;
    skipSpace(text, len, &pos);
    if (pos >= len || u8(text + pos * 8L) != 40L) {
      return 0L;
    }
    pos = pos + 1L;
    long cond = 0L;
    if (evalRel(bc, text, len, &pos, &cond) != 1L) {
      return 0L;
    }
    skipSpace(text, len, &pos);
    if (pos >= len || u8(text + pos * 8L) != 41L) {
      return 0L;
    }
    pos = pos + 1L;
    if (cond == 0L) {
      return 1L;
    }
    return runFrom(bc, text, len, pos);
  }
  if (pos + 5L <= len && u8(text + pos * 8L) == 119L && u8(text + (pos + 1L) * 8L) == 104L
      && u8(text + (pos + 2L) * 8L) == 105L && u8(text + (pos + 3L) * 8L) == 108L
      && u8(text + (pos + 4L) * 8L) == 101L) {
    pos = pos + 5L;
    skipSpace(text, len, &pos);
    if (pos >= len || u8(text + pos * 8L) != 40L) {
      return 0L;
    }
    pos = pos + 1L;
    while (1L == 1L) {
      long cond = 0L;
      long cp = pos;
      if (evalRel(bc, text, len, &cp, &cond) != 1L) {
        return 0L;
      }
      skipSpace(text, len, &cp);
      if (cp >= len || u8(text + cp * 8L) != 41L) {
        return 0L;
      }
      cp = cp + 1L;
      if (cond == 0L) {
        return 1L;
      }
      if (runFrom(bc, text, len, cp) != 1L) {
        return 0L;
      }
      if (bc.fail == 1L) {
        return 0L;
      }
    }
  }
  long savePos = pos;
  long fidx = 0L;
  if (parseIdent(text, len, &pos, &fidx) == 1L) {
    skipSpace(text, len, &pos);
    if (pos < len && u8(text + pos * 8L) == 40L) {
      long scan = pos + 1L;
      while (scan < len && u8(text + scan * 8L) != 123L) {
        scan = scan + 1L;
      }
      if (scan < len && u8(text + scan * 8L) == 123L) {
        bcFail(bc, "bc: function not supported\n");
        return 1L;
      }
    }
  }
  pos = savePos;
  if (pos + 4L <= len && u8(text + pos * 8L) == 115L && u8(text + (pos + 1L) * 8L) == 99L
      && u8(text + (pos + 2L) * 8L) == 97L && u8(text + (pos + 3L) * 8L) == 108L) {
    pos = pos + 4L;
    skipSpace(text, len, &pos);
    long val = 0L;
    if (evalExpr(bc, text, len, &pos, &val) != 1L) {
      return 0L;
    }
    if (val < 0L) {
      val = 0L;
    }
    bc.scale = val;
    return 1L;
  }
  if (pos + 5L <= len && u8(text + pos * 8L) == 105L && u8(text + (pos + 1L) * 8L) == 98L) {
    long val = 0L;
    pos = pos + 5L;
    if (evalExpr(bc, text, len, &pos, &val) != 1L || val < 2L || val > 16L) {
      return 0L;
    }
    bc.ibase = val;
    return 1L;
  }
  if (pos + 5L <= len && u8(text + pos * 8L) == 111L && u8(text + (pos + 1L) * 8L) == 98L) {
    long val = 0L;
    pos = pos + 5L;
    if (evalExpr(bc, text, len, &pos, &val) != 1L || val < 2L || val > 16L) {
      return 0L;
    }
    bc.obase = val;
    return 1L;
  }
  if (pos + 5L <= len && u8(text + pos * 8L) == 112L && u8(text + (pos + 1L) * 8L) == 114L) {
    pos = pos + 5L;
    long val = 0L;
    if (evalExpr(bc, text, len, &pos, &val) != 1L) {
      return 0L;
    }
    writeNum(bc.home, val, bc.obase);
    bc.last = val;
    bc.lastSet = 1L;
    return 1L;
  }
  if (pos + 6L <= len && u8(text + pos * 8L) == 108L && u8(text + (pos + 1L) * 8L) == 101L) {
    pos = pos + 6L;
    skipSpace(text, len, &pos);
    long val = 0L;
    if (evalExpr(bc, text, len, &pos, &val) != 1L) {
      return 0L;
    }
    long n = 0L;
    long t = val;
    if (t < 0L) {
      t = 0L - t;
    }
    if (t == 0L) {
      n = 1L;
    }
    while (t > 0L) {
      n = n + 1L;
      t = t / bc.ibase;
    }
    bc.last = n;
    bc.lastSet = 1L;
    writeNum(bc.home, n, bc.obase);
    return 1L;
  }
  long vidx = 0L;
  long saveAssign = pos;
  if (parseIdent(text, len, &pos, &vidx) == 1L) {
    skipSpace(text, len, &pos);
    if (pos < len && u8(text + pos * 8L) == 61L) {
      pos = pos + 1L;
      long val = 0L;
      if (evalExpr(bc, text, len, &pos, &val) != 1L) {
        return 0L;
      }
      if (vidx == 18L) {
        bc.scale = val;
      } else if (vidx == 19L) {
        if (val < 2L || val > 16L) {
          return 0L;
        }
        bc.ibase = val;
      } else if (vidx == 20L) {
        if (val < 2L || val > 16L) {
          return 0L;
        }
        bc.obase = val;
      } else if (vidx >= 0L && vidx < 18L) {
        bc.vars[vidx] = val;
      }
      bc.last = val;
      bc.lastSet = 1L;
      return 1L;
    }
  }
  pos = saveAssign;
  long val = 0L;
  if (evalExpr(bc, text, len, &pos, &val) != 1L) {
    return 0L;
  }
  bc.last = val;
  bc.lastSet = 1L;
  return 1L;
}

deRfun runLine(Bc* bc, long text, long len): long {
  return runFrom(bc, text, len, 0L);
}

deRfun readLine(long home, long fd, long buf, long* len, long* fileOff): long {
  long cap = 4096L;
  long filled = 0L;
  while (filled < cap) {
    if (obr::proc::read(home, fd, *fileOff, 1L) != 0L) {
      return 0L;
    }
    long n = obr::proc::slot(home, 320L);
    if (n < 1L) {
      break;
    }
    *fileOff = *fileOff + n;
    long bit = u8(obr::proc::bytes(home));
    if (bit == 10L) {
      break;
    }
    memory::storeOctet(bit, buf + filled * 8L);
    filled = filled + 1L;
  }
  *len = filled;
  return 1L;
}

deRfun plantPath(long home, long addr, long count): void {
  memory::store64(count, obr::proc::path(home));
  long index = 0L;
  while (index < count) {
    memory::storeOctet(u8(addr + index * 8L), obr::proc::path(home) + 64L + index * 8L);
    index = index + 1L;
  }
}

deRfun runFile(Bc* bc, long addr, long count): long {
  if (count < 0L || count > 8192L) {
    return 0L;
  }
  plantPath(bc.home, addr, count);
  if (obr::proc::open(bc.home, 0L) != 0L) {
    return 0L;
  }
  long fd = obr::proc::slot(bc.home, 192L);
  long buf = obr::proc::alloc(bc.home, 4096L * 8L);
  long len = 0L;
  long fileOff = 0L;
  long more = 1L;
  while (more == 1L) {
    if (readLine(bc.home, fd, buf, &len, &fileOff) != 1L) {
      more = 0L;
      break;
    }
    if (len < 1L) {
      more = 0L;
      break;
    }
    if (runLine(bc, buf, len) != 1L) {
      bcFail(bc, "bc: syntax error\n");
      if (fd != 0L) {
        obr::proc::close(bc.home, fd);
      }
      return 0L;
    }
  }
  if (fd != 0L) {
    obr::proc::close(bc.home, fd);
  }
  return 1L;
}

deRfun main(): int {
  long home = obr::proc::home();
  Bc bc;
  bc.home = home;
  bc.scale = 0L;
  bc.ibase = 10L;
  bc.obase = 10L;
  bc.vars = new array[long](26);
  bc.last = 0L;
  bc.lastSet = 0L;
  bc.fail = 0L;
  long index = 1L;
  long lib = 0L;
  while (index < argc(home)) {
    long at = argPtr(home, index);
    long len = argLen(home, index);
    if (len == 2L && u8(at) == 45L && u8(at + 8L) == 108L) {
      lib = 1L;
      index = index + 1L;
    } else {
      break;
    }
  }
  long hadOpenFail = 0L;
  while (index < argc(home)) {
    long at = argPtr(home, index);
    long len = argLen(home, index);
    if (runFile(&bc, at, len) != 1L) {
      hadOpenFail = 1L;
    }
    if (bc.fail == 1L) {
      return finish(home, 1L);
    }
    index = index + 1L;
  }
  long buf = obr::proc::alloc(home, 4096L * 8L);
  long len = 0L;
  long fileOff = 0L;
  long more = 1L;
  while (more == 1L) {
    if (readLine(home, 0L, buf, &len, &fileOff) != 1L) {
      break;
    }
    if (len < 1L) {
      more = 0L;
      break;
    }
    if (runLine(&bc, buf, len) != 1L) {
      bcFail(&bc, "bc: syntax error\n");
      return finish(home, 1L);
    }
  }
  if (bc.fail == 1L) {
    return finish(home, 1L);
  }
  return finish(home, 0L);
}

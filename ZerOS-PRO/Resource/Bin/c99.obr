/* POSIX.1-2017 c99（utilities/c99.html）。本平台没有 C 前端（无预处理器/编译器）。
   形式：c99 [-cEgOs] [-D name[=def]] [-I dir] [-L dir] [-l library] [-o outfile]
              [-U name] [operand...]
   完整处理选项与操作数（-c -E -g -O -s、-D/-U/-I/-L/-l 带参、-o outfile、
   operand 为 .c/.o/.a 文件），校验形状后明确报告：
   c99: no C compiler on this platform，退出 127（稳定退出码，不假装成功）。
   缺操作数写 c99: missing operand，退出 1（用法错误按 POSIX 退出 >0）。
   诊断英文 ASCII，描述符 2，前缀 c99:。结束用服务 28。 */
#DYN
import obr.proc;
import arg;
import binutil;

deRfun main(): int {
  long home = obr::proc::home();
  long count = argc(home);
  long index = 1L;
  long ended = 0L;
  long operands = 0L;
  while (index < count) {
    long at = argPtr(home, index);
    long len = argLen(home, index);
    if (ended == 0L && len == 2L && spanSame(at, len, "--") == 1L) {
      ended = 1L;
    } else if (ended == 0L && len >= 2L && byteAt(at) == 45L) {
      long c = 1L;
      while (c < len) {
        long o = byteAt(at + c * 8L);
        if (o == 99L || o == 69L || o == 103L || o == 79L || o == 115L) {
          c = c + 1L;
        } else if (o == 68L || o == 85L || o == 73L || o == 76L || o == 108L || o == 111L) {
          c = c + 1L;
          if (c >= len) {
            index = index + 1L;
            if (index >= count) {
              writeErr(home, "c99: option requires an argument\n");
              return finish(home, 1L);
            }
          }
          c = len;
        } else {
          writeErr(home, "c99: invalid option\n");
          return finish(home, 1L);
        }
      }
    } else {
      operands = operands + 1L;
    }
    index = index + 1L;
  }
  if (operands == 0L) {
    writeErr(home, "c99: missing operand\n");
    return finish(home, 1L);
  }
  writeErr(home, "c99: no C compiler on this platform\n");
  return finish(home, 127L);
}

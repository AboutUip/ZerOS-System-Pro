/* POSIX cat。只接受 -u，-uu 也行。读到一块就写到标准输出，所以 -u 不改变行为。
   -- 结束选项；第一个不是选项的参数也结束选项，后面的 -u 是文件名。
   没有文件，或文件是单独一个 -，就读标准输入，并且不关闭描述符 0。
   打开失败写到标准错误，继续后面的文件，已经写出的内容留着，最后以 1 退出。 */
import memory;
import obr.os;
import obr.proc;
import arg;

deRfun u8(long addr): long {
  long value = memory::loadOctet(addr);
  if (value < 0L) {
    value = value + 256L;
  }
  return value;
}

deRfun copySpan(long from, long to, long count): void {
  long index = 0L;
  while (index < count) {
    memory::storeOctet(u8(from + index * 8L), to + index * 8L);
    index = index + 1L;
  }
}

/* 八位组先搬进读写字节区再 write。一次最多 4096。 */
deRfun writeFd(long home, long fd, long addr, long count): void {
  long offset = 0L;
  while (offset < count) {
    long chunk = count - offset;
    if (chunk > 4096L) {
      chunk = 4096L;
    }
    long index = 0L;
    while (index < chunk) {
      memory::storeOctet(u8(addr + (offset + index) * 8L), obr::proc::bytes(home) + index * 8L);
      index = index + 1L;
    }
    obr::proc::write(home, fd, 0L, chunk);
    offset = offset + chunk;
  }
}

deRfun writeErr(long home, string text): void {
  int raw = length(text);
  long count = raw;
  long index = 0L;
  while (index < count) {
    memory::storeOctet(text[index], obr::proc::bytes(home) + index * 8L);
    index = index + 1L;
  }
  if (count > 0L) {
    obr::proc::write(home, 2L, 0L, count);
  }
}

/* 长度字在路径起点，八位组从 +64 起、隔 8 位。计数字符串最长 8192。 */
deRfun plant(long home, long addr, long count): void {
  memory::store64(count, obr::proc::path(home));
  copySpan(addr, obr::proc::path(home) + 64L, count);
}

deRfun miss(long home, long addr, long count): void {
  writeErr(home, "cat: ");
  writeFd(home, 2L, addr, count);
  writeErr(home, ": No such file or directory\n");
}

/* 读和写共用 bytes()。这一块写完才读下一块。
   普通文件的偏移是绝对位置，写出的位置要往下累加。
   管道和控制台不看这个偏移。一次写不满时，剩下的挪回字节区开头。
   返回 0 成功，1 读失败，2 写失败。 */
deRfun pour(long home, long fd): long {
  long offset = 0L;
  long outAt = 0L;
  long reading = 1L;
  while (reading == 1L) {
    if (obr::proc::read(home, fd, offset, 4096L) != 0L) {
      writeErr(home, "cat: read error\n");
      return 1L;
    }
    long n = obr::proc::slot(home, 320L);
    if (n < 0L) {
      writeErr(home, "cat: read error\n");
      return 1L;
    }
    if (n == 0L) {
      reading = 0L;
    } else {
      if (n > 4096L) {
        n = 4096L;
      }
      long pending = n;
      while (pending > 0L) {
        long chunk = pending;
        if (chunk > 4096L) {
          chunk = 4096L;
        }
        if (obr::proc::write(home, 1L, outAt, chunk) != 0L) {
          writeErr(home, "cat: write error\n");
          return 2L;
        }
        long wrote = obr::proc::slot(home, 320L);
        if (wrote < 1L) {
          writeErr(home, "cat: write error\n");
          return 2L;
        }
        if (wrote > chunk) {
          wrote = chunk;
        }
        pending = pending - wrote;
        outAt = outAt + wrote;
        if (pending > 0L) {
          copySpan(obr::proc::bytes(home) + wrote * 8L, obr::proc::bytes(home), pending);
        }
      }
      offset = offset + n;
    }
  }
  return 0L;
}

/* 只读打开。成功时描述符在 +192，必须在下一次 read 之前取走。描述符 0 不关。 */
deRfun pourFile(long home, long addr, long count): long {
  if (count < 0L || count > 8192L) {
    miss(home, addr, count);
    return 1L;
  }
  plant(home, addr, count);
  if (obr::proc::open(home, 0L) != 0L) {
    miss(home, addr, count);
    return 1L;
  }
  long fd = obr::proc::slot(home, 192L);
  long status = pour(home, fd);
  if (fd != 0L) {
    obr::proc::close(home, fd);
  }
  return status;
}

deRfun finish(long home, long code): int {
  obr::proc::exit(home, code);
  return 0;
}

deRfun main(): int {
  long home = obr::proc::home();
  long index = 1L;
  long count = argc(home);
  long ended = 0L;
  while (index < count && ended == 0L) {
    long at = argPtr(home, index);
    long len = argLen(home, index);
    if (len == 2L && u8(at) == 45L && u8(at + 8L) == 45L) {
      index = index + 1L;
      ended = 1L;
    } else if (len >= 2L && u8(at) == 45L) {
      long cursor = 1L;
      while (cursor < len) {
        /* 117 是 u。只有 u 可以连写。 */
        if (u8(at + cursor * 8L) != 117L) {
          writeErr(home, "cat: invalid option\n");
          return finish(home, 1L);
        }
        cursor = cursor + 1L;
      }
      index = index + 1L;
    } else {
      ended = 1L;
    }
  }
  long failed = 0L;
  if (index >= count) {
    long status = pour(home, 0L);
    if (status == 2L) {
      return finish(home, 1L);
    }
    if (status != 0L) {
      failed = 1L;
    }
  }
  while (index < count) {
    long at = argPtr(home, index);
    long len = argLen(home, index);
    long status = 0L;
    if (len == 1L && u8(at) == 45L) {
      status = pour(home, 0L);
    } else {
      status = pourFile(home, at, len);
    }
    if (status == 2L) {
      return finish(home, 1L);
    }
    if (status != 0L) {
      failed = 1L;
    }
    index = index + 1L;
  }
  if (failed != 0L) {
    return finish(home, 1L);
  }
  return finish(home, 0L);
}

/* POSIX env。形式是 env [-i] [-u name]... [name=value]... [utility [argument...]]。
   不做 -0、-C、-S、-v。
   选项从下标 1 起。-- 结束选项。短选项只有 i 和 u。
   u 必须是这一簇的最后一个字母：后面紧跟的字节就是名字，没有就用下一个参数。
   缺名字写 env: missing operand，退出 1。别的字母写 env: invalid option，退出 1。
   -i 丢掉继承来的环境。-u 删掉当时同名的一条；名字当时不在，不算错。
   名字为空或含着等号，写 env: invalid name，退出 1。可以多次 -u。
   选项之后，含等号的词按第一个等号拆开。名字非空，每个字节都是字母、数字或下划线，
   并且第一个字节不是数字，才是赋值。否则这个词就是要跑的程序，后面的都是参数。
   同一个名字后写的赋值覆盖先写的。值可以为空。
   组装顺序：没有 -i 就先按原顺序拷带等号的继承环境，再按 -u 删除，再按操作数放赋值。
   已有的名字就地替换，没有就追加到末尾。没有等号的继承条目跳过。
   没有程序时，每条写成名字、等号、值、换行，退出 0。-i 且没有赋值时什么都不写。
   有程序时不打印。名字里有斜杠就用这条路径；否则在即将交给子进程的 PATH 里按冒号分段。
   PATH 没有这一条时用 /bin:/os:/kernel。空段表示当前目录，路径就是程序名本身。
   段不以斜杠结尾就加一个斜杠再接名字。种类必须是 1 或 5，否则继续下一段。
   都找不到写 env: 名字: No such file or directory，退出 127。
   找到了但 spawn 失败，写 env: 名字: cannot execute，退出 126。
   spawn 会把界限起点 +4194304 的整段抄给子任务，所以先抄到 alloc 的块里，再改写，再 spawn。
   字 0 是 argc，字 1 是环境条数，字 2 是参数八位组数，字 3 是环境八位组数。
   参数长度从 +256 起，环境长度从 +4352 起。参数八位组从 +8448 起，环境八位组从 +73984 起。
   argc 含程序名。条数各至多 64，两段八位组各至多 8192。超出写 env: argument list too long，退出 1。
   没用到的长度字写 0。不要先把整段 139520 位清零再漏写环境。
   打印走描述符 1，偏移从 0 累加，一次最多 4096。写失败写 env: write error，退出 1。
   诊断写描述符 2，偏移从 0。不关闭描述符 0。stat 的种类在 slot 128，要马上抄走。
   alloc 的单位是位，失败写 env: out of memory，退出 1。main 经 finish 调 exit。 */
import memory;
import obr.os;
import obr.proc;
import arg;

/* loadOctet 是补码。最高位为 1 时读出来是负数，加 256 才是 0 到 255。 */
deRfun u8(long addr): long {
  long value = memory::loadOctet(addr);
  if (value < 0L) {
    value = value + 256L;
  }
  return value;
}

deRfun copySpan(long from, long to, long count): void {
  long index = 0L;
  while (index < count) {
    memory::storeOctet(u8(from + index * 8L), to + index * 8L);
    index = index + 1L;
  }
}

/* 从长度表往前加。下标 0 得到 0，用来算某条八位组的起点。 */
deRfun sumLens(long table, long index): long {
  long filled = 0L;
  long cursor = 0L;
  while (cursor < index) {
    filled = filled + memory::load64(table + cursor * 64L);
    cursor = cursor + 1L;
  }
  return filled;
}

deRfun putText(long addr, long at, string text): long {
  int raw = length(text);
  int index = 0;
  while (index < raw) {
    memory::storeOctet(text[index], addr + (at + index) * 8L);
    index = index + 1;
  }
  long next = at + raw;
  return next;
}

/* 诊断一律从偏移 0 写到描述符 2。控制台不看这个偏移。 */
deRfun writeErr(long home, string text): void {
  int raw = length(text);
  long count = raw;
  long index = 0L;
  while (index < count) {
    memory::storeOctet(text[index], obr::proc::bytes(home) + index * 8L);
    index = index + 1L;
  }
  if (count > 0L) {
    obr::proc::write(home, 2L, 0L, count);
  }
}

deRfun writeErrSpan(long home, long addr, long count): void {
  long offset = 0L;
  while (offset < count) {
    long chunk = count - offset;
    if (chunk > 4096L) {
      chunk = 4096L;
    }
    copySpan(addr + offset * 8L, obr::proc::bytes(home), chunk);
    obr::proc::write(home, 2L, 0L, chunk);
    offset = offset + chunk;
  }
}

deRfun sayMiss(long home, long addr, long count): void {
  writeErr(home, "env: ");
  writeErrSpan(home, addr, count);
  writeErr(home, ": No such file or directory\n");
}

deRfun sayExec(long home, long addr, long count): void {
  writeErr(home, "env: ");
  writeErrSpan(home, addr, count);
  writeErr(home, ": cannot execute\n");
}

/* 描述符 1 的偏移从 0 一直往下加。一次最多 4096。写不满就把剩下的挪回字节区开头。
   失败已经写过 env: write error，返回 1。 */
deRfun emitReady(long home, long* place, long count): long {
  long pending = count;
  while (pending > 0L) {
    long chunk = pending;
    if (chunk > 4096L) {
      chunk = 4096L;
    }
    if (obr::proc::write(home, 1L, *place, chunk) != 0L) {
      writeErr(home, "env: write error\n");
      return 1L;
    }
    long wrote = obr::proc::slot(home, 320L);
    if (wrote < 1L) {
      writeErr(home, "env: write error\n");
      return 1L;
    }
    if (wrote > chunk) {
      wrote = chunk;
    }
    pending = pending - wrote;
    *place = *place + wrote;
    if (pending > 0L) {
      copySpan(obr::proc::bytes(home) + wrote * 8L, obr::proc::bytes(home), pending);
    }
  }
  return 0L;
}

deRfun emitSpan(long home, long* place, long addr, long count): long {
  long offset = 0L;
  while (offset < count) {
    long chunk = count - offset;
    if (chunk > 4096L) {
      chunk = 4096L;
    }
    copySpan(addr + offset * 8L, obr::proc::bytes(home), chunk);
    if (emitReady(home, place, chunk) != 0L) {
      return 1L;
    }
    offset = offset + chunk;
  }
  return 0L;
}

deRfun emitByte(long home, long* place, long value): long {
  memory::storeOctet(value, obr::proc::bytes(home));
  return emitReady(home, place, 1L);
}

/* 计数字符串：长度在 path()，八位组从 +64 起、隔 8 位。最长 8192。 */
deRfun plant(long home, long addr, long count): void {
  memory::store64(count, obr::proc::path(home));
  copySpan(addr, obr::proc::path(home) + 64L, count);
}

/* 种类在 slot 128。必须在这次 stat 之后、下一次系统调用之前抄出来。 */
deRfun fileKind(long home): long {
  if (obr::proc::stat(home) != 0L) {
    return -1L;
  }
  long kind = obr::proc::slot(home, 128L);
  return kind;
}

deRfun finish(long home, long code): int {
  obr::proc::exit(home, code);
  return 0;
}

/* 第一个等号的下标。没有就返回 -1。 */
deRfun eqAt(long addr, long count): long {
  long index = 0L;
  while (index < count) {
    if (u8(addr + index * 8L) == 61L) {
      return index;
    }
    index = index + 1L;
  }
  return -1L;
}

/* lead 不是 0 时拒绝数字。字母和下划线两种情况都收。 */
deRfun nameChar(long bit, long lead): long {
  if (bit >= 65L && bit <= 90L) {
    return 1L;
  }
  if (bit >= 97L && bit <= 122L) {
    return 1L;
  }
  if (bit == 95L) {
    return 1L;
  }
  if (lead == 0L && bit >= 48L && bit <= 57L) {
    return 1L;
  }
  return 0L;
}

/* 是赋值就返回 1，并把等号前的长度写进 *nameLen。不是赋值就返回 0，调用方把它当成程序。 */
deRfun isAssign(long addr, long count, long* nameLen): long {
  long eq = eqAt(addr, count);
  if (eq < 1L) {
    return 0L;
  }
  long index = 0L;
  while (index < eq) {
    long lead = 0L;
    if (index == 0L) {
      lead = 1L;
    }
    if (nameChar(u8(addr + index * 8L), lead) == 0L) {
      return 0L;
    }
    index = index + 1L;
  }
  *nameLen = eq;
  return 1L;
}

/* -u 的名字为空，或里面有等号，都算不合法。别的字节留着，继承来的名字不一定是标识符。 */
deRfun badUnset(long addr, long count): long {
  if (count < 1L) {
    return 1L;
  }
  long index = 0L;
  while (index < count) {
    if (u8(addr + index * 8L) == 61L) {
      return 1L;
    }
    index = index + 1L;
  }
  return 0L;
}

deRfun hasSlash(long addr, long count): long {
  long index = 0L;
  while (index < count) {
    if (u8(addr + index * 8L) == 47L) {
      return 1L;
    }
    index = index + 1L;
  }
  return 0L;
}

/* 抄出来的窗口和内核 argAt 同一张布局。后面改写活窗口时只读这里。 */
deRfun savedArgLen(long saved, long index): long {
  return memory::load64(saved + 256L + index * 64L);
}

deRfun savedArgPtr(long saved, long index): long {
  return saved + 8448L + sumLens(saved + 256L, index) * 8L;
}

deRfun savedEnvLen(long saved, long index): long {
  return memory::load64(saved + 4352L + index * 64L);
}

deRfun savedEnvPtr(long saved, long index): long {
  return saved + 73984L + sumLens(saved + 4352L, index) * 8L;
}

/* 用 arg.obr 的 argc、argLen、argPtr、envc、envLen、envPtr 把活窗口抄走。
   这一步必须发生在改写 +4194304 之前。超出 64 条或 8192 个八位组就失败。 */
deRfun saveWindow(long home, long dest): long {
  long narg = argc(home);
  long nenv = envc(home);
  if (narg < 0L || narg > 64L || nenv < 0L || nenv > 64L) {
    return 1L;
  }
  memory::store64(narg, dest);
  memory::store64(nenv, dest + 64L);
  long argBytes = 0L;
  long index = 0L;
  while (index < narg) {
    long len = argLen(home, index);
    if (len < 0L || len > 8192L || argBytes + len > 8192L) {
      return 1L;
    }
    memory::store64(len, dest + 256L + index * 64L);
    if (len > 0L) {
      copySpan(argPtr(home, index), dest + 8448L + argBytes * 8L, len);
    }
    argBytes = argBytes + len;
    index = index + 1L;
  }
  memory::store64(argBytes, dest + 128L);
  while (index < 64L) {
    memory::store64(0L, dest + 256L + index * 64L);
    index = index + 1L;
  }
  long envBytes = 0L;
  index = 0L;
  while (index < nenv) {
    long len = envLen(home, index);
    if (len < 0L || len > 8192L || envBytes + len > 8192L) {
      return 1L;
    }
    memory::store64(len, dest + 4352L + index * 64L);
    if (len > 0L) {
      copySpan(envPtr(home, index), dest + 73984L + envBytes * 8L, len);
    }
    envBytes = envBytes + len;
    index = index + 1L;
  }
  memory::store64(envBytes, dest + 192L);
  while (index < 64L) {
    memory::store64(0L, dest + 4352L + index * 64L);
    index = index + 1L;
  }
  return 0L;
}

/* 工作环境不是内核那张全表。字 0 是条数，字 1 是八位组数。
   长度从 +128 起，八位组从 +4224 起，相邻隔 8 位。整块 69760 位。
   alloc 不保证清零，用之前要把条数、八位组数和 64 个长度字写成 0。 */
deRfun packLen(long pack, long index): long {
  return memory::load64(pack + 128L + index * 64L);
}

deRfun packPtr(long pack, long index): long {
  return pack + 4224L + sumLens(pack + 128L, index) * 8L;
}

deRfun packReset(long pack): void {
  memory::store64(0L, pack);
  memory::store64(0L, pack + 64L);
  long index = 0L;
  while (index < 64L) {
    memory::store64(0L, pack + 128L + index * 64L);
    index = index + 1L;
  }
}

/* 继承来的一条已经是名字、等号、值。原样接在末尾，保持原来的先后。 */
deRfun envAppendRaw(long pack, long addr, long len): long {
  long count = memory::load64(pack);
  long total = memory::load64(pack + 64L);
  if (len < 0L || count >= 64L || len > 8192L || total + len > 8192L) {
    return 1L;
  }
  if (len > 0L) {
    copySpan(addr, pack + 4224L + total * 8L, len);
  }
  memory::store64(len, pack + 128L + count * 64L);
  memory::store64(count + 1L, pack);
  memory::store64(total + len, pack + 64L);
  return 0L;
}

deRfun envAppendParts(long pack, long name, long nameLen, long value, long valueLen): long {
  long count = memory::load64(pack);
  long total = memory::load64(pack + 64L);
  long len = nameLen + 1L + valueLen;
  if (count >= 64L || len > 8192L || total + len > 8192L) {
    return 1L;
  }
  long at = pack + 4224L + total * 8L;
  if (nameLen > 0L) {
    copySpan(name, at, nameLen);
  }
  memory::storeOctet(61L, at + nameLen * 8L);
  if (valueLen > 0L) {
    copySpan(value, at + (nameLen + 1L) * 8L, valueLen);
  }
  memory::store64(len, pack + 128L + count * 64L);
  memory::store64(count + 1L, pack);
  memory::store64(total + len, pack + 64L);
  return 0L;
}

/* 名字相同是：等号正好卡在名字长度的位置，前面每个字节都一样。 */
deRfun envSame(long entry, long entryLen, long name, long nameLen): long {
  if (nameLen < 1L || entryLen < nameLen + 1L) {
    return 0L;
  }
  long index = 0L;
  while (index < nameLen) {
    if (u8(entry + index * 8L) != u8(name + index * 8L)) {
      return 0L;
    }
    index = index + 1L;
  }
  if (u8(entry + nameLen * 8L) != 61L) {
    return 0L;
  }
  return 1L;
}

deRfun envFind(long pack, long name, long nameLen): long {
  long count = memory::load64(pack);
  long index = 0L;
  while (index < count) {
    if (envSame(packPtr(pack, index), packLen(pack, index), name, nameLen) == 1L) {
      return index;
    }
    index = index + 1L;
  }
  return -1L;
}

/* delta 为正时从尾巴往前搬，避免盖住还没搬的字节。为负时从前往后搬。 */
deRfun shiftOctets(long at, long count, long delta): void {
  if (delta == 0L || count < 1L) {
    return;
  }
  if (delta > 0L) {
    long index = count - 1L;
    while (index >= 0L) {
      memory::storeOctet(u8(at + index * 8L), at + (index + delta) * 8L);
      index = index - 1L;
    }
  } else {
    long index = 0L;
    while (index < count) {
      memory::storeOctet(u8(at + index * 8L), at + (index + delta) * 8L);
      index = index + 1L;
    }
  }
}

/* 删掉下标这一条。后面的长度字往前靠，最后那个空位写 0。八位组也往前靠。 */
deRfun envRemoveAt(long pack, long index): void {
  long count = memory::load64(pack);
  long total = memory::load64(pack + 64L);
  long len = packLen(pack, index);
  long filled = sumLens(pack + 128L, index);
  if (count < 1L || len < 0L || filled > total || len > total - filled) {
    return;
  }
  long tail = total - filled - len;
  if (len > 0L && tail > 0L) {
    copySpan(pack + 4224L + (filled + len) * 8L, pack + 4224L + filled * 8L, tail);
  }
  long cursor = index;
  while (cursor + 1L < count) {
    memory::store64(packLen(pack, cursor + 1L), pack + 128L + cursor * 64L);
    cursor = cursor + 1L;
  }
  memory::store64(0L, pack + 128L + (count - 1L) * 64L);
  memory::store64(count - 1L, pack);
  memory::store64(total - len, pack + 64L);
}

/* 一次 -u 只删第一条同名的。当时没有这条，什么都不做。 */
deRfun envDrop(long pack, long name, long nameLen): void {
  long hit = envFind(pack, name, nameLen);
  if (hit >= 0L) {
    envRemoveAt(pack, hit);
  }
}

/* 已经有这个名字就留在原位置，只换值。没有就接到末尾。放不下返回 1。 */
deRfun envPut(long pack, long name, long nameLen, long value, long valueLen): long {
  long hit = envFind(pack, name, nameLen);
  if (hit < 0L) {
    return envAppendParts(pack, name, nameLen, value, valueLen);
  }
  long newLen = nameLen + 1L + valueLen;
  long oldLen = packLen(pack, hit);
  long total = memory::load64(pack + 64L);
  long filled = sumLens(pack + 128L, hit);
  if (newLen < 1L || newLen > 8192L || oldLen < 0L || filled > total || oldLen > total - filled) {
    return 1L;
  }
  long delta = newLen - oldLen;
  if (total + delta > 8192L) {
    return 1L;
  }
  long tail = total - filled - oldLen;
  if (delta != 0L && tail > 0L) {
    shiftOctets(pack + 4224L + (filled + oldLen) * 8L, tail, delta);
  }
  long at = pack + 4224L + filled * 8L;
  if (nameLen > 0L) {
    copySpan(name, at, nameLen);
  }
  memory::storeOctet(61L, at + nameLen * 8L);
  if (valueLen > 0L) {
    copySpan(value, at + (nameLen + 1L) * 8L, valueLen);
  }
  memory::store64(newLen, pack + 128L + hit * 64L);
  memory::store64(total + delta, pack + 64L);
  return 0L;
}

/* 没有等号的条目不进结果。带等号的，哪怕名字是空的，也按原顺序留下。 */
deRfun takeInherited(long saved, long pack): long {
  long count = memory::load64(saved + 64L);
  long index = 0L;
  while (index < count) {
    long len = savedEnvLen(saved, index);
    long at = savedEnvPtr(saved, index);
    if (eqAt(at, len) >= 0L) {
      if (envAppendRaw(pack, at, len) != 0L) {
        return 1L;
      }
    }
    index = index + 1L;
  }
  return 0L;
}

/* 一条 -u：64 位地址，再 64 位长度。从 +64 起，步进 128。最多 64 条。 */
deRfun unsetSlot(long table, long index): long {
  return table + 64L + index * 128L;
}

deRfun noteUnset(long table, long addr, long len): void {
  long count = memory::load64(table);
  long slot = unsetSlot(table, count);
  memory::store64(addr, slot);
  memory::store64(len, slot + 64L);
  memory::store64(count + 1L, table);
}

deRfun applyUnset(long pack, long table): void {
  long count = memory::load64(table);
  long index = 0L;
  while (index < count) {
    long slot = unsetSlot(table, index);
    envDrop(pack, memory::load64(slot), memory::load64(slot + 64L));
    index = index + 1L;
  }
}

/* 检查都通过以后才动活窗口。四个头字、两张长度表、两段八位组都写。
   用不到的长度字写 0。这里不清整段 139520 位，避免清完忘了把环境写回去。 */
deRfun publish(long home, long saved, long pack, long argBegin): long {
  long all = memory::load64(saved);
  if (argBegin < 0L || argBegin >= all) {
    return 1L;
  }
  long argcOut = all - argBegin;
  if (argcOut < 1L || argcOut > 64L) {
    return 1L;
  }
  long total = 0L;
  long index = 0L;
  while (index < argcOut) {
    long len = savedArgLen(saved, argBegin + index);
    if (len < 0L || len > 8192L || total + len > 8192L) {
      return 1L;
    }
    total = total + len;
    index = index + 1L;
  }
  long envn = memory::load64(pack);
  long envb = memory::load64(pack + 64L);
  if (envn < 0L || envn > 64L || envb < 0L || envb > 8192L) {
    return 1L;
  }
  long base = home + 65536L * 64L;
  memory::store64(argcOut, base);
  memory::store64(envn, base + 64L);
  memory::store64(total, base + 128L);
  memory::store64(envb, base + 192L);
  long skip = sumLens(saved + 256L, argBegin);
  index = 0L;
  while (index < 64L) {
    long len = 0L;
    if (index < argcOut) {
      len = savedArgLen(saved, argBegin + index);
    }
    memory::store64(len, base + 256L + index * 64L);
    index = index + 1L;
  }
  if (total > 0L) {
    copySpan(saved + 8448L + skip * 8L, base + 8448L, total);
  }
  index = 0L;
  while (index < 64L) {
    long len = 0L;
    if (index < envn) {
      len = packLen(pack, index);
    }
    memory::store64(len, base + 4352L + index * 64L);
    index = index + 1L;
  }
  if (envb > 0L) {
    copySpan(pack + 4224L, base + 73984L, envb);
  }
  return 0L;
}

/* 第一条名字是 PATH 的值。80、65、84、72 是 P、A、T、H。没有就返回 0。 */
deRfun pathValue(long pack, long* value, long* valueLen): long {
  long count = memory::load64(pack);
  long index = 0L;
  while (index < count) {
    long len = packLen(pack, index);
    long at = packPtr(pack, index);
    if (len >= 5L && u8(at) == 80L && u8(at + 8L) == 65L && u8(at + 16L) == 84L && u8(at + 24L) == 72L && u8(at + 32L) == 61L) {
      *value = at + 40L;
      *valueLen = len - 5L;
      return 1L;
    }
    index = index + 1L;
  }
  return 0L;
}

/* scratch 前 8192 个八位组用来拼路径。缺省 PATH 放在 +65536，不和拼接区重叠。
   找到时路径留在 scratch 开头，长度写进 *outLen，返回 1。找不到返回 0。 */
deRfun resolve(long home, long pack, long scratch, long name, long nameLen, long* outLen): long {
  if (hasSlash(name, nameLen) == 1L) {
    if (nameLen < 1L || nameLen > 8192L) {
      return 0L;
    }
    copySpan(name, scratch, nameLen);
    plant(home, scratch, nameLen);
    long kind = fileKind(home);
    if (kind == 1L || kind == 5L) {
      *outLen = nameLen;
      return 1L;
    }
    return 0L;
  }
  long path = 0L;
  long pathLen = 0L;
  long value = 0L;
  long valueLen = 0L;
  if (pathValue(pack, &value, &valueLen) == 1L) {
    path = value;
    pathLen = valueLen;
  } else {
    path = scratch + 65536L;
    pathLen = putText(path, 0L, "/bin:/os:/kernel");
  }
  long cursor = 0L;
  while (cursor <= pathLen) {
    long start = cursor;
    while (cursor < pathLen && u8(path + cursor * 8L) != 58L) {
      cursor = cursor + 1L;
    }
    long compLen = cursor - start;
    long joined = 0L;
    long ok = 1L;
    if (compLen == 0L) {
      if (nameLen < 0L || nameLen > 8192L) {
        ok = 0L;
      } else {
        if (nameLen > 0L) {
          copySpan(name, scratch, nameLen);
        }
        joined = nameLen;
      }
    } else {
      long extra = 0L;
      if (u8(path + (start + compLen - 1L) * 8L) != 47L) {
        extra = 1L;
      }
      joined = compLen + extra + nameLen;
      if (nameLen < 0L || joined > 8192L) {
        ok = 0L;
      } else {
        copySpan(path + start * 8L, scratch, compLen);
        if (extra == 1L) {
          memory::storeOctet(47L, scratch + compLen * 8L);
        }
        if (nameLen > 0L) {
          copySpan(name, scratch + (compLen + extra) * 8L, nameLen);
        }
      }
    }
    if (ok == 1L && joined > 0L) {
      plant(home, scratch, joined);
      long kind = fileKind(home);
      if (kind == 1L || kind == 5L) {
        *outLen = joined;
        return 1L;
      }
    }
    if (cursor >= pathLen) {
      return 0L;
    }
    cursor = cursor + 1L;
  }
  return 0L;
}

/* 每条已经是名字、等号、值。再补一个换行。偏移跨所有条目累加。 */
deRfun showEnv(long home, long pack): long {
  long place = 0L;
  long count = memory::load64(pack);
  long index = 0L;
  while (index < count) {
    if (emitSpan(home, &place, packPtr(pack, index), packLen(pack, index)) != 0L) {
      return 1L;
    }
    if (emitByte(home, &place, 10L) != 0L) {
      return 1L;
    }
    index = index + 1L;
  }
  return 0L;
}

/* 返回 1 时诊断已经写过。*index 停在第一个操作数上，-- 自己被跳过。 */
deRfun parseOpt(long home, long saved, long table, long* index, long* clear): long {
  long count = memory::load64(saved);
  long ended = 0L;
  while (*index < count && ended == 0L) {
    long at = savedArgPtr(saved, *index);
    long len = savedArgLen(saved, *index);
    if (len == 2L && u8(at) == 45L && u8(at + 8L) == 45L) {
      *index = *index + 1L;
      ended = 1L;
    } else if (len >= 2L && u8(at) == 45L) {
      long cursor = 1L;
      while (cursor < len) {
        long bit = u8(at + cursor * 8L);
        if (bit == 105L) {
          *clear = 1L;
          cursor = cursor + 1L;
        } else if (bit == 117L) {
          long nameAt = 0L;
          long nameLen = 0L;
          if (cursor + 1L < len) {
            nameAt = at + (cursor + 1L) * 8L;
            nameLen = len - cursor - 1L;
            cursor = len;
          } else {
            *index = *index + 1L;
            if (*index >= count) {
              writeErr(home, "env: missing operand\n");
              return 1L;
            }
            nameAt = savedArgPtr(saved, *index);
            nameLen = savedArgLen(saved, *index);
            cursor = len;
          }
          if (badUnset(nameAt, nameLen) == 1L) {
            writeErr(home, "env: invalid name\n");
            return 1L;
          }
          if (memory::load64(table) >= 64L) {
            writeErr(home, "env: argument list too long\n");
            return 1L;
          }
          noteUnset(table, nameAt, nameLen);
        } else {
          writeErr(home, "env: invalid option\n");
          return 1L;
        }
      }
      *index = *index + 1L;
    } else {
      ended = 1L;
    }
  }
  return 0L;
}

deRfun main(): int {
  long home = obr::proc::home();
  /* 139520 是活窗口整段。69760 是工作环境。8256 是 64 条 -u。
     65664 是 8192 个八位组的拼接区，再加缺省 PATH 的 16 个八位组。 */
  long saved = obr::proc::alloc(home, 139520L);
  long pack = obr::proc::alloc(home, 69760L);
  long table = obr::proc::alloc(home, 8256L);
  long scratch = obr::proc::alloc(home, 65664L);
  if (saved == 0L || pack == 0L || table == 0L || scratch == 0L) {
    writeErr(home, "env: out of memory\n");
    return finish(home, 1L);
  }
  if (saveWindow(home, saved) != 0L) {
    writeErr(home, "env: argument list too long\n");
    return finish(home, 1L);
  }
  memory::store64(0L, table);
  packReset(pack);
  long index = 1L;
  long clear = 0L;
  if (parseOpt(home, saved, table, &index, &clear) != 0L) {
    return finish(home, 1L);
  }
  if (clear == 0L) {
    if (takeInherited(saved, pack) != 0L) {
      writeErr(home, "env: argument list too long\n");
      return finish(home, 1L);
    }
  }
  applyUnset(pack, table);
  long count = memory::load64(saved);
  while (index < count) {
    long at = savedArgPtr(saved, index);
    long len = savedArgLen(saved, index);
    long nameLen = 0L;
    if (isAssign(at, len, &nameLen) == 0L) {
      break;
    }
    long valueAt = at + (nameLen + 1L) * 8L;
    long valueLen = len - nameLen - 1L;
    if (envPut(pack, at, nameLen, valueAt, valueLen) != 0L) {
      writeErr(home, "env: argument list too long\n");
      return finish(home, 1L);
    }
    index = index + 1L;
  }
  if (index >= count) {
    if (showEnv(home, pack) != 0L) {
      return finish(home, 1L);
    }
    return finish(home, 0L);
  }
  long util = savedArgPtr(saved, index);
  long utilLen = savedArgLen(saved, index);
  long pathLen = 0L;
  if (resolve(home, pack, scratch, util, utilLen, &pathLen) == 0L) {
    sayMiss(home, util, utilLen);
    return finish(home, 127L);
  }
  if (publish(home, saved, pack, index) != 0L) {
    writeErr(home, "env: argument list too long\n");
    return finish(home, 1L);
  }
  plant(home, scratch, pathLen);
  if (obr::proc::spawn(home, 0L) != 0L) {
    sayExec(home, util, utilLen);
    return finish(home, 126L);
  }
  long pid = obr::proc::slot(home, 192L);
  obr::proc::wait(home, pid);
  long code = obr::proc::slot(home, 192L);
  if (code < 0L) {
    code = 0L;
  }
  if (code > 255L) {
    code = code % 256L;
  }
  return finish(home, code);
}

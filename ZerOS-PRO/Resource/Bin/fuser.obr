/* POSIX.1-2017 fuser（utilities/fuser.html）。形式是 fuser [-cfu] file...
   本系统没有“谁打开了这个文件”的查询。
   选定：这不是打开该文件的进程，而是当时的任务表。
   -c -f -u 接受。-u 在每个 pid 后写 (uid)，uid 取任务表里的 euid。
   对每个文件先 stat，失败写 fuser: 路径: No such file or directory 到描述符 2。
   成功则向描述符 1 写路径、空格，再把服务 33 看到的每个任务 pid 写出来，之间空格，末尾换行。
   没有操作数写 fuser: missing operand，退出 1。任一文件 stat 失败则最终退出 1。
   诊断英文 ASCII，以 fuser: 开头。结束用 obr::proc::exit。 */
#DYN
import memory;
import obr.oct;
import obr.os;
import obr.proc;
import arg;

deRfun u8(long addr): long {
  return obr::oct::get(addr);
}

deRfun copySpan(long from, long to, long count): void {
  long index = 0L;
  while (index < count) {
    memory::storeOctet(u8(from + index * 8L), to + index * 8L);
    index = index + 1L;
  }
}

deRfun plant(long home, long addr, long count): void {
  memory::store64(count, obr::proc::path(home));
  copySpan(addr, obr::proc::path(home) + 64L, count);
}

deRfun writeErr(long home, string text): void {
  int raw = length(text);
  long count = raw;
  long index = 0L;
  while (index < count) {
    memory::storeOctet(text[index], obr::proc::bytes(home) + index * 8L);
    index = index + 1L;
  }
  if (count > 0L) {
    obr::proc::write(home, 2L, 0L, count);
  }
}

deRfun writeSpan(long home, long fd, long addr, long count): void {
  long offset = 0L;
  while (offset < count) {
    long chunk = count - offset;
    if (chunk > 4096L) {
      chunk = 4096L;
    }
    long index = 0L;
    while (index < chunk) {
      memory::storeOctet(u8(addr + (offset + index) * 8L), obr::proc::bytes(home) + index * 8L);
      index = index + 1L;
    }
    obr::proc::write(home, fd, 0L, chunk);
    offset = offset + chunk;
  }
}

deRfun miss(long home, long addr, long count): void {
  writeErr(home, "fuser: ");
  writeSpan(home, 2L, addr, count);
  writeErr(home, ": No such file or directory\n");
}

deRfun finish(long home, long code): int {
  obr::proc::exit(home, code);
  return 0;
}

deRfun putByte(long home, long* filled, long bit): void {
  long count = *filled;
  if (count >= 4096L) {
    obr::proc::write(home, 1L, 0L, count);
    count = 0L;
  }
  memory::storeOctet(bit, obr::proc::bytes(home) + count * 8L);
  *filled = count + 1L;
}

deRfun putSpan(long home, long* filled, long addr, long count): void {
  long index = 0L;
  while (index < count) {
    putByte(home, filled, u8(addr + index * 8L));
    index = index + 1L;
  }
}

deRfun putDec(long home, long* filled, long value): void {
  if (value < 0L) {
    value = 0L;
  }
  long rev = home + 9664L;
  long count = 0L;
  if (value == 0L) {
    memory::storeOctet(48L, rev);
    count = 1L;
  } else {
    while (value > 0L && count < 20L) {
      memory::storeOctet(48L + (value % 10L), rev + count * 8L);
      value = value / 10L;
      count = count + 1L;
    }
  }
  while (count > 0L) {
    count = count - 1L;
    putByte(home, filled, u8(rev + count * 8L));
  }
}

deRfun flushOut(long home, long filled): void {
  if (filled > 0L) {
    obr::proc::write(home, 1L, 0L, filled);
  }
}

deRfun emitTasks(long home, long flagU): void {
  long filled = 0L;
  long index = 0L;
  long first = 1L;
  while (index >= 0L) {
    long status = obr::proc::task(home, index);
    if (status == 2L) {
      break;
    }
    if (status != 0L) {
      break;
    }
    long pid = memory::load64(obr::proc::bytes(home));
    long euid = memory::load64(obr::proc::bytes(home) + 6L * 64L);
    if (first == 0L) {
      putByte(home, &filled, 32L);
    }
    first = 0L;
    putDec(home, &filled, pid);
    if (flagU == 1L) {
      putByte(home, &filled, 40L);
      putDec(home, &filled, euid);
      putByte(home, &filled, 41L);
    }
    long next = obr::proc::slot(home, 320L);
    if (next <= index) {
      break;
    }
    index = next;
  }
  putByte(home, &filled, 10L);
  flushOut(home, filled);
}

deRfun main(): int {
  long home = obr::proc::home();
  long flagU = 0L;
  long index = 1L;
  long count = argc(home);
  long ended = 0L;
  while (index < count && ended == 0L) {
    long at = argPtr(home, index);
    long len = argLen(home, index);
    if (len < 1L || u8(at) != 45L) {
      ended = 1L;
    } else if (len == 2L && u8(at + 8L) == 45L) {
      index = index + 1L;
      ended = 1L;
    } else if (len == 1L) {
      ended = 1L;
    } else {
      long cursor = 1L;
      while (cursor < len) {
        long bit = u8(at + cursor * 8L);
        if (bit == 99L) {
          cursor = cursor + 1L;
        } else if (bit == 102L) {
          cursor = cursor + 1L;
        } else if (bit == 117L) {
          flagU = 1L;
          cursor = cursor + 1L;
        } else {
          ended = 1L;
          cursor = len;
        }
      }
      index = index + 1L;
    }
  }
  if (index >= count) {
    writeErr(home, "fuser: missing operand\n");
    return finish(home, 1L);
  }
  long failed = 0L;
  while (index < count) {
    long at = argPtr(home, index);
    long len = argLen(home, index);
    if (len < 1L || len > 8192L) {
      miss(home, at, len);
      failed = 1L;
    } else {
      plant(home, at, len);
      if (obr::proc::stat(home) != 0L) {
        miss(home, at, len);
        failed = 1L;
      } else {
        long filled = 0L;
        putSpan(home, &filled, at, len);
        putByte(home, &filled, 32L);
        flushOut(home, filled);
        emitTasks(home, flagU);
      }
    }
    index = index + 1L;
  }
  if (failed == 1L) {
    return finish(home, 1L);
  }
  return finish(home, 0L);
}

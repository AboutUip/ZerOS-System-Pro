/* POSIX.1-2017 localedef（utilities/localedef.html）选定子集。
   形式：localedef [-c] [-f charmap] [-i sourcefile] [-u code_set_name] locale
   平台口径：没有 locale 数据库与 libc，编译产物是登记文件 /usr/lib/locale/<locale>
   （内容记录 charmap/code_set 与源文件文本，供 locale 工具族查询）。
   选项全量：-c 只检查不写产物（真校验源文件可读与 locale 名形状）；
   -f charmap 字符映射文件（须可读；本平台不做映射表编译，登记文件名，注明）；
   -i sourcefile 源定义（须可读；正文原样收进登记文件，注明）；
   -u code_set_name 代码集名（登记）。
   locale 名须是字母数字下划线与斜杠的组合（<=64），否则写 localedef: invalid
   locale name，退出 1。缺 locale 写 localedef: missing operand，退出 1；
   输入打不开写 localedef: 文件: No such file or directory，退出 1。
   诊断英文 ASCII，描述符 2，前缀 localedef:。结束用服务 28。 */
#DYN
import memory;
import obr.proc;
import arg;
import binutil;

deRfun okName(long at, long len): long {
  if (len < 1L || len > 64L) {
    return 0L;
  }
  long i = 0L;
  while (i < len) {
    long c = byteAt(at + i * 8L);
    long good = 0L;
    if (c >= 48L && c <= 57L) {
      good = 1L;
    }
    if (c >= 65L && c <= 90L) {
      good = 1L;
    }
    if (c >= 97L && c <= 122L) {
      good = 1L;
    }
    if (c == 95L || c == 47L || c == 45L) {
      good = 1L;
    }
    if (good == 0L) {
      return 0L;
    }
    i = i + 1L;
  }
  return 1L;
}

deRfun mustRead(long home, long at, long len): long {
  plant(home, at, len);
  if (obr::proc::open(home, 0L) != 0L) {
    writeErr(home, "localedef: ");
    writeSpan(home, 2L, 0L, at, len);
    writeErr(home, ": No such file or directory\n");
    return 1L;
  }
  long fd = obr::proc::slot(home, 192L);
  obr::proc::close(home, fd);
  return 0L;
}

deRfun main(): int {
  long home = obr::proc::home();
  long count = argc(home);
  long index = 1L;
  long ended = 0L;
  long checkOnly = 0L;
  long charAt = 0L;
  long charLen = 0L;
  long srcAt = 0L;
  long srcLen = 0L;
  long setName = obr::proc::alloc(home, 4096L);
  long setNameLen = 0L;
  long locAt = 0L;
  long locLen = 0L;
  while (index < count) {
    long at = argPtr(home, index);
    long len = argLen(home, index);
    if (ended == 0L && len == 2L && spanSame(at, len, "--") == 1L) {
      ended = 1L;
    } else if (ended == 0L && len >= 2L && byteAt(at) == 45L && locLen == 0L) {
      long o = byteAt(at + 8L);
      if (o == 99L && len == 2L) {
        checkOnly = 1L;
      } else if (o == 102L && len == 2L) {
        index = index + 1L;
        if (index >= count) {
          writeErr(home, "localedef: option requires an argument\n");
          return finish(home, 1L);
        }
        charAt = argPtr(home, index);
        charLen = argLen(home, index);
      } else if (o == 105L && len == 2L) {
        index = index + 1L;
        if (index >= count) {
          writeErr(home, "localedef: option requires an argument\n");
          return finish(home, 1L);
        }
        srcAt = argPtr(home, index);
        srcLen = argLen(home, index);
      } else if (o == 117L && len == 2L) {
        index = index + 1L;
        if (index >= count) {
          writeErr(home, "localedef: option requires an argument\n");
          return finish(home, 1L);
        }
        setNameLen = argLen(home, index);
        copySpan(argPtr(home, index), setName, setNameLen);
      } else {
        writeErr(home, "localedef: invalid option\n");
        return finish(home, 1L);
      }
    } else {
      if (locLen > 0L) {
        writeErr(home, "localedef: too many operands\n");
        return finish(home, 1L);
      }
      locAt = at;
      locLen = len;
    }
    index = index + 1L;
  }
  if (locLen == 0L) {
    writeErr(home, "localedef: missing operand\n");
    return finish(home, 1L);
  }
  if (okName(locAt, locLen) == 0L) {
    writeErr(home, "localedef: invalid locale name\n");
    return finish(home, 1L);
  }
  if (charLen > 0L && mustRead(home, charAt, charLen) != 0L) {
    return finish(home, 1L);
  }
  if (srcLen > 0L && mustRead(home, srcAt, srcLen) != 0L) {
    return finish(home, 1L);
  }
  if (checkOnly == 1L) {
    return finish(home, 0L);
  }
  /* 写登记文件 /usr/lib/locale/<locale>。 */
  long dir = obr::proc::alloc(home, 4096L);
  long dirLen = putText(dir, 0L, "/usr/lib");
  plant(home, dir, dirLen);
  obr::proc::mkdir(home);
  putText(dir, 0L, "/usr/lib/locale");
  plant(home, dir, 15L);
  obr::proc::mkdir(home);
  long path = obr::proc::alloc(home, 8192L * 8L);
  putText(path, 0L, "/usr/lib/locale/");
  copySpan(locAt, path + 16L * 8L, locLen);
  plant(home, path, 16L + locLen);
  if (obr::proc::open(home, 1L) != 0L) {
    writeErr(home, "localedef: cannot write locale\n");
    return finish(home, 1L);
  }
  long fd = obr::proc::slot(home, 192L);
  long at = putText(obr::proc::bytes(home), 0L, "codeset: ");
  if (setNameLen > 0L) {
    copySpan(setName, obr::proc::bytes(home) + at * 8L, setNameLen);
    at = at + setNameLen;
  }
  memory::storeOctet(10L, obr::proc::bytes(home) + at * 8L);
  at = at + 1L;
  obr::proc::write(home, fd, 0L, at);
  if (srcLen > 0L) {
    plant(home, srcAt, srcLen);
    if (obr::proc::open(home, 0L) == 0L) {
      long sfd = obr::proc::slot(home, 192L);
      long off = at;
      while (1L == 1L) {
        if (obr::proc::read(home, sfd, off, 4096L) != 0L) {
          break;
        }
        long got = obr::proc::slot(home, 320L);
        if (got <= 0L) {
          break;
        }
        if (got > 4096L) {
          got = 4096L;
        }
        obr::proc::write(home, fd, off, got);
        off = off + got;
        if (got < 4096L) {
          break;
        }
      }
      obr::proc::close(home, sfd);
    }
  }
  obr::proc::close(home, fd);
  return finish(home, 0L);
}

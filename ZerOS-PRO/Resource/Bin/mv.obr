/* POSIX.1-2017 mv。形式是
   mv [-if] source_file target_file
   mv [-if] source_file... target_dir
   下标 0 是程序名。-- 结束选项。单独一个 - 是名为减号的路径。
   第一个不是选项的参数也结束选项。短选项可以叠在一起。
   -f 不询问，-i 在目标已经存在时询问。后写的盖住先写的，
   所以 -fi 询问，-if 不询问。两个都没写时也不询问：
   规范里「目标不可写且标准输入是终端才询问」做不到，
   没有判断终端的服务，也没有当前用户号，看不了是不是写得动。
   别的字母写 mv: invalid option，立刻退出 1。
   少于两个操作数写 mv: missing operand。
   多于两个操作数时，最后一个必须已经是目录，否则一个都不移动。

   obr.proc 没有 rename。每次移动都是先复制，成功后再删除源。
   这不是一次改名，中间失败时目标上可能已经有不完整的副本，源还留着。
   没有时间服务，不能保留时间戳。
   服务 15 只有超级用户能改属主，普通用户一调用就会失败，
   所以这里不 chown。新建出来的属主是当前用户。
   复制之后按源的低 9 位 chmod。chmod 失败写 cannot preserve，
   不删除源。没有符号链接，也不建字符设备；种类不是普通文件
   或目录时写 cannot move。

   目标已是目录时，新路径是目标加上源的最后一段。
   否则目标自己就是新路径。末尾斜杠表示必须是目录。
   两边先拼上当前目录，再去掉 .、.. 和重复斜杠。
   收成同一条路径写 same file，不打开，避免把源截成空的。
   源是目录，且目标收成之后落在源里面，写
   cannot move a directory into itself。
   根、最后一段是 . 或 .. 的源，写 cannot move，不动。

   源是目录时：目标不存在就 mkdir；目标已是空目录就沿用它；
   目标目录里还有别的名字写 Directory not empty，不复制。
   然后按层复制。层数从这一次操作数算第 1 层，超过 32 写 too deep。
   正要进入的目录和栈上祖先收成同一条路径时，写 directory loop。
   没有序列号，只能认这条路径。整棵复制成功后，再从叶子把源删掉。
   复制中途失败则不删源。

   -i 的询问写到描述符 2：mv: overwrite 路径? 再加一个空格。
   从描述符 0 读到换行或 512 个八位组，只认第一个是 y 或 Y。
   别的回答跳过这一项，不算失败。读失败写 mv: read error，立刻退出。
   诊断在描述符 2。成功退出 0，失败退出 1。结束用服务 28。 */
import memory;
import obr.os;
import obr.proc;
import arg;

deRfun u8(long addr): long {
  long value = memory::loadOctet(addr);
  if (value < 0L) {
    value = value + 256L;
  }
  return value;
}

deRfun copySpan(long from, long to, long count): void {
  long index = 0L;
  while (index < count) {
    memory::storeOctet(u8(from + index * 8L), to + index * 8L);
    index = index + 1L;
  }
}

deRfun writeErr(long home, string text): void {
  int raw = length(text);
  long count = raw;
  long index = 0L;
  while (index < count) {
    memory::storeOctet(text[index], obr::proc::bytes(home) + index * 8L);
    index = index + 1L;
  }
  if (count > 0L) {
    obr::proc::write(home, 2L, 0L, count);
  }
}

deRfun writeSpan(long home, long addr, long count): void {
  long done = 0L;
  while (done < count) {
    long chunk = count - done;
    if (chunk > 4096L) {
      chunk = 4096L;
    }
    long index = 0L;
    while (index < chunk) {
      memory::storeOctet(u8(addr + (done + index) * 8L), obr::proc::bytes(home) + index * 8L);
      index = index + 1L;
    }
    obr::proc::write(home, 2L, 0L, chunk);
    done = done + chunk;
  }
}

deRfun blame(long home, long addr, long count, string suffix): void {
  writeErr(home, "mv: ");
  if (count > 0L) {
    writeSpan(home, addr, count);
  }
  writeErr(home, suffix);
}

deRfun plant(long home, long addr, long count): void {
  memory::store64(count, obr::proc::path(home));
  copySpan(addr, obr::proc::path(home) + 64L, count);
}

deRfun finish(long home, long code): int {
  obr::proc::exit(home, code);
  return 0;
}

deRfun fail(long home, string text): int {
  writeErr(home, text);
  return finish(home, 1L);
}

deRfun shut(long home, long fd): void {
  if (fd > 2L) {
    obr::proc::close(home, fd);
  }
}

deRfun sameSpan(long left, long leftLen, long right, long rightLen): long {
  if (leftLen != rightLen) {
    return 0L;
  }
  long index = 0L;
  while (index < leftLen) {
    if (u8(left + index * 8L) != u8(right + index * 8L)) {
      return 0L;
    }
    index = index + 1L;
  }
  return 1L;
}

deRfun isDot(long addr, long count): long {
  if (count == 1L && u8(addr) == 46L) {
    return 1L;
  }
  if (count == 2L && u8(addr) == 46L && u8(addr + 8L) == 46L) {
    return 1L;
  }
  return 0L;
}

deRfun isDir(long kind): long {
  if (kind == 2L || kind == 4L || kind == 6L) {
    return 1L;
  }
  return 0L;
}

deRfun isFile(long kind): long {
  if (kind == 1L || kind == 5L) {
    return 1L;
  }
  return 0L;
}

deRfun trimEnd(long addr, long count): long {
  long end = count;
  while (end > 1L && u8(addr + (end - 1L) * 8L) == 47L) {
    end = end - 1L;
  }
  return end;
}

deRfun rootPath(long addr, long count): long {
  if (count < 1L) {
    return 0L;
  }
  long index = 0L;
  while (index < count) {
    if (u8(addr + index * 8L) != 47L) {
      return 0L;
    }
    index = index + 1L;
  }
  return 1L;
}

deRfun finalDot(long addr, long count): long {
  long end = trimEnd(addr, count);
  long start = end;
  while (start > 0L && u8(addr + (start - 1L) * 8L) != 47L) {
    start = start - 1L;
  }
  long span = end - start;
  if (span == 1L && u8(addr + start * 8L) == 46L) {
    return 1L;
  }
  if (span == 2L && u8(addr + start * 8L) == 46L && u8(addr + (start + 1L) * 8L) == 46L) {
    return 1L;
  }
  return 0L;
}

deRfun refusePath(long addr, long count): long {
  if (rootPath(addr, count) == 1L) {
    return 1L;
  }
  if (finalDot(addr, count) == 1L) {
    return 1L;
  }
  return 0L;
}

deRfun joinPath(long parent, long parentLen, long name, long nameLen, long dest): long {
  if (nameLen < 1L) {
    return -1L;
  }
  long slash = 1L;
  if (parentLen > 0L && u8(parent + (parentLen - 1L) * 8L) == 47L) {
    slash = 0L;
  }
  long total = parentLen + slash + nameLen;
  if (total > 8192L) {
    return -1L;
  }
  copySpan(parent, dest, parentLen);
  if (slash == 1L) {
    memory::storeOctet(47L, dest + parentLen * 8L);
  }
  copySpan(name, dest + (parentLen + slash) * 8L, nameLen);
  return total;
}

deRfun baseOf(long addr, long count, long* at, long* len): void {
  long end = trimEnd(addr, count);
  long start = end;
  while (start > 0L && u8(addr + (start - 1L) * 8L) != 47L) {
    start = start - 1L;
  }
  *at = addr + start * 8L;
  *len = end - start;
}

deRfun collapse(long src, long srcLen, long dest): long {
  long absolute = 0L;
  long out = 0L;
  if (srcLen > 0L && u8(src) == 47L) {
    absolute = 1L;
    memory::storeOctet(47L, dest);
    out = 1L;
  }
  long index = 0L;
  while (index < srcLen) {
    while (index < srcLen && u8(src + index * 8L) == 47L) {
      index = index + 1L;
    }
    if (index < srcLen) {
      long start = index;
      while (index < srcLen && u8(src + index * 8L) != 47L) {
        index = index + 1L;
      }
      long n = index - start;
      long part = 0L;
      if (n == 1L && u8(src + start * 8L) == 46L) {
        part = 1L;
      }
      if (n == 2L && u8(src + start * 8L) == 46L && u8(src + (start + 1L) * 8L) == 46L) {
        part = 2L;
      }
      if (part == 2L && absolute == 1L) {
        if (out > 1L) {
          long p = out - 1L;
          while (p > 0L && u8(dest + p * 8L) != 47L) {
            p = p - 1L;
          }
          if (p == 0L) {
            out = 1L;
          } else {
            out = p;
          }
        }
      } else if (part == 2L && out == 0L) {
        memory::storeOctet(46L, dest);
        memory::storeOctet(46L, dest + 8L);
        out = 2L;
      } else if (part == 2L) {
        long slash = -1L;
        long p = out - 1L;
        while (p > 0L) {
          if (u8(dest + p * 8L) == 47L) {
            slash = p;
            p = 0L;
          } else {
            p = p - 1L;
          }
        }
        long comp = 0L;
        if (slash >= 0L) {
          comp = slash + 1L;
        }
        long clen = out - comp;
        long keep = 0L;
        if (clen == 2L && u8(dest + comp * 8L) == 46L && u8(dest + (comp + 1L) * 8L) == 46L) {
          keep = 1L;
        }
        if (keep == 1L) {
          if (out + 3L > 8192L) {
            return -1L;
          }
          memory::storeOctet(47L, dest + out * 8L);
          memory::storeOctet(46L, dest + (out + 1L) * 8L);
          memory::storeOctet(46L, dest + (out + 2L) * 8L);
          out = out + 3L;
        } else if (slash < 0L) {
          out = 0L;
        } else {
          out = slash;
        }
      } else if (part == 0L) {
        long extra = n;
        long lead = 0L;
        if (out != 0L && (absolute != 1L || out != 1L)) {
          lead = 1L;
          extra = n + 1L;
        }
        if (n < 1L || out + extra > 8192L) {
          return -1L;
        }
        if (lead == 1L) {
          memory::storeOctet(47L, dest + out * 8L);
          out = out + 1L;
        }
        copySpan(src + start * 8L, dest + out * 8L, n);
        out = out + n;
      }
    }
  }
  if (out == 0L) {
    memory::storeOctet(46L, dest);
    return 1L;
  }
  return out;
}

deRfun resolve(long cwd, long cwdLen, long path, long pathLen, long scratch, long dest): long {
  if (pathLen < 1L || pathLen > 8192L) {
    return -1L;
  }
  long absLen = 0L;
  if (cwdLen < 1L || u8(path) == 47L) {
    copySpan(path, scratch, pathLen);
    absLen = pathLen;
  } else {
    absLen = joinPath(cwd, cwdLen, path, pathLen, scratch);
    if (absLen < 0L) {
      return -1L;
    }
  }
  return collapse(scratch, absLen, dest);
}

deRfun readCwd(long home, long dest): long {
  if (obr::proc::getcwd(home) != 0L) {
    return 0L;
  }
  long n = obr::proc::slot(home, 256L);
  if (n < 1L || n > 8192L) {
    return 0L;
  }
  copySpan(obr::proc::bytes(home), dest, n);
  return n;
}

/* 目标比源长，并且源是它的路径前缀。相等不算在里面。 */
deRfun properInside(long parent, long parentLen, long child, long childLen): long {
  if (parentLen < 1L || childLen <= parentLen) {
    return 0L;
  }
  if (sameSpan(parent, parentLen, child, parentLen) == 0L) {
    return 0L;
  }
  if (parentLen == 1L && u8(parent) == 47L) {
    return 1L;
  }
  if (u8(child + parentLen * 8L) == 47L) {
    return 1L;
  }
  return 0L;
}

deRfun ask(long home, long addr, long count, long offsetAt): long {
  writeErr(home, "mv: overwrite ");
  if (count > 0L) {
    writeSpan(home, addr, count);
  }
  writeErr(home, "? ");
  long cursor = memory::load64(offsetAt);
  long got = 0L;
  long have = 0L;
  long first = 0L;
  long reading = 1L;
  while (reading == 1L && got < 512L) {
    if (obr::proc::read(home, 0L, cursor, 1L) != 0L) {
      writeErr(home, "mv: read error\n");
      return -1L;
    }
    long n = obr::proc::slot(home, 320L);
    if (n < 0L) {
      writeErr(home, "mv: read error\n");
      return -1L;
    }
    if (n == 0L) {
      reading = 0L;
    } else {
      long octet = u8(obr::proc::bytes(home));
      if (have == 0L) {
        first = octet;
        have = 1L;
      }
      cursor = cursor + 1L;
      got = got + 1L;
      if (octet == 10L) {
        reading = 0L;
      }
    }
  }
  memory::store64(cursor, offsetAt);
  if (have == 1L && (first == 121L || first == 89L)) {
    return 1L;
  }
  return 0L;
}

deRfun pour(long home, long inFd, long outFd): long {
  long inOff = 0L;
  long outOff = 0L;
  long reading = 1L;
  while (reading == 1L) {
    if (obr::proc::read(home, inFd, inOff, 4096L) != 0L) {
      writeErr(home, "mv: read error\n");
      return -1L;
    }
    long n = obr::proc::slot(home, 320L);
    if (n < 0L) {
      writeErr(home, "mv: read error\n");
      return -1L;
    }
    if (n == 0L) {
      reading = 0L;
    } else {
      if (n > 4096L) {
        n = 4096L;
      }
      long pending = n;
      while (pending > 0L) {
        long chunk = pending;
        if (chunk > 4096L) {
          chunk = 4096L;
        }
        if (obr::proc::write(home, outFd, outOff, chunk) != 0L) {
          writeErr(home, "mv: write error\n");
          return -1L;
        }
        long wrote = obr::proc::slot(home, 320L);
        if (wrote < 1L) {
          writeErr(home, "mv: write error\n");
          return -1L;
        }
        if (wrote > chunk) {
          wrote = chunk;
        }
        pending = pending - wrote;
        outOff = outOff + wrote;
        if (pending > 0L) {
          copySpan(obr::proc::bytes(home) + wrote * 8L, obr::proc::bytes(home), pending);
        }
      }
      inOff = inOff + n;
    }
  }
  return 0L;
}

deRfun keepMode(long home, long addr, long count, long mode): long {
  plant(home, addr, count);
  if (obr::proc::chmod(home, mode % 512L) != 0L) {
    blame(home, addr, count, ": cannot preserve\n");
    return 1L;
  }
  return 0L;
}

/* 只复制字节和权限，不删除源。返回 0 成功，1 失败，-1 读写失败。 */
deRfun copyFile(long home, long src, long srcLen, long dst, long dstLen, long mode, long existed): long {
  plant(home, src, srcLen);
  if (obr::proc::open(home, 0L) != 0L) {
    blame(home, src, srcLen, ": No such file or directory\n");
    return 1L;
  }
  long inFd = obr::proc::slot(home, 192L);
  plant(home, dst, dstLen);
  long opened = obr::proc::open(home, 1L);
  if (opened != 0L && existed == 1L) {
    plant(home, dst, dstLen);
    obr::proc::unlink(home);
    plant(home, dst, dstLen);
    opened = obr::proc::open(home, 1L);
  }
  if (opened != 0L) {
    shut(home, inFd);
    blame(home, dst, dstLen, ": cannot move\n");
    return 1L;
  }
  long outFd = obr::proc::slot(home, 192L);
  if (inFd == outFd) {
    shut(home, inFd);
    blame(home, src, srcLen, ": same file\n");
    return 1L;
  }
  long poured = pour(home, inFd, outFd);
  shut(home, inFd);
  shut(home, outFd);
  if (poured != 0L) {
    return -1L;
  }
  return keepMode(home, dst, dstLen, mode);
}

/* 1 空目录，0 里面还有别的名字，-1 读失败。 */
deRfun isEmpty(long home, long addr, long count, long names): long {
  long index = 0L;
  long reading = 1L;
  while (reading == 1L) {
    plant(home, addr, count);
    long listed = obr::proc::readdir(home, index, 512L);
    if (listed == 2L) {
      return 1L;
    }
    if (listed != 0L) {
      blame(home, addr, count, ": cannot read\n");
      return -1L;
    }
    long nameLen = obr::proc::slot(home, 256L);
    if (nameLen == 0L) {
      return 1L;
    }
    if (nameLen < 0L || nameLen > 512L) {
      blame(home, addr, count, ": cannot read\n");
      return -1L;
    }
    copySpan(obr::proc::bytes(home), names, nameLen);
    index = index + 1L;
    if (isDot(names, nameLen) == 0L) {
      return 0L;
    }
  }
  return 1L;
}

deRfun spanStep(long count): long {
  long step = 64L + count * 8L;
  long rem = step % 64L;
  if (rem != 0L) {
    step = step + (64L - rem);
  }
  return step;
}

/* work：+128 名字，+192 源路径槽，+256 目标路径槽，+320 帧，+384 收好的路径，
   +448 当前目录，+512 它的长度，+576 草稿，+640 折叠结果。 */
deRfun looped(long work, long sp, long raw, long rawLen, long folded, long foldedLen): long {
  long slots = memory::load64(work + 192L);
  long anc = memory::load64(work + 384L);
  long frames = memory::load64(work + 320L);
  long index = 0L;
  while (index <= sp) {
    long frame = frames + index * 512L;
    long alen = memory::load64(frame + 384L);
    long hit = 0L;
    if (alen >= 0L && foldedLen >= 0L) {
      if (sameSpan(anc + index * 65536L, alen, folded, foldedLen) == 1L) {
        hit = 1L;
      }
    } else {
      long plen = memory::load64(frame);
      if (sameSpan(slots + index * 65536L, plen, raw, rawLen) == 1L) {
        hit = 1L;
      }
    }
    if (hit == 1L) {
      return 1L;
    }
    index = index + 1L;
  }
  return 0L;
}

/* 目录已经就绪。把里面的文件和子目录复制过去，不删除源。 */
deRfun copyKids(long home, long work, long src, long srcLen, long dst, long dstLen): long {
  long slots = memory::load64(work + 192L);
  long dests = memory::load64(work + 256L);
  long frames = memory::load64(work + 320L);
  long anc = memory::load64(work + 384L);
  long names = memory::load64(work + 128L);
  long scratch = memory::load64(work + 576L);
  long fold = memory::load64(work + 640L);
  if (srcLen > 8192L || dstLen > 8192L) {
    writeErr(home, "mv: path too long\n");
    return 1L;
  }
  copySpan(src, slots, srcLen);
  copySpan(dst, dests, dstLen);
  long top = frames;
  memory::store64(srcLen, top);
  memory::store64(dstLen, top + 64L);
  memory::store64(0L, top + 128L);
  memory::store64(1L, top + 192L);
  memory::store64(1L, top + 256L);
  long absLen = resolve(memory::load64(work + 448L), memory::load64(work + 512L), slots, srcLen, scratch, fold);
  if (absLen >= 0L) {
    copySpan(fold, anc, absLen);
    memory::store64(absLen, top + 384L);
  } else {
    memory::store64(-1L, top + 384L);
  }
  long sp = 0L;
  while (sp >= 0L) {
    long frame = frames + sp * 512L;
    long node = slots + sp * 65536L;
    long nlen = memory::load64(frame);
    long dest = dests + sp * 65536L;
    long dlen = memory::load64(frame + 64L);
    long index = memory::load64(frame + 128L);
    plant(home, node, nlen);
    long listed = obr::proc::readdir(home, index, 512L);
    if (listed == 2L) {
      sp = sp - 1L;
    } else if (listed != 0L) {
      blame(home, node, nlen, ": cannot read\n");
      return 1L;
    } else {
      long nameLen = obr::proc::slot(home, 256L);
      if (nameLen == 0L) {
        sp = sp - 1L;
      } else if (nameLen < 0L || nameLen > 512L) {
        blame(home, node, nlen, ": cannot read\n");
        return 1L;
      } else {
        copySpan(obr::proc::bytes(home), names, nameLen);
        memory::store64(index + 1L, frame + 128L);
        if (isDot(names, nameLen) == 0L) {
          if (memory::load64(frame + 192L) >= 32L || sp >= 31L) {
            writeErr(home, "mv: too deep\n");
            return 1L;
          }
          long childSrc = slots + (sp + 1L) * 65536L;
          long childDst = dests + (sp + 1L) * 65536L;
          long childSLen = joinPath(node, nlen, names, nameLen, childSrc);
          long childDLen = joinPath(dest, dlen, names, nameLen, childDst);
          if (childSLen < 0L || childDLen < 0L) {
            writeErr(home, "mv: path too long\n");
            return 1L;
          }
          plant(home, childSrc, childSLen);
          long status = obr::proc::stat(home);
          if (status != 0L) {
            blame(home, childSrc, childSLen, ": No such file or directory\n");
            return 1L;
          }
          long kind = obr::proc::slot(home, 128L);
          long mode = obr::proc::slot(home, 256L);
          if (isDir(kind) == 1L) {
            long folded = resolve(memory::load64(work + 448L), memory::load64(work + 512L), childSrc, childSLen, scratch, fold);
            if (looped(work, sp, childSrc, childSLen, fold, folded) == 1L) {
              blame(home, childSrc, childSLen, ": directory loop\n");
              return 1L;
            }
            plant(home, childDst, childDLen);
            long destStatus = obr::proc::stat(home);
            long make = 1L;
            if (destStatus == 0L) {
              long destKind = obr::proc::slot(home, 128L);
              if (isDir(destKind) == 0L) {
                blame(home, childDst, childDLen, ": not a directory\n");
                return 1L;
              }
              long empty = isEmpty(home, childDst, childDLen, names);
              if (empty < 0L) {
                return 1L;
              }
              if (empty == 0L) {
                blame(home, childDst, childDLen, ": Directory not empty\n");
                return 1L;
              }
              make = 0L;
            } else if (destStatus != 2L) {
              blame(home, childDst, childDLen, ": cannot move\n");
              return 1L;
            }
            if (make == 1L) {
              plant(home, childDst, childDLen);
              if (obr::proc::mkdir(home) != 0L) {
                blame(home, childDst, childDLen, ": cannot move\n");
                return 1L;
              }
            }
            if (keepMode(home, childDst, childDLen, mode) != 0L) {
              return 1L;
            }
            long child = frames + (sp + 1L) * 512L;
            memory::store64(childSLen, child);
            memory::store64(childDLen, child + 64L);
            memory::store64(0L, child + 128L);
            memory::store64(memory::load64(frame + 192L) + 1L, child + 192L);
            memory::store64(1L, child + 256L);
            if (folded >= 0L) {
              copySpan(fold, anc + (sp + 1L) * 65536L, folded);
              memory::store64(folded, child + 384L);
            } else {
              memory::store64(-1L, child + 384L);
            }
            sp = sp + 1L;
          } else if (isFile(kind) == 1L) {
            plant(home, childDst, childDLen);
            long destStatus = obr::proc::stat(home);
            long existed = 0L;
            if (destStatus == 0L) {
              long destKind = obr::proc::slot(home, 128L);
              if (isDir(destKind) == 1L) {
                blame(home, childDst, childDLen, ": is a directory\n");
                return 1L;
              }
              existed = 1L;
            }
            long copied = copyFile(home, childSrc, childSLen, childDst, childDLen, mode, existed);
            if (copied != 0L) {
              return copied;
            }
          } else {
            blame(home, childSrc, childSLen, ": cannot move\n");
            return 1L;
          }
        }
      }
    }
  }
  return 0L;
}

/* 复制已经完成。从叶子删掉源。子项删掉之后下标不动。 */
deRfun removeTree(long home, long work, long src, long srcLen): long {
  long slots = memory::load64(work + 192L);
  long frames = memory::load64(work + 320L);
  long anc = memory::load64(work + 384L);
  long names = memory::load64(work + 128L);
  long scratch = memory::load64(work + 576L);
  long fold = memory::load64(work + 640L);
  copySpan(src, slots, srcLen);
  long top = frames;
  memory::store64(srcLen, top);
  memory::store64(0L, top + 64L);
  memory::store64(0L, top + 128L);
  memory::store64(1L, top + 192L);
  memory::store64(0L, top + 256L);
  memory::store64(0L, top + 320L);
  long absLen = resolve(memory::load64(work + 448L), memory::load64(work + 512L), slots, srcLen, scratch, fold);
  if (absLen >= 0L) {
    copySpan(fold, anc, absLen);
    memory::store64(absLen, top + 384L);
  } else {
    memory::store64(-1L, top + 384L);
  }
  long sp = 0L;
  long failed = 0L;
  while (sp >= 0L) {
    long frame = frames + sp * 512L;
    long phase = memory::load64(frame + 64L);
    long node = slots + sp * 65536L;
    long nlen = memory::load64(frame);
    if (phase == 0L) {
      plant(home, node, nlen);
      long status = obr::proc::stat(home);
      if (status != 0L) {
        blame(home, node, nlen, ": cannot remove\n");
        failed = 1L;
        memory::store64(0L, frame + 256L);
        memory::store64(1L, frame + 320L);
        if (sp > 0L) {
          memory::store64(1L, frames + (sp - 1L) * 512L + 320L);
        }
        sp = sp - 1L;
      } else {
        long kind = obr::proc::slot(home, 128L);
        if (isDir(kind) == 0L) {
          plant(home, node, nlen);
          long gone = 1L;
          if (obr::proc::unlink(home) != 0L) {
            blame(home, node, nlen, ": cannot remove\n");
            gone = 0L;
            failed = 1L;
            memory::store64(1L, frame + 320L);
            if (sp > 0L) {
              memory::store64(1L, frames + (sp - 1L) * 512L + 320L);
            }
          }
          memory::store64(gone, frame + 256L);
          sp = sp - 1L;
        } else {
          long folded = memory::load64(frame + 384L);
          if (sp > 0L && looped(work, sp - 1L, node, nlen, anc + sp * 65536L, folded) == 1L) {
            blame(home, node, nlen, ": directory loop\n");
            failed = 1L;
            memory::store64(0L, frame + 256L);
            memory::store64(1L, frame + 320L);
            memory::store64(1L, frames + (sp - 1L) * 512L + 320L);
            sp = sp - 1L;
          } else {
            memory::store64(1L, frame + 64L);
            memory::store64(0L, frame + 128L);
          }
        }
      }
    } else if (phase == 1L) {
      if (memory::load64(frame + 320L) == 1L) {
        memory::store64(2L, frame + 64L);
      } else {
        long index = memory::load64(frame + 128L);
        plant(home, node, nlen);
        long listed = obr::proc::readdir(home, index, 512L);
        if (listed == 2L) {
          memory::store64(2L, frame + 64L);
        } else if (listed != 0L) {
          blame(home, node, nlen, ": cannot read\n");
          memory::store64(1L, frame + 320L);
          memory::store64(2L, frame + 64L);
        } else {
          long nameLen = obr::proc::slot(home, 256L);
          if (nameLen == 0L) {
            memory::store64(2L, frame + 64L);
          } else if (nameLen < 0L || nameLen > 512L) {
            blame(home, node, nlen, ": cannot read\n");
            memory::store64(1L, frame + 320L);
            memory::store64(2L, frame + 64L);
          } else {
            copySpan(obr::proc::bytes(home), names, nameLen);
            if (isDot(names, nameLen) == 1L) {
              memory::store64(index + 1L, frame + 128L);
            } else if (memory::load64(frame + 192L) >= 32L || sp >= 31L) {
              writeErr(home, "mv: too deep\n");
              memory::store64(1L, frame + 320L);
              memory::store64(2L, frame + 64L);
            } else {
              long childSrc = slots + (sp + 1L) * 65536L;
              long childLen = joinPath(node, nlen, names, nameLen, childSrc);
              if (childLen < 0L) {
                writeErr(home, "mv: path too long\n");
                memory::store64(1L, frame + 320L);
                memory::store64(2L, frame + 64L);
              } else {
                memory::store64(3L, frame + 64L);
                long child = frames + (sp + 1L) * 512L;
                memory::store64(childLen, child);
                memory::store64(0L, child + 64L);
                memory::store64(0L, child + 128L);
                memory::store64(memory::load64(frame + 192L) + 1L, child + 192L);
                memory::store64(0L, child + 256L);
                memory::store64(0L, child + 320L);
                long folded = resolve(memory::load64(work + 448L), memory::load64(work + 512L), childSrc, childLen, scratch, fold);
                if (folded >= 0L) {
                  copySpan(fold, anc + (sp + 1L) * 65536L, folded);
                  memory::store64(folded, child + 384L);
                } else {
                  memory::store64(-1L, child + 384L);
                }
                sp = sp + 1L;
              }
            }
          }
        }
      }
    } else if (phase == 3L) {
      /* 子帧还留在 sp+1。删掉了就不要加下标，下一项已经挤上来。 */
      long child = frames + (sp + 1L) * 512L;
      if (memory::load64(child + 320L) == 1L || memory::load64(frame + 320L) == 1L) {
        memory::store64(1L, frame + 320L);
        memory::store64(2L, frame + 64L);
      } else {
        if (memory::load64(child + 256L) == 0L) {
          memory::store64(memory::load64(frame + 128L) + 1L, frame + 128L);
        }
        memory::store64(1L, frame + 64L);
      }
    } else {
      long hold = memory::load64(frame + 320L);
      if (hold == 0L) {
        plant(home, node, nlen);
        if (obr::proc::unlink(home) != 0L) {
          blame(home, node, nlen, ": cannot remove\n");
          hold = 1L;
          failed = 1L;
          memory::store64(0L, frame + 256L);
        } else {
          memory::store64(1L, frame + 256L);
        }
      } else {
        failed = 1L;
        memory::store64(0L, frame + 256L);
      }
      memory::store64(hold, frame + 320L);
      if (sp > 0L && hold == 1L) {
        memory::store64(1L, frames + (sp - 1L) * 512L + 320L);
      }
      sp = sp - 1L;
    }
  }
  if (failed != 0L) {
    return 1L;
  }
  return 0L;
}

/* 返回 0 成功或用户跳过，1 这一项失败，-1 必须马上停。 */
deRfun moveOne(long home, long work, long src, long srcLen, long target, long targetLen): long {
  if (srcLen < 1L || targetLen < 1L) {
    blame(home, src, srcLen, ": No such file or directory\n");
    return 1L;
  }
  if (refusePath(src, srcLen) == 1L) {
    blame(home, src, srcLen, ": cannot move\n");
    return 1L;
  }
  plant(home, src, srcLen);
  long status = obr::proc::stat(home);
  if (status != 0L) {
    blame(home, src, srcLen, ": No such file or directory\n");
    return 1L;
  }
  long kind = obr::proc::slot(home, 128L);
  long mode = obr::proc::slot(home, 256L);
  if (u8(src + (srcLen - 1L) * 8L) == 47L && isDir(kind) == 0L) {
    blame(home, src, srcLen, ": not a directory\n");
    return 1L;
  }
  long targetSlash = 0L;
  if (u8(target + (targetLen - 1L) * 8L) == 47L) {
    targetSlash = 1L;
  }
  plant(home, target, targetLen);
  long targetStatus = obr::proc::stat(home);
  long targetDir = 0L;
  if (targetStatus == 0L) {
    long targetKind = obr::proc::slot(home, 128L);
    if (isDir(targetKind) == 1L) {
      targetDir = 1L;
    }
  }
  if (targetSlash == 1L && targetDir == 0L) {
    if (targetStatus == 0L) {
      blame(home, target, targetLen, ": not a directory\n");
    } else {
      blame(home, target, targetLen, ": No such file or directory\n");
    }
    return 1L;
  }
  long held = memory::load64(work + 704L);
  long dest = held;
  long destLen = targetLen;
  if (targetDir == 1L) {
    long leafAt = 0L;
    long leafLen = 0L;
    baseOf(src, srcLen, &leafAt, &leafLen);
    if (leafLen < 1L) {
      blame(home, src, srcLen, ": cannot move\n");
      return 1L;
    }
    destLen = joinPath(target, targetLen, leafAt, leafLen, held);
    if (destLen < 0L) {
      writeErr(home, "mv: path too long\n");
      return 1L;
    }
  } else {
    copySpan(target, held, targetLen);
  }
  long scratch = memory::load64(work + 576L);
  long fold = memory::load64(work + 640L);
  long anc = memory::load64(work + 384L);
  long srcAbs = resolve(memory::load64(work + 448L), memory::load64(work + 512L), src, srcLen, scratch, anc);
  long dstAbs = resolve(memory::load64(work + 448L), memory::load64(work + 512L), dest, destLen, scratch, fold);
  if (srcAbs < 0L || dstAbs < 0L) {
    writeErr(home, "mv: path too long\n");
    return 1L;
  }
  if (sameSpan(anc, srcAbs, fold, dstAbs) == 1L) {
    blame(home, src, srcLen, ": same file\n");
    return 1L;
  }
  if (isDir(kind) == 1L && properInside(anc, srcAbs, fold, dstAbs) == 1L) {
    blame(home, src, srcLen, ": cannot move a directory into itself\n");
    return 1L;
  }
  plant(home, dest, destLen);
  long destStatus = obr::proc::stat(home);
  long destExists = 0L;
  long destDir = 0L;
  if (destStatus == 0L) {
    destExists = 1L;
    long destKind = obr::proc::slot(home, 128L);
    if (isDir(destKind) == 1L) {
      destDir = 1L;
    }
  } else if (destStatus != 2L) {
    blame(home, dest, destLen, ": cannot move\n");
    return 1L;
  }
  if (destExists == 1L && memory::load64(work + 64L) == 1L) {
    long answer = ask(home, dest, destLen, work);
    if (answer < 0L) {
      return -1L;
    }
    if (answer == 0L) {
      return 0L;
    }
  }
  if (isDir(kind) == 1L) {
    if (destExists == 1L && destDir == 0L) {
      blame(home, dest, destLen, ": not a directory\n");
      return 1L;
    }
    if (destExists == 1L) {
      long empty = isEmpty(home, dest, destLen, memory::load64(work + 128L));
      if (empty < 0L) {
        return 1L;
      }
      if (empty == 0L) {
        blame(home, dest, destLen, ": Directory not empty\n");
        return 1L;
      }
    } else {
      plant(home, dest, destLen);
      if (obr::proc::mkdir(home) != 0L) {
        blame(home, dest, destLen, ": cannot move\n");
        return 1L;
      }
    }
    if (keepMode(home, dest, destLen, mode) != 0L) {
      return 1L;
    }
    long copied = copyKids(home, work, src, srcLen, dest, destLen);
    if (copied != 0L) {
      return copied;
    }
    return removeTree(home, work, src, srcLen);
  }
  if (isFile(kind) == 0L) {
    blame(home, src, srcLen, ": cannot move\n");
    return 1L;
  }
  if (destDir == 1L) {
    blame(home, dest, destLen, ": is a directory\n");
    return 1L;
  }
  long copied = copyFile(home, src, srcLen, dest, destLen, mode, destExists);
  if (copied != 0L) {
    return copied;
  }
  plant(home, src, srcLen);
  if (obr::proc::unlink(home) != 0L) {
    blame(home, src, srcLen, ": cannot remove\n");
    return 1L;
  }
  return 0L;
}

deRfun main(): int {
  long home = obr::proc::home();
  long asking = 0L;
  long index = 1L;
  long count = argc(home);
  long ended = 0L;
  while (index < count && ended == 0L) {
    long at = argPtr(home, index);
    long len = argLen(home, index);
    if (len < 1L || u8(at) != 45L || len == 1L) {
      ended = 1L;
    } else if (len == 2L && u8(at + 8L) == 45L) {
      index = index + 1L;
      ended = 1L;
    } else {
      long cursor = 1L;
      while (cursor < len) {
        long bit = u8(at + cursor * 8L);
        if (bit == 102L) {
          asking = 0L;
        } else if (bit == 105L) {
          asking = 1L;
        } else {
          return fail(home, "mv: invalid option\n");
        }
        cursor = cursor + 1L;
      }
      index = index + 1L;
    }
  }
  if (count - index < 2L) {
    return fail(home, "mv: missing operand\n");
  }
  if (count - index > 2L) {
    long target = argPtr(home, count - 1L);
    long targetLen = argLen(home, count - 1L);
    plant(home, target, targetLen);
    long targetStatus = obr::proc::stat(home);
    if (targetStatus != 0L) {
      blame(home, target, targetLen, ": No such file or directory\n");
      return finish(home, 1L);
    }
    long targetKind = obr::proc::slot(home, 128L);
    if (isDir(targetKind) == 0L) {
      blame(home, target, targetLen, ": not a directory\n");
      return finish(home, 1L);
    }
  }
  long names = obr::proc::alloc(home, 512L * 8L);
  long srcSlots = obr::proc::alloc(home, 32L * 65536L);
  long dstSlots = obr::proc::alloc(home, 32L * 65536L);
  long frames = obr::proc::alloc(home, 32L * 512L);
  long anc = obr::proc::alloc(home, 32L * 65536L);
  long cwd = obr::proc::alloc(home, 65536L);
  long scratch = obr::proc::alloc(home, 65536L);
  long fold = obr::proc::alloc(home, 65536L);
  long held = obr::proc::alloc(home, 65536L);
  long work = obr::proc::alloc(home, 2048L);
  if (names == 0L || srcSlots == 0L || dstSlots == 0L || frames == 0L || anc == 0L) {
    return fail(home, "mv: out of memory\n");
  }
  if (cwd == 0L || scratch == 0L || fold == 0L || held == 0L || work == 0L) {
    return fail(home, "mv: out of memory\n");
  }
  long cwdLen = readCwd(home, cwd);
  memory::store64(0L, work);
  memory::store64(asking, work + 64L);
  memory::store64(names, work + 128L);
  memory::store64(srcSlots, work + 192L);
  memory::store64(dstSlots, work + 256L);
  memory::store64(frames, work + 320L);
  memory::store64(anc, work + 384L);
  memory::store64(cwd, work + 448L);
  memory::store64(cwdLen, work + 512L);
  memory::store64(scratch, work + 576L);
  memory::store64(fold, work + 640L);
  memory::store64(held, work + 704L);
  long failed = 0L;
  while (index + 1L < count) {
    long outcome = moveOne(home, work, argPtr(home, index), argLen(home, index), argPtr(home, count - 1L), argLen(home, count - 1L));
    if (outcome < 0L) {
      return finish(home, 1L);
    }
    if (outcome != 0L) {
      failed = 1L;
    }
    index = index + 1L;
  }
  if (failed != 0L) {
    return finish(home, 1L);
  }
  return finish(home, 0L);
}

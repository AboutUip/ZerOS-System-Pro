/* POSIX.1-2017 newgrp（utilities/newgrp.html）。形式是 newgrp [group]。
   本系统没有组数据库，也没有 setgid 服务：gid 只能是服务 32 读到的当前值。
   选定：没有操作数、操作数是 -、或操作数等于当前组（十进制 gid，gid 为 0 时
   也接受 root）时，派生 /os/sh 起一个新壳并等待，退出码是壳的退出码；
   找不到 /os/sh 写 newgrp: cannot execute shell，退出 1。
   其它组名或组号写
   newgrp: changing group is not supported on this platform，退出 1。
   诊断英文 ASCII，描述符 2，前缀 newgrp:。结束用服务 28。 */
#DYN
import obr.proc;
import arg;
import binutil;

deRfun digits(long addr, long count, long expect): long {
  if (count < 1L || count > 9L) {
    return 0L;
  }
  long value = 0L;
  if (spanNum(addr, count, &value) != 0L) {
    return 0L;
  }
  if (value != expect) {
    return 0L;
  }
  return 1L;
}

deRfun main(): int {
  long home = obr::proc::home();
  long count = argc(home);
  if (count > 2L) {
    writeErr(home, "newgrp: too many operands\n");
    return finish(home, 1L);
  }
  if (count == 2L) {
    long at = argPtr(home, 1L);
    long len = argLen(home, 1L);
    if (spanSame(at, len, "-") == 1L) {
      /* 登录组：本系统无组数据库，等同不换组。 */
    } else {
      obr::proc::ident(home);
      long gid = obr::proc::slot(home, 192L);
      long ok = digits(at, len, gid);
      if (ok == 0L && gid == 0L) {
        ok = spanSame(at, len, "root");
      }
      if (ok == 0L) {
        writeErr(home, "newgrp: changing group is not supported on this platform\n");
        return finish(home, 1L);
      }
    }
  }
  long saved = obr::proc::alloc(home, 139520L);
  long scratch = obr::proc::alloc(home, 65728L);
  if (saved == 0L || scratch == 0L) {
    writeErr(home, "newgrp: out of memory\n");
    return finish(home, 1L);
  }
  if (saveWindow(home, saved) != 0L) {
    writeErr(home, "newgrp: out of memory\n");
    return finish(home, 1L);
  }
  long shellLen = 0L;
  putText(scratch, 0L, "/os/sh");
  if (resolve(home, scratch, scratch, 6L, &shellLen) == 0L) {
    writeErr(home, "newgrp: cannot execute shell\n");
    return finish(home, 1L);
  }
  if (setSolo(home, saved, "/os/sh") != 0L) {
    writeErr(home, "newgrp: cannot execute shell\n");
    return finish(home, 1L);
  }
  plant(home, scratch, shellLen);
  if (obr::proc::spawn(home, 0L) != 0L) {
    writeErr(home, "newgrp: cannot execute shell\n");
    return finish(home, 1L);
  }
  long pid = obr::proc::slot(home, 192L);
  obr::proc::wait(home, pid);
  long code = obr::proc::slot(home, 192L);
  if (code < 0L) {
    code = 0L;
  }
  if (code > 255L) {
    code = code % 256L;
  }
  return finish(home, code);
}

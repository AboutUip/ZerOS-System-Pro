/* POSIX.1-2017 pathchk（utilities/pathchk.html）。形式是 pathchk [-p] pathname...
   -p 再按可移植上限检查：整条路径不超过 256 个八位组，每个分量不超过 14。
   本系统整条最长 8192，分量最长 512。空路径无效。八位组 0 无效。
   没有操作数写 pathchk: missing operand，退出 1。
   不认识的选项写 pathchk: invalid option，退出 1。
   -- 结束选项。第一个不是选项的参数也结束选项。
   某个路径无效写 pathchk: 路径: 原因 到描述符 2，继续后面的操作数，最终退出 1。
   全部有效退出 0。状态经 obr::proc::exit 交出。 */
#DYN
import memory;
import obr.oct;
import obr.os;
import obr.proc;
import arg;

deRfun u8(long addr): long {
  return obr::oct::get(addr);
}

deRfun writeErr(long home, string text): void {
  int raw = length(text);
  long count = raw;
  long index = 0L;
  while (index < count) {
    memory::storeOctet(text[index], obr::proc::bytes(home) + index * 8L);
    index = index + 1L;
  }
  if (count > 0L) {
    obr::proc::write(home, 2L, 0L, count);
  }
}

deRfun writeSpan(long home, long addr, long count): void {
  long offset = 0L;
  while (offset < count) {
    long chunk = count - offset;
    if (chunk > 4096L) {
      chunk = 4096L;
    }
    long index = 0L;
    while (index < chunk) {
      memory::storeOctet(u8(addr + (offset + index) * 8L), obr::proc::bytes(home) + index * 8L);
      index = index + 1L;
    }
    obr::proc::write(home, 2L, 0L, chunk);
    offset = offset + chunk;
  }
}

deRfun complain(long home, long addr, long count, string why): void {
  writeErr(home, "pathchk: ");
  writeSpan(home, addr, count);
  writeErr(home, ": ");
  writeErr(home, why);
  writeErr(home, "\n");
}

deRfun finish(long home, long code): int {
  obr::proc::exit(home, code);
  return 0;
}

/* 返回 0 有效，否则返回要写的诊断句（不含前缀路径）。 */
deRfun checkOne(long addr, long count, long portable): long {
  if (count < 1L) {
    return 1L;
  }
  long maxPath = 8192L;
  long maxName = 512L;
  if (portable == 1L) {
    maxPath = 256L;
    maxName = 14L;
  }
  if (count > maxPath) {
    return 2L;
  }
  long index = 0L;
  long compLen = 0L;
  while (index < count) {
    long bit = u8(addr + index * 8L);
    if (bit == 0L) {
      return 3L;
    }
    if (bit == 47L) {
      if (compLen > maxName) {
        return 4L;
      }
      compLen = 0L;
      index = index + 1L;
    } else {
      compLen = compLen + 1L;
      index = index + 1L;
    }
  }
  if (compLen > maxName) {
    return 4L;
  }
  return 0L;
}

deRfun whyText(long code): string {
  if (code == 1L) {
    return "invalid pathname";
  }
  if (code == 2L) {
    return "pathname too long";
  }
  if (code == 3L) {
    return "invalid pathname";
  }
  if (code == 4L) {
    return "component name too long";
  }
  return "invalid pathname";
}

deRfun main(): int {
  long home = obr::proc::home();
  long portable = 0L;
  long index = 1L;
  long total = argc(home);
  long ended = 0L;
  while (index < total && ended == 0L) {
    long at = argPtr(home, index);
    long len = argLen(home, index);
    if (len == 2L && u8(at) == 45L && u8(at + 8L) == 45L) {
      index = index + 1L;
      ended = 1L;
    } else if (len >= 2L && u8(at) == 45L) {
      long cursor = 1L;
      while (cursor < len) {
        if (u8(at + cursor * 8L) == 112L) {
          portable = 1L;
          cursor = cursor + 1L;
        } else {
          writeErr(home, "pathchk: invalid option\n");
          return finish(home, 1L);
        }
      }
      index = index + 1L;
    } else {
      ended = 1L;
    }
  }
  if (index >= total) {
    writeErr(home, "pathchk: missing operand\n");
    return finish(home, 1L);
  }
  long failed = 0L;
  while (index < total) {
    long at = argPtr(home, index);
    long len = argLen(home, index);
    long code = checkOne(at, len, portable);
    if (code != 0L) {
      complain(home, at, len, whyText(code));
      failed = 1L;
    }
    index = index + 1L;
  }
  if (failed == 1L) {
    return finish(home, 1L);
  }
  return finish(home, 0L);
}

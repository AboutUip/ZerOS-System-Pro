/* POSIX pwd。-L 是缺省，-P 打印 getcwd。两个都写了，以后写的为准。
   -L 只在 PWD 是当前目录的绝对路径、且分量里没有 . 和 .. 时打印 PWD。
   否则改走 -P。诊断写到标准错误。 */
import memory;
import obr.os;
import obr.proc;
import arg;

deRfun u8(long addr): long {
  long value = memory::loadOctet(addr);
  if (value < 0L) {
    value = value + 256L;
  }
  return value;
}

deRfun copySpan(long from, long to, long count): void {
  long index = 0L;
  while (index < count) {
    memory::storeOctet(u8(from + index * 8L), to + index * 8L);
    index = index + 1L;
  }
}

deRfun writeFd(long home, long fd, long addr, long count): void {
  long offset = 0L;
  while (offset < count) {
    long chunk = count - offset;
    if (chunk > 4096L) {
      chunk = 4096L;
    }
    long index = 0L;
    while (index < chunk) {
      memory::storeOctet(u8(addr + (offset + index) * 8L), obr::proc::bytes(home) + index * 8L);
      index = index + 1L;
    }
    obr::proc::write(home, fd, 0L, chunk);
    offset = offset + chunk;
  }
}

deRfun writeErr(long home, string text): void {
  int raw = length(text);
  long count = raw;
  long index = 0L;
  while (index < count) {
    memory::storeOctet(text[index], obr::proc::bytes(home) + index * 8L);
    index = index + 1L;
  }
  if (count > 0L) {
    obr::proc::write(home, 2L, 0L, count);
  }
}

deRfun plant(long home, long addr, long count): void {
  memory::store64(count, obr::proc::path(home));
  copySpan(addr, obr::proc::path(home) + 64L, count);
}

/* 字节区里的路径立刻抄走。下一次读写会盖住同一段。 */
deRfun readCwd(long home, long dest): long {
  if (obr::proc::getcwd(home) != 0L) {
    return -1L;
  }
  long count = obr::proc::slot(home, 256L);
  if (count < 1L || count > 8192L) {
    return -1L;
  }
  copySpan(obr::proc::bytes(home), dest, count);
  return count;
}

deRfun sameSpan(long left, long leftLen, long right, long rightLen): long {
  if (leftLen != rightLen) {
    return 0L;
  }
  long index = 0L;
  while (index < leftLen) {
    if (u8(left + index * 8L) != u8(right + index * 8L)) {
      return 0L;
    }
    index = index + 1L;
  }
  return 1L;
}

/* 绝对路径，分量里没有空串、. 和 ..。单独一个 / 可以。 */
deRfun logicalOk(long addr, long count): long {
  if (count < 1L || u8(addr) != 47L) {
    return 0L;
  }
  if (count == 1L) {
    return 1L;
  }
  long index = 1L;
  long start = 1L;
  while (index <= count) {
    long boundary = 0L;
    if (index == count) {
      boundary = 1L;
    } else if (u8(addr + index * 8L) == 47L) {
      boundary = 1L;
    }
    if (boundary == 1L) {
      long len = index - start;
      if (len < 1L) {
        return 0L;
      }
      if (len == 1L && u8(addr + start * 8L) == 46L) {
        return 0L;
      }
      if (len == 2L && u8(addr + start * 8L) == 46L && u8(addr + (start + 1L) * 8L) == 46L) {
        return 0L;
      }
      start = index + 1L;
    }
    index = index + 1L;
  }
  return 1L;
}

deRfun finish(long home, long code): int {
  obr::proc::exit(home, code);
  return 0;
}

deRfun main(): int {
  long home = obr::proc::home();
  long physical = obr::proc::alloc(home, 65536L);
  long other = obr::proc::alloc(home, 65536L);
  if (physical == 0L || other == 0L) {
    writeErr(home, "pwd: out of memory\n");
    return finish(home, 1L);
  }
  long physicalLen = readCwd(home, physical);
  if (physicalLen < 1L) {
    writeErr(home, "pwd: cannot get current directory\n");
    return finish(home, 1L);
  }
  long logical = 1L;
  long index = 1L;
  long count = argc(home);
  long ended = 0L;
  while (index < count && ended == 0L) {
    long at = argPtr(home, index);
    long len = argLen(home, index);
    if (len < 1L || u8(at) != 45L) {
      ended = 1L;
    } else if (len == 2L && u8(at + 8L) == 45L) {
      index = index + 1L;
      ended = 1L;
    } else if (len == 1L) {
      writeErr(home, "pwd: invalid option\n");
      return finish(home, 1L);
    } else {
      long cursor = 1L;
      while (cursor < len) {
        long bit = u8(at + cursor * 8L);
        if (bit == 76L) {
          logical = 1L;
        } else if (bit == 80L) {
          logical = 0L;
        } else {
          writeErr(home, "pwd: invalid option\n");
          return finish(home, 1L);
        }
        cursor = cursor + 1L;
      }
      index = index + 1L;
    }
  }
  if (index < count) {
    writeErr(home, "pwd: too many arguments\n");
    return finish(home, 1L);
  }
  long out = physical;
  long outLen = physicalLen;
  if (logical == 1L) {
    long name = obr::proc::alloc(home, 512L);
    long value = 0L;
    long valueLen = 0L;
    if (name != 0L) {
      memory::storeOctet(80L, name);
      memory::storeOctet(87L, name + 8L);
      memory::storeOctet(68L, name + 16L);
      if (envLookup(home, name, 3L, &value, &valueLen) == 1L && logicalOk(value, valueLen) == 1L) {
        plant(home, value, valueLen);
        if (obr::proc::chdir(home) == 0L) {
          long seen = readCwd(home, other);
          plant(home, physical, physicalLen);
          if (obr::proc::chdir(home) != 0L) {
            writeErr(home, "pwd: cannot restore current directory\n");
            return finish(home, 1L);
          }
          if (seen == physicalLen && sameSpan(other, seen, physical, physicalLen) == 1L) {
            out = value;
            outLen = valueLen;
          }
        }
      }
    }
  }
  writeFd(home, 1L, out, outLen);
  memory::storeOctet(10L, obr::proc::bytes(home));
  obr::proc::write(home, 1L, 0L, 1L);
  return finish(home, 0L);
}

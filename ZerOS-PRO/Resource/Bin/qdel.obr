/* POSIX.1-2017 qdel（utilities/qdel.html，批量作业族）。选定子集：
   qdel [-u user_list] [-x] [--] job_identifier...
   删除 /var/spool/nqs/job.<N>（job_identifier 子集：纯数字作业号，
   可带 .queue 后缀，忽略后缀）；-u user_list 校验 owner 一致（不一致
   写 qdel: job: not owner，退出 1）；-x 兼容接受。
   不存在写 qdel: job: nonexistent job，退出 1。
   诊断英文 ASCII，描述符 2，前缀 qdel:。结束用服务 28。 */
#DYN
import memory;
import obr.proc;
import arg;
import binutil;
import nqslib;

deRfun main(): int {
  long home = obr::proc::home();
  long st = obr::proc::alloc(home, 131072L);
  long buf = obr::proc::alloc(home, 524288L);
  long dir = obr::proc::alloc(home, 8192L * 8L);
  long dirLen = putText(dir, 0L, "/var/spool/nqs");
  nqsEnsure(home, dir, dirLen);
  long count = argc(home);
  long index = 1L;
  long ended = 0L;
  long userAt = 0L;
  long userLen = 0L;
  long failed = 0L;
  long operands = 0L;
  while (index < count) {
    long at = argPtr(home, index);
    long len = argLen(home, index);
    if (ended == 0L && len == 2L && spanSame(at, len, "--") == 1L) {
      ended = 1L;
    } else if (ended == 0L && len >= 2L && byteAt(at) == 45L) {
      long o = byteAt(at + 8L);
      if (o == 117L) {
        index = index + 1L;
        if (index >= count) {
          writeErr(home, "qdel: option requires an argument\n");
          return finish(home, 1L);
        }
        userAt = argPtr(home, index);
        userLen = argLen(home, index);
      } else if (o == 120L) {
        /* 兼容接受。 */
      } else {
        writeErr(home, "qdel: invalid option\n");
        return finish(home, 1L);
      }
    } else {
      operands = operands + 1L;
      /* 作业号：去掉 .queue 后缀。 */
      long idLen = 0L;
      while (idLen < len && byteAt(at + idLen * 8L) != 46L) {
        idLen = idLen + 1L;
      }
      long path = obr::proc::alloc(home, 8192L * 8L);
      long plen = nqsPath(dir, dirLen, 0L, path);
      /* 直接用操作数拼 job.<id>。 */
      copySpan(dir, path, dirLen);
      putText(path, dirLen, "/job.");
      copySpan(at, path + (dirLen + 5L) * 8L, idLen);
      plen = dirLen + 5L + idLen;
      if (nqsLoad(home, st, buf, path, plen) != 0L) {
        writeErr(home, "qdel: ");
        writeSpan(home, 2L, 0L, at, idLen);
        writeErr(home, ": nonexistent job\n");
        failed = 1L;
        index = index + 1L;
        continue;
      }
      if (userLen > 0L) {
        long vAt = 0L;
        long vLen = 0L;
        long ok = 0L;
        if (nqsGet(st, "owner", &vAt, &vLen) == 1L && vLen == userLen) {
          ok = 1L;
          long c = 0L;
          while (c < vLen) {
            if (byteAt(userAt + c * 8L) != byteAt(vAt + c * 8L)) {
              ok = 0L;
            }
            c = c + 1L;
          }
        }
        if (ok == 0L) {
          writeErr(home, "qdel: ");
          writeSpan(home, 2L, 0L, at, idLen);
          writeErr(home, ": not owner\n");
          failed = 1L;
          index = index + 1L;
          continue;
        }
      }
      plant(home, path, plen);
      if (obr::proc::unlink(home) != 0L) {
        writeErr(home, "qdel: ");
        writeSpan(home, 2L, 0L, at, idLen);
        writeErr(home, ": cannot delete\n");
        failed = 1L;
      }
    }
    index = index + 1L;
  }
  if (operands == 0L) {
    writeErr(home, "qdel: missing operand\n");
    return finish(home, 1L);
  }
  return finish(home, failed);
}

/* POSIX.1-2017 qsig（utilities/qsig.html，批量作业族）。选定子集：
   qsig [-s signal] [--] job_identifier...
   给作业发信号：登记 sig 字段（缺省 TERM；signal 可为无 SIG 前缀的名字
   或数字——本平台无运行中作业队列语义，信号登记为头字段由 runner 读取，
   如实注明「登记不投递」）。
   job_identifier 子集：纯数字作业号（可带 .queue 后缀，忽略后缀）。
   不存在写 qsig: job: nonexistent job，退出 1。
   诊断英文 ASCII，描述符 2，前缀 qsig:。结束用服务 28。 */
#DYN
import memory;
import obr.proc;
import arg;
import binutil;
import nqslib;

deRfun main(): int {
  long home = obr::proc::home();
  long st = obr::proc::alloc(home, 131072L);
  long buf = obr::proc::alloc(home, 524288L);
  long dir = obr::proc::alloc(home, 8192L * 8L);
  long dirLen = putText(dir, 0L, "/var/spool/nqs");
  nqsEnsure(home, dir, dirLen);
  long count = argc(home);
  long index = 1L;
  long ended = 0L;
  long sigAt = 0L;
  long sigLen = 0L;
  long failed = 0L;
  long operands = 0L;
  while (index < count) {
    long at = argPtr(home, index);
    long len = argLen(home, index);
    if (ended == 0L && len == 2L && spanSame(at, len, "--") == 1L) {
      ended = 1L;
    } else if (ended == 0L && len >= 2L && spanSame(at, 2L, "-s") == 1L) {
      if (len > 2L) {
        sigAt = at + 16L;
        sigLen = len - 2L;
      } else {
        index = index + 1L;
        if (index >= count) {
          writeErr(home, "qsig: option requires an argument\n");
          return finish(home, 1L);
        }
        sigAt = argPtr(home, index);
        sigLen = argLen(home, index);
      }
    } else if (ended == 0L && len >= 2L && byteAt(at) == 45L) {
      writeErr(home, "qsig: invalid option\n");
      return finish(home, 1L);
    } else {
      operands = operands + 1L;
      long idLen = 0L;
      while (idLen < len && byteAt(at + idLen * 8L) != 46L) {
        idLen = idLen + 1L;
      }
      long path = obr::proc::alloc(home, 8192L * 8L);
      copySpan(dir, path, dirLen);
      putText(path, dirLen, "/job.");
      copySpan(at, path + (dirLen + 5L) * 8L, idLen);
      long plen = dirLen + 5L + idLen;
      if (nqsLoad(home, st, buf, path, plen) != 0L) {
        writeErr(home, "qsig: ");
        writeSpan(home, 2L, 0L, at, idLen);
        writeErr(home, ": nonexistent job\n");
        failed = 1L;
        index = index + 1L;
        continue;
      }
      long vAt = obr::proc::bytes(home);
      long vLen = 0L;
      if (sigLen > 0L) {
        copySpan(sigAt, vAt, sigLen);
        vLen = sigLen;
      } else {
        vLen = putText(vAt, 0L, "TERM");
      }
      nqsSet(st, "sig", vAt, vLen);
      if (nqsSave(home, st, buf, path, plen) != 0L) {
        writeErr(home, "qsig: cannot write job\n");
        failed = 1L;
      }
    }
    index = index + 1L;
  }
  if (operands == 0L) {
    writeErr(home, "qsig: missing operand\n");
    return finish(home, 1L);
  }
  return finish(home, failed);
}

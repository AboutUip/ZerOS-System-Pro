/* POSIX.1-2017 qsub（utilities/qsub.html，批量作业族）。选定子集：
   qsub [-a date_time] [-A account_string] [-c interval] [-C directive_prefix]
        [-e path_name] [-h] [-I] [-j join] [-k keep] [-l resource_list]
        [-m mail_options] [-M mail_list] [-N job_name] [-o path_name]
        [-p priority] [-P project] [-q destination] [-r y|n] [-S path_name]
        [-u user_list] [-v variable_list] [-z] [-X] [--] [script]
   入队到 /var/spool/nqs/job.<N>（键值头 + 脚本）。脚本取自 script 或描述符 0。
   -h 挂起（state:H，缺省 state:Q）；-I 交互作业——本平台无交互守护，写
   qsub: interactive jobs are not supported on this platform，退出 1；
   其余选项原样登记进头（account/cinterval/directive/errfile/join/keep/
   mail_options/mail_list/jobname/outfile/priority/project/destination/
   rerun/shell/user_list/variable_list），由 qstat/qalter 可见；
   -z 兼容接受。属性值语义（资源表/邮件方式等）本平台无调度器，仅登记——
   逐项如实注明「登记不解释」。
   平台扩展 -X：手动 runner——把 state:Q 的作业脚本交 /os/sh 执行（管道喂
   脚本与 exit，与 at -X 同口径），完成后置 state:D 并删除作业文件；H 作业
   跳过。无自动到期判定（无守护进程，如实注明）。
   成功打印 `<作业号>.<目的>` 到标准输出（子集格式 job id=NN）。
   诊断英文 ASCII，描述符 2，前缀 qsub:。结束用服务 28。 */
#DYN
import memory;
import obr.proc;
import arg;
import binutil;
import nqslib;

deRfun main(): int {
  long home = obr::proc::home();
  long st = obr::proc::alloc(home, 131072L);
  long buf = obr::proc::alloc(home, 524288L);
  long dir = obr::proc::alloc(home, 8192L * 8L);
  if (st == 0L || buf == 0L || dir == 0L) {
    writeErr(home, "qsub: out of memory\n");
    return finish(home, 1L);
  }
  long dirLen = putText(dir, 0L, "/var/spool/nqs");
  long count = argc(home);
  long index = 1L;
  long ended = 0L;
  long holdStart = 0L;
  long runner = 0L;
  long scriptAt = 0L;
  long scriptLen = 0L;
  while (index < count) {
    long at = argPtr(home, index);
    long len = argLen(home, index);
    if (ended == 0L && len == 2L && spanSame(at, len, "--") == 1L) {
      ended = 1L;
    } else if (ended == 0L && len >= 2L && byteAt(at) == 45L && scriptLen == 0L) {
      long o = byteAt(at + 8L);
      if (o == 104L && len == 2L) {
        holdStart = 1L;
      } else if (o == 88L && len == 2L) {
        runner = 1L;
      } else if (o == 73L && len == 2L) {
        writeErr(home, "qsub: interactive jobs are not supported on this platform\n");
        return finish(home, 1L);
      } else if (o == 122L && len == 2L) {
        /* -z：兼容接受。 */
      } else if (o == 97L || o == 65L || o == 99L || o == 67L || o == 101L || o == 106L || o == 107L || o == 108L || o == 109L || o == 77L || o == 78L || o == 111L || o == 112L || o == 80L || o == 113L || o == 114L || o == 83L || o == 117L || o == 118L) {
        /* 带值选项：值取词内剩余或下一词，登记为键值头。 */
        long vAt = at + 16L;
        long vLen = len - 2L;
        if (vLen == 0L) {
          index = index + 1L;
          if (index < count) {
            vAt = argPtr(home, index);
            vLen = argLen(home, index);
          } else {
            vAt = 0L;
            vLen = 0L;
          }
        }
        /* 键名按选项字母登记（qstat 显示原始键）。 */
        long keyBuf = obr::proc::bytes(home);
        long kl = putText(keyBuf, 0L, "opt_");
        memory::storeOctet(o, keyBuf + kl * 8L);
        nqsSet(st, "opt", vAt, vLen);
        /* 逐项语义登记（不解释）。 */
        if (o == 78L) {
          nqsSet(st, "name", vAt, vLen);
        } else if (o == 111L) {
          nqsSet(st, "outfile", vAt, vLen);
        } else if (o == 101L) {
          nqsSet(st, "errfile", vAt, vLen);
        } else if (o == 112L) {
          nqsSet(st, "priority", vAt, vLen);
        } else if (o == 113L) {
          nqsSet(st, "queue", vAt, vLen);
        } else if (o == 65L) {
          nqsSet(st, "account", vAt, vLen);
        } else if (o == 80L) {
          nqsSet(st, "project", vAt, vLen);
        } else if (o == 77L) {
          nqsSet(st, "mail", vAt, vLen);
        } else if (o == 114L) {
          nqsSet(st, "rerun", vAt, vLen);
        } else if (o == 97L) {
          nqsSet(st, "atime", vAt, vLen);
        } else if (o == 83L) {
          nqsSet(st, "shell", vAt, vLen);
        }
      } else {
        writeErr(home, "qsub: invalid option\n");
        return finish(home, 1L);
      }
    } else {
      scriptAt = at;
      scriptLen = len;
    }
    index = index + 1L;
  }
  if (runner == 1L) {
    /* 手动 runner：执行 state:Q 作业。 */
    nqsEnsure(home, dir, dirLen);
    plant(home, dir, dirLen);
    long d = 0L;
    while (d < 512L) {
      if (obr::proc::readdir(home, d, 512L) != 0L) {
        break;
      }
      long nlen = obr::proc::slot(home, 256L);
      if (nlen < 1L) {
        break;
      }
      long nameAt = obr::proc::bytes(home);
      if (nlen > 4L && byteAt(nameAt) == 106L && byteAt(nameAt + 8L) == 111L && byteAt(nameAt + 16L) == 98L && byteAt(nameAt + 24L) == 46L) {
        long path = obr::proc::alloc(home, 8192L * 8L);
        long plen = nqsPath(dir, dirLen, 0L, path);
        /* 用 readdir 名字拼路径。 */
        copySpan(dir, path, dirLen);
        memory::storeOctet(47L, path + dirLen * 8L);
        copySpan(nameAt, path + (dirLen + 1L) * 8L, nlen);
        plen = dirLen + 1L + nlen;
        if (nqsLoad(home, st, buf, path, plen) == 0L) {
          long vAt = 0L;
          long vLen = 0L;
          if (nqsGet(st, "state", &vAt, &vLen) == 1L && vLen == 1L && byteAt(vAt) == 81L) {
            long bodyAt = memory::load64(st + 64L);
            long bodyLen = memory::load64(st + 128L);
            shellRun(home, buf + bodyAt * 8L, bodyLen);
            nqsSet(st, "state", vAt, 0L);
            vAt = obr::proc::bytes(home);
            memory::storeOctet(68L, vAt);
            nqsSet(st, "state", vAt, 1L);
            nqsSave(home, st, buf, path, plen);
            plant(home, path, plen);
            obr::proc::unlink(home);
          }
        }
      }
      d = d + 1L;
    }
    return finish(home, 0L);
  }
  /* 入队。 */
  nqsEnsure(home, dir, dirLen);
  long job = nqsNext(home, dir, dirLen);
  memory::store64(0L, st);
  memory::store64(0L, st + 64L);
  memory::store64(0L, st + 128L);
  long vAt = obr::proc::bytes(home);
  if (holdStart == 1L) {
    memory::storeOctet(72L, vAt);
    nqsSet(st, "state", vAt, 1L);
  } else {
    memory::storeOctet(81L, vAt);
    nqsSet(st, "state", vAt, 1L);
  }
  nqsSet(st, "owner", vAt, 0L);
  long oLen = putText(vAt, 0L, "root");
  nqsSet(st, "owner", vAt, oLen);
  /* 脚本正文。 */
  long bodyAt = 200000L;
  long bodyLen = 0L;
  if (scriptLen > 0L) {
    plant(home, scriptAt, scriptLen);
    if (obr::proc::open(home, 0L) != 0L) {
      writeErr(home, "qsub: cannot read script\n");
      return finish(home, 1L);
    }
    long fd = obr::proc::slot(home, 192L);
    while (bodyLen < 65536L) {
      if (obr::proc::read(home, fd, bodyLen, 4096L) != 0L) {
        break;
      }
      long got = obr::proc::slot(home, 320L);
      if (got <= 0L) {
        break;
      }
      if (got > 4096L) {
        got = 4096L;
      }
      copySpan(obr::proc::bytes(home), buf + (bodyAt + bodyLen) * 8L, got);
      bodyLen = bodyLen + got;
      if (got < 4096L) {
        break;
      }
    }
    obr::proc::close(home, fd);
  } else {
    while (bodyLen < 65536L) {
      if (obr::proc::read(home, 0L, bodyLen, 4096L) != 0L) {
        break;
      }
      long got = obr::proc::slot(home, 320L);
      if (got <= 0L) {
        break;
      }
      if (got > 4096L) {
        got = 4096L;
      }
      copySpan(obr::proc::bytes(home), buf + (bodyAt + bodyLen) * 8L, got);
      bodyLen = bodyLen + got;
      if (got < 4096L) {
        break;
      }
    }
  }
  memory::store64(bodyAt, st + 64L);
  memory::store64(bodyLen, st + 128L);
  long path = obr::proc::alloc(home, 8192L * 8L);
  long plen = nqsPath(dir, dirLen, job, path);
  if (nqsSave(home, st, buf, path, plen) != 0L) {
    writeErr(home, "qsub: cannot queue job\n");
    return finish(home, 1L);
  }
  writeStr(home, 1L, "job ");
  writeNum(home, 1L, job);
  writeStr(home, 1L, "\n");
  return finish(home, 0L);
}

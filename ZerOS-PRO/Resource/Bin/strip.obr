/* POSIX.1-2017 strip（utilities/strip.html）。形式是 strip [--] file...
   选项：无（POSIX 选项集为空；-- 结束选项仅作习惯接受）。
   本平台口径：可剥离文件是 obrc 产出的 ZerOS 映像（ZPB1 链接映像 / ZNB1 原生映像）。
   映像内的符号表是装载所需（导入/导出链接表），不可剥离；可剥离的「不必要信息」
   是映像旁的对照文件 <file>.debug（源行映射）与 <file>.zap（反汇编文本）。
   strip 删除这两个旁文件：存在则删，不存在也算成功；两者都不在时输出 nothing to
   strip 信息到描述符 2 并退出 0（不是错误）。
   不是 ZerOS 映像的文件写 strip: 文件: file format not recognized，退出 1；
   打不开写 strip: 文件: No such file or directory，退出 1。多文件逐个处理，
   任一失败最终退出 1。
   诊断英文 ASCII，描述符 2，前缀 strip:。结束用服务 28。 */
#DYN
import memory;
import obr.proc;
import arg;
import binutil;

deRfun readAt(long home, long fd, long off, long count, long out): long {
  if (obr::proc::read(home, fd, off, count) != 0L) {
    return 0L;
  }
  long got = obr::proc::slot(home, 320L);
  if (got < 0L) {
    return 0L;
  }
  copySpan(obr::proc::bytes(home), out, got);
  return got;
}

deRfun isImage(long home, long at, long len): long {
  plant(home, at, len);
  if (obr::proc::open(home, 0L) != 0L) {
    return -1L;
  }
  long fd = obr::proc::slot(home, 192L);
  long head = obr::proc::alloc(home, 64L);
  long got = readAt(home, fd, 0L, 4L, head);
  obr::proc::close(home, fd);
  if (got < 4L) {
    return 0L;
  }
  long zpb = 0L;
  long znb = 0L;
  if (byteAt(head) == 90L && byteAt(head + 8L) == 80L && byteAt(head + 16L) == 66L && byteAt(head + 24L) == 49L) {
    zpb = 1L;
  }
  if (byteAt(head) == 90L && byteAt(head + 8L) == 78L && byteAt(head + 16L) == 66L && byteAt(head + 24L) == 49L) {
    znb = 1L;
  }
  if (zpb == 1L || znb == 1L) {
    return 1L;
  }
  return 0L;
}

deRfun main(): int {
  long home = obr::proc::home();
  long count = argc(home);
  long index = 1L;
  long ended = 0L;
  long operands = 0L;
  long failed = 0L;
  while (index < count) {
    long at = argPtr(home, index);
    long len = argLen(home, index);
    if (ended == 0L && len == 2L && spanSame(at, len, "--") == 1L) {
      ended = 1L;
      index = index + 1L;
      continue;
    }
    if (ended == 0L && len >= 2L && byteAt(at) == 45L) {
      writeErr(home, "strip: invalid option\n");
      return finish(home, 1L);
    }
    operands = operands + 1L;
    index = index + 1L;
    long kind = isImage(home, at, len);
    if (kind < 0L) {
      writeErr(home, "strip: ");
      writeSpan(home, 2L, 0L, at, len);
      writeErr(home, ": No such file or directory\n");
      failed = 1L;
      index = index + 1L;
      continue;
    }
    if (kind == 0L) {
      writeErr(home, "strip: ");
      writeSpan(home, 2L, 0L, at, len);
      writeErr(home, ": file format not recognized\n");
      failed = 1L;
      index = index + 1L;
      continue;
    }
    /* 旁文件：<name>.debug 与 <name>.zap。存在即删；都不存在则提示。 */
    long name = obr::proc::alloc(home, 8192L * 8L);
    if (name == 0L) {
      failed = 1L;
      index = index + 1L;
      continue;
    }
    long removed = 0L;
    copySpan(at, name, len);
    long next = putText(name, len, ".debug");
    plant(home, name, next);
    if (obr::proc::unlink(home) == 0L) {
      removed = removed + 1L;
    }
    copySpan(at, name, len);
    next = putText(name, len, ".zap");
    plant(home, name, next);
    if (obr::proc::unlink(home) == 0L) {
      removed = removed + 1L;
    }
    if (removed == 0L) {
      writeErr(home, "strip: ");
      writeSpan(home, 2L, 0L, at, len);
      writeErr(home, ": nothing to strip\n");
    }
  }
  if (operands == 0L) {
    writeErr(home, "strip: missing operand\n");
    return finish(home, 1L);
  }
  return finish(home, failed);
}

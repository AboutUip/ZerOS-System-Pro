/* POSIX.1-2017 touch。形式是 touch [-acm] [-r ref_file|-t time] file...
   下标 0 是程序名。-- 结束选项。单独一个 - 是名为减号的文件。
   第一个不是选项的参数也结束选项。短选项可以叠在一起。
   -r 和 -t 若同一簇后面还有字节，那些字节就是参数；否则用下一个参数。
   不认识的字母，以及 -h、--help，写 touch: invalid option，立刻退出 1。
   缺了 -r 或 -t 的参数，写 touch: option requires an argument。
   -r 和 -t 不能同时出现，写 touch: cannot specify both -r and -t。
   没有文件操作数，写 touch: missing operand。这些都还没去动文件。

   -a 只改访问时间，-m 只改修改时间。两个都没写就两个都改。
   没写 -r 和 -t 时，改成现在。-r 用参考文件的对应时间。-t 用给出的时刻。
   时刻是从 Unix 纪元起的毫秒，本地时间与 UTC 相同。
   参考文件不存在就 touch: 路径: No such file or directory，一个文件都不处理。
   -t 不合法写 touch: invalid time，同样一个文件都不处理。
   年份只写两位时，69 到 99 当作 19xx，00 到 68 当作 20xx。
   没写年份时用今年。二月 29 日在非闰年不合法。秒可以是 60。

   没有 -c 且 stat 得到 2：用打开标志 1 建一个空文件，不写入任何八位组，再按上面的规则改时间。
   文件已经在：不打开，避免标志 1 把正文截掉，只改时间。
   -c 时文件不在：不创建，不写诊断，这一项不算失败。
   别的 stat 或打开失败写 touch: 路径: 原因，继续后面的文件，最后退出 1。
   诊断在描述符 2。结束用服务 28。 */
import memory;
import obr.os;
import obr.proc;
import arg;

deRfun u8(long addr): long {
  long value = memory::loadOctet(addr);
  if (value < 0L) {
    value = value + 256L;
  }
  return value;
}

deRfun copySpan(long from, long to, long count): void {
  long index = 0L;
  while (index < count) {
    memory::storeOctet(u8(from + index * 8L), to + index * 8L);
    index = index + 1L;
  }
}

deRfun writeErr(long home, string text): void {
  int raw = length(text);
  long count = raw;
  long index = 0L;
  while (index < count) {
    memory::storeOctet(text[index], obr::proc::bytes(home) + index * 8L);
    index = index + 1L;
  }
  if (count > 0L) {
    obr::proc::write(home, 2L, 0L, count);
  }
}

deRfun writeSpan(long home, long addr, long count): void {
  long done = 0L;
  while (done < count) {
    long chunk = count - done;
    if (chunk > 4096L) {
      chunk = 4096L;
    }
    long index = 0L;
    while (index < chunk) {
      memory::storeOctet(u8(addr + (done + index) * 8L), obr::proc::bytes(home) + index * 8L);
      index = index + 1L;
    }
    obr::proc::write(home, 2L, 0L, chunk);
    done = done + chunk;
  }
}

deRfun plant(long home, long addr, long count): void {
  memory::store64(count, obr::proc::path(home));
  copySpan(addr, obr::proc::path(home) + 64L, count);
}

deRfun finish(long home, long code): int {
  obr::proc::exit(home, code);
  return 0;
}

deRfun fail(long home, string text): int {
  writeErr(home, text);
  return finish(home, 1L);
}

deRfun why(long home, long status): void {
  if (status == -1L) {
    writeErr(home, "Permission denied");
  } else if (status == 3L) {
    writeErr(home, "Not a directory");
  } else if (status == 6L) {
    writeErr(home, "File name too long");
  } else if (status == 7L) {
    writeErr(home, "No space left on device");
  } else if (status == 13L) {
    writeErr(home, "Invalid argument");
  } else {
    writeErr(home, "No such file or directory");
  }
}

deRfun blame(long home, long addr, long count, long status): void {
  writeErr(home, "touch: ");
  if (count > 0L) {
    writeSpan(home, addr, count);
  }
  writeErr(home, ": ");
  why(home, status);
  writeErr(home, "\n");
}

/* 两位十进制。不合法返回 -1。00 是合法的 0。 */
deRfun twoDigits(long addr, long index): long {
  long hi = u8(addr + index * 8L);
  long lo = u8(addr + (index + 1L) * 8L);
  if (hi < 48L || hi > 57L || lo < 48L || lo > 57L) {
    return -1L;
  }
  return (hi - 48L) * 10L + (lo - 48L);
}

deRfun leapYear(long year): long {
  if (year % 400L == 0L) {
    return 1L;
  }
  if (year % 100L == 0L) {
    return 0L;
  }
  if (year % 4L == 0L) {
    return 1L;
  }
  return 0L;
}

deRfun floorDiv(long n, long d): long {
  long q = n / d;
  if (n % d < 0L) {
    q = q - 1L;
  }
  return q;
}

deRfun daysFromCivil(long y, long m, long d): long {
  if (m <= 2L) {
    y = y - 1L;
  }
  long era = y / 400L;
  if (y < 0L) {
    era = (y - 399L) / 400L;
  }
  long yoe = y - era * 400L;
  long march = m + 9L;
  if (m > 2L) {
    march = m - 3L;
  }
  long doy = (153L * march + 2L) / 5L + d - 1L;
  long doe = yoe * 365L + yoe / 4L - yoe / 100L + doy;
  return era * 146097L + doe - 719468L;
}

deRfun civilFromDays(long z, long* y, long* m, long* d): void {
  z = z + 719468L;
  long era = z / 146097L;
  if (z < 0L) {
    era = (z - 146096L) / 146097L;
  }
  long doe = z - era * 146097L;
  long yoe = (doe - doe / 1460L + doe / 36524L - doe / 146096L) / 365L;
  long year = yoe + era * 400L;
  long doy = doe - (365L * yoe + yoe / 4L - yoe / 100L);
  long mp = (5L * doy + 2L) / 153L;
  long day = doy - (153L * mp + 2L) / 5L + 1L;
  long month = mp + 3L;
  if (mp >= 10L) {
    month = mp - 9L;
  }
  if (month <= 2L) {
    year = year + 1L;
  }
  *y = year;
  *m = month;
  *d = day;
}

deRfun monthLen(long year, long month): long {
  if (month == 2L) {
    if (leapYear(year) == 1L) {
      return 29L;
    }
    return 28L;
  }
  if (month == 4L || month == 6L || month == 9L || month == 11L) {
    return 30L;
  }
  return 31L;
}

deRfun breakMillis(long ms, long* year, long* month, long* day, long* hour, long* minute, long* second): void {
  long days = floorDiv(ms, 86400000L);
  long tod = ms - days * 86400000L;
  long seconds = tod / 1000L;
  *hour = seconds / 3600L;
  *minute = (seconds % 3600L) / 60L;
  *second = seconds % 60L;
  civilFromDays(days, year, month, day);
}

deRfun packMillis(long year, long month, long day, long hour, long minute, long second): long {
  long days = daysFromCivil(year, month, day);
  return (days * 86400L + hour * 3600L + minute * 60L + second) * 1000L;
}

/* [[CC]YY]MMDDhhmm[.SS]。合法时 *out 是毫秒，返回 1。没写年份就用 now 的年份。 */
deRfun packTime(long addr, long count, long now, long* out): long {
  long sec = 0L;
  long body = count;
  if (count >= 3L && u8(addr + (count - 3L) * 8L) == 46L) {
    sec = twoDigits(addr, count - 2L);
    if (sec < 0L || sec > 60L) {
      return 0L;
    }
    body = count - 3L;
  }
  long base = 0L;
  long year = 0L;
  if (body == 8L) {
    long monthNow = 0L;
    long dayNow = 0L;
    long hourNow = 0L;
    long minuteNow = 0L;
    long secondNow = 0L;
    breakMillis(now, &year, &monthNow, &dayNow, &hourNow, &minuteNow, &secondNow);
    base = 0L;
  } else if (body == 10L) {
    long yy = twoDigits(addr, 0L);
    if (yy < 0L) {
      return 0L;
    }
    if (yy >= 69L) {
      year = 1900L + yy;
    } else {
      year = 2000L + yy;
    }
    base = 2L;
  } else if (body == 12L) {
    long cc = twoDigits(addr, 0L);
    long yy = twoDigits(addr, 2L);
    if (cc < 0L || yy < 0L) {
      return 0L;
    }
    year = cc * 100L + yy;
    base = 4L;
  } else {
    return 0L;
  }
  long month = twoDigits(addr, base);
  long day = twoDigits(addr, base + 2L);
  long hour = twoDigits(addr, base + 4L);
  long minute = twoDigits(addr, base + 6L);
  if (month < 1L || month > 12L || day < 1L || hour < 0L || hour > 23L || minute < 0L || minute > 59L) {
    return 0L;
  }
  if (day > monthLen(year, month)) {
    return 0L;
  }
  *out = packMillis(year, month, day, hour, minute, sec);
  return 1L;
}

/* 返回 0 成功或按 -c 跳过，1 这一项失败。已存在的文件不打开，只改时间。 */
deRfun touchOne(long home, long addr, long count, long keep, long setAccess, long setModify, long access, long modify): long {
  if (count < 1L) {
    blame(home, addr, count, 2L);
    return 1L;
  }
  plant(home, addr, count);
  long status = obr::proc::stat(home);
  if (status == 2L) {
    if (keep == 1L) {
      return 0L;
    }
    plant(home, addr, count);
    long opened = obr::proc::open(home, 1L);
    if (opened != 0L) {
      blame(home, addr, count, opened);
      return 1L;
    }
    long fd = obr::proc::slot(home, 192L);
    if (fd > 2L) {
      obr::proc::close(home, fd);
    }
  } else if (status != 0L) {
    blame(home, addr, count, status);
    return 1L;
  }
  plant(home, addr, count);
  long changed = obr::proc::utime(home, setAccess, setModify, access, modify);
  if (changed != 0L) {
    blame(home, addr, count, changed);
    return 1L;
  }
  return 0L;
}

deRfun main(): int {
  long home = obr::proc::home();
  long keep = 0L;
  long sawAccess = 0L;
  long sawModify = 0L;
  long haveRef = 0L;
  long haveTime = 0L;
  long refAt = 0L;
  long refLen = 0L;
  long timeAt = 0L;
  long timeLen = 0L;
  long index = 1L;
  long count = argc(home);
  long ended = 0L;
  while (index < count && ended == 0L) {
    long at = argPtr(home, index);
    long len = argLen(home, index);
    if (len < 1L || u8(at) != 45L || len == 1L) {
      ended = 1L;
    } else if (len == 2L && u8(at + 8L) == 45L) {
      index = index + 1L;
      ended = 1L;
    } else {
      long cursor = 1L;
      long stop = 0L;
      while (cursor < len && stop == 0L) {
        long bit = u8(at + cursor * 8L);
        if (bit == 97L) {
          sawAccess = 1L;
          cursor = cursor + 1L;
        } else if (bit == 109L) {
          sawModify = 1L;
          cursor = cursor + 1L;
        } else if (bit == 99L) {
          keep = 1L;
          cursor = cursor + 1L;
        } else if (bit == 114L || bit == 116L) {
          long gotAt = 0L;
          long gotLen = 0L;
          long ok = 0L;
          if (cursor + 1L < len) {
            gotAt = at + (cursor + 1L) * 8L;
            gotLen = len - cursor - 1L;
            ok = 1L;
          } else {
            index = index + 1L;
            if (index < count) {
              gotAt = argPtr(home, index);
              gotLen = argLen(home, index);
              ok = 1L;
            }
          }
          if (ok == 0L) {
            return fail(home, "touch: option requires an argument\n");
          }
          if (bit == 114L) {
            haveRef = 1L;
            refAt = gotAt;
            refLen = gotLen;
          } else {
            haveTime = 1L;
            timeAt = gotAt;
            timeLen = gotLen;
          }
          stop = 1L;
          cursor = len;
        } else {
          return fail(home, "touch: invalid option\n");
        }
      }
      index = index + 1L;
    }
  }
  if (haveRef == 1L && haveTime == 1L) {
    return fail(home, "touch: cannot specify both -r and -t\n");
  }
  if (obr::proc::clock(home) != 0L) {
    return fail(home, "touch: cannot read clock\n");
  }
  long now = obr::proc::slot(home, 128L);
  long packed = 0L;
  if (haveTime == 1L && packTime(timeAt, timeLen, now, &packed) == 0L) {
    return fail(home, "touch: invalid time\n");
  }
  long refAccess = 0L;
  long refModify = 0L;
  if (haveRef == 1L) {
    plant(home, refAt, refLen);
    long status = obr::proc::stat(home);
    if (status != 0L) {
      blame(home, refAt, refLen, status);
      return finish(home, 1L);
    }
    refAccess = obr::proc::slot(home, 448L);
    refModify = obr::proc::slot(home, 576L);
  }
  if (index >= count) {
    return fail(home, "touch: missing operand\n");
  }
  long setAccess = 1L;
  long setModify = 1L;
  if (sawAccess == 1L || sawModify == 1L) {
    setAccess = sawAccess;
    setModify = sawModify;
  }
  long access = now;
  long modify = now;
  if (haveRef == 1L) {
    access = refAccess;
    modify = refModify;
  }
  if (haveTime == 1L) {
    access = packed;
    modify = packed;
  }
  long failed = 0L;
  while (index < count) {
    if (touchOne(home, argPtr(home, index), argLen(home, index), keep, setAccess, setModify, access, modify) != 0L) {
      failed = 1L;
    }
    index = index + 1L;
  }
  if (failed != 0L) {
    return finish(home, 1L);
  }
  return finish(home, 0L);
}

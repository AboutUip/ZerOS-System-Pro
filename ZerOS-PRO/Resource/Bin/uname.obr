/* uname。形式是 uname [-amnrsv]。
   没有查询名字的调用，五个字段写死：
   s 是 ZerOS，n 是 zeros，r 是 0，v 是 0，m 是 zcp1。
   缺省只印 s。-a 把 s n r v m 全部打开。
   同一个字母写多次只记一次。输出顺序始终是 s n r v m，字段之间一个空格。
   整行一次写到描述符 1，末尾一个换行。
   -- 结束选项。单独的 -、空串和其它不是选项的词都是多余操作数。
   不认识的字母写 uname: invalid option，退出 1。
   有多余操作数写 uname: too many arguments，退出 1。
   成功退出 0。诊断在描述符 2，每条以换行结束。 */
import memory;
import obr.os;
import obr.proc;
import arg;

/* loadOctet 是补码。最高位为 1 时读出来是负数，加 256 才是八位组。 */
deRfun u8(long addr): long {
  long value = memory::loadOctet(addr);
  if (value < 0L) {
    value = value + 256L;
  }
  return value;
}

deRfun writeErr(long home, string text): void {
  int raw = length(text);
  long count = raw;
  long index = 0L;
  while (index < count) {
    memory::storeOctet(text[index], obr::proc::bytes(home) + index * 8L);
    index = index + 1L;
  }
  if (count > 0L) {
    obr::proc::write(home, 2L, 0L, count);
  }
}

deRfun addText(long home, long* filled, string text): void {
  int raw = length(text);
  long count = raw;
  long index = 0L;
  long at = *filled;
  while (index < count) {
    memory::storeOctet(text[index], obr::proc::bytes(home) + (at + index) * 8L);
    index = index + 1L;
  }
  *filled = at + count;
}

/* 从第二个字段起，先放一个空格（字节 32）。 */
deRfun gap(long home, long* filled, long* any): void {
  if (*any == 1L) {
    long at = *filled;
    memory::storeOctet(32L, obr::proc::bytes(home) + at * 8L);
    *filled = at + 1L;
  }
  *any = 1L;
}

deRfun emit(long home, long showS, long showN, long showR, long showV, long showM): void {
  long filled = 0L;
  long any = 0L;
  if (showS == 1L) {
    gap(home, &filled, &any);
    addText(home, &filled, "ZerOS");
  }
  if (showN == 1L) {
    gap(home, &filled, &any);
    addText(home, &filled, "zeros");
  }
  if (showR == 1L) {
    gap(home, &filled, &any);
    addText(home, &filled, "0");
  }
  if (showV == 1L) {
    gap(home, &filled, &any);
    addText(home, &filled, "0");
  }
  if (showM == 1L) {
    gap(home, &filled, &any);
    addText(home, &filled, "zcp1");
  }
  memory::storeOctet(10L, obr::proc::bytes(home) + filled * 8L);
  filled = filled + 1L;
  obr::proc::write(home, 1L, 0L, filled);
}

deRfun finish(long home, long code): int {
  obr::proc::exit(home, code);
  return 0;
}

deRfun main(): int {
  long home = obr::proc::home();
  long showS = 0L;
  long showN = 0L;
  long showR = 0L;
  long showV = 0L;
  long showM = 0L;
  long saw = 0L;
  long index = 1L;
  long count = argc(home);
  long ended = 0L;
  while (index < count && ended == 0L) {
    long at = argPtr(home, index);
    long len = argLen(home, index);
    if (len < 1L || u8(at) != 45L) {
      ended = 1L;
    } else if (len == 2L && u8(at + 8L) == 45L) {
      index = index + 1L;
      ended = 1L;
    } else if (len == 1L) {
      ended = 1L;
    } else {
      long cursor = 1L;
      while (cursor < len) {
        long bit = u8(at + cursor * 8L);
        /* 97 a，109 m，110 n，114 r，115 s，118 v。 */
        if (bit == 97L) {
          showS = 1L;
          showN = 1L;
          showR = 1L;
          showV = 1L;
          showM = 1L;
        } else if (bit == 109L) {
          showM = 1L;
        } else if (bit == 110L) {
          showN = 1L;
        } else if (bit == 114L) {
          showR = 1L;
        } else if (bit == 115L) {
          showS = 1L;
        } else if (bit == 118L) {
          showV = 1L;
        } else {
          writeErr(home, "uname: invalid option\n");
          return finish(home, 1L);
        }
        saw = 1L;
        cursor = cursor + 1L;
      }
      index = index + 1L;
    }
  }
  if (index < count) {
    writeErr(home, "uname: too many arguments\n");
    return finish(home, 1L);
  }
  if (saw == 0L) {
    showS = 1L;
  }
  emit(home, showS, showN, showR, showV, showM);
  return finish(home, 0L);
}

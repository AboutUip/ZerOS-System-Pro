/* 用户态 1 号任务。用 -pie -slot 0 编译，放到 /kernel/init。
   操作系统起来之后只调度 /os/sh。没有这一份就直接去等。
   shell 自己停在让出上，这里等不到它退出，驱动才能在这次等待之后放行。 */
import board;
import memory;
import obr.os;
import obr.proc;
import obr.text;

deRfun main(): int {
  long home = query(1L, 8L, obr::os::core());
  if (obr::text::put(obr::proc::path(home), "/os/sh") == 0L) {
    obr::proc::spawn(home, 0L);
  }
  while (1) {
    memory::store64(0L, home + 128L);
    if (obr::os::svc(21L) == 2L) {
      obr::os::yield();
    }
  }
  return 0;
}

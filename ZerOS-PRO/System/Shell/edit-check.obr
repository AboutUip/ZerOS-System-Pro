/* 行编辑、拆词和路径的自检。编成原生映像后由宿主核对三格：用例数、失败数、第一处失败。
   不进引导，也不打开终端。 */
import memory;
import edit;

deRfun stateAt(): long {
  return 4194304L;
}

deRfun outAt(): long {
  return 4718592L;
}

deRfun blobAt(): long {
  return 5242880L;
}

deRfun expect(boolean ok, long id): void {
  static long cases = 0L;
  static long fails = 0L;
  static long first = 0L;
  cases = cases + 1L;
  if (!ok) {
    if (first == 0L) {
      first = id;
    }
    fails = fails + 1L;
  }
  memory::store64(cases, 2097152L);
  memory::store64(fails, 2097216L);
  memory::store64(first, 2097280L);
}

deRfun plant(long addr, string text): long {
  int raw = length(text);
  int index = 0;
  while (index < raw) {
    memory::storeOctet(text[index], addr + index * 8L);
    index = index + 1;
  }
  long count = raw;
  return count;
}

deRfun lineIs(long state, string text): long {
  return bytesEq(state + 4096L, editLen(state), text);
}

deRfun feedText(long state, string text): long {
  int raw = length(text);
  int index = 0;
  long action = 0L;
  while (index < raw) {
    long value = text[index];
    action = editFeed(state, value);
    index = index + 1;
  }
  return action;
}

deRfun editCases(): void {
  long state = stateAt();
  editInit(state);

  expect(editFeed(state, 98L) == 0L && lineIs(state, "ab") == 1L && editCursor(state) == 2L, 2L);
  expect(editFeed(state, 1L) == 0L && editCursor(state) == 0L, 3L);
  expect(editFeed(state, 88L) == 0L && lineIs(state, "Xab") == 1L && editCursor(state) == 1L, 4L);
  expect(editFeed(state, 127L) == 0L && lineIs(state, "ab") == 1L && editCursor(state) == 0L, 5L);
  expect(editFeed(state, 5L) == 0L && editCursor(state) == 2L, 6L);
